@page "/services"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "UtilityBusiness")]
@inject IStringLocalizer<UtilityResources> L
@inject ServiceCatalogPageService PageService
@inject ContractServiceRegistrationService RegistrationService
@inject Web.Features.Utilities.Services.ServiceRegistrationService RegistrationRequestService
@inject ToastService Toast
@inject NavigationManager Navigation
@inject ILogger<ServiceCatalogView> Logger

<PageTitle>@L["CatalogPageTitle"]</PageTitle>

<div class="service-catalog-page">
    @if (_isLoading)
    {
        <div class="page-loading">
            <LoadingOverlay Visible="true" Text="@L["LoadingText"]" />
        </div>
    }
    else
    {
    <!-- Page Heading -->
    <header class="page-header">
        <div class="heading-group">
            <div class="breadcrumb-title-stack">
                <NavBreadcrumb />
                <h1 class="page-title">@L["CatalogHeading"]</h1>
            </div>
            <p class="page-subtitle">@L["CatalogSubtitle"]</p>
            @if (_isSampleData)
            {
                <div class="sample-data-note">
                    <span class="sample-data-badge">@L["SampleDataBadge"] · VHT-32</span>
                    <span>@L["SampleDataNotice"]</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <div class="sample-data-note" style="border-left: 3px solid #ef4444; background: #fef2f2; color: #991b1b;">
                    <span class="sample-data-badge" style="background: #ef4444; color: #fff;">@L["SqlErrorBadge"]</span>
                    <span>@_loadError</span>
                </div>
            }
        </div>

        <div class="header-actions">
            <button type="button" class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/services/prices")'>
                <LucideIcon Name="history" />
                <span>@L["PriceHistoryBtn"]</span>
            </button>
            <button type="button" class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/services/readings/costs")'>
                <LucideIcon Name="zap" />
                <span>@L["MeterReadingBtn"]</span>
            </button>
            <AuthorizeView Policy="UtilityManage">
                <Authorized>
                    <button id="service-create-open-btn" type="button" class="btn btn-primary" @onclick="() => _isCreateModalOpen = true">
                        <LucideIcon Name="plus" />
                        <span>@L["AddNewServiceBtn"]</span>
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    <!-- 4 Stat KPI Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-info">
                <span class="stat-label">@L["StatTotalServices"]</span>
                <div class="stat-value-row">
                    <span class="stat-number tabular-nums">@_totalCount</span>
                    <span class="stat-unit">@L["StatUnitTypes"]</span>
                </div>
                <span class="stat-subtext">@L["StatTotalServicesSub"]</span>
            </div>
            <div class="stat-icon-box indigo-box">
                <LucideIcon Name="package" />
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-info">
                <span class="stat-label">@L["StatActiveServices"]</span>
                <div class="stat-value-row">
                    <span class="stat-number tabular-nums">@_activeCount</span>
                    <span class="stat-unit">@L["StatUnitServices"]</span>
                </div>
                <span class="stat-subtext">@L["StatActiveServicesSub"]</span>
            </div>
            <div class="stat-icon-box green-box">
                <LucideIcon Name="circle-check" />
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-info">
                <span class="stat-label">@L["StatPausedServices"]</span>
                <div class="stat-value-row">
                    <span class="stat-number tabular-nums">@_pausedCount</span>
                    <span class="stat-unit">@L["StatUnitServices"]</span>
                </div>
                <span class="stat-subtext">@L["StatPausedServicesSub"]</span>
            </div>
            <div class="stat-icon-box slate-box">
                <LucideIcon Name="pause-circle" />
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-info">
                <span class="stat-label">@L["StatReadOnlyTariff"]</span>
                <div class="stat-value-row">
                    <span class="stat-number tabular-nums">@_readOnlyCount</span>
                    <span class="stat-unit">@L["StatUnitServices"]</span>
                </div>
                <span class="stat-subtext">@L["StatReadOnlyTariffSub"]</span>
            </div>
            <div class="stat-icon-box blue-box">
                <LucideIcon Name="shield-check" />
            </div>
        </div>
    </div>

    <!-- Filter and Search Toolbar -->
    <div class="filters-container">
        <div class="filters-row">
            <div class="search-input-box">
                <span class="search-icon" aria-hidden="true">
                    <LucideIcon Name="search" />
                </span>
                <input type="text"
                       class="input search-field"
                       placeholder="@L["SearchPlaceholder"]"
                       @bind="_searchTerm"
                       @bind:event="oninput"
                       @bind:after="ApplyFilters" />
            </div>

            <select class="input select-filter" @bind="_selectedBuilding" @bind:after="ApplyFilters">
                <option value="all">@L["AllBuildings"]</option>
                @foreach (var b in _visibleBuildings.Where(b => b.Id != "all"))
                {
                    <option value="@b.Id">@b.Name</option>
                }
            </select>

            <select class="input select-filter" @bind="_selectedType" @bind:after="ApplyFilters">
                <option value="all">@L["AllTypes"]</option>
                <option value="meter">@L["MeterType"]</option>
                <option value="fixed_monthly">@L["FixedMonthlyType"]</option>
                <option value="custom">@L["CustomType"]</option>
            </select>

            <select id="service-status-filter" class="input select-filter" @bind="_selectedStatus" @bind:after="ApplyFilters">
                <option value="all">@L["AllStatuses"]</option>
                <option value="active">@L["ActiveStatus"]</option>
                <option value="inactive">@L["InactiveStatus"]</option>
            </select>

            <button type="button" class="btn btn-secondary btn-reset" @onclick="ResetFilters">
                <LucideIcon Name="refresh" />
                <span>@L["ResetFilter"]</span>
            </button>
        </div>

        @if (_selectedBuilding != "all")
        {
            <div class="active-condition-tag">
                <span>@L["ActiveFilterCondition"]</span>
                <span class="condition-chip">
                    <span>@L["BuildingFilterPrefix"] <strong>@GetCurrentBuildingName()</strong></span>
                    <button type="button" class="chip-remove-btn" @onclick='() => { _selectedBuilding = "all"; ApplyFilters(); }' aria-label="@L["ClearFilterBtn"]">
                        <LucideIcon Name="close" />
                    </button>
                </span>
            </div>
        }
    </div>

    <!-- Table or Empty State -->
    <div class="table-card">
        @if (_filteredServices.Count > 0)
        {
            <div class="table-responsive">
                <table class="services-table">
                    <thead>
                        <tr>
                            <th>@L["ThServiceName"]</th>
                            <th>@L["ThServiceType"]</th>
                            <th>@L["ThUnit"]</th>
                            <th class="text-right">@L["ThRate"]</th>
                            <th>@L["ThEffectiveFrom"]</th>
                            <th>@L["ThEffectiveTo"]</th>
                            <th class="text-center">@L["ThActive"]</th>
                            <th class="text-right">@L["ThActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var service in _filteredServices)
                        {
                            <tr class="service-row" data-service-id="@service.Id">
                                <!-- Tên dịch vụ -->
                                <td class="cell-name">
                                    <div class="service-name-cell">
                                        <span class="service-name font-semibold text-indigo-900">@service.Name</span>
                                        @if (!string.IsNullOrWhiteSpace(service.Description))
                                        {
                                            <span class="service-description">@service.Description</span>
                                        }
                                        @if (_isSampleData)
                                        {
                                            <span class="record-origin-badge @(service.IsSessionCreated ? "session" : "")" style="white-space: normal; word-break: break-word;">
                                                @L[service.IsSessionCreated ? "RecordCreatedStatus" : "RecordSampleStatus"]
                                            </span>
                                        }
                                        @if (service.IsReadOnly)
                                        {
                                            <span class="readonly-badge" title="@L["ReadOnlyTitle"]">
                                                <LucideIcon Name="lock" />
                                            </span>
                                        }
                                    </div>
                                </td>

                                <!-- Loại dịch vụ -->
                                <td>
                                    <span class="type-pill @(service.Type == ServiceTypeCategory.Meter ? "meter-pill" : "fixed-pill")">
                                        @L[GetServiceTypeResourceKey(service.Type)]
                                    </span>
                                </td>

                                <!-- Đơn vị tính -->
                                <td class="cell-unit font-medium text-slate-600">@L[GetUnitResourceKey(service.Unit)]</td>

                                <!-- Đơn giá áp dụng -->
                                <td class="text-right cell-rate tabular-nums">
                                    @if (service.RateType == ServiceRateType.Tiered)
                                    {
                                        <button type="button" class="tier-view-link" @onclick="() => OpenTierModal(service.Name)">
                                            <span>@L["TieredTariffLabel"]</span>
                                            <LucideIcon Name="eye" />
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="font-bold text-slate-900">@MoneyFormatter.Format(service.CurrentRate)</span>
                                    }
                                    <span class="price-status @GetPriceStatusClass(service.PriceStatus)">
                                        @L[GetPriceStatusResourceKey(service.PriceStatus)]
                                    </span>
                                </td>

                                <!-- Bắt đầu hiệu lực -->
                                <td class="tabular-nums cell-date text-slate-600">
                                    @DateFormatter.Format(service.EffectiveFrom)
                                </td>

                                <!-- Hết hiệu lực -->
                                <td class="tabular-nums cell-date">
                                    @if (service.EffectiveTo.HasValue)
                                    {
                                        <span class="text-slate-600">@DateFormatter.Format(service.EffectiveTo)</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 italic">@L["NoData"]</span>
                                    }
                                </td>

                                <!-- Kích hoạt Switch -->
                                <td class="text-center cell-switch">
                                    <AuthorizeView Policy="UtilityManage">
                                        <Authorized>
                                            <button type="button"
                                                    role="switch"
                                                    aria-label="@L[service.Active ? "ActiveStatus" : "InactiveStatus"]"
                                                    aria-checked="@(service.Active ? "true" : "false")"
                                                    disabled="@(service.IsReadOnly || !_canWrite)"
                                                    class="ui-switch @(service.Active ? "active" : "") @(service.IsReadOnly || !_canWrite ? "disabled" : "")"
                                                    title="@(service.IsReadOnly ? L["ReadOnlyTitle"] : (!_canWrite ? L["WriteActionBlockedNotice"] : (service.Active ? L["ActiveStatus"] : L["InactiveStatus"])) )"
                                                    @onclick="() => HandleToggleActive(service.Id)">
                                                <span class="ui-switch-thumb" aria-hidden="true"></span>
                                            </button>
                                            @if (service.IsReadOnly)
                                            {
                                                <span class="readonly-inline-label">@L["ReadOnlyStatus"]</span>
                                            }
                                        </Authorized>
                                        <NotAuthorized>
                                            <span class="service-status-text">@L[service.Active ? "ActiveStatus" : "InactiveStatus"]</span>
                                        </NotAuthorized>
                                    </AuthorizeView>
                                </td>

                                <!-- Thao tác -->
                                <td class="text-right cell-actions">
                                    <div class="action-buttons-group">
                                        <button type="button"
                                                class="icon-action-btn"
                                                title="@L["ViewDetailTooltip"]"
                                                @onclick="() => HandleViewDetail(service)">
                                            <LucideIcon Name="eye" />
                                        </button>

                                        @if (_callerRole == Roles.KhachThue && !service.IsReadOnly && service.Type != ServiceTypeCategory.Meter)
                                        {
                                            var alreadyRegistered = _registeredServiceIds.Contains(GetCatalogId(service));
                                            <button type="button"
                                                    class="btn @(_pendingServiceIds.Contains(GetCatalogId(service)) ? "btn-secondary" : (alreadyRegistered ? "btn-secondary" : "btn-primary")) register-btn"
                                                    disabled="@_togglingServiceId.Contains(GetCatalogId(service))"
                                                    @onclick="() => OpenRegistrationModal(service)">
                                                <span>@(alreadyRegistered ? L["ServiceAlreadyRegisteredBtn"] : L["ServiceRegisterBtn"])</span>
                                            </button>
                                        }

                                        @if (service.IsReadOnly)
                                        {
                                            <button type="button"
                                                    class="icon-action-btn"
                                                    title="@L["PriceHistoryTooltip"]"
                                                    @onclick='() => Navigation.NavigateTo($"/services/prices?serviceId={Uri.EscapeDataString(service.Id)}")'>
                                                <LucideIcon Name="history" />
                                            </button>
                                        }
                                        else if (!service.IsReadOnly)
                                        {
                                            <AuthorizeView Policy="UtilityManage">
                                                <Authorized>
                                                    <button type="button"
                                                            class="icon-action-btn edit-action-btn"
                                                            data-action="edit-price"
                                                            title="@L["EditPriceTooltip"]"
                                                            aria-label="@L["EditPriceTooltip"]"
                                                            @onclick="() => OpenUpdateModal(service)">
                                                        <LucideIcon Name="edit" />
                                                    </button>
                                                    <button type="button"
                                                            class="icon-action-btn delete-action-btn"
                                                            data-action="delete-service"
                                                            title="@L["DeleteServiceTooltip"]"
                                                            aria-label="@L["DeleteServiceTooltip"]"
                                                            @onclick="() => RequestDelete(service)">
                                                        <LucideIcon Name="trash" />
                                                    </button>
                                                </Authorized>
                                            </AuthorizeView>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <footer class="table-footer">
                <div class="pagination-info">
                    @string.Format(L["TableResultCount"], _filteredServices.Count)
                </div>
            </footer>
        }
        else
        {
            <div class="empty-state-box">
                <div class="empty-icon-wrap">
                    <LucideIcon Name="search" Class="empty-state-icon" />
                </div>
                <h3 class="empty-title">@L["EmptyServicesTitle"]</h3>
                <p class="empty-desc">@L["EmptyServicesDesc"]</p>
                <button type="button" class="btn btn-secondary" @onclick="ResetFilters">
                    <LucideIcon Name="refresh" />
                    <span>@L["ClearFilterBtn"]</span>
                </button>
            </div>
        }
    </div>
    }
</div>

<!-- Modals -->
<AuthorizeView Policy="UtilityManage">
    <Authorized>
        <ServicePriceModal IsOpen="@_isUpdateModalOpen"
                           Service="@_selectedService"
                           CanWrite="@_canWrite"
                           OnClose="() => _isUpdateModalOpen = false"
                           OnSave="HandleSavePrice" />
        <ServiceCreateModal IsOpen="@_isCreateModalOpen"
                            Buildings="@_visibleBuildings"
                            CanWrite="@_canWrite"
                            OnClose="() => _isCreateModalOpen = false"
                            OnCreate="HandleCreateService" />
    </Authorized>
</AuthorizeView>

<ServiceTierModal IsOpen="@_isTierModalOpen"
                  ServiceName="@_tierServiceName"
                  OnClose="() => _isTierModalOpen = false" />

<AuthorizeView Policy="UtilityManage">
    <Authorized>
        <ConfirmDialog Visible="_isDeleteConfirmOpen"
                       Title="@L["DeleteServiceTitle"]"
                       Message="@L["DeleteServiceConfirm", _deleteTarget?.Name ?? string.Empty]"
                       ConfirmText="@L["DeleteServiceAction"]"
                       CancelText="@L["CancelBtn"]"
                       BusyText="@L["DeletingService"]"
                       Danger="true"
                       OnConfirm="DeleteServiceAsync"
                       OnCancel="CancelDelete" />
    </Authorized>
</AuthorizeView>

<!-- Tenant: đăng ký dịch vụ (gửi yêu cầu xét duyệt) -->
@if (_registrationTarget is not null)
{
    <div class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="registration-title" @onclick="CloseRegistrationModal">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <header class="modal-header">
                <div class="modal-header-text">
                    <h2 id="registration-title">@L["ServiceRequestTitle"]</h2>
                    <p>@_registrationTarget.Name</p>
                </div>
                <button type="button" class="icon-action-btn" aria-label="@L["CancelBtn"]" @onclick="CloseRegistrationModal">✕</button>
            </header>
            <div class="modal-body">
                <dl class="summary-lines">
                    <div><dt>@L["ServiceRequestName"]</dt><dd>@_registrationTarget.Name</dd></div>
                    <div><dt>@L["ServiceRequestPrice"]</dt><dd class="tabular-nums">@MoneyFormatter.Format(_registrationTarget.CurrentRate)</dd></div>
                    <div><dt>@L["ServiceRequestMonth"]</dt><dd class="tabular-nums">@DateOnly.FromDateTime(DateTime.Today).ToString("MM/yyyy")</dd></div>
                </dl>
                <p class="muted">@L["ServiceRequestMonthlyNote"]</p>
                <div class="form-field">
                    <label for="registration-note">@L["ServiceRequestNote"]</label>
                    <input id="registration-note" type="text" class="input" placeholder="@L["ServiceRequestNotePlaceholder"]" @bind="_registrationNote" />
                </div>
                @if (_registrationError is not null)
                {
                    <div class="form-alert" role="alert"><span>@_registrationError</span></div>
                }
                <p class="muted">@L["ServiceRequestPendingNote"]</p>
            </div>
            <footer class="modal-footer">
                <button type="button" class="btn btn-secondary" disabled="@_submittingRegistration" @onclick="CloseRegistrationModal">@L["CancelBtn"]</button>
                <button type="button" class="btn btn-primary" disabled="@_submittingRegistration" @onclick="SubmitRegistrationAsync">
                    @(_submittingRegistration ? L["LoadingText"] : L["ServiceRequestSubmit"])
                </button>
            </footer>
        </div>
    </div>
}

@code {
    private List<ServiceItemDto> _allServices = [];
    private List<ServiceItemDto> _filteredServices = [];
    private string _searchTerm = string.Empty;
    private string _selectedBuilding = "all";
    private string _selectedType = "all";
    private string _selectedStatus = "all";
    private string _callerRole = string.Empty;
    private List<BuildingOptionDto> _visibleBuildings = [];
    private bool _isLoading = true;
    private bool _isSampleData = false;
    private bool _canWrite = false;
    private string? _loadError;

    private int _totalCount;
    private int _activeCount;
    private int _pausedCount;
    private int _readOnlyCount;

    private bool _isUpdateModalOpen;
    private bool _isTierModalOpen;
    private bool _isCreateModalOpen;
    private bool _isDeleteConfirmOpen;
    private ServiceItemDto? _selectedService;
    private ServiceItemDto? _deleteTarget;
    private string _tierServiceName = string.Empty;

    private IReadOnlySet<int> _registeredServiceIds = new HashSet<int>();
    private readonly HashSet<int> _togglingServiceId = [];
    private IReadOnlySet<int> _pendingServiceIds = new HashSet<int>();

    private ServiceItemDto? _registrationTarget;
    private string _registrationNote = string.Empty;
    private string? _registrationError;
    private bool _submittingRegistration;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        _isLoading = false;
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _callerRole = await PageService.GetCurrentRoleAsync();
            _visibleBuildings = (await PageService.GetBuildingsForCallerAsync()).ToList();

            _allServices = (await PageService.GetServicesForCallerAsync()).ToList();
            _registeredServiceIds = string.Equals(_callerRole, Roles.KhachThue, StringComparison.OrdinalIgnoreCase)
                ? await RegistrationService.GetMyRegisteredServiceIdsAsync()
                : new HashSet<int>();
            if (string.Equals(_callerRole, Roles.KhachThue, StringComparison.OrdinalIgnoreCase))
            {
                var requests = await RegistrationRequestService.ListMineAsync();
                _pendingServiceIds = requests
                    .Where(request => request.Status == Web.Features.Utilities.Entities.ServiceRegistrationStatus.PendingApproval)
                    .Select(request => request.ServiceCatalogId)
                    .ToHashSet();
            }
            _totalCount = _allServices.Count;
            _activeCount = _allServices.Count(s => s.Active);
            _pausedCount = _allServices.Count(s => !s.Active);
            _readOnlyCount = _allServices.Count(s => s.IsReadOnly);

            _isSampleData = PageService.IsSampleData;
            _canWrite = PageService.CheckWriteSupport().CanWrite && string.Equals(_callerRole, Roles.ChuTro, StringComparison.OrdinalIgnoreCase);
            _loadError = null;
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the service catalog page.");
            _loadError = L["SqlLoadServicesError"];
            _allServices = [];
            _filteredServices = [];
            _totalCount = 0;
            _activeCount = 0;
            _pausedCount = 0;
            _readOnlyCount = 0;
        }
    }

    private static int GetCatalogId(ServiceItemDto service)
    {
        int.TryParse(service.Id, out var id);
        return id;
    }

    private void OpenRegistrationModal(ServiceItemDto service)
    {
        _registrationTarget = service;
        _registrationNote = string.Empty;
        _registrationError = null;
    }

    private void CloseRegistrationModal()
    {
        if (_submittingRegistration) return;
        _registrationTarget = null;
    }

    private async Task SubmitRegistrationAsync()
    {
        if (_registrationTarget is null || _submittingRegistration) return;
        _submittingRegistration = true;
        _registrationError = null;
        try
        {
            var request = await RegistrationRequestService.RequestAsync(
                GetCatalogId(_registrationTarget),
                _registrationNote);
            _pendingServiceIds = _pendingServiceIds.Append(request.ServiceCatalogId).ToHashSet();
            Toast.Success(L["ServiceRequestSuccess"]);
            _registrationTarget = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to submit service registration request.");
            _registrationError = ex.Message;
        }
        finally
        {
            _submittingRegistration = false;
        }
    }

    private void ApplyFilters()
    {
        IEnumerable<ServiceItemDto> query = _allServices;

        if (!string.IsNullOrWhiteSpace(_selectedBuilding) && _selectedBuilding != "all")
        {
            query = query.Where(s => s.BuildingId == "all" || s.BuildingId == _selectedBuilding);
        }

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(s =>
                s.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                s.Code.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (s.Description != null && s.Description.Contains(term, StringComparison.OrdinalIgnoreCase)));
        }

        if (!string.IsNullOrWhiteSpace(_selectedType) && _selectedType != "all")
        {
            query = _selectedType switch
            {
                "meter" => query.Where(s => s.Type == ServiceTypeCategory.Meter),
                "fixed_monthly" => query.Where(s => s.Type == ServiceTypeCategory.FixedMonthly),
                "custom" => query.Where(s => s.Type == ServiceTypeCategory.Custom),
                _ => query,
            };
        }

        if (!string.IsNullOrWhiteSpace(_selectedStatus) && _selectedStatus != "all")
        {
            query = _selectedStatus switch
            {
                "active" => query.Where(s => s.Active),
                "inactive" => query.Where(s => !s.Active),
                _ => query,
            };
        }

        _filteredServices = query.ToList();
    }

    private void ResetFilters()
    {
        _searchTerm = string.Empty;
        _selectedBuilding = "all";
        _selectedType = "all";
        _selectedStatus = "all";
        ApplyFilters();
    }

    private string GetCurrentBuildingName()
    {
        var b = _visibleBuildings.FirstOrDefault(x => x.Id == _selectedBuilding);
        return b?.Name ?? L["AllBuildings"];
    }

    private async Task HandleToggleActive(string serviceId)
    {
        var res = await PageService.ToggleServiceActiveAsync(serviceId);
        if (res.Success)
        {
            await LoadDataAsync();
            Toast.Success(_isSampleData ? L["ToastServiceToggled"] : L["ToastServiceToggledSuccessSql"]);
        }
        else
        {
            Toast.Error(res.ErrorMessage ?? L["ErrorUnknown"]);
        }
    }

    private void RequestDelete(ServiceItemDto service)
    {
        _deleteTarget = service;
        _isDeleteConfirmOpen = true;
    }

    private void CancelDelete()
    {
        _isDeleteConfirmOpen = false;
        _deleteTarget = null;
    }

    private async Task DeleteServiceAsync()
    {
        if (_deleteTarget is null)
        {
            CancelDelete();
            return;
        }

        var res = await PageService.DeleteServiceAsync(_deleteTarget.Id);
        _isDeleteConfirmOpen = false;
        if (res.Success)
        {
            _deleteTarget = null;
            await LoadDataAsync();
            Toast.Success(L["ToastServiceDeletedSuccess"]);
        }
        else
        {
            Toast.Error(res.ErrorMessage ?? L["ErrorUnknown"]);
        }
    }

    private void OpenTierModal(string serviceName)
    {
        _tierServiceName = serviceName;
        _isTierModalOpen = true;
    }

    private void OpenUpdateModal(ServiceItemDto service)
    {
        _selectedService = service;
        _isUpdateModalOpen = true;
    }

    private void HandleViewDetail(ServiceItemDto service)
    {
        if (service.RateType == ServiceRateType.Tiered)
        {
            OpenTierModal(service.Name);
        }
        else
        {
            Navigation.NavigateTo($"/services/prices?serviceId={Uri.EscapeDataString(service.Id)}");
        }
    }

    private async Task HandleSavePrice(UpdatePriceRequest req)
    {
        var res = await PageService.UpdateServicePriceAsync(req);
        if (res.Success)
        {
            await LoadDataAsync();
            Toast.Success(_isSampleData ? L["ToastPriceUpdatedSuccess"] : L["ToastPriceUpdatedSuccessSql"]);
            _isUpdateModalOpen = false;
        }
        else
        {
            Toast.Error(res.ErrorMessage ?? L["ErrorUnknown"]);
        }
    }

    private async Task HandleCreateService(CreateServiceRequest req)
    {
        var res = await PageService.AddServiceAsync(req);
        if (res.Success)
        {
            await LoadDataAsync();
            Toast.Success(_isSampleData ? L["ToastCreatedSuccess"] : L["ToastCreatedSuccessSql"]);
            _isCreateModalOpen = false;
        }
        else
        {
            Toast.Error(res.ErrorMessage ?? L["ErrorUnknown"]);
        }
    }

    private static string GetServiceTypeResourceKey(ServiceTypeCategory type) => type switch
    {
        ServiceTypeCategory.Meter => "MeterType",
        ServiceTypeCategory.FixedMonthly => "FixedMonthlyType",
        _ => "CustomType",
    };

    private static string GetUnitResourceKey(ServiceUnitCategory unit) => unit switch
    {
        ServiceUnitCategory.Room => "UnitRoom",
        ServiceUnitCategory.Person => "UnitPerson",
        ServiceUnitCategory.Vehicle => "UnitVehicle",
        ServiceUnitCategory.Visit => "UnitVisit",
        ServiceUnitCategory.KilowattHour => "UnitKwh",
        ServiceUnitCategory.CubicMeter => "UnitM3",
        _ => "NoData",
    };

    private static string GetPriceStatusResourceKey(PriceVersionStatus status) => status switch
    {
        PriceVersionStatus.Active => "StatusActive",
        PriceVersionStatus.Upcoming => "StatusUpcoming",
        _ => "StatusExpired",
    };

    private static string GetPriceStatusClass(PriceVersionStatus status) => status switch
    {
        PriceVersionStatus.Active => "price-status-active",
        PriceVersionStatus.Upcoming => "price-status-upcoming",
        _ => "price-status-expired",
    };
}
