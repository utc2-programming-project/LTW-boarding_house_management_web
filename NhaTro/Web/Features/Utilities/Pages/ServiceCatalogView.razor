@page "/services"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "UtilityBusiness")]
@using Web.Common.Utils
@using Web.Infrastructure.Time
@inject IStringLocalizer<UtilityResources> L
@inject ServiceCatalogPageService PageService
@inject ContractServiceRegistrationService RegistrationService
@inject Web.Features.Utilities.Services.ServiceRegistrationService RegistrationRequestService
@inject ToastService Toast
@inject NavigationManager Navigation
@inject ILogger<ServiceCatalogView> Logger
@inject TimeProvider Clock

<PageTitle>@L["CatalogPageTitle"]</PageTitle>

<div class="service-catalog-page">
    @if (_isLoading)
    {
        <div class="page-loading">
            <LoadingOverlay Visible="true" Text="@L["LoadingText"]" />
        </div>
    }
    else
    {
    <!-- Page Heading -->
    <PageHeading Title="@L["CatalogHeading"]" HelpText="@L["CatalogSubtitle"]">
        <HeadingMeta>
            @if (_isSampleData)
            {
                <div class="sample-data-note">
                    <span class="sample-data-badge">@L["SampleDataBadge"] · VHT-32</span>
                    <span>@L["SampleDataNotice"]</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <div class="sample-data-note" style="border-left: 3px solid var(--danger); background: var(--error-bg); color: var(--error-text);">
                    <span class="sample-data-badge" style="background: var(--danger); color: var(--on-primary);">@L["SqlErrorBadge"]</span>
                    <span>@_loadError</span>
                </div>
            }
        </HeadingMeta>
        <Actions>
            <div class="header-actions">
                <button type="button" class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/services/prices")'>
                    <LucideIcon Name="history" />
                    <span>@L["PriceHistoryBtn"]</span>
                </button>
                <button type="button" class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/services/readings/costs")'>
                    <LucideIcon Name="zap" />
                    <span>@L["MeterReadingBtn"]</span>
                </button>
                <AuthorizeView Policy="UtilityManage">
                    <Authorized>
                        <button id="service-create-open-btn" type="button" class="btn btn-primary" @onclick="() => _isCreateModalOpen = true">
                            <LucideIcon Name="plus" />
                            <span>@L["AddNewServiceBtn"]</span>
                        </button>
                    </Authorized>
                </AuthorizeView>
            </div>
        </Actions>
    </PageHeading>

    <!-- 4 Stat KPI Cards -->
    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-card__top">
                <span class="stat-label">
                    @L["StatTotalServices"]
                    <button type="button" class="stat-help" data-tip="@L["StatTotalServicesSub"]" aria-label="@L["StatTotalServicesSub"]">?</button>
                </span>
                <span class="stat-icon stat-icon--accent"><LucideIcon Name="package" /></span>
            </div>
            <div class="stat-value">@_totalCount <small>@L["StatUnitTypes"]</small></div>
        </div>

        <div class="stat-card">
            <div class="stat-card__top">
                <span class="stat-label">
                    @L["StatActiveServices"]
                    <button type="button" class="stat-help" data-tip="@L["StatActiveServicesSub"]" aria-label="@L["StatActiveServicesSub"]">?</button>
                </span>
                <span class="stat-icon stat-icon--success"><LucideIcon Name="circle-check" /></span>
            </div>
            <div class="stat-value">@_activeCount <small>@L["StatUnitServices"]</small></div>
        </div>

        <div class="stat-card">
            <div class="stat-card__top">
                <span class="stat-label">
                    @L["StatPausedServices"]
                    <button type="button" class="stat-help" data-tip="@L["StatPausedServicesSub"]" aria-label="@L["StatPausedServicesSub"]">?</button>
                </span>
                <span class="stat-icon stat-icon--neutral"><LucideIcon Name="pause-circle" /></span>
            </div>
            <div class="stat-value">@_pausedCount <small>@L["StatUnitServices"]</small></div>
        </div>

        <div class="stat-card">
            <div class="stat-card__top">
                <span class="stat-label">
                    @L["StatReadOnlyTariff"]
                    <button type="button" class="stat-help" data-tip="@L["StatReadOnlyTariffSub"]" aria-label="@L["StatReadOnlyTariffSub"]">?</button>
                </span>
                <span class="stat-icon stat-icon--info"><LucideIcon Name="shield-check" /></span>
            </div>
            <div class="stat-value">@_readOnlyCount <small>@L["StatUnitServices"]</small></div>
        </div>
    </div>

    <!-- Filter and Search Toolbar -->
    <div class="filter-bar filter-bar--panel">
        <div class="filter-bar__row">
            <div class="filter-bar__search">
                <label class="sr-only" for="service-search">@L["SearchPlaceholder"]</label>
                <span class="filter-bar__icon" aria-hidden="true"><LucideIcon Name="search" /></span>
                <input id="service-search" type="search" class="input"
                       placeholder="@L["SearchPlaceholder"]"
                       @bind="_searchTerm" @bind:event="oninput" @bind:after="ApplyFilters" />
            </div>
            <div class="filter-bar__field filter-bar__select">
                <label class="sr-only" for="service-building">@L["AllBuildings"]</label>
                <select id="service-building" class="input" @bind="_selectedBuilding" @bind:after="ApplyFilters">
                    <option value="all">@L["AllBuildings"]</option>
                    @foreach (var b in _visibleBuildings.Where(b => b.Id != "all"))
                    {
                        <option value="@b.Id">@b.Name</option>
                    }
                </select>
            </div>
            <div class="filter-bar__field filter-bar__select">
                <label class="sr-only" for="service-type">@L["AllTypes"]</label>
                <select id="service-type" class="input" @bind="_selectedType" @bind:after="ApplyFilters">
                    <option value="all">@L["AllTypes"]</option>
                    <option value="meter">@L["MeterType"]</option>
                    <option value="fixed_monthly">@L["FixedMonthlyType"]</option>
                    <option value="custom">@L["CustomType"]</option>
                </select>
            </div>
            <div class="filter-bar__field filter-bar__select">
                <label class="sr-only" for="service-status-filter">@L["AllStatuses"]</label>
                <select id="service-status-filter" class="input" @bind="_selectedStatus" @bind:after="ApplyFilters">
                    <option value="all">@L["AllStatuses"]</option>
                    <option value="active">@L["ActiveStatus"]</option>
                    <option value="inactive">@L["InactiveStatus"]</option>
                </select>
            </div>
            <div class="filter-bar__actions">
                <button type="button" class="btn btn-secondary filter-bar__reset" @onclick="ResetFilters">
                    <LucideIcon Name="refresh-cw" /> @L["ResetFilter"]
                </button>
            </div>
        </div>

        @if (_selectedBuilding != "all")
        {
            <div class="filter-bar__chips">
                <span>@L["ActiveFilterCondition"]</span>
                <span class="condition-chip">
                    <span>@L["BuildingFilterPrefix"] <strong>@GetCurrentBuildingName()</strong></span>
                    <button type="button" class="chip-remove-btn" @onclick='() => { _selectedBuilding = "all"; ApplyFilters(); }' aria-label="@L["ClearFilterBtn"]">
                        <LucideIcon Name="close" />
                    </button>
                </span>
            </div>
        }
    </div>

    <!-- Table or Empty State -->
    <div class="table-card">
        @if (_filteredServices.Count > 0)
        {
            <div class="table-responsive">
                <table class="services-table">
                    <thead>
                        <tr>
                            <th>@L["ThServiceName"]</th>
                            <th>@L["ThTypeUnit"]</th>
                            <th class="text-right">@L["ThRate"]</th>
                            <th>@L["ThEffectiveRange"]</th>
                            <th class="text-center">@L["ThActive"]</th>
                            <th class="text-center">@L["ThActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var service in _pageServices)
                        {
                            <tr class="service-row" data-service-id="@service.Id">
                                <!-- Tên dịch vụ -->
                                <td class="cell-name">
                                    <div class="service-name-cell">
                                        <span class="service-name font-semibold text-indigo-900">@service.Name</span>
                                        @if (!string.IsNullOrWhiteSpace(service.Description))
                                        {
                                            <span class="service-description">@service.Description</span>
                                        }
                                        @if (_isSampleData)
                                        {
                                            <span class="record-origin-badge @(service.IsSessionCreated ? "session" : "")" style="white-space: normal; word-break: break-word;">
                                                @L[service.IsSessionCreated ? "RecordCreatedStatus" : "RecordSampleStatus"]
                                            </span>
                                        }
                                    </div>
                                </td>

                                <!-- Loại dịch vụ + Đơn vị tính -->
                                <td>
                                    <div class="service-meta-cell">
                                        <span class="type-pill @(service.Type == ServiceTypeCategory.Meter ? "meter-pill" : "fixed-pill")">
                                            @L[GetServiceTypeResourceKey(service.Type)]
                                        </span>
                                        <span class="service-unit">@L[GetUnitResourceKey(service.Unit)]</span>
                                    </div>
                                </td>

                                <!-- Đơn giá áp dụng -->
                                <td class="text-right cell-rate tabular-nums">
                                    @if (service.RateType == ServiceRateType.Tiered)
                                    {
                                        <button type="button" class="tier-view-link" @onclick="() => OpenTierModal(service)">
                                            <span>@L["TieredTariffLabel"]</span>
                                            <LucideIcon Name="eye" />
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="font-bold text-slate-900">@MoneyFormatter.Format(service.CurrentRate)</span>
                                    }
                                    <span class="price-status @GetPriceStatusClass(service.PriceStatus)">
                                        @L[GetPriceStatusResourceKey(service.PriceStatus)]
                                    </span>
                                </td>

                                <!-- Thời hạn hiệu lực -->
                                <td class="tabular-nums cell-date">
                                    <div class="service-period">
                                        <span>@DateFormatter.Format(service.EffectiveFrom)</span>
                                        <span class="service-period-end">– @(service.EffectiveTo.HasValue ? DateFormatter.Format(service.EffectiveTo) : L["NoEndDate"].Value)</span>
                                    </div>
                                </td>

                                <!-- Kích hoạt: công tắc hoặc nhãn "Chỉ xem" với biểu giá mặc định -->
                                <td class="text-center cell-switch">
                                    @if (service.IsReadOnly)
                                    {
                                        <span class="readonly-chip" title="@L["ReadOnlyTitle"]">
                                            <LucideIcon Name="lock" />
                                            <span>@L["ReadOnlyStatus"]</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <AuthorizeView Policy="UtilityManage">
                                            <Authorized>
                                                <button type="button"
                                                        role="switch"
                                                        aria-label="@L[service.Active ? "ActiveStatus" : "InactiveStatus"]"
                                                        aria-checked="@(service.Active ? "true" : "false")"
                                                        disabled="@(!_canWrite)"
                                                        class="ui-switch @(service.Active ? "active" : "") @(!_canWrite ? "disabled" : "")"
                                                        title="@(!_canWrite ? L["WriteActionBlockedNotice"] : (service.Active ? L["ActiveStatus"] : L["InactiveStatus"]))"
                                                        @onclick="() => HandleToggleActive(service.Id)">
                                                    <span class="ui-switch-thumb" aria-hidden="true"></span>
                                                </button>
                                            </Authorized>
                                            <NotAuthorized>
                                                <span class="service-status-text">@L[service.Active ? "ActiveStatus" : "InactiveStatus"]</span>
                                            </NotAuthorized>
                                        </AuthorizeView>
                                    }
                                </td>

                                <!-- Thao tác -->
                                <td class="text-center cell-actions">
                                    <div class="p2-row-actions">
                                        <button type="button"
                                                class="icon-button p2-menu-trigger @(IsMenuOpen(service.Id) ? "is-open" : null)"
                                                title="@L["ThActions"]"
                                                aria-label="@($"{L["ThActions"]}: {service.Name}")"
                                                aria-haspopup="menu"
                                                aria-expanded="@(IsMenuOpen(service.Id) ? "true" : "false")"
                                                aria-controls="@($"service-row-menu-{service.Id}")"
                                                @onclick="() => ToggleRowMenu(service.Id)">
                                            <LucideIcon Name="ellipsis" />
                                        </button>
                                        @if (IsMenuOpen(service.Id))
                                        {
                                            <div id="@($"service-row-menu-{service.Id}")" class="p2-row-menu" role="menu" aria-label="@L["ThActions"]" data-row-menu>
                                                <button type="button" class="p2-row-menu-item" role="menuitem" @onclick="() => MenuView(service)">
                                                    <LucideIcon Name="eye" /><span>@L["ViewDetailTooltip"]</span>
                                                </button>

                                                @if (_callerRole == Roles.KhachThue && !service.IsReadOnly && service.Type != ServiceTypeCategory.Meter)
                                                {
                                                    <button type="button" class="p2-row-menu-item" role="menuitem"
                                                            disabled="@_togglingServiceId.Contains(GetCatalogId(service))"
                                                            @onclick="() => MenuRegister(service)">
                                                        <LucideIcon Name="send" />
                                                        <span>@L["ServiceRegisterBtn"]</span>
                                                    </button>
                                                }

                                                @if (service.IsReadOnly)
                                                {
                                                    <button type="button" class="p2-row-menu-item" role="menuitem" @onclick="() => MenuHistory(service)">
                                                        <LucideIcon Name="history" /><span>@L["PriceHistoryTooltip"]</span>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <AuthorizeView Policy="UtilityManage">
                                                        <Authorized>
                                                            <button type="button" class="p2-row-menu-item" role="menuitem" @onclick="() => MenuEdit(service)">
                                                                <LucideIcon Name="edit" /><span>@L["EditPriceTooltip"]</span>
                                                            </button>
                                                            <div class="p2-row-menu-sep" role="separator"></div>
                                                            <button type="button" class="p2-row-menu-item danger" role="menuitem" @onclick="() => MenuDelete(service)">
                                                                <LucideIcon Name="trash" /><span>@L["DeleteServiceTooltip"]</span>
                                                            </button>
                                                        </Authorized>
                                                    </AuthorizeView>
                                                }
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <footer class="table-footer">
                <span class="pagination-info">
                    @string.Format(L["TablePageInfo"], _page, TotalPages, _filteredServices.Count)
                </span>
                <div class="pager">
                    <button type="button" class="btn btn-secondary btn-sm" disabled="@(_page <= 1)" @onclick="() => ChangePage(-1)">
                        @L["Previous"]
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" disabled="@(_page >= TotalPages)" @onclick="() => ChangePage(1)">
                        @L["Next"]
                    </button>
                </div>
            </footer>
        }
        else
        {
            <div class="empty-state-box">
                <div class="empty-icon-wrap">
                    <LucideIcon Name="search" Class="empty-state-icon" />
                </div>
                <h3 class="empty-title">@L["EmptyServicesTitle"]</h3>
                <p class="empty-desc">@L["EmptyServicesDesc"]</p>
                <button type="button" class="btn btn-secondary" @onclick="ResetFilters">
                    <LucideIcon Name="refresh" />
                    <span>@L["ClearFilterBtn"]</span>
                </button>
            </div>
        }
    </div>
    }
</div>

<!-- Modals -->
<AuthorizeView Policy="UtilityManage">
    <Authorized>
        <ServicePriceModal IsOpen="@_isUpdateModalOpen"
                           Service="@_selectedService"
                           CanWrite="@_canWrite"
                           OnClose="() => _isUpdateModalOpen = false"
                           OnSave="HandleSavePrice" />
        <ServiceCreateModal IsOpen="@_isCreateModalOpen"
                            Buildings="@_visibleBuildings"
                            CanWrite="@_canWrite"
                            OnClose="() => _isCreateModalOpen = false"
                            OnCreate="HandleCreateService" />
    </Authorized>
</AuthorizeView>

<ServiceTierModal IsOpen="@_isTierModalOpen"
                  Service="@_tierService"
                  OnClose="() => _isTierModalOpen = false" />

<AuthorizeView Policy="UtilityManage">
    <Authorized>
        <ConfirmDialog Visible="_isDeleteConfirmOpen"
                       Title="@L["DeleteServiceTitle"]"
                       Message="@L["DeleteServiceConfirm", _deleteTarget?.Name ?? string.Empty]"
                       ConfirmText="@L["DeleteServiceAction"]"
                       CancelText="@L["CancelBtn"]"
                       BusyText="@L["DeletingService"]"
                       Danger="true"
                       OnConfirm="DeleteServiceAsync"
                       OnCancel="CancelDelete" />
    </Authorized>
</AuthorizeView>

<!-- Tenant: đăng ký dịch vụ (gửi yêu cầu xét duyệt) -->
@if (_registrationTarget is not null)
{
    <div class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="registration-title" @onclick="CloseRegistrationModal">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <header class="modal-header">
                <div class="modal-header-text">
                    <h2 id="registration-title">@L["ServiceRequestTitle"]</h2>
                    <p>@_registrationTarget.Name</p>
                </div>
                <button type="button" class="icon-action-btn" aria-label="@L["CancelBtn"]" @onclick="CloseRegistrationModal">✕</button>
            </header>
            <div class="modal-body">
                <dl class="summary-lines">
                    <div><dt>@L["ServiceRequestName"]</dt><dd>@_registrationTarget.Name</dd></div>
                    <div><dt>@L["ServiceRequestPrice"]</dt><dd class="tabular-nums">@MoneyFormatter.Format(_registrationTarget.CurrentRate)</dd></div>
                    <div><dt>@L["ServiceRequestMonth"]</dt><dd class="tabular-nums">@Clock.TodayVietnam().ToString("MM/yyyy")</dd></div>
                </dl>
                <p class="muted">@L["ServiceRequestMonthlyNote"]</p>
                <div class="form-field">
                    <label for="registration-contract">@L["ServiceRequestContractLabel"]</label>
                    @if (_contractOptions.Count == 0)
                    {
                        <div class="form-alert" role="alert"><span>@L["RegErrorNoActiveContract"]</span></div>
                    }
                    else
                    {
                        <select id="registration-contract" class="input" @bind="_registrationContractId" disabled="@(_contractOptions.Count <= 1)">
                            @foreach (var contract in _contractOptions)
                            {
                                <option value="@contract.ContractId">@contract.RoomCode · @contract.PropertyName · @contract.ContractNumber</option>
                            }
                        </select>
                    }
                </div>
                <div class="form-field">
                    <label for="registration-note">@L["ServiceRequestNote"]</label>
                    <input id="registration-note" type="text" class="input" placeholder="@L["ServiceRequestNotePlaceholder"]" @bind="_registrationNote" />
                </div>
                @if (IsRegisteredForSelectedContract)
                {
                    <div class="form-alert" role="status"><span>@L["ServiceAlreadyRegisteredBtn"]</span></div>
                }
                else if (IsPendingForSelectedContract)
                {
                    <div class="form-alert" role="status"><span>@L["ServicePendingApprovalBtn"]</span></div>
                }
                @if (_registrationError is not null)
                {
                    <div class="form-alert" role="alert"><span>@_registrationError</span></div>
                }
                <p class="muted">@L["ServiceRequestPendingNote"]</p>
            </div>
            <footer class="modal-footer">
                <button type="button" class="btn btn-secondary" disabled="@_submittingRegistration" @onclick="CloseRegistrationModal">@L["CancelBtn"]</button>
                <button type="button" class="btn btn-primary" disabled="@(_submittingRegistration || _registrationContractId is null || IsRegisteredForSelectedContract || IsPendingForSelectedContract)" @onclick="SubmitRegistrationAsync">
                    @(_submittingRegistration ? L["LoadingText"] : L["ServiceRequestSubmit"])
                </button>
            </footer>
        </div>
    </div>

    <ConfirmDialog Visible="_registrationDiscard"
                   Title="@L["P5DiscardTitle"]"
                   Message="@L["P5DiscardBody"]"
                   ConfirmText="@L["P5DiscardConfirm"]"
                   CancelText="@L["P5DiscardKeep"]"
                   OnConfirm="DiscardRegistrationChangesAsync"
                   OnCancel="KeepRegistrationEditing" />
}

@code {
    private const int PageSize = 20;

    private List<ServiceItemDto> _allServices = [];
    private List<ServiceItemDto> _filteredServices = [];
    private List<ServiceItemDto> _pageServices = [];
    private int _page = 1;
    private string _searchTerm = string.Empty;
    private string _selectedBuilding = "all";
    private string _selectedType = "all";
    private string _selectedStatus = "all";
    private string _callerRole = string.Empty;
    private List<BuildingOptionDto> _visibleBuildings = [];
    private bool _isLoading = true;
    private bool _isSampleData = false;
    private bool _canWrite = false;
    private string? _loadError;

    private int _totalCount;
    private int _activeCount;
    private int _pausedCount;
    private int _readOnlyCount;

    private string? _openMenuId;
    private bool _isUpdateModalOpen;
    private bool _isTierModalOpen;
    private bool _isCreateModalOpen;
    private bool _isDeleteConfirmOpen;
    private ServiceItemDto? _selectedService;
    private ServiceItemDto? _deleteTarget;
    private ServiceItemDto? _tierService;

    private IReadOnlySet<(Guid ContractId, int ServiceCatalogId)> _registeredServices = new HashSet<(Guid, int)>();
    private readonly HashSet<int> _togglingServiceId = [];
    private readonly HashSet<(Guid ContractId, int ServiceCatalogId)> _pendingRegistrations = [];
    private IReadOnlyList<ServiceRegistrationContractOptionDto> _contractOptions = [];

    private ServiceItemDto? _registrationTarget;
    private Guid? _registrationContractId;
    private string _registrationNote = string.Empty;
    private string? _registrationError;
    private bool _submittingRegistration;
    private bool _registrationDiscard;

    private int TotalPages => PaginationHelper.TotalPages(_filteredServices.Count, PageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        _isLoading = false;
    }

    private async Task LoadDataAsync(bool resetPage = true)
    {
        try
        {
            _callerRole = await PageService.GetCurrentRoleAsync();
            _visibleBuildings = (await PageService.GetBuildingsForCallerAsync()).ToList();

            _allServices = (await PageService.GetServicesForCallerAsync()).ToList();
            _registeredServices = string.Equals(_callerRole, Roles.KhachThue, StringComparison.OrdinalIgnoreCase)
                ? (await RegistrationService.GetMyRegisteredServicesAsync())
                    .Select(item => (item.ContractId, item.ServiceCatalogId))
                    .ToHashSet()
                : new HashSet<(Guid, int)>();
            if (string.Equals(_callerRole, Roles.KhachThue, StringComparison.OrdinalIgnoreCase))
            {
                var requests = await RegistrationRequestService.ListMineAsync();
                _pendingRegistrations.Clear();
                foreach (var request in requests.Where(request =>
                             request.Status == Web.Features.Utilities.Entities.ServiceRegistrationStatus.PendingApproval))
                {
                    _pendingRegistrations.Add((request.ContractId, request.ServiceCatalogId));
                }
                _contractOptions = await RegistrationRequestService.GetMyContractOptionsAsync();
            }
            _totalCount = _allServices.Count;
            _activeCount = _allServices.Count(s => s.Active);
            _pausedCount = _allServices.Count(s => !s.Active);
            _readOnlyCount = _allServices.Count(s => s.IsReadOnly);

            _isSampleData = PageService.IsSampleData;
            _canWrite = PageService.CheckWriteSupport().CanWrite && string.Equals(_callerRole, Roles.ChuTro, StringComparison.OrdinalIgnoreCase);
            _loadError = null;
            ApplyFiltersCore(resetPage);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the service catalog page.");
            _loadError = L["SqlLoadServicesError"];
            _allServices = [];
            _filteredServices = [];
            _totalCount = 0;
            _activeCount = 0;
            _pausedCount = 0;
            _readOnlyCount = 0;
        }
    }

    private static int GetCatalogId(ServiceItemDto service)
    {
        int.TryParse(service.Id, out var id);
        return id;
    }

    private bool IsRegisteredForSelectedContract =>
        _registrationContractId is Guid contractId
        && _registrationTarget is not null
        && _registeredServices.Contains((contractId, GetCatalogId(_registrationTarget)));

    private bool IsPendingForSelectedContract =>
        _registrationContractId is Guid contractId
        && _registrationTarget is not null
        && _pendingRegistrations.Contains((contractId, GetCatalogId(_registrationTarget)));

    private void OpenRegistrationModal(ServiceItemDto service)
    {
        _registrationTarget = service;
        _registrationContractId = _contractOptions.FirstOrDefault()?.ContractId;
        _registrationNote = string.Empty;
        _registrationError = null;
        _registrationDiscard = false;
    }

    private void CloseRegistrationModal()
    {
        if (_submittingRegistration) return;
        if (!string.IsNullOrWhiteSpace(_registrationNote))
        {
            _registrationDiscard = true;
            return;
        }
        _registrationTarget = null;
    }

    private Task KeepRegistrationEditing()
    {
        _registrationDiscard = false;
        return Task.CompletedTask;
    }

    private Task DiscardRegistrationChangesAsync()
    {
        _registrationDiscard = false;
        _registrationTarget = null;
        return Task.CompletedTask;
    }

    private async Task SubmitRegistrationAsync()
    {
        if (_registrationTarget is null || _registrationContractId is null || _submittingRegistration) return;
        _submittingRegistration = true;
        _registrationError = null;
        try
        {
            var request = await RegistrationRequestService.RequestAsync(
                GetCatalogId(_registrationTarget),
                _registrationContractId.Value,
                _registrationNote);
            _pendingRegistrations.Add((_registrationContractId!.Value, request.ServiceCatalogId));
            Toast.Success(L["ServiceRequestSuccess"]);
            _registrationTarget = null;
        }
        catch (ServiceRegistrationException ex)
        {
            Logger.LogError(ex, "Failed to submit service registration request.");
            var key = $"RegError{ex.ErrorCode}";
            var localized = L[key];
            _registrationError = localized.ResourceNotFound ? L["RegErrorGeneric"].Value : localized.Value;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to submit service registration request.");
            _registrationError = L["RegErrorGeneric"];
        }
        finally
        {
            _submittingRegistration = false;
        }
    }

