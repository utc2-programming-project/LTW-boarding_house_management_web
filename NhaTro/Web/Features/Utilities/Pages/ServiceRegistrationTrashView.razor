@page "/services/registrations/trash"
@attribute [Authorize(Roles = Roles.ChuTro)]
@rendermode InteractiveServer
@using Web.Common.Models
@using Web.Common.SoftDelete
@inject ContractServiceRegistrationService RegistrationService
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject IStringLocalizer<UtilityResources> L
@inject ILogger<ServiceRegistrationTrashView> Logger

<PageTitle>@L["ServiceRegistrationTrashTitle"] · @L["CatalogPageTitle"]</PageTitle>

<div class="page-stack">
    <PageHeading Title="@L["ServiceRegistrationTrashTitle"]" HelpText="@L["ServiceRegistrationTrashSubtitle"]">
        <Actions>
            <button type="button" class="btn btn-danger" @onclick="OpenEmptyTrash">
                <LucideIcon Name="trash" />@L["EmptyTrash"]
            </button>
            <button type="button" class="btn btn-secondary" @onclick="GoToRegistrations">
                <LucideIcon Name="file" />@L["RegManageTitle"]
            </button>
        </Actions>
    </PageHeading>

    <div class="filter-bar filter-bar--panel">
        <div class="filter-bar__row">
            <div class="filter-bar__search">
                <label class="sr-only" for="registration-trash-search">@L["ServiceRegistrationTrashSearchLabel"]</label>
                <span class="filter-bar__icon" aria-hidden="true"><LucideIcon Name="search" /></span>
                <input id="registration-trash-search" type="search" class="input"
                       placeholder="@L["ServiceRegistrationTrashSearchPlaceholder"]" @bind="_keyword" @bind:after="ReloadAsync" />
            </div>
            <div class="filter-bar__actions">
                <div class="filter-bar__state">
                    <label class="sr-only" for="registration-trash-page-size">@L["P2RowsPerPage"]</label>
                    <select id="registration-trash-page-size" class="input" value="@_pageSize" @onchange="ChangePageSize">
                        <option value="10">@string.Format(L["RowsPerPageOption"].Value, 10)</option>
                        <option value="20">@string.Format(L["RowsPerPageOption"].Value, 20)</option>
                        <option value="50">@string.Format(L["RowsPerPageOption"].Value, 50)</option>
                    </select>
                </div>
                <FilterResetButton OnClick="ClearSearchAsync" />
            </div>
        </div>
    </div>

    <DataTable @ref="_table" @key="_tableKey" TItem="ServiceRegistrationTrashItemDto" Columns="_columns"
               ItemsProvider="LoadDeletedAsync" PageSize="_pageSize"
               Caption="@L["ServiceRegistrationTrashTitle"]" Labels="_tableLabels" />
</div>

<ConfirmDialog Visible="_restoreVisible" Title="@L["ServiceRegistrationTrashRestoreTitle"]"
               Message="@string.Format(L["ServiceRegistrationTrashRestoreMessage"], _restoreItem?.ServiceName ?? string.Empty)"
               ConfirmText="@L["Restore"]" CancelText="@L["Cancel"]"
               OnConfirm="RestoreAsync" OnCancel="CloseRestore" />

<PurgeConfirmDialog Visible="_purgeVisible" Title="@L["PurgeTitle"]"
                    Message="@string.Format(L["PurgeMessage"], _purgeItem?.ServiceName ?? string.Empty)"
                    ExpectedText="@(_purgeItem?.ServiceName ?? string.Empty)"
                    PromptText="@string.Format(L["PurgeTypePrompt"], _purgeItem?.ServiceName ?? string.Empty)"
                    MismatchText="@L["PurgeMismatch"]"
                    ConfirmText="@L["Purge"]" CancelText="@L["Cancel"]"
                    OnConfirm="PurgeAsync" OnCancel="ClosePurge" />

<PurgeConfirmDialog Visible="_emptyVisible" Title="@L["EmptyTrashTitle"]"
                    Message="@L["EmptyTrashMessage"]"
                    ExpectedText="@L["TrashEmptyPhrase"]"
                    PromptText="@string.Format(L["PurgeTypePrompt"], L["TrashEmptyPhrase"].Value)"
                    MismatchText="@L["PurgeMismatch"]"
                    ConfirmText="@L["EmptyTrash"]" CancelText="@L["Cancel"]"
                    OnConfirm="EmptyTrashAsync" OnCancel="CloseEmptyTrash" />

@code {
    private DataTable<ServiceRegistrationTrashItemDto>? _table;
    private IReadOnlyList<DataTableColumn<ServiceRegistrationTrashItemDto>> _columns = [];
    private DataTableLabels _tableLabels = new();
    private ServiceRegistrationTrashItemDto? _restoreItem;
    private ServiceRegistrationTrashItemDto? _purgeItem;
    private bool _restoreVisible;
    private bool _purgeVisible;
    private bool _emptyVisible;
    private int _pageSize = 20;
    private int _tableKey;
    private string _keyword = string.Empty;
    private int? _openMenuId;

    protected override void OnInitialized()
    {
        _tableLabels = DataTableLabelLocalizer.Create(L);
        _columns = BuildColumns();
    }

    private IReadOnlyList<DataTableColumn<ServiceRegistrationTrashItemDto>> BuildColumns()
    {
        RenderFragment<ServiceRegistrationTrashItemDto> actions = item => @<div class="p2-row-actions">
            <button type="button" class="icon-button p2-menu-trigger @(_openMenuId == item.Id ? "is-open" : null)"
                    aria-haspopup="menu" aria-expanded="@(_openMenuId == item.Id ? "true" : "false")"
                    @onclick="() => ToggleMenu(item.Id)">
                <LucideIcon Name="ellipsis" />
            </button>
            @if (_openMenuId == item.Id)
            {
                <div class="p2-row-menu" role="menu">
                    <button type="button" class="p2-row-menu-item" @onclick="() => { CloseMenu(); RequestRestore(item); }">
                        <LucideIcon Name="refresh-cw" /><span>@L["Restore"]</span>
                    </button>
                    <div class="p2-row-menu-sep" role="separator"></div>
                    <button type="button" class="p2-row-menu-item danger" @onclick="() => { CloseMenu(); RequestPurge(item); }">
                        <LucideIcon Name="trash" /><span>@L["Purge"]</span>
                    </button>
                </div>
            }
        </div>;

        return
        [
            new() { Key = "contract", Title = L["ServiceRegistrationTrashColumnContract"], Value = item => item.ContractNumber },
            new() { Key = "room", Title = L["ServiceRegistrationTrashColumnRoom"], Value = item => item.RoomCode },
            new() { Key = "property", Title = L["ServiceRegistrationTrashColumnProperty"], Value = item => item.PropertyName },
            new() { Key = "service", Title = L["ServiceRegistrationTrashColumnService"], Value = item => item.ServiceName },
            new() { Key = "month", Title = L["ServiceRegistrationTrashColumnMonth"], Value = item => DateFormatter.FormatMonth(item.MonthStart) },
            TrashColumns.DeletedAt<ServiceRegistrationTrashItemDto>(L["TrashDeletedAt"], item => item.DeletedAt),
            TrashColumns.Actions(L["P2Actions"], actions),
        ];
    }

    private async Task<PagedResult<ServiceRegistrationTrashItemDto>> LoadDeletedAsync(DataTableRequest request) =>
        await RegistrationService.ListDeletedAsync(
            string.IsNullOrWhiteSpace(_keyword) ? null : _keyword.Trim(),
            request.Page,
            request.PageSize);

    private Task ClearSearchAsync()
    {
        _keyword = string.Empty;
        return ReloadAsync();
    }

    private Task ReloadAsync()
    {
        _tableKey++;
        return Task.CompletedTask;
    }

    private Task ChangePageSize(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value) && value is 10 or 20 or 50)
        {
            _pageSize = value;
            _tableKey++;
        }

        return Task.CompletedTask;
    }

    private void ToggleMenu(int id) => _openMenuId = _openMenuId == id ? null : id;
    private void CloseMenu() => _openMenuId = null;

    private void RequestRestore(ServiceRegistrationTrashItemDto item)
    {
        _restoreItem = item;
        _restoreVisible = true;
    }

    private void CloseRestore()
    {
        _restoreVisible = false;
        _restoreItem = null;
    }

    private void RequestPurge(ServiceRegistrationTrashItemDto item)
    {
        _purgeItem = item;
        _purgeVisible = true;
    }

    private void ClosePurge()
    {
        _purgeVisible = false;
        _purgeItem = null;
    }

    private void OpenEmptyTrash() => _emptyVisible = true;

    private void CloseEmptyTrash() => _emptyVisible = false;

    private async Task RestoreAsync()
    {
        if (_restoreItem is null)
        {
            CloseRestore();
            return;
        }

        try
        {
            await RegistrationService.RestoreAsync(_restoreItem.Id);
            CloseRestore();
            Toasts.Success(L["ServiceRegistrationTrashRestored"]);
            await ReloadTableAsync();
        }
        catch (Exception ex) when (ex is ServiceRegistrationException or UnauthorizedAccessException)
        {
            CloseRestore();
            Toasts.Error(ErrorText(ex));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Service registration restore failed");
            CloseRestore();
            Toasts.Error(L["PurgeFailed"]);
        }
    }

    private async Task PurgeAsync()
    {
        if (_purgeItem is null)
        {
            ClosePurge();
            return;
        }

        try
        {
            await RegistrationService.PurgeAsync(_purgeItem.Id);
            ClosePurge();
            Toasts.Success(L["PurgeSuccess"]);
            await ReloadTableAsync();
        }
        catch (Exception ex) when (ex is ServiceRegistrationException or UnauthorizedAccessException)
        {
            ClosePurge();
            Toasts.Error(ErrorText(ex));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Service registration purge failed");
            ClosePurge();
            Toasts.Error(L["PurgeFailed"]);
        }
    }

    private async Task EmptyTrashAsync()
    {
        try
        {
            var summary = await RegistrationService.PurgeAllAsync();
            CloseEmptyTrash();
            if (summary.Purged == 0 && summary.Skipped == 0)
            {
                Toasts.Success(L["EmptyTrashNothing"]);
            }
            else
            {
                Toasts.Success(string.Format(L["EmptyTrashSuccess"], summary.Purged, summary.Skipped));
            }

            await ReloadTableAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Service registration empty trash failed");
            CloseEmptyTrash();
            Toasts.Error(L["PurgeFailed"]);
        }
    }

    private async Task ReloadTableAsync()
    {
        if (_table is not null)
        {
            await _table.ReloadAsync();
        }
    }

    private string ErrorText(Exception ex) => ex switch
    {
        ServiceRegistrationException { ErrorCode: "TrashItemNotFound" } => L["PurgeNotInTrash"],
        ServiceRegistrationException { ErrorCode: "ServiceDeleted" } => L["ServiceRegistrationServiceDeleted"],
        ServiceRegistrationException { ErrorCode: "Duplicate" } => L["ServiceRegistrationDuplicate"],
        UnauthorizedAccessException => L["ErrorAccessDenied"],
        _ => L["PurgeFailed"],
    };

    private void GoToRegistrations() => Navigation.NavigateTo("/service-registrations");
}
