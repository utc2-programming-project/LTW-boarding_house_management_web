}

@if (_createPeriodOpen)
{
    var createPeriodStart = new DateOnly(_createPeriodYear, _createPeriodMonth, 1);
    var createPeriodEnd = new DateOnly(_createPeriodYear, _createPeriodMonth, DateTime.DaysInMonth(_createPeriodYear, _createPeriodMonth));
    var createPeriodRoom = CreatePeriodRooms.FirstOrDefault(room => room.ContractId == _createPeriodContractId);
    <div class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="cost-create-period-title" @onclick="CloseCreatePeriod">
        <div class="modal-dialog period-create-dialog" @onclick:stopPropagation="true">
            <header class="modal-header">
                <div class="modal-header-icon">
                    <LucideIcon Name="file-plus" />
                </div>
                <div class="modal-header-text">
                    <h2 id="cost-create-period-title">@UL["P5CostCreatePeriodTitle"]</h2>
                    <p>@UL["P5CostCreatePeriodSubtitle"]</p>
                </div>
                <button type="button" class="icon-btn" aria-label="@UL["P5CostClosePanel"]" @onclick="CloseCreatePeriod" disabled="@_creatingPeriod">
                    <LucideIcon Name="close" />
                </button>
            </header>

            <div class="modal-body">
                <div class="edit-grid">
                    <div class="form-field">
                        <label for="period-property">@UL["P5CostPeriodPropertyLabel"]</label>
                        <select id="period-property" class="input" @bind="_createPeriodPropertyId" @bind:after="OnCreatePeriodPropertyChanged">
                            <option value="">@UL["P5CostAllProperties"]</option>
                            @foreach (var property in _data?.Properties ?? [])
                            {
                                <option value="@property.Id">@property.Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-field">
                        <label for="period-room">@UL["P5CostPeriodRoomLabel"]</label>
                        <select id="period-room"
                                class="input @(_createPeriodRoomInvalid ? "is-invalid" : "")"
                                disabled="@_createPeriodLoadingRooms"
                                @bind="_createPeriodContractId"
                                @bind:after="OnCreatePeriodRoomChanged">
                            <option value="">@UL["P5CostPeriodSelectRoom"]</option>
                            @foreach (var room in CreatePeriodRooms)
                            {
                                <option value="@room.ContractId">@room.RoomCode</option>
                            }
                        </select>
                        @if (_createPeriodLoadingRooms)
                        {
                            <span class="field-hint">@UL["P5CostPeriodLoadingRooms"]</span>
                        }
                        else if (createPeriodRoom is not null)
