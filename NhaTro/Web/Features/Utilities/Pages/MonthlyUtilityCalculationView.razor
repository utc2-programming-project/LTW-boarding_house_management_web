@page "/services/readings/costs"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "UtilityBusiness")]
@using System.Globalization
@using Web.Common.Utils
@using Web.Features.Invoices.Enums
@using Web.Features.Utilities.Services
@using Web.Infrastructure.Time
@inject MonthlyUtilityCalculationPageService PageService
@inject TimeProvider Clock
@inject ToastService Toast
@inject NavigationManager Navigation
@inject IStringLocalizer<UtilityResources> UL

<PageTitle>@UL["P5CostPageTitle"]</PageTitle>

<div class="monthly-cost-page">
    <PageHeading Title="@UL["P5CostHeading"]" HelpText="@UL["P5CostSubtitle"]">
        <Actions>
            <AuthorizeView Policy="UtilityRecord">
                <Authorized>
                    <button type="button" class="btn btn-primary" disabled="@_loading" @onclick="OpenCreatePeriodAsync">
                        <LucideIcon Name="file-plus" />
                        <span>@UL["P5CostCreatePeriod"]</span>
                    </button>
                </Authorized>
            </AuthorizeView>
            <button type="button" class="btn btn-secondary" disabled="@_loading" @onclick="LoadAsync">
                <LucideIcon Name="refresh" />
                <span>@UL["P5CostRefresh"]</span>
            </button>
        </Actions>
    </PageHeading>

    @if (_loading)
    {
        <div class="stats-grid" aria-hidden="true">
            @for (var i = 0; i < 4; i++)
            {
                <div class="stat-card skeleton tall"></div>
            }
        </div>
        <div class="filter-bar filter-bar--panel skeleton short"></div>
        <div class="table-card skeleton table-skeleton"></div>
        <div class="loading-line" role="status">
            <span class="spinner" aria-hidden="true"></span>
            <span>@UL["P5CostLoading"]</span>
        </div>
    }
    else if (_error is not null)
    {
        <div class="inline-error" role="alert">
            <LucideIcon Name="alert-triangle" />
            <div>
                <h2>@UL["P5CostLoadErrorTitle"]</h2>
                <p>@_error</p>
            </div>
            <button type="button" class="btn btn-secondary" @onclick="LoadAsync">
                <LucideIcon Name="refresh" />
                <span>@UL["P5CostRetry"]</span>
            </button>
        </div>
    }
    else if (_data is not null)
    {
        <div class="stats-grid">
            <div class="stat-card">
                <span class="stat-label">@UL["P5CostStatRooms"]</span>
                <span class="stat-number tabular-nums">@FilteredRooms.Count</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">@UL["P5CostStatRecorded"]</span>
                <span class="stat-number tabular-nums">@RecordedCount</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">@UL["P5CostStatInvoiced"]</span>
                <span class="stat-number tabular-nums">@InvoicedCount</span>
            </div>
            <div class="stat-card total-stat">
                <span class="stat-label">@UL["P5CostStatTotal"]</span>
                <span class="stat-number tabular-nums">@MoneyFormatter.Format(FilteredRooms.Sum(room => room.TotalAmount))</span>
            </div>
        </div>

        <div class="filter-bar filter-bar--panel">
            <div class="filter-bar__row">
                <div class="filter-bar__stack filter-bar__select">
                    <label for="cost-property">@UL["P5CostPropertyFilter"]</label>
                    <select id="cost-property" class="input" @bind="_propertyId" @bind:after="LoadAsync">
                        <option value="">@UL["P5CostAllProperties"]</option>
                        @foreach (var property in _data.Properties)
                        {
                            <option value="@property.Id">@property.Name</option>
                        }
                    </select>
                </div>

                <div class="filter-bar__stack filter-bar__select">
                    <label for="cost-period-start">@UL["P5CostPeriodStart"]</label>
                    <input id="cost-period-start" type="date" class="input" @bind="_periodStart" @bind:after="OnPeriodChangedAsync" />
                </div>

                <div class="filter-bar__stack filter-bar__select">
                    <label for="cost-period-end">@UL["P5CostPeriodEnd"]</label>
                    <input id="cost-period-end" type="date" class="input" @bind="_periodEnd" @bind:after="OnPeriodChangedAsync" />
                </div>

                <div class="filter-bar__search">
                    <label class="sr-only" for="cost-search">@UL["P5CostSearchLabel"]</label>
                    <span class="filter-bar__icon" aria-hidden="true"><LucideIcon Name="search" /></span>
                    <input id="cost-search" type="search" class="input" placeholder="@UL["P5CostSearchPlaceholder"]"
                           @bind="_search" @bind:event="oninput" @bind:after="ResetPage" />
                </div>

                <label class="filter-bar__check" for="cost-only-unrecorded">
                    <input id="cost-only-unrecorded" type="checkbox" @bind="_onlyUnrecorded" @bind:after="ResetPage" />
                    <span>@UL["P5CostOnlyUnrecorded"]</span>
                </label>

                <div class="filter-bar__actions">
                    <FilterResetButton OnClick="ResetFiltersAsync" />
                </div>
            </div>

            @if (_periodError is not null)
            {
                <p class="filter-bar__error" role="alert">@_periodError</p>
            }
            <p class="filter-bar__meta formula-hint">
                <LucideIcon Name="info" />
                <span>@UL["P5CostFormulaHint"]</span>
            </p>
        </div>

        @if (FilteredRooms.Count == 0)
        {
            <EmptyStateCard Title="@UL["P5CostEmptyTitle"]" Description="@UL["P5CostEmptyDescription"]">
                <button type="button" class="btn btn-secondary" @onclick="ResetFiltersAsync">
                    <LucideIcon Name="refresh-cw" />
                    <span>@UL["P5CostResetFilter"]</span>
                </button>
            </EmptyStateCard>
        }
        else
        {
            <div class="table-card">
                <div class="table-responsive">
                    <table class="cost-table">
                        <thead>
                            <tr>
                                <th class="text-left">@UL["P5CostThRoom"]</th>
                                <th class="text-right">@UL["P5CostThElectricUsage"]</th>
                                <th class="text-right">@UL["P5CostThElectricAmount"]</th>
                                <th class="text-right">@UL["P5CostThWaterUsage"]</th>
                                <th class="text-right">@UL["P5CostThWaterAmount"]</th>
                                <th class="text-right">@UL["P5CostThServices"]</th>
                                <th class="text-right">@UL["P5CostThTotal"]</th>
                                <th>@UL["P5CostThInvoiceStatus"]</th>
                                <th class="text-right">@UL["P5CostThActions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var room in PagedRooms)
                            {
                                <tr @key="room.ContractId">
                                    <td class="cell-room" data-label="@UL["P5CostThRoom"]">
                                        <div class="room-cell">
                                            <div>
                                                <span class="room-code">@room.RoomCode</span>
                                                <span class="room-property">@room.PropertyName</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(room.TenantNames))
                                            {
                                                <span class="room-tenant">@room.TenantNames</span>
                                            }
                                            <span class="status-badge @StatusClass(room)">@StatusLabel(room)</span>
                                        </div>
                                    </td>
                                    <td class="text-right tabular-nums" data-label="@UL["P5CostThElectricUsage"]">
                                        @if (room.HasReadings)
                                        {
                                            @FormatUsage(room.ElectricUsage, "kWh")
                                        }
                                        else
                                        {
                                            <span class="no-data">@UL["P5CostNoData"]</span>
                                        }
                                    </td>
                                    <td class="text-right tabular-nums amount" data-label="@UL["P5CostThElectricAmount"]">
                                        @if (room.HasReadings)
                                        {
                                            @MoneyFormatter.Format(room.ElectricCost)
                                        }
                                        else
                                        {
                                            <span class="no-data">@UL["P5CostNoData"]</span>
                                        }
                                    </td>
                                    <td class="text-right tabular-nums" data-label="@UL["P5CostThWaterUsage"]">
                                        @if (room.HasReadings)
                                        {
                                            @FormatUsage(room.WaterUsage, "m³")
                                        }
                                        else
                                        {
                                            <span class="no-data">@UL["P5CostNoData"]</span>
                                        }
                                    </td>
                                    <td class="text-right tabular-nums amount" data-label="@UL["P5CostThWaterAmount"]">
                                        @if (room.HasReadings)
                                        {
                                            @MoneyFormatter.Format(room.WaterCost)
                                        }
                                        else
                                        {
                                            <span class="no-data">@UL["P5CostNoData"]</span>
                                        }
                                    </td>
                                    <td class="text-right tabular-nums amount" data-label="@UL["P5CostThServices"]">
                                        @if (room.ServiceLines.Count > 0)
                                        {
                                            <span>@MoneyFormatter.Format(room.ServiceCost)</span>
                                            <span class="service-count">@string.Format(UL["P5CostServiceCount"], room.ServiceLines.Count)</span>
                                        }
                                        else
                                        {
                                            <span class="no-data">@UL["P5CostNoData"]</span>
                                        }
                                    </td>
                                    <td class="text-right tabular-nums amount total-cell" data-label="@UL["P5CostThTotal"]">
                                        @MoneyFormatter.Format(room.TotalAmount)
                                    </td>
                                    <td class="cell-invoice" data-label="@UL["P5CostThInvoiceStatus"]">
                                        @if (room.InvoiceId is { } invoiceId)
                                        {
                                            <a class="invoice-link created" href="@InvoiceDetailHref(invoiceId)">
                                                <LucideIcon Name="receipt" />
                                                <span>@UL["P5CostInvoiceCreated"]</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="invoice-pill pending">
                                                <LucideIcon Name="file" />
                                                <span>@UL["P5CostInvoicePending"]</span>
                                            </span>
                                        }
                                    </td>
                                    <td class="text-right cell-actions" data-label="@UL["P5CostThActions"]">
                                        <div class="p2-row-actions">
                                            <button type="button"
                                                    class="icon-button p2-menu-trigger @(IsMenuOpen(room.ContractId) ? "is-open" : null)"
                                                    title="@UL["P5CostThActions"]"
                                                    aria-label="@($"{UL["P5CostThActions"]}: {room.RoomCode}")"
                                                    aria-haspopup="menu"
                                                    aria-expanded="@(IsMenuOpen(room.ContractId) ? "true" : "false")"
                                                    aria-controls="@($"cost-row-menu-{room.ContractId}")"
                                                    @onclick="() => ToggleRowMenu(room.ContractId)">
                                                <LucideIcon Name="ellipsis" />
                                            </button>
                                            @if (IsMenuOpen(room.ContractId))
                                            {
                                                <div id="@($"cost-row-menu-{room.ContractId}")" class="p2-row-menu" role="menu" aria-label="@UL["P5CostThActions"]" data-row-menu>
                                                    <button type="button" class="p2-row-menu-item" role="menuitem" @onclick="() => MenuDetails(room)">
                                                        <LucideIcon Name="eye" /><span>@UL["P5CostDetails"]</span>
                                                    </button>
                                                    <AuthorizeView Policy="UtilityRecord">
                                                        <Authorized>
                                                            @if (!room.IsInvoiced && (room.CanAdjust || !room.HasReadings))
                                                            {
                                                                <button type="button" class="p2-row-menu-item" role="menuitem" @onclick="() => MenuEditReading(room)">
                                                                    <LucideIcon Name="@(room.HasReadings ? "edit" : "plus")" />
                                                                    <span>@UL["P5CostEditReading"]</span>
                                                                </button>
                                                            }
                                                            @if (room.InvoiceId is null)
                                                            {
                                                                <button type="button" class="p2-row-menu-item" role="menuitem"
                                                                        disabled="@(_creatingInvoice || !room.HasReadings)"
                                                                        title="@(room.HasReadings ? null : UL["P5CostInvoiceMissingReadings"].Value)"
                                                                        @onclick="() => MenuCreateInvoice(room)">
                                                                    <LucideIcon Name="receipt" />
                                                                    <span>@UL["P5CostCreateInvoice"]</span>
                                                                </button>
                                                            }
                                                        </Authorized>
                                                    </AuthorizeView>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <TablePager Page="_page" TotalPages="TotalPages" From="FirstItem" To="LastItem" Total="FilteredRooms.Count"
                            PageChanged="GoToPage" />
            </div>
        }
    }
</div>

@if (_detailRoom is not null)
{
    var detail = _detailRoom;
    <div class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="cost-detail-title" @onclick="CloseDetails">
        <div class="modal-dialog detail-dialog" @onclick:stopPropagation="true">
            <header class="modal-header">
                <div class="modal-header-text">
                    <h2 id="cost-detail-title">@string.Format(UL["P5CostDetailTitle"], detail.RoomCode)</h2>
                    <p>@detail.PropertyName · @detail.ContractNumber · @DateFormatter.Format(detail.PeriodStart) – @DateFormatter.Format(detail.PeriodEnd)</p>
                </div>
                <button type="button" class="icon-btn" aria-label="@UL["P5CostClosePanel"]" @onclick="CloseDetails">
                    <LucideIcon Name="close" />
                </button>
            </header>

            <div class="modal-body detail-body">
                <div class="detail-topline">
                    <span class="status-badge @StatusClass(detail)">@StatusLabel(detail)</span>
                    @if (detail.InvoiceId is { } detailInvoiceId)
                    {
                        <a class="invoice-link created" href="@InvoiceDetailHref(detailInvoiceId)">
                            <LucideIcon Name="receipt" />
                            <span>@UL["P5CostInvoiceCreated"]</span>
                        </a>
                    }
                    else
                    {
                        <span class="invoice-pill pending">
                            <LucideIcon Name="file" />
                            <span>@UL["P5CostInvoicePending"]</span>
                        </span>
                    }
                </div>

                <div class="reading-pair-grid">
                    <section class="reading-pair-card">
                        <h3><LucideIcon Name="zap" /> @UL["P5CostElectricSection"]</h3>
                        <dl>
                            <div><dt>@UL["P5CostBeforeLabel"]</dt><dd class="tabular-nums">@FormatUsage(detail.ElectricStart, "kWh")</dd></div>
                            <div><dt>@UL["P5CostAfterLabel"]</dt><dd class="tabular-nums">@FormatUsage(detail.ElectricEnd, "kWh")</dd></div>
                            <div><dt>@UL["P5CostUsageLabel"]</dt><dd class="tabular-nums">@FormatUsage(detail.ElectricUsage, "kWh")</dd></div>
                            <div><dt>@UL["P5CostAvgUnitPrice"]</dt><dd class="tabular-nums">@MoneyFormatter.Format(detail.ElectricUnitPrice)</dd></div>
                            <div class="strong"><dt>@UL["P5CostAmountLabel"]</dt><dd class="tabular-nums">@MoneyFormatter.Format(detail.ElectricCost)</dd></div>
                        </dl>
                        @if (detail.ElectricTiers.Count > 0)
                        {
                            <table class="mini-table">
                                <thead>
                                    <tr>
                                        <th>@UL["P5CostTierLabel"]</th>
                                        <th class="text-right">@UL["P5CostQuantityLabel"]</th>
                                        <th class="text-right">@UL["P5CostUnitPriceLabel"]</th>
                                        <th class="text-right">@UL["P5CostAmountLabel"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tier in detail.ElectricTiers)
                                    {
                                        <tr>
                                            <td>@tier.TierNumber</td>
                                            <td class="text-right tabular-nums">@FormatUsage(tier.Quantity, "kWh")</td>
                                            <td class="text-right tabular-nums">@MoneyFormatter.Format(tier.UnitPrice)</td>
                                            <td class="text-right tabular-nums">@MoneyFormatter.Format(tier.Amount)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </section>

                    <section class="reading-pair-card">
                        <h3><LucideIcon Name="droplet" /> @UL["P5CostWaterSection"]</h3>
                        <dl>
                            <div><dt>@UL["P5CostBeforeLabel"]</dt><dd class="tabular-nums">@FormatUsage(detail.WaterStart, "m³")</dd></div>
                            <div><dt>@UL["P5CostAfterLabel"]</dt><dd class="tabular-nums">@FormatUsage(detail.WaterEnd, "m³")</dd></div>
                            <div><dt>@UL["P5CostUsageLabel"]</dt><dd class="tabular-nums">@FormatUsage(detail.WaterUsage, "m³")</dd></div>
                            <div><dt>@UL["P5CostAvgUnitPrice"]</dt><dd class="tabular-nums">@MoneyFormatter.Format(detail.WaterUnitPrice)</dd></div>
                            <div class="strong"><dt>@UL["P5CostAmountLabel"]</dt><dd class="tabular-nums">@MoneyFormatter.Format(detail.WaterCost)</dd></div>
                        </dl>
                        @if (detail.WaterTiers.Count > 0)
                        {
                            <table class="mini-table">
                                <thead>
                                    <tr>
                                        <th>@UL["P5CostTierLabel"]</th>
                                        <th class="text-right">@UL["P5CostQuantityLabel"]</th>
                                        <th class="text-right">@UL["P5CostUnitPriceLabel"]</th>
                                        <th class="text-right">@UL["P5CostAmountLabel"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tier in detail.WaterTiers)
                                    {
                                        <tr>
                                            <td>@tier.TierNumber</td>
                                            <td class="text-right tabular-nums">@FormatUsage(tier.Quantity, "m³")</td>
                                            <td class="text-right tabular-nums">@MoneyFormatter.Format(tier.UnitPrice)</td>
                                            <td class="text-right tabular-nums">@MoneyFormatter.Format(tier.Amount)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </section>
                </div>

                <section class="detail-section">
                    <h3><LucideIcon Name="home" /> @UL["P5CostServiceSection"]</h3>
                    <dl class="summary-lines">
                        <div><dt>@UL["P5CostRentLabel"]</dt><dd class="tabular-nums">@MoneyFormatter.Format(detail.RentAmount)</dd></div>
                        @foreach (var line in detail.ServiceLines)
                        {
                            <div>
                                <dt>@line.Name <span class="muted">(@FormatUsage(line.Quantity, line.Unit))</span></dt>
                                <dd class="tabular-nums">@MoneyFormatter.Format(line.Amount)</dd>
                            </div>
                        }
                        <div class="strong total"><dt>@UL["P5CostTotalLabel"]</dt><dd class="tabular-nums">@MoneyFormatter.Format(detail.TotalAmount)</dd></div>
                    </dl>
                </section>

                @if (detail.InvoiceRevisions.Count > 0)
                {
                    <section class="detail-section invoice-revision-section">
                        <div class="section-title-row">
                            <h3><LucideIcon Name="receipt" /> @UL["P5CostInvoiceRevisionsTitle"]</h3>
                            <span class="chip">@string.Format(detail.InvoiceRevisions.Count == 1 ? UL["P5CostInvoiceRevisionsCountOne"] : UL["P5CostInvoiceRevisionsCount"], detail.InvoiceRevisions.Count)</span>
                        </div>
                        <p class="muted">@UL["P5CostInvoiceRevisionsHint"]</p>
                        <div class="invoice-revision-list">
                            @foreach (var revision in detail.InvoiceRevisions)
                            {
                                <div class="invoice-revision-item">
                                    <div class="invoice-revision-reason">@revision.Reason</div>
                                    <div class="invoice-revision-meta">
                                        <span class="tabular-nums">@FormatMoment(revision.ChangedAt)</span>
                                        @if (revision.PreviousTotalAmount != revision.NewTotalAmount)
                                        {
                                            <span class="invoice-revision-amount tabular-nums">
                                                @MoneyFormatter.Format(revision.PreviousTotalAmount)
                                                <LucideIcon Name="arrow-right" />
                                                @MoneyFormatter.Format(revision.NewTotalAmount)
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                }

                <section class="detail-section">
                    <div class="section-title-row">
                        <h3><LucideIcon Name="history" /> @UL["P5CostCorrectionsTitle"]</h3>
                        <span class="chip">@string.Format(detail.Corrections.Count == 1 ? UL["P5CostCorrectionsCountOne"] : UL["P5CostCorrectionsCount"], detail.Corrections.Count)</span>
                    </div>
                    @if (detail.Corrections.Count == 0)
                    {
                        <p class="muted">@UL["P5CostCorrectionsEmpty"]</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="mini-table corrections-table">
                                <thead>
                                    <tr>
                                        <th>@UL["P5CostCorrectionField"]</th>
                                        <th class="text-right">@UL["P5CostCorrectionDiff"]</th>
                                        <th>@UL["P5CostCorrectionReason"]</th>
                                        <th>@UL["P5CostCorrectionChangedAt"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var correction in detail.Corrections)
                                    {
                                        <tr>
                                            <td>@CorrectionFieldLabel(correction.Field)</td>
                                            <td class="text-right tabular-nums">@FormatCorrection(correction)</td>
                                            <td>@correction.Reason</td>
                                            <td class="tabular-nums">@FormatMoment(correction.ChangedAt)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            </div>

            <footer class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseDetails">
                    <span>@UL["P5CostClosePanel"]</span>
                </button>
                <AuthorizeView Policy="UtilityRecord">
                    <Authorized>
                        @if (!detail.IsInvoiced && detail.CanCorrectPrevious && detail.PreviousReading is not null)
                        {
                            <button type="button" class="btn btn-secondary" @onclick="() => OpenEdit(detail, true)">
                                <LucideIcon Name="history" />
                                <span>@UL["P5CostCorrectPrevious"]</span>
                            </button>
                        }
                        @if (!detail.IsInvoiced && (detail.CanAdjust || !detail.HasReadings))
                        {
                            <button type="button" class="btn btn-primary" @onclick="() => OpenEdit(detail, false)">
                                <LucideIcon Name="edit" />
                                <span>@(detail.HasReadings ? UL["P5CostAdjustReading"] : UL["P5CostEditReading"])</span>
                            </button>
                        }
                        @if (detail.InvoiceId is null)
                        {
                            <button type="button" class="btn btn-primary" disabled="@(_creatingInvoice || !detail.HasReadings)" title="@(detail.HasReadings ? null : UL["P5CostInvoiceMissingReadings"].Value)" @onclick="() => RequestCreateInvoice(detail)">
                                @if (_creatingInvoice)
                                {
                                    <span class="spinner" aria-hidden="true"></span>
                                    <span>@UL["P5CostInvoiceCreating"]</span>
                                }
                                else
                                {
                                    <LucideIcon Name="receipt" />
                                    <span>@UL["P5CostCreateInvoice"]</span>
                                }
                            </button>
                        }
                    </Authorized>
                </AuthorizeView>
            </footer>
        </div>
    </div>
}

@if (_editRoom is not null)
{
    var edit = _editRoom;
    var previous = edit.PreviousReading;
    var editPeriodStart = _editPrevious && previous is not null ? previous.PeriodStart : edit.PeriodStart;
    var editPeriodEnd = _editPrevious && previous is not null ? previous.PeriodEnd : edit.PeriodEnd;
    <div class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="cost-edit-title" @onclick="CloseEdit">
        <div class="modal-dialog edit-dialog" @onclick:stopPropagation="true">
            <header class="modal-header">
                <div class="modal-header-text">
                    <h2 id="cost-edit-title">@(_editPrevious ? UL["P5CostCorrectPreviousTitle"] : UL["P5CostEditTitle"])</h2>
                    <p>@string.Format(UL["P5CostEditDescription"], edit.RoomCode, DateFormatter.Format(editPeriodStart), DateFormatter.Format(editPeriodEnd))</p>
                </div>
                <button type="button" class="icon-btn" aria-label="@UL["P5CostClosePanel"]" @onclick="CloseEdit" disabled="@_saving">
                    <LucideIcon Name="close" />
                </button>
            </header>

            <div class="modal-body">
                @if (_editPrevious && previous is not null)
                {
                    <div class="previous-note">
                        <LucideIcon Name="history" />
                        <span>@string.Format(UL["P5CostPreviousPeriodNote"], DateFormatter.Format(previous.PeriodStart), DateFormatter.Format(previous.PeriodEnd))</span>
                    </div>
                }

                <div class="edit-grid">
                    <div class="form-field">
                        <label for="edit-electric">@UL["P5CostElectricEndLabel"]</label>
                        <input id="edit-electric"
                               type="number"
                               step="0.01"
                               class="input tabular-nums @(_editElectricInvalid ? "is-invalid" : "")"
                               @bind="_editElectricEnd" />
                        <span class="field-hint">@string.Format(UL["P5CostStartReadingHint"], FormatUsage(EditElectricStart, "kWh"))</span>
                    </div>

                    <div class="form-field">
                        <label for="edit-water">@UL["P5CostWaterEndLabel"]</label>
                        <input id="edit-water"
                               type="number"
                               step="0.01"
                               class="input tabular-nums @(_editWaterInvalid ? "is-invalid" : "")"
                               @bind="_editWaterEnd" />
                        <span class="field-hint">@string.Format(UL["P5CostStartReadingHint"], FormatUsage(EditWaterStart, "m³"))</span>
                    </div>
                </div>

                @if (NeedsReason)
                {
                    <div class="form-field">
                        <label for="edit-reason">@UL["P5CostReasonLabel"] <span class="required">*</span></label>
                        <input id="edit-reason"
                               type="text"
                               class="input @(_editReasonError is not null ? "is-invalid" : "")"
                               placeholder="@UL["P5CostReasonPlaceholder"]"
                               @bind="_editReason" />
                        @if (_editReasonError is not null)
                        {
                            <span class="field-error" role="alert">@_editReasonError</span>
                        }
                    </div>
                }

                @if (_editInlineError is not null)
                {
                    <div class="inline-error compact" role="alert">
                        <LucideIcon Name="alert" />
                        <span>@_editInlineError</span>
                    </div>
                }
            </div>

            <footer class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseEdit" disabled="@_saving">
                    @UL["P5CostCancelButton"]
                </button>
                <button type="button" class="btn btn-primary" @onclick="SaveEditAsync" disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                        <span>@UL["P5CostSavingButton"]</span>
                    }
                    else
                    {
                        <LucideIcon Name="check" />
                        <span>@UL["P5CostSaveButton"]</span>
                    }
                </button>
            </footer>
        </div>
    </div>
}

