                            <span class="field-hint">@createPeriodRoom.PropertyName@(string.IsNullOrWhiteSpace(createPeriodRoom.TenantNames) ? string.Empty : $" · {createPeriodRoom.TenantNames}")</span>
                        }
                        else if (CreatePeriodRooms.Count == 0)
                        {
                            <span class="field-hint">@UL["P5CostPeriodNoRooms"]</span>
                        }
                        else
                        {
                            <span class="field-hint">@UL["P5CostPeriodRoomHint"]</span>
                        }
                    </div>
                </div>

                <div class="edit-grid">
                    <div class="form-field">
                        <label for="period-month">@UL["P5CostPeriodMonthLabel"]</label>
                        <select id="period-month" class="input" @bind="_createPeriodMonth" @bind:after="ReloadCreatePeriodRoomsAsync">
                            @for (var month = 1; month <= 12; month++)
                            {
                                <option value="@month">@string.Format(UL["P5CostPeriodMonthOption"], month)</option>
                            }
                        </select>
                    </div>

                    <div class="form-field">
                        <label for="period-year">@UL["P5CostPeriodYearLabel"]</label>
                        <select id="period-year" class="input" @bind="_createPeriodYear" @bind:after="ReloadCreatePeriodRoomsAsync">
                            @foreach (var year in CreatePeriodYearOptions)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="period-range-block">
                    <div class="period-range-item">
                        <span class="period-range-label">@UL["P5CostPeriodStartDateLabel"]</span>
                        <strong class="tabular-nums">@DateFormatter.Format(createPeriodStart)</strong>
                    </div>
                    <LucideIcon Name="arrow-right" />
                    <div class="period-range-item">
                        <span class="period-range-label">@UL["P5CostPeriodEndDateLabel"]</span>
                        <strong class="tabular-nums">@DateFormatter.Format(createPeriodEnd)</strong>
                    </div>
                </div>
                <p class="field-hint">@UL["P5CostPeriodAutoRangeHint"]</p>

                @if (_createPeriodError is not null)
                {
                    <div class="inline-error compact" role="alert">
                        <LucideIcon Name="alert" />
                        <span>@_createPeriodError</span>
                    </div>
                }
            </div>

            <footer class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseCreatePeriod" disabled="@_creatingPeriod">
                    @UL["P5CostCancelButton"]
                </button>
                <button type="button" class="btn btn-primary" @onclick="SubmitCreatePeriodAsync" disabled="@(_creatingPeriod || _createPeriodLoadingRooms || CreatePeriodRooms.Count == 0)">
                    @if (_creatingPeriod)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                        <span>@UL["P5CostPeriodCreatingButton"]</span>
                    }
                    else
                    {
                        <LucideIcon Name="file-plus" />
                        <span>@UL["P5CostPeriodCreateButton"]</span>
                    }
                </button>
            </footer>
        </div>
    </div>
}

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    private MonthlyUtilityViewData? _data;
    private MonthlyUtilityRoomCostDto? _detailRoom;
    private MonthlyUtilityRoomCostDto? _invoiceConfirmRoom;
    private MonthlyUtilityRoomCostDto? _editRoom;

    private bool _loading = true;
    private bool _saving;
    private bool _creatingInvoice;
    private bool _editPrevious;
    private string? _error;
    private string? _periodError;
    private string? _editInlineError;
    private string? _editReasonError;
    private bool _editElectricInvalid;
    private bool _editWaterInvalid;

    private int? _propertyId;
    private string _search = string.Empty;
    private bool _onlyUnrecorded;
    private DateOnly _periodStart;
    private DateOnly _periodEnd;

    private decimal _editElectricEnd;
    private decimal _editWaterEnd;
    private string _editReason = string.Empty;

    private bool _createPeriodOpen;
    private bool _creatingPeriod;
    private bool _createPeriodLoadingRooms;
    private bool _createPeriodRoomInvalid;
    private int? _createPeriodPropertyId;
    private Guid? _createPeriodContractId;
    private int _createPeriodMonth;
    private int _createPeriodYear;
    private IReadOnlyList<MonthlyUtilityRoomOptionDto> _createPeriodRooms = [];
    private string? _createPeriodError;

    private const int PageSize = 20;
    private int _page = 1;

    private int TotalPages => PaginationHelper.TotalPages(FilteredRooms.Count, PageSize);

    private int FirstItem => FilteredRooms.Count == 0 ? 0 : (_page - 1) * PageSize + 1;

    private int LastItem => Math.Min(_page * PageSize, FilteredRooms.Count);

    private IReadOnlyList<MonthlyUtilityRoomCostDto> PagedRooms
    {
        get
        {
            var page = PaginationHelper.ClampPage(_page, TotalPages);
            return FilteredRooms.Skip((page - 1) * PageSize).Take(PageSize).ToList();
        }
    }

    private void GoToPage(int page) => _page = PaginationHelper.ClampPage(page, TotalPages);

    private void ResetPage() => _page = 1;

    private IReadOnlyList<MonthlyUtilityRoomCostDto> FilteredRooms
    {
        get
        {
            if (_data is null) return [];

            IEnumerable<MonthlyUtilityRoomCostDto> rooms = _data.Rooms;
            if (_onlyUnrecorded)
            {
                rooms = rooms.Where(room => !room.HasReadings);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var term = _search.Trim();
                rooms = rooms.Where(room =>
                    room.RoomCode.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || room.TenantNames.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || room.PropertyName.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || room.ContractNumber.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return rooms.ToList();
        }
    }

    private int RecordedCount => FilteredRooms.Count(room => room.HasReadings);
    private int InvoicedCount => FilteredRooms.Count(room => room.IsInvoiced);

    private bool NeedsReason => _editPrevious || _editRoom?.HasReadings == true;

    private decimal EditElectricStart => _editPrevious
        ? _editRoom?.PreviousReading?.ElectricStart ?? 0m
        : _editRoom?.ElectricStart ?? 0m;

    private decimal EditWaterStart => _editPrevious
        ? _editRoom?.PreviousReading?.WaterStart ?? 0m
        : _editRoom?.WaterStart ?? 0m;

    protected override Task OnInitializedAsync()
    {
        var today = Clock.TodayVietnam();
        _periodStart = new DateOnly(today.Year, today.Month, 1);
        _periodEnd = new DateOnly(today.Year, today.Month, DateTime.DaysInMonth(today.Year, today.Month));
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _periodError = null;
        _page = 1;
        try
        {
            if (_periodEnd < _periodStart)
            {
                _periodError = UL["ErrorBillingPeriodEndMustBeOnOrAfterStart"];
                _loading = false;
                return;
            }

            _data = await PageService.LoadAsync(_propertyId, _periodStart, _periodEnd, CancellationToken.None);

            if (_detailRoom is not null)
            {
                // Mỗi dòng là một hợp đồng; một phòng có thể có nhiều hợp đồng trong kỳ lọc.
                _detailRoom = _data.Rooms.FirstOrDefault(room => room.ContractId == _detailRoom.ContractId);
            }
        }
        catch (UnauthorizedAccessException)
        {
            _error = UL["ErrorAccessDenied"];
            Toast.Error(_error);
        }
        catch (Exception)
        {
            _error = UL["P5CostLoadError"];
            Toast.Error(_error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnPeriodChangedAsync()
    {
        if (_periodEnd < _periodStart)
        {
            _periodError = UL["ErrorBillingPeriodEndMustBeOnOrAfterStart"];
            return;
        }
        _periodError = null;
        await LoadAsync();
    }

    private async Task ResetFiltersAsync()
    {
        var today = Clock.TodayVietnam();
        _propertyId = null;
        _search = string.Empty;
        _onlyUnrecorded = false;
        _periodStart = new DateOnly(today.Year, today.Month, 1);
        _periodEnd = new DateOnly(today.Year, today.Month, DateTime.DaysInMonth(today.Year, today.Month));
        await LoadAsync();
    }

    // --- Lập phiếu ghi chỉ số cho tháng mới ---
    private IReadOnlyList<MonthlyUtilityRoomOptionDto> CreatePeriodRooms =>
        _createPeriodPropertyId is { } propertyId
            ? _createPeriodRooms.Where(room => room.PropertyId == propertyId).ToList()
            : _createPeriodRooms;

    private IEnumerable<int> CreatePeriodYearOptions
    {
        get
        {
            var current = Clock.TodayVietnam().Year;
            for (var year = current - 1; year <= current + 3; year++)
            {
                yield return year;
            }
        }
    }

    private async Task OpenCreatePeriodAsync()
    {
        if (_loading) return;

        var next = _periodStart.AddMonths(1);
        _createPeriodMonth = next.Month;
        _createPeriodYear = next.Year;
        _createPeriodPropertyId = _propertyId;
        _createPeriodContractId = null;
        _createPeriodError = null;
        _createPeriodRoomInvalid = false;
        _createPeriodOpen = true;
        await LoadCreatePeriodRoomsAsync();
    }

    private void CloseCreatePeriod()
    {
        if (_creatingPeriod) return;
        _createPeriodOpen = false;
        _createPeriodError = null;
        _createPeriodRoomInvalid = false;
    }

    private void OnCreatePeriodPropertyChanged()
    {
        _createPeriodContractId = null;
        _createPeriodRoomInvalid = false;
        _createPeriodError = null;
    }

    private void OnCreatePeriodRoomChanged()
    {
        _createPeriodRoomInvalid = false;
        _createPeriodError = null;
    }

    private async Task ReloadCreatePeriodRoomsAsync()
    {
        _createPeriodContractId = null;
        await LoadCreatePeriodRoomsAsync();
    }

    private async Task LoadCreatePeriodRoomsAsync()
    {
        _createPeriodLoadingRooms = true;
        _createPeriodError = null;
        try
        {
            var start = new DateOnly(_createPeriodYear, _createPeriodMonth, 1);
            var end = new DateOnly(
                _createPeriodYear,
                _createPeriodMonth,
                DateTime.DaysInMonth(_createPeriodYear, _createPeriodMonth));
            _createPeriodRooms = await PageService.LoadPeriodRoomOptionsAsync(start, end, CancellationToken.None);
        }
        catch (UnauthorizedAccessException)
        {
            _createPeriodRooms = [];
            _createPeriodError = UL["ErrorAccessDenied"];
        }
        catch (Exception)
        {
            _createPeriodRooms = [];
            _createPeriodError = UL["P5CostPeriodLoadRoomsFailed"];
        }
        finally
        {
            _createPeriodLoadingRooms = false;
        }
    }

    private async Task SubmitCreatePeriodAsync()
    {
        if (_creatingPeriod || _createPeriodLoadingRooms) return;

        _createPeriodError = null;
        _createPeriodRoomInvalid = false;

        if (_createPeriodContractId is not { } contractId)
        {
            _createPeriodRoomInvalid = true;
            _createPeriodError = UL["P5CostPeriodSelectRoomError"];
            return;
        }

        _creatingPeriod = true;
        await Task.Yield();
        try
        {
            var result = await PageService.CreatePeriodAsync(
                contractId,
                _createPeriodYear,
                _createPeriodMonth,
                CancellationToken.None);

            if (result.Success)
            {
                var selected = _createPeriodRooms.FirstOrDefault(room => room.ContractId == contractId);
                var createdStart = new DateOnly(_createPeriodYear, _createPeriodMonth, 1);
                var createdEnd = new DateOnly(
                    _createPeriodYear,
                    _createPeriodMonth,
                    DateTime.DaysInMonth(_createPeriodYear, _createPeriodMonth));

                _createPeriodOpen = false;
                _periodStart = createdStart;
                _periodEnd = createdEnd;
                _propertyId = selected?.PropertyId ?? _propertyId;
                _search = string.Empty;
                _onlyUnrecorded = false;
                _page = 1;

                Toast.Success(string.Format(
                    UL["P5CostPeriodCreateSuccess"],
                    selected?.RoomCode ?? string.Empty,
                    _createPeriodMonth,
                    _createPeriodYear));
                await LoadAsync();
                return;
            }

            _createPeriodError = CreatePeriodErrorMessage(result.ErrorCode);
            Toast.Error(_createPeriodError);
        }
        catch (UnauthorizedAccessException)
        {
            _createPeriodError = UL["ErrorAccessDenied"];
            Toast.Error(_createPeriodError);
        }
        catch (Exception)
        {
            _createPeriodError = UL["P5CostPeriodCreateFailed"];
            Toast.Error(_createPeriodError);
        }
        finally
        {
            _creatingPeriod = false;
        }
    }

    private string CreatePeriodErrorMessage(string? code) => code switch
    {
        "ContractNotFound" => UL["P5CostPeriodContractNotFound"],
        "DuplicatePeriod" => UL["P5CostPeriodDuplicate"],
        "OverlappingPeriod" => UL["P5CostPeriodOverlap"],
        "PeriodHasLaterPeriod" => UL["P5CostPeriodHasLater"],
        "InvalidPeriod" => UL["P5CostPeriodInvalidMonth"],
        "Forbidden" or "AccessDenied" or "OutsideScope" => UL["ErrorAccessDenied"],
        _ => UL["P5CostPeriodCreateFailed"],
    };

    private void OpenDetails(MonthlyUtilityRoomCostDto room) => _detailRoom = room;

    private void CloseDetails() => _detailRoom = null;

    private void OpenEdit(MonthlyUtilityRoomCostDto room, bool previous)
    {
        _editRoom = room;
        _editPrevious = previous;
        _editReason = string.Empty;
        _editReasonError = null;
        _editInlineError = null;
        _editElectricInvalid = false;
        _editWaterInvalid = false;

        if (previous && room.PreviousReading is not null)
        {
            _editElectricEnd = room.PreviousReading.ElectricEnd;
            _editWaterEnd = room.PreviousReading.WaterEnd;
        }
        else if (room.HasReadings)
        {
            _editElectricEnd = room.ElectricEnd;
            _editWaterEnd = room.WaterEnd;
        }
        else
        {
            _editElectricEnd = room.ElectricStart;
            _editWaterEnd = room.WaterStart;
        }
    }

    private void CloseEdit()
    {
        if (_saving) return;
        _editRoom = null;
        _editInlineError = null;
        _editReasonError = null;
        _editElectricInvalid = false;
        _editWaterInvalid = false;
        _editPrevious = false;
    }

    private async Task SaveEditAsync()
    {
        if (_editRoom is null || _saving) return;

        _editInlineError = null;
        _editReasonError = null;
        _editElectricInvalid = false;
        _editWaterInvalid = false;

        if (_editElectricEnd < EditElectricStart || _editWaterEnd < EditWaterStart)
        {
            _editElectricInvalid = _editElectricEnd < EditElectricStart;
            _editWaterInvalid = _editWaterEnd < EditWaterStart;
            _editInlineError = UL["ErrorMeterReadingMustBeGreaterOrEqualStart"];
            return;
        }

        if (_editElectricEnd < 0m || _editWaterEnd < 0m)
        {
            _editElectricInvalid = _editElectricEnd < 0m;
            _editWaterInvalid = _editWaterEnd < 0m;
            _editInlineError = UL["ErrorMeterReadingCannotBeNegative"];
            return;
        }

        if (NeedsReason && string.IsNullOrWhiteSpace(_editReason))
        {
            _editReasonError = UL["ErrorAdjustmentReasonIsRequired"];
            return;
        }

        _saving = true;
        await Task.Yield();
        try
        {
            MonthlyUtilitySaveResult result;
            if (_editPrevious)
            {
                var previous = _editRoom.PreviousReading;
                if (previous is null)
                {
                    _editInlineError = UL["P5CostSaveFailed"];
                    return;
                }

                result = await PageService.CorrectAsync(
                    previous.Id,
                    _editElectricEnd,
                    _editWaterEnd,
                    _editReason,
                    CancellationToken.None);
            }
            else
            {
                result = await PageService.SaveAsync(
                    new MonthlyUtilitySaveRequest(
                        _editRoom.RoomId,
                        _editRoom.ContractId,
                        _editRoom.ReadingId,
                        _editRoom.PeriodStart,
                        _editRoom.PeriodEnd,
                        _editElectricEnd,
                        _editWaterEnd,
                        NeedsReason ? _editReason : null),
                    CancellationToken.None);
            }

            if (result.Success)
            {
                Toast.Success(NeedsReason ? UL["P5CostAdjustSuccess"] : UL["P5CostSaveSuccess"]);
                _detailRoom = null;
                // CloseEdit() tự bỏ qua khi _saving còn true; hạ cờ trước để modal đóng thật.
                _saving = false;
                CloseEdit();
                await LoadAsync();
                return;
            }

            var message = result.PendingApproval
                ? UL["P5CostApprovalPending"]
                : ErrorMessage(result.ErrorCode);
            if (result.ErrorCode == "InvalidReading")
            {
                _editElectricInvalid = true;
                _editWaterInvalid = true;
            }
            _editInlineError = message;
            Toast.Error(message);
        }
        catch (Exception)
        {
            _editInlineError = UL["P5CostSaveFailed"];
            Toast.Error(_editInlineError);
        }
        finally
        {
            _saving = false;
        }
    }

    private void RequestCreateInvoice(MonthlyUtilityRoomCostDto room)
    {
        if (_creatingInvoice || !room.HasReadings) return;
        _invoiceConfirmRoom = room;
    }

    // --- Menu thao tác 3 chấm (đồng bộ với các trang danh sách khác) ---
    private Guid? _openMenuContractId;

    private bool IsMenuOpen(Guid contractId) => _openMenuContractId == contractId;

    private void ToggleRowMenu(Guid contractId)
    {
        _openMenuContractId = _openMenuContractId == contractId ? null : contractId;
    }

    private void MenuDetails(MonthlyUtilityRoomCostDto room)
    {
        _openMenuContractId = null;
        OpenDetails(room);
    }

    private void MenuEditReading(MonthlyUtilityRoomCostDto room)
    {
        _openMenuContractId = null;
        OpenEdit(room, false);
    }

    private void MenuCreateInvoice(MonthlyUtilityRoomCostDto room)
    {
        _openMenuContractId = null;
        RequestCreateInvoice(room);
    }

    private Task CancelCreateInvoice()
    {
        _invoiceConfirmRoom = null;
        return Task.CompletedTask;
    }

    private async Task ConfirmCreateInvoiceAsync()
    {
        if (_invoiceConfirmRoom is not { } room) return;
        try
        {
            await CreateInvoiceAsync(room);
        }
        finally
        {
            _invoiceConfirmRoom = null;
        }
    }

    private async Task CreateInvoiceAsync(MonthlyUtilityRoomCostDto room)
    {
        if (_creatingInvoice) return;
        _creatingInvoice = true;
        try
        {
            var result = await PageService.CreateInvoiceAsync(
                room.ContractId,
                room.PeriodStart,
                room.PeriodEnd,
                CancellationToken.None);
            if (result.Success && result.InvoiceId is { } invoiceId)
            {
                Toast.Success(UL["P5CostInvoiceCreatedToast"]);
                _detailRoom = null;
                Navigation.NavigateTo($"/invoices/{invoiceId}");
                return;
            }

            var message = InvoiceErrorMessage(result.ErrorCode);
            Toast.Error(message);
        }
        catch (Exception)
        {
            Toast.Error(UL["P5CostInvoiceFailed"]);
        }
        finally
        {
            _creatingInvoice = false;
        }
    }

    private string InvoiceErrorMessage(string? code) => code switch
    {
        "DuplicateInvoice" => UL["P5CostInvoiceDuplicate"],
        "Forbidden" or "AccessDenied" or "OutsideScope" or "ContractNotApproved" or "ContractNotFound" => UL["ErrorAccessDenied"],
        "InvalidPeriod" => UL["ErrorBillingPeriodEndMustBeOnOrAfterStart"],
        "InvalidItem" or "ItemsRequired" => UL["P5CostInvoiceFailed"],
        "ApprovalRequired" => UL["P5CostApprovalPending"],
        "RoomNotFound" => UL["ErrorRoomNotFound"],
        "MissingReadings" => UL["P5CostInvoiceMissingReadings"],
        _ => UL["P5CostInvoiceFailed"],
    };

    private string ErrorMessage(string? code) => code switch
    {
        "Forbidden" or "AccessDenied" or "OutsideScope" => UL["ErrorAccessDenied"],
        "InvalidPeriod" => UL["ErrorBillingPeriodEndMustBeOnOrAfterStart"],
        "InvalidReading" => UL["ErrorMeterReadingMustBeGreaterOrEqualStart"],
        "AdjustmentReasonRequired" => UL["ErrorAdjustmentReasonIsRequired"],
        "NotAdjustable" => UL["P5CostNotAdjustable"],
        "ApprovalRequired" => UL["P5CostApprovalPending"],
        "DuplicatePeriod" => UL["P5CostDuplicatePeriod"],
        "ConcurrencyConflict" => UL["P5CostConcurrencyConflict"],
        "RoomNotFound" => UL["ErrorRoomNotFound"],
        "ReadingNotFound" => UL["P5CostReadingNotFound"],
        "NoChange" => UL["P5CostNoChange"],
        "TariffMissing" => UL["P5CostTariffMissing"],
        _ => UL["P5CostSaveFailed"],
    };

    private string StatusClass(MonthlyUtilityRoomCostDto room) =>
        !room.HasPeriod && room.State == MonthlyUtilityPeriodState.Open
            ? "status-none"
            : StatusClass(room.State);

    private string StatusLabel(MonthlyUtilityRoomCostDto room) =>
        !room.HasPeriod && room.State == MonthlyUtilityPeriodState.Open
            ? UL["P5CostStatusNoSheet"]
            : StatusLabel(room.State);

    private string StatusClass(MonthlyUtilityPeriodState state) => state switch
    {
        MonthlyUtilityPeriodState.Open => "status-open",
        MonthlyUtilityPeriodState.Closed => "status-closed",
        _ => "status-invoiced",
    };

    private string StatusLabel(MonthlyUtilityPeriodState state) => state switch
    {
        MonthlyUtilityPeriodState.Open => UL["P5CostStatusOpen"],
        MonthlyUtilityPeriodState.Closed => UL["P5CostStatusClosed"],
        _ => UL["P5CostStatusInvoiced"],
    };

    private string CorrectionFieldLabel(string field) => field switch
    {
        "Electric" => UL["P5CostCorrectionElectric"],
        "Water" => UL["P5CostCorrectionWater"],
        _ => field,
    };

    private string FormatCorrection(MonthlyUtilityCorrectionDto correction) =>
        $"{FormatNumber(correction.OldValue)} → {FormatNumber(correction.NewValue)}";

    private string FormatUsage(decimal value, string unit) => $"{FormatNumber(value)} {unit}";

    private static string FormatNumber(decimal value) => value.ToString("0.##", Inv);

    private static string FormatMoment(DateTimeOffset value) =>
        DateFormatter.FormatDateTime(value.UtcDateTime);

    private static string FormatMoment(DateTime value) =>
        DateFormatter.FormatDateTime(value);

    private static string InvoiceDetailHref(int invoiceId) => $"/invoices/{invoiceId}";
}
