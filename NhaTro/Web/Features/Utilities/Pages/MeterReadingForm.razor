@page "/meter-readings"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "UtilityBusiness")]
@using Microsoft.AspNetCore.Authorization
@using Web.Common.Utils
@using Web.Components.Layout
@using Web.Components.Shared
@using Web.Components.Shared.Feedback
@using Web.Features.Accounts
@using Web.Features.Invoices.Rules
@using Web.Features.Utilities.Components
@using Web.Features.Utilities.DTOs
@using Web.Features.Utilities.MockData
@using Web.Features.Utilities.Services
@inject MeterReadingPageService PageService
@inject ToastService Toast
@inject IStringLocalizer<Shared> L
@inject NavigationManager Navigation
@inject ILogger<MeterReadingForm> Logger

<PageTitle>@L["MeterReadingPageTitle"] · @L["AppName"]</PageTitle>

<div class="meter-reading-page">
    <BreadcrumbNav Items="@_breadcrumbs" />

    <!-- Simulation Banner (Dữ liệu mẫu — Sprint 2C) -->
    <div class="simulation-banner">
        <div class="banner-left">
            <LucideIcon Name="info" />
            <div class="banner-text">
                <div class="banner-title-row">
                    <strong class="banner-title">@L["MeterReadingSampleBanner"]</strong>
                    <span class="banner-chip">@L["MeterReadingSprint2C"]</span>
                </div>
                <p class="banner-desc">@L["MeterReadingSampleBannerDesc"]</p>
            </div>
        </div>
    </div>

    <!-- Header trang -->
    <header class="page-header">
        <div>
            <h1 class="page-title">@L["MeterReadingPageTitle"]</h1>
            <p class="page-subtitle">@L["MeterReadingPageSubtitle"]</p>
        </div>
    </header>

    @if (_isLoading)
    {
        <!-- Skeleton Loading 4 KPI + Filters + 3 Room Cards -->
        <div class="kpi-strip">
            <div class="kpi-card skeleton"></div>
            <div class="kpi-card skeleton"></div>
            <div class="kpi-card skeleton"></div>
            <div class="kpi-card skeleton"></div>
        </div>

        <div class="filters-container">
            <div class="skeleton kpi-card"></div>
        </div>

        <div class="room-cards-container">
            <div class="skeleton room-card-skeleton"></div>
            <div class="skeleton room-card-skeleton"></div>
            <div class="skeleton room-card-skeleton"></div>
        </div>
    }
    else if (_errorMessage is not null)
    {
        <div class="empty-state-box" role="alert">
            <div class="empty-icon-wrap">
                <LucideIcon Name="alert-triangle" />
            </div>
            <h3 class="empty-title">@L["MeterReadingLoadDataError"]</h3>
            <button type="button" class="btn btn-secondary" @onclick="ReloadDataAsync">
                <LucideIcon Name="refresh-cw" />
                <span>@L["MeterReadingRetry"]</span>
            </button>
        </div>
    }
    else
    {
        <!-- 4 KPI cards -->
        <div class="kpi-strip">
            <div class="kpi-card">
                <div class="kpi-label">@L["MeterReadingKpiTotalRooms"]</div>
                <div class="kpi-value tabular-nums">@TotalRoomsCount</div>
                <div class="kpi-sub">@string.Format(L["MeterReadingKpiInPeriod"], _periodLabel)</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-label">@L["MeterReadingKpiRecorded"]</div>
                <div class="kpi-value tabular-nums kpi-recorded">@RecordedRoomsCount</div>
                <div class="kpi-sub">@L["MeterReadingKpiRecordedSub"]</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-label">@L["MeterReadingKpiUnrecorded"]</div>
                <div class="kpi-value tabular-nums kpi-unrecorded">@UnrecordedRoomsCount</div>
                <div class="kpi-sub">@L["MeterReadingKpiUnrecordedSub"]</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-label">@L["MeterReadingKpiLocked"]</div>
                <div class="kpi-value tabular-nums kpi-locked">@LockedRoomsCount</div>
                <div class="kpi-sub">@L["MeterReadingKpiLockedSub"]</div>
            </div>
        </div>

        <!-- Filters: Building & Month/Year Period Picker -->
        <div class="filters-container">
            <div class="filters-row">
                <label class="filter-field wide">
                    <span>@L["MeterReadingBuildingFilter"]</span>
                    <select id="select-building"
                            class="input"
                            value="@_selectedBuildingId"
                            @onchange="HandleBuildingChanged"
                            disabled="@(_callerRole == Roles.KhachThue)">
                        <option value="">@L["MeterReadingSelectBuildingPrompt"]</option>
                        @foreach (var b in _buildings)
                        {
                            <option value="@b.Id">@b.Name (@string.Format(L["MeterReadingRoomCountFormat"], b.TotalRooms))</option>
                        }
                    </select>
                </label>

                <label class="filter-field">
                    <span>@L["MeterReadingMonthFilter"]</span>
                    <select id="select-period-month"
                            class="input"
                            value="@_selectedMonth"
                            @onchange="HandleMonthChanged">
                        @for (var m = 1; m <= 12; m++)
                        {
                            <option value="@m">@string.Format(L["MeterReadingMonthOptionFormat"], m)</option>
                        }
                    </select>
                </label>

                <label class="filter-field">
                    <span>@L["MeterReadingYearFilter"]</span>
                    <select id="select-period-year"
                            class="input"
                            value="@_selectedYear"
                            @onchange="HandleYearChanged">
                        @foreach (var y in AvailableYears)
                        {
                            <option value="@y">@y</option>
                        }
                    </select>
                </label>

                <div class="filter-field wide">
                    <span>@L["MeterReadingPeriodFilter"]</span>
                    <div class="period-display" aria-live="polite">
                        <LucideIcon Name="calendar" />
                        <span class="period-display-main">
                            @string.Format(L["MeterReadingMonthOptionFormat"], _selectedMonth) / @_selectedYear
                        </span>
                        <span class="period-display-range">
                            (@_periodStart.ToString("dd/MM/yyyy") – @_periodEnd.ToString("dd/MM/yyyy"))
                        </span>
                    </div>
                </div>

                <button type="button" class="btn btn-secondary reset-button" @onclick="ReloadDataAsync" title="@L["MeterReadingRefreshBtn"]">
                    <LucideIcon Name="refresh-cw" />
                    <span>@L["MeterReadingRefreshBtn"]</span>
                </button>
            </div>
        </div>

        <!-- Empty states -->
        @if (_callerRole == Roles.KhachThue && _filteredRooms.Count == 0 && !_periodHasNoData)
        {
            <div class="empty-state-box">
                <div class="empty-icon-wrap">
                    <LucideIcon Name="user-off" />
                </div>
                <h3 class="empty-title">@L["MeterReadingEmptyTenantTitle"]</h3>
                <p class="empty-desc">@L["MeterReadingEmptyTenantDesc"]</p>
                <button type="button" class="btn btn-secondary" @onclick="ReloadDataAsync">
                    <LucideIcon Name="refresh-cw" />
                    <span>@L["MeterReadingRefreshBtn"]</span>
                </button>
            </div>
        }
        else if (string.IsNullOrWhiteSpace(_selectedBuildingId))
        {
            <div class="empty-state-box">
                <div class="empty-icon-wrap">
                    <LucideIcon Name="building" />
                </div>
                <h3 class="empty-title">@L["MeterReadingSelectBuildingTitle"]</h3>
                <p class="empty-desc">@L["MeterReadingSelectBuildingDesc"]</p>
                <button type="button" class="btn btn-primary" @onclick="SelectFirstBuilding">
                    <span>@L["MeterReadingSelectFirstBuildingBtn"]</span>
                </button>
            </div>
        }
        else if (_periodHasNoData)
        {
            <div class="empty-state-box">
                <div class="empty-icon-wrap">
                    <LucideIcon Name="calendar" />
                </div>
                <h3 class="empty-title">@L["MeterReadingEmptyPeriodTitle"]</h3>
                <p class="empty-desc">@L["MeterReadingEmptyPeriodDesc"]</p>
                <button type="button" class="btn btn-secondary" @onclick="ReloadDataAsync">
                    <LucideIcon Name="refresh-cw" />
                    <span>@L["MeterReadingRefreshBtn"]</span>
                </button>
            </div>
        }
        else if (_filteredRooms.Count == 0)
        {
            <div class="empty-state-box">
                <div class="empty-icon-wrap">
                    <LucideIcon Name="door" />
                </div>
                <h3 class="empty-title">@L["MeterReadingEmptyRoomsTitle"]</h3>
                <p class="empty-desc">@L["MeterReadingEmptyRoomsDesc"]</p>
                <button type="button" class="btn btn-secondary" @onclick="ReloadDataAsync">
                    <LucideIcon Name="refresh-cw" />
                    <span>@L["MeterReadingRefreshBtn"]</span>
                </button>
            </div>
        }
        else
        {
            <!-- Danh sách phòng gọn theo tầng, bấm để mở chi tiết -->
            <div class="room-accordion">
                @foreach (var group in PagedFloorGroups)
                {
                    <section class="floor-group" @key="group.Floor">
                        <header class="floor-group-header">
                            <div class="floor-group-title">
                                <LucideIcon Name="layers" />
                                <h2>@string.Format(L["MeterReadingFloorGroup"], group.Floor > 0 ? group.Floor.ToString() : L["MeterReadingUnknownFloor"].Value)</h2>
                            </div>
                            <span class="floor-group-count">@string.Format(L["MeterReadingRoomCountFormat"], group.Rooms.Count)</span>
                        </header>

                        <div class="floor-group-rooms">
                            @foreach (var room in group.Rooms)
                            {
                                var isExpanded = _expandedRoomId == room.Id;
                                <article class="room-row @(isExpanded ? "expanded" : "")" @key="room.Id">
                                    <button type="button"
                                            class="room-row-header"
                                            @onclick="() => ToggleRoom(room.Id)"
                                            aria-expanded="@(isExpanded ? "true" : "false")"
                                            aria-label="@string.Format(L["MeterReadingToggleRoomDetails"], room.RoomCode)">
                                        <div class="room-row-main">
                                            <span class="room-row-badge"><LucideIcon Name="door" /></span>
                                            <span class="room-row-text">
                                                <span class="room-row-title">
                                                    <span class="room-row-code">@room.RoomCode</span>
                                                    <span class="room-row-name">@room.RoomName</span>
                                                    <span class="room-status-chip @GetRoomStatusCss(room)">@GetRoomStatusLabel(room)</span>
                                                </span>
                                                <span class="room-row-meta">
                                                    <span>@L["MeterReadingTenantLabel"] <strong>@room.TenantName</strong></span>
                                                    <span class="meta-sep">•</span>
                                                    <span>@L["MeterReadingContractCodeLabel"] <code>@room.ContractCode</code></span>
                                                </span>
                                            </span>
                                        </div>

                                        <div class="room-row-stats">
                                            <span class="room-stat electric">
                                                <LucideIcon Name="zap" />
                                                <span class="room-stat-label">@L["MeterReadingElectricMeter"]</span>
                                                <strong class="room-stat-value">@FormatElectricUsage(room)</strong>
                                            </span>
                                            <span class="room-stat water">
                                                <LucideIcon Name="droplet" />
                                                <span class="room-stat-label">@L["MeterReadingWaterMeter"]</span>
                                                <strong class="room-stat-value">@FormatWaterUsage(room)</strong>
                                            </span>
                                            <span class="room-chevron @(isExpanded ? "rotated" : "")">
                                                <LucideIcon Name="chevron-down" />
                                            </span>
                                        </div>
                                    </button>

                                    @if (isExpanded)
                                    {
                                        <div class="room-row-body">
                                            <RoomReadingCard @key="room.Id"
                                                             Room="room"
                                                             CallerRole="@_callerRole"
                                                             PeriodStart="@_periodStart"
                                                             PeriodEnd="@_periodEnd"
                                                             HideHeader="true"
                                                             OnChanged="HandleRoomReadingChanged"
                                                             OnSave="HandleRoomSave" />
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    </section>
                }
            </div>

            <footer class="table-footer">
                <div class="pagination-info">
                    @string.Format(L["TableSummary"], FirstItem, LastItem, _filteredRooms.Count)
                </div>

                <div class="pagination-controls">
                    <label class="page-size-field" for="meter-page-size">
                        <span>@L["P2RowsPerPage"]</span>
                        <select id="meter-page-size" class="input page-size-select" value="@_pageSize" @onchange="ChangePageSize">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>
                    </label>

                    <nav class="pager" aria-label="@L["TablePagination"]">
                        <button type="button" class="pager-btn" disabled="@(_page <= 1)" @onclick="GoToPreviousPage" aria-label="@L["TablePreviousPage"]">
                            <LucideIcon Name="chevron-left" />
                        </button>
                        <span class="page-indicator">@_page / @TotalPages</span>
                        <button type="button" class="pager-btn" disabled="@(_page >= TotalPages)" @onclick="GoToNextPage" aria-label="@L["TableNextPage"]">
                            <LucideIcon Name="chevron-right" />
                        </button>
                    </nav>
                </div>
            </footer>
        }
    }
</div>

@code {
    private bool _isLoading = true;
    private string? _errorMessage;
    private string _callerRole = string.Empty;
    private string _callerEmail = string.Empty;

    private string _selectedBuildingId = "b1";
    private int _selectedYear = 2026;
    private int _selectedMonth = 10;
    private bool _periodHasNoData;
    private string _periodLabel = "10/2026";
    private DateOnly _periodStart = new(2026, 10, 1);
    private DateOnly _periodEnd = new(2026, 10, 31);

    private static readonly IReadOnlyList<int> AvailableYears = Enumerable.Range(2024, 5).Reverse().ToArray();

    private IReadOnlyList<BuildingOptionDto> _buildings = [];
    private List<RoomReadingSampleDto> _allRooms = [];
    private List<RoomReadingSampleDto> _filteredRooms = [];
    private readonly Dictionary<string, (decimal? ElectricEnd, decimal? WaterEnd)> _draftReadings = new(StringComparer.Ordinal);

    private int _page = 1;
    private int _pageSize = 10;
    private string? _expandedRoomId;

    private sealed record FloorGroup(int Floor, IReadOnlyList<RoomReadingSampleDto> Rooms);

    private List<RoomReadingSampleDto> SortedRooms => _filteredRooms
        .OrderBy(GetFloor)
        .ThenBy(r => r.RoomCode, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private List<FloorGroup> PagedFloorGroups => SortedRooms
        .Skip((_page - 1) * _pageSize)
        .Take(_pageSize)
        .GroupBy(GetFloor)
        .Select(g => new FloorGroup(g.Key, g.ToList()))
        .ToList();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filteredRooms.Count / (double)_pageSize));
    private int FirstItem => _filteredRooms.Count == 0 ? 0 : (_page - 1) * _pageSize + 1;
    private int LastItem => Math.Min(_page * _pageSize, _filteredRooms.Count);

    private List<BreadcrumbNav.BreadcrumbItem> _breadcrumbs = [];

    private int TotalRoomsCount => _filteredRooms.Count;
    private int LockedRoomsCount => _filteredRooms.Count(r => string.Equals(r.Status, "locked", StringComparison.OrdinalIgnoreCase));
    private int RecordedRoomsCount => _filteredRooms.Count(r =>
    {
        if (string.Equals(r.Status, "locked", StringComparison.OrdinalIgnoreCase)) return false;
        if (_draftReadings.TryGetValue(r.Id, out var draft))
        {
            return draft.ElectricEnd.HasValue && draft.WaterEnd.HasValue;
        }
        return r.HasElectricReading && r.HasWaterReading;
    });
    private int UnrecordedRoomsCount => Math.Max(0, TotalRoomsCount - RecordedRoomsCount - LockedRoomsCount);

    protected override async Task OnInitializedAsync()
    {
        _breadcrumbs =
        [
            new(L["MeterReadingNavHome"], "/"),
            new(L["MeterReadingNavServices"], "/services"),
            new(L["MeterReadingNavReadings"], null)
        ];

        UpdatePeriodRange(_selectedYear, _selectedMonth);
        await ReloadDataAsync();
    }

    private async Task ReloadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _callerRole = await PageService.GetCurrentRoleAsync();
            _callerEmail = await PageService.GetCurrentEmailAsync();

            _buildings = await PageService.GetBuildingsAsync();
            _allRooms = (await PageService.GetRoomReadingsAsync()).ToList();
            _draftReadings.Clear();

            if (_callerRole == Roles.KhachThue)
            {
                // Tenant only views own room
                _selectedBuildingId = _buildings.FirstOrDefault()?.Id ?? "b1";
            }
            else if (string.IsNullOrWhiteSpace(_selectedBuildingId) && _buildings.Count > 0)
            {
                _selectedBuildingId = _buildings[0].Id;
            }

            ApplyFilters();
        }
        catch (UnauthorizedAccessException ex)
        {
            _errorMessage = L["MeterReadingLoadDataError"];
            ClearReadingState();
            Logger.LogWarning(ex, "P5 meter readings access denied");
        }
        catch (Exception ex)
        {
            _errorMessage = L["MeterReadingLoadDataError"];
            ClearReadingState();
            Logger.LogError(ex, "P5 meter readings load failed");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleBuildingChanged(ChangeEventArgs e)
    {
        _selectedBuildingId = e.Value?.ToString() ?? string.Empty;
        _draftReadings.Clear();
        ApplyFilters();
    }

    private void HandleMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var month) && month is >= 1 and <= 12)
        {
            _selectedMonth = month;
            _draftReadings.Clear();
            UpdatePeriodRange(_selectedYear, _selectedMonth);
            ApplyFilters();
        }
    }

    private void HandleYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var year) && year is >= 2000 and <= 2100)
        {
            _selectedYear = year;
            _draftReadings.Clear();
            UpdatePeriodRange(_selectedYear, _selectedMonth);
            ApplyFilters();
        }
    }

    private void UpdatePeriodRange(int year, int month)
    {
        var anchor = new DateOnly(year, month, 1);
        _periodStart = InvoicePeriodRules.Start(anchor);
        _periodEnd = InvoicePeriodRules.EndInclusive(anchor);
        _periodLabel = $"{month:D2}/{year:D4}";
    }

    private void SelectFirstBuilding()
    {
        if (_buildings.Count > 0)
        {
            _selectedBuildingId = _buildings[0].Id;
            ApplyFilters();
        }
    }

    private void ApplyFilters()
    {
        var roomsInPeriod = _allRooms
            .Where(r => r.PeriodStart == _periodStart && r.PeriodEnd == _periodEnd)
            .ToList();

        _page = 1;
        _expandedRoomId = null;

        if (roomsInPeriod.Count == 0)
        {
            _periodHasNoData = true;
            _filteredRooms = [];
            return;
        }

        _periodHasNoData = false;

        if (_callerRole == Roles.KhachThue)
        {
            var allowedIds = UtilitySampleData.GetAllowedRoomIds(_callerRole, _callerEmail);
            _filteredRooms = roomsInPeriod.Where(r => allowedIds.Contains(r.Id)).ToList();
            return;
        }

        if (string.IsNullOrWhiteSpace(_selectedBuildingId) || _selectedBuildingId == "all")
        {
            _filteredRooms = roomsInPeriod;
        }
        else
        {
            _filteredRooms = roomsInPeriod.Where(r => r.BuildingId == _selectedBuildingId).ToList();
        }
    }

    private void ToggleRoom(string roomId)
    {
        _expandedRoomId = _expandedRoomId == roomId ? null : roomId;
    }

    private void ChangePageSize(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            _pageSize = size;
            _page = 1;
            _expandedRoomId = null;
        }
    }

    private void GoToPreviousPage()
    {
        if (_page <= 1) return;
        _page--;
        _expandedRoomId = null;
    }

    private void GoToNextPage()
    {
        if (_page >= TotalPages) return;
        _page++;
        _expandedRoomId = null;
    }

    private static int GetFloor(RoomReadingSampleDto room)
    {
        // P101 -> tầng 1, P201 -> tầng 2, P1001 -> tầng 10
        var digits = new string(room.RoomCode.Where(char.IsDigit).ToArray());
        if (!int.TryParse(digits, out var number) || number < 100)
        {
            return 0;
        }

        return number / 100;
    }

    private bool HasDraftEnd(RoomReadingSampleDto room, bool electric, out decimal end)
    {
        if (_draftReadings.TryGetValue(room.Id, out var draft))
        {
            var value = electric ? draft.ElectricEnd : draft.WaterEnd;
            if (value.HasValue)
            {
                end = value.Value;
                return true;
            }
        }

        end = electric ? room.ElectricEnd : room.WaterEnd;
        return electric ? room.HasElectricReading : room.HasWaterReading;
    }

    private string FormatElectricUsage(RoomReadingSampleDto room)
    {
        if (!HasDraftEnd(room, electric: true, out var end))
        {
            return "—";
        }

        var usage = Math.Max(0m, end - room.ElectricStart);
        return string.Format("{0:N0} kWh", usage);
    }

    private string FormatWaterUsage(RoomReadingSampleDto room)
    {
        if (!HasDraftEnd(room, electric: false, out var end))
        {
            return "—";
        }

        var usage = Math.Max(0m, end - room.WaterStart);
        return string.Format("{0:N0} m³", usage);
    }

    private string GetRoomStatusCss(RoomReadingSampleDto room)
    {
        if (string.Equals(room.Status, "locked", StringComparison.OrdinalIgnoreCase))
        {
            return "locked";
        }

        var hasElectric = HasDraftEnd(room, electric: true, out _);
        var hasWater = HasDraftEnd(room, electric: false, out _);
        return hasElectric && hasWater ? "recorded" : "unrecorded";
    }

    private string GetRoomStatusLabel(RoomReadingSampleDto room) => GetRoomStatusCss(room) switch
    {
        "locked" => L["MeterReadingStatusLocked"].Value,
        "recorded" => L["MeterReadingKpiRecorded"].Value,
        _ => L["MeterReadingKpiUnrecorded"].Value,
    };

    private void HandleRoomReadingChanged((string RoomId, decimal? ElectricEnd, decimal? WaterEnd) payload)
    {
        // Chỉ lưu draft khi có thay đổi thực sự so với dữ liệu đã lưu
        // (tránh KPI "Đã ghi" tăng vô lý khi user bấm "Hủy" trên phòng chưa nhập)
        var room = _allRooms.FirstOrDefault(r => r.Id == payload.RoomId);
        var savedElectric = room is { HasElectricReading: true } ? room.ElectricEnd : (decimal?)null;
        var savedWater = room is { HasWaterReading: true } ? room.WaterEnd : (decimal?)null;
        var hasRealChange = room is not null &&
            (payload.ElectricEnd != savedElectric || payload.WaterEnd != savedWater);

        if (hasRealChange)
        {
            _draftReadings[payload.RoomId] = (payload.ElectricEnd, payload.WaterEnd);
        }
        else
        {
            _draftReadings.Remove(payload.RoomId);
        }

        StateHasChanged();
    }

    private void ClearReadingState()
    {
        _allRooms = [];
        _filteredRooms = [];
        _draftReadings.Clear();
        _periodHasNoData = false;
    }

    private async Task<bool> HandleRoomSave((string RoomId, decimal ElectricEnd, decimal WaterEnd, string? Reason, bool IsLock) payload)
    {
        SaveResult result;
        try
        {
            result = await PageService.SaveReadingAsync(
                payload.RoomId,
                payload.ElectricEnd,
                payload.WaterEnd,
                _periodStart,
                _periodEnd,
                payload.Reason,
                payload.IsLock);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "P5 meter reading save failed for room {RoomId}", payload.RoomId);
            Toast.Error(L["MeterReadingSaveError"]);
            return false;
        }

        if (!result.Success)
        {
            var roomRef = _allRooms.FirstOrDefault(r => r.Id == payload.RoomId);
            var message = result.ErrorCode switch
            {
                MeterReadingErrorCodes.NegativeReading => L["MeterReadingErrorNegative"].ToString(),
                MeterReadingErrorCodes.RoomNotFound => L["MeterReadingErrorRoomNotFound"].ToString(),
                MeterReadingErrorCodes.ElectricEndLessThanStart => string.Format(
                    L["MeterReadingErrorElectricMustBeGreater"],
                    payload.ElectricEnd,
                    roomRef?.ElectricStart ?? 0m),
                MeterReadingErrorCodes.WaterEndLessThanStart => string.Format(
                    L["MeterReadingErrorWaterMustBeGreater"],
                    payload.WaterEnd,
                    roomRef?.WaterStart ?? 0m),
                MeterReadingErrorCodes.AdjustmentReasonRequired => L["MeterReadingAdjustmentReasonRequired"].ToString(),
                MeterReadingErrorCodes.InvalidRequest => L["MeterReadingErrorInvalidRequest"].ToString(),
                _ => L["MeterReadingSaveError"].ToString()
            };
            Toast.Error(message);
            return false;
        }

        _draftReadings.Remove(payload.RoomId);

        // Update room in local state
        if (result.Room is not null)
        {
            var allIdx = _allRooms.FindIndex(r => r.Id == payload.RoomId);
            if (allIdx >= 0)
            {
                _allRooms[allIdx] = result.Room;
            }

            var idx = _filteredRooms.FindIndex(r => r.Id == payload.RoomId);
            if (idx >= 0)
            {
                _filteredRooms[idx] = result.Room;
            }
        }

        if (payload.IsLock)
        {
            Toast.Success(string.Format(L["MeterReadingLockSuccess"], result.Room?.RoomCode ?? ""));
        }
        else
        {
            Toast.Success(string.Format(L["MeterReadingDraftSuccess"], result.Room?.RoomCode ?? ""));
        }

        StateHasChanged();
        return true;
    }
}
