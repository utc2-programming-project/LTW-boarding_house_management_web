@page "/services/trash"
@attribute [Authorize(Roles = Roles.ChuTro)]
@rendermode InteractiveServer
@using Web.Common.Models
@using Web.Common.SoftDelete
@inject ServiceCatalogPageService PageService
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject IStringLocalizer<UtilityResources> L
@inject ILogger<ServiceTrashView> Logger

<PageTitle>@L["ServiceTrashTitle"] · @L["CatalogPageTitle"]</PageTitle>

<div class="page-stack">
    <PageHeading Title="@L["ServiceTrashTitle"]" HelpText="@L["ServiceTrashSubtitle"]">
        <Actions>
            <button type="button" class="btn btn-danger" @onclick="OpenEmptyTrash">
                <LucideIcon Name="trash" />@L["EmptyTrash"]
            </button>
            <button type="button" class="btn btn-secondary" @onclick="GoToServices">
                <LucideIcon Name="settings" />@L["CatalogHeading"]
            </button>
        </Actions>
    </PageHeading>

    <div class="filter-bar filter-bar--panel">
        <div class="filter-bar__row">
            <div class="filter-bar__search">
                <label class="sr-only" for="service-trash-search">@L["ServiceTrashSearchLabel"]</label>
                <span class="filter-bar__icon" aria-hidden="true"><LucideIcon Name="search" /></span>
                <input id="service-trash-search" type="search" class="input"
                       placeholder="@L["ServiceTrashSearchPlaceholder"]" @bind="_keyword" @bind:after="ReloadAsync" />
            </div>
            <div class="filter-bar__actions">
                <div class="filter-bar__state">
                    <label class="sr-only" for="service-trash-page-size">@L["P2RowsPerPage"]</label>
                    <select id="service-trash-page-size" class="input" value="@_pageSize" @onchange="ChangePageSize">
                        <option value="10">@string.Format(L["RowsPerPageOption"].Value, 10)</option>
                        <option value="20">@string.Format(L["RowsPerPageOption"].Value, 20)</option>
                        <option value="50">@string.Format(L["RowsPerPageOption"].Value, 50)</option>
                    </select>
                </div>
                <FilterResetButton OnClick="ClearSearchAsync" />
            </div>
        </div>
    </div>

    <DataTable @ref="_table" @key="_tableKey" TItem="ServiceCatalogTrashItemDto" Columns="_columns"
               ItemsProvider="LoadDeletedAsync" PageSize="_pageSize" AllowOverflow="true"
               Caption="@L["ServiceTrashTitle"]" Labels="_tableLabels" />
</div>

<ConfirmDialog Visible="_restoreVisible" Title="@L["ServiceTrashRestoreTitle"]"
               Message="@string.Format(L["ServiceTrashRestoreMessage"], _restoreItem?.Name ?? string.Empty)"
               ConfirmText="@L["Restore"]" CancelText="@L["Cancel"]"
               OnConfirm="RestoreAsync" OnCancel="CloseRestore" />

<PurgeConfirmDialog Visible="_purgeVisible" Title="@L["PurgeTitle"]"
                    Message="@string.Format(L["PurgeMessage"], _purgeItem?.Name ?? string.Empty)"
                    ExpectedText="@(_purgeItem?.Name ?? string.Empty)"
                    PromptText="@string.Format(L["PurgeTypePrompt"], _purgeItem?.Name ?? string.Empty)"
                    MismatchText="@L["PurgeMismatch"]"
                    ConfirmText="@L["Purge"]" CancelText="@L["Cancel"]"
                    OnConfirm="PurgeAsync" OnCancel="ClosePurge" />

<PurgeConfirmDialog Visible="_emptyVisible" Title="@L["EmptyTrashTitle"]"
                    Message="@L["EmptyTrashMessage"]"
                    ExpectedText="@L["TrashEmptyPhrase"]"
                    PromptText="@string.Format(L["PurgeTypePrompt"], L["TrashEmptyPhrase"].Value)"
                    MismatchText="@L["PurgeMismatch"]"
                    ConfirmText="@L["EmptyTrash"]" CancelText="@L["Cancel"]"
                    OnConfirm="EmptyTrashAsync" OnCancel="CloseEmptyTrash" />

@code {
    private DataTable<ServiceCatalogTrashItemDto>? _table;
    private IReadOnlyList<DataTableColumn<ServiceCatalogTrashItemDto>> _columns = [];
    private DataTableLabels _tableLabels = new();
    private ServiceCatalogTrashItemDto? _restoreItem;
    private ServiceCatalogTrashItemDto? _purgeItem;
    private bool _restoreVisible;
    private bool _purgeVisible;
    private bool _emptyVisible;
    private int _pageSize = 20;
    private int _tableKey;
    private string _keyword = string.Empty;

    protected override void OnInitialized()
    {
        _tableLabels = DataTableLabelLocalizer.Create(L);
        _columns = BuildColumns();
    }

    private IReadOnlyList<DataTableColumn<ServiceCatalogTrashItemDto>> BuildColumns()
    {
        RenderFragment<ServiceCatalogTrashItemDto> actions = item => @<TrashRowMenu RestoreText="@L["Restore"]" PurgeText="@L["Purge"]"
            OnRestore="() => RequestRestore(item)" OnPurge="() => RequestPurge(item)" />;

        return
        [
            new() { Key = "name", Title = L["ServiceTrashColumnName"], Value = item => item.Name },
            new() { Key = "property", Title = L["ServiceTrashColumnProperty"], Value = item => item.PropertyName },
            new() { Key = "unit", Title = L["ServiceTrashColumnUnit"], Value = item => item.Unit },
            new() { Key = "price", Title = L["ServiceTrashColumnPrice"], Value = item => item.UnitPrice.ToString("N0", CultureInfo.CurrentCulture), IsNumeric = true },
            new() { Key = "versions", Title = L["ServiceTrashColumnVersions"], Value = item => item.PriceVersionCount.ToString(CultureInfo.CurrentCulture), IsNumeric = true },
            TrashColumns.DeletedAt<ServiceCatalogTrashItemDto>(L["TrashDeletedAt"], item => item.DeletedAt),
            TrashColumns.Actions(L["P2Actions"], actions),
        ];
    }

    private async Task<PagedResult<ServiceCatalogTrashItemDto>> LoadDeletedAsync(DataTableRequest request) =>
        await PageService.ListDeletedServicesAsync(
            string.IsNullOrWhiteSpace(_keyword) ? null : _keyword.Trim(),
            request.Page,
            request.PageSize);

    private Task ClearSearchAsync()
    {
        _keyword = string.Empty;
        return ReloadAsync();
    }

    private Task ReloadAsync()
    {
        _tableKey++;
        return Task.CompletedTask;
    }

    private Task ChangePageSize(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value) && value is 10 or 20 or 50)
        {
            _pageSize = value;
            _tableKey++;
        }

        return Task.CompletedTask;
    }

    private void RequestRestore(ServiceCatalogTrashItemDto item)
    {
        _restoreItem = item;
        _restoreVisible = true;
    }

    private void CloseRestore()
    {
        _restoreVisible = false;
        _restoreItem = null;
    }

    private void RequestPurge(ServiceCatalogTrashItemDto item)
    {
        _purgeItem = item;
        _purgeVisible = true;
    }

    private void ClosePurge()
    {
        _purgeVisible = false;
        _purgeItem = null;
    }

    private void OpenEmptyTrash() => _emptyVisible = true;

    private void CloseEmptyTrash() => _emptyVisible = false;

    private async Task RestoreAsync()
    {
        if (_restoreItem is null)
        {
            CloseRestore();
            return;
        }

        var (success, error) = await PageService.RestoreDeletedServiceAsync(_restoreItem.Id);
        CloseRestore();
        if (!success)
        {
            Toasts.Error(error ?? L["PurgeFailed"]);
            return;
        }

        Toasts.Success(L["ServiceTrashRestored"]);
        await ReloadTableAsync();
    }

    private async Task PurgeAsync()
    {
        if (_purgeItem is null)
        {
            ClosePurge();
            return;
        }

        try
        {
            var (success, error) = await PageService.PurgeDeletedServiceAsync(_purgeItem.Id);
            ClosePurge();
            if (!success)
            {
                Toasts.Error(error ?? L["PurgeFailed"]);
                return;
            }

            Toasts.Success(L["PurgeSuccess"]);
            await ReloadTableAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Service purge failed");
            Toasts.Error(L["PurgeFailed"]);
            ClosePurge();
        }
    }

    private async Task EmptyTrashAsync()
    {
        try
        {
            var (success, error, summary) = await PageService.PurgeAllDeletedServicesAsync();
            CloseEmptyTrash();
            if (!success || summary is null)
            {
                Toasts.Error(error ?? L["PurgeFailed"]);
                return;
            }

            if (summary.Purged == 0 && summary.Skipped == 0)
            {
                Toasts.Success(L["EmptyTrashNothing"]);
            }
            else
            {
                Toasts.Success(string.Format(L["EmptyTrashSuccess"], summary.Purged, summary.Skipped));
            }

            await ReloadTableAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Service empty trash failed");
            Toasts.Error(L["PurgeFailed"]);
            CloseEmptyTrash();
        }
    }

    private async Task ReloadTableAsync()
    {
        if (_table is not null)
        {
            await _table.ReloadAsync();
        }
    }

    private void GoToServices() => Navigation.NavigateTo("/services");
}
