@page "/services/prices"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "UtilityBusiness")]
@inject IStringLocalizer<UtilityResources> L
@inject ServiceCatalogPageService PageService
@inject ToastService Toast
@inject NavigationManager Navigation
@inject ILogger<ServicePricesView> Logger

<PageTitle>@L["PricesPageTitle"]</PageTitle>

<div class="service-prices-page">
    @if (_isLoading)
    {
        <div class="page-loading">
            <LoadingOverlay Visible="true" Text="@L["LoadingText"]" />
        </div>
    }
    else
    {
    <!-- Header -->
    <PageHeading Title="@L["PricesHeading"]" HelpText="@L["PricesSubtitle"]">
        <HeadingMeta>
            @if (_isSampleData)
            {
                <div class="sample-data-note">
                    <span class="sample-data-badge">@L["SampleDataBadge"] · VHT-32</span>
                    <span>@L["SampleDataNotice"]</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <div class="sample-data-note" style="border-left: 3px solid var(--danger); background: var(--error-bg); color: var(--error-text);">
                    <span class="sample-data-badge" style="background: var(--danger); color: var(--on-primary);">@L["SqlErrorBadge"]</span>
                    <span>@_loadError</span>
                </div>
            }
        </HeadingMeta>
        <Actions>
            <div class="header-actions">
                <button type="button" class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/services")'>
                    <LucideIcon Name="arrow-left" />
                    <span>@L["BackToCatalogBtn"]</span>
                </button>
                <AuthorizeView Policy="UtilityManage">
                    <Authorized>
                        @if (_currentSelectedService is not null && !_currentSelectedService.IsReadOnly)
                        {
                            <button type="button" class="btn btn-primary" @onclick="() => _isPriceModalOpen = true">
                                <LucideIcon Name="plus" />
                                <span>@L["UpdatePriceMilestoneBtn"]</span>
                            </button>
                        }
                    </Authorized>
                </AuthorizeView>
            </div>
        </Actions>
    </PageHeading>

    <!-- Service Selector Tabs -->
    <div class="service-tabs-container">
        <button type="button"
                class="tab-btn @(_selectedServiceId == "all" ? "active" : "")"
                @onclick='() => SelectServiceTab("all")'>
            @L["TabAllServices"]
        </button>
        @foreach (var srv in _services)
        {
            <button type="button"
                    class="tab-btn @(_selectedServiceId == srv.Id ? "active" : "")"
                    @onclick="() => SelectServiceTab(srv.Id)">
                <span>@srv.Name</span>
                @if (srv.IsReadOnly)
                {
                    <LucideIcon Name="lock" Class="tab-lock-icon" />
                }
            </button>
        }
    </div>

    <!-- Filter Toolbar -->
    <div class="filters-container">
        <div class="filters-row">
            <label class="filter-field" for="price-keyword-filter">
                <span class="filter-label">@L["PriceKeywordFilter"]</span>
                <input id="price-keyword-filter" type="search" class="input" autocomplete="off"
                       placeholder="@L["PriceKeywordPlaceholder"]"
                       @bind="_keywordFilter" @bind:event="oninput" @bind:after="OnFilterChanged" />
            </label>

            <label class="filter-field" for="price-status-filter">
                <span class="filter-label">@L["ThPriceStatus"]</span>
                <select id="price-status-filter" class="input select-filter" @bind="_statusFilter" @bind:after="OnFilterChanged">
                    <option value="all">@L["AllStatuses"]</option>
                    <option value="@((int)PriceVersionStatus.Active)">@L["StatusActive"]</option>
                    <option value="@((int)PriceVersionStatus.Upcoming)">@L["StatusUpcoming"]</option>
                    <option value="@((int)PriceVersionStatus.Expired)">@L["StatusExpired"]</option>
                </select>
            </label>

            <label class="filter-field" for="price-scope-filter">
                <span class="filter-label">@L["ThPriceScope"]</span>
                <select id="price-scope-filter" class="input select-filter" @bind="_scopeFilter" @bind:after="OnFilterChanged">
                    <option value="">@L["AllScopes"]</option>
                    @foreach (var scope in _scopeOptions)
                    {
                        <option value="@scope.Value">@scope.Label</option>
                    }
                </select>
            </label>

            <label class="filter-field" for="price-effective-from-filter">
                <span class="filter-label">@L["PriceEffectiveFromFilter"]</span>
                <input id="price-effective-from-filter" type="date" class="input date-filter"
                       @bind="_effectiveFromFilter" @bind:after="OnFilterChanged" />
            </label>

            <label class="filter-field" for="price-effective-to-filter">
                <span class="filter-label">@L["PriceEffectiveToFilter"]</span>
                <input id="price-effective-to-filter" type="date" class="input date-filter"
                       @bind="_effectiveToFilter" @bind:after="OnFilterChanged" />
            </label>

            <button type="button" class="btn btn-secondary btn-reset" @onclick="ResetFilters">
                <LucideIcon Name="refresh" />
                <span>@L["ResetFilter"]</span>
            </button>
        </div>
        @if (!string.IsNullOrEmpty(_rangeError))
        {
            <p class="field-error-text" role="alert">@_rangeError</p>
        }
    </div>

    <!-- Timeline History Table -->
    <div class="table-card">
        @if (_filteredVersions.Count > 0)
        {
            <div class="table-responsive">
                <table class="prices-table">
                    <thead>
                        <tr>
                            <th>@L["ThPriceEffectiveFrom"]</th>
                            <th>@L["ThPriceEffectiveTo"]</th>
                            <th class="text-right">@L["ThPriceRate"]</th>
                            <th class="text-center">@L["ThPriceStatus"]</th>
                            <th>@L["ThPriceScope"]</th>
                            <th>@L["ThPriceCreator"]</th>
                            <th>@L["ThPriceCreatedAt"]</th>
                            <th>@L["ThPriceNotes"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in PagedVersions)
                        {
                            <tr class="version-row">
                                <td class="tabular-nums font-semibold text-slate-800">
                                    <div>@DateFormatter.Format(v.EffectiveFrom)</div>
                                    @if (_isSampleData)
                                    {
                                        <span class="record-origin-badge @(v.IsSessionCreated ? "session" : "")" style="white-space: normal; word-break: break-word;">
                                            @L[v.IsSessionCreated ? "RecordCreatedStatus" : "RecordSampleStatus"]
                                        </span>
                                    }
                                </td>
                                <td class="tabular-nums">
                                    @if (v.EffectiveTo.HasValue)
                                    {
                                        <span class="text-slate-600">@DateFormatter.Format(v.EffectiveTo)</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 italic">@L["NoData"]</span>
                                    }
                                </td>
                                <td class="text-right tabular-nums font-bold text-slate-900">
                                    @if (v.RateType == ServiceRateType.Tiered && !string.IsNullOrWhiteSpace(v.TierLabel))
                                    {
                                        <div class="tier-range-label">@v.TierLabel</div>
                                        <span>@MoneyFormatter.Format(v.Rate)</span>
                                        <span> / </span>
                                        <span>@L[GetUnitResourceKey(v.Unit)]</span>
                                    }
                                    else if (v.RateType == ServiceRateType.Tiered)
                                    {
                                        @L["TieredTariffLabel"]
                                    }
                                    else
                                    {
                                        <span>@MoneyFormatter.Format(v.Rate)</span>
                                        <span> / </span>
                                        <span>@L[GetUnitResourceKey(v.Unit)]</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="status-badge-chip @GetStatusBadgeClass(v.Status)">
                                        @L[GetStatusResourceKey(v.Status)]
                                    </span>
                                </td>
                                <td class="text-slate-700">@(v.BuildingScope == "all" ? L["AllBuildings"] : v.BuildingName)</td>
                                <td class="text-slate-700 font-medium">@v.CreatedBy</td>
                                <td class="tabular-nums text-slate-500 font-mono text-xs">
                                    @(!v.CreatedAt.HasValue || v.CreatedAt.Value == default ? "—" : DateFormatter.FormatDateTime(v.CreatedAt.Value))
                                </td>
                                    <td class="text-slate-600 italic">@(string.IsNullOrWhiteSpace(v.Note) ? L["NoData"].Value : v.Note)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <footer class="table-footer">
                <div class="pagination-info">
                    @L["TableShowing"] @FirstItem–@LastItem @L["TableOf"] @_filteredVersions.Count
                </div>

                <div class="pagination-controls">
                    <label class="page-size-field" for="price-page-size">
                        <span>@L["RowsPerPage"]</span>
                        <select id="price-page-size" class="input page-size-select" value="@_pageSize" @onchange="ChangePageSize">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>
                    </label>

                    <nav class="pager" aria-label="@L["PaginationLabel"]">
                        <button type="button" class="pager-btn" disabled="@(_page <= 1)" @onclick="GoToPreviousPage" aria-label="@L["PreviousPage"]">
                            <LucideIcon Name="chevron-left" />
                        </button>
                        <span class="page-indicator">@_page / @TotalPages</span>
                        <button type="button" class="pager-btn" disabled="@(_page >= TotalPages)" @onclick="GoToNextPage" aria-label="@L["NextPage"]">
                            <LucideIcon Name="chevron-right" />
                        </button>
                    </nav>
                </div>
            </footer>
        }
        else
        {
            <div class="empty-state-box">
                <div class="empty-icon-wrap">
                    <LucideIcon Name="history" Class="empty-state-icon" />
                </div>
                <h3 class="empty-title">@L["NoData"]</h3>
                <p class="empty-desc">@L["PricesEmptyDescription"]</p>
                <div class="empty-state-actions">
                    <AuthorizeView Policy="UtilityManage">
                        <Authorized>
                            @if (_currentSelectedService is not null && !_currentSelectedService.IsReadOnly)
                            {
                                <button type="button" class="btn btn-primary" @onclick="() => _isPriceModalOpen = true">
                                    <LucideIcon Name="plus" />
                                    <span>@L["UpdatePriceMilestoneBtn"]</span>
                                </button>
                            }
                            else if (_currentSelectedService is null)
                            {
                                <button type="button" class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/services")'>
                                    <LucideIcon Name="plus" />
                                    <span>@L["AddNewServiceBtn"]</span>
                                </button>
                            }
                        </Authorized>
                    </AuthorizeView>
                    @if (_selectedServiceId != "all")
                    {
                        <button type="button" class="btn btn-secondary" @onclick='() => SelectServiceTab("all")'>
                            <LucideIcon Name="refresh" />
                            <span>@L["ClearFilterBtn"]</span>
                        </button>
                    }
                </div>
            </div>
        }
    </div>
    }
</div>

<AuthorizeView Policy="UtilityManage">
    <Authorized>
        <ServicePriceModal IsOpen="@_isPriceModalOpen"
                           Service="@_currentSelectedService"
                           CanWrite="@_canWrite"
                           OnClose="() => _isPriceModalOpen = false"
                           OnSave="HandleSavePrice" />
    </Authorized>
</AuthorizeView>

@code {
    private List<ServiceItemDto> _services = [];
    private List<PriceVersionDto> _allVersions = [];
    private List<PriceVersionDto> _filteredVersions = [];
    private List<(string Value, string Label)> _scopeOptions = [];
    private string _selectedServiceId = string.Empty;
    // Query param chỉ áp dụng lần đầu để reload sau khi lưu không kéo tab về dịch vụ cũ.
    private string? _lastAppliedServiceId;
    private string _statusFilter = "all";
    private string _scopeFilter = string.Empty;
    private string _keywordFilter = string.Empty;
    private DateTime? _effectiveFromFilter;
    private DateTime? _effectiveToFilter;
    private string? _rangeError;
    private int _pageSize = 10;
    private int _page = 1;
    private ServiceItemDto? _currentSelectedService;
    private string _callerRole = string.Empty;
    private bool _isPriceModalOpen;
    private bool _isLoading = true;
    private bool _isSampleData = false;
    private bool _canWrite = false;
    private string? _loadError;

    [Parameter, SupplyParameterFromQuery(Name = "serviceId")]
    public string? ServiceId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        _isLoading = false;
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _callerRole = await PageService.GetCurrentRoleAsync();
            _services = (await PageService.GetServicesForCallerAsync()).ToList();

            if (!string.IsNullOrWhiteSpace(ServiceId) && ServiceId != _lastAppliedServiceId
                && _services.Any(service => service.Id == ServiceId))
            {
                _selectedServiceId = ServiceId;
                _lastAppliedServiceId = ServiceId;
            }
            else if (!_services.Any(service => service.Id == _selectedServiceId))
            {
                _selectedServiceId = _services.FirstOrDefault()?.Id ?? string.Empty;
            }

            await SelectServiceTab(_selectedServiceId);

            _isSampleData = PageService.IsSampleData;
            _canWrite = PageService.CheckWriteSupport().CanWrite && string.Equals(_callerRole, Roles.ChuTro, StringComparison.OrdinalIgnoreCase);
            _loadError = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load service price history page.");
            _loadError = L["SqlLoadPricesError"];
            _services = [];
            _filteredVersions = [];
        }
    }

    private async Task SelectServiceTab(string serviceId)
    {
        _selectedServiceId = serviceId;
        _currentSelectedService = _services.FirstOrDefault(s => s.Id == serviceId);
        _statusFilter = "all";
        _scopeFilter = string.Empty;
        _keywordFilter = string.Empty;
        _effectiveFromFilter = null;
        _effectiveToFilter = null;
        _page = 1;
        try
        {
            var versions = await PageService.GetPriceVersionsForCallerAsync(serviceId);
            _allVersions = versions.ToList();
            BuildScopeOptions();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load service price versions.");
            _loadError = L["SqlLoadVersionsError"];
            _allVersions = [];
            _filteredVersions = [];
            _scopeOptions = [];
        }
    }

    private void BuildScopeOptions()
    {
        _scopeOptions = _allVersions
            .GroupBy(v => v.BuildingScope)
            .Select(group => (
                Value: group.Key,
                Label: group.Key == "all" ? L["AllBuildingsDescription"].Value : group.First().BuildingName))
            .ToList();
    }

    private void ApplyFilters()
    {
        if (_effectiveFromFilter.HasValue && _effectiveToFilter.HasValue
            && _effectiveFromFilter.Value.Date > _effectiveToFilter.Value.Date)
        {
            _rangeError = L["PriceFilterRangeInvalid"];
            _filteredVersions = [];
            _page = 1;
            return;
        }

        _rangeError = null;
        IEnumerable<PriceVersionDto> query = _allVersions;

        if (!string.IsNullOrWhiteSpace(_keywordFilter))
        {
            var keyword = _keywordFilter.Trim();
            query = query.Where(v =>
                Contains(v.CreatedBy, keyword) ||
                Contains(v.Note, keyword) ||
                Contains(v.BuildingName, keyword));
        }

        if (_statusFilter != "all" && Enum.TryParse<PriceVersionStatus>(_statusFilter, out var status))
        {
            query = query.Where(v => v.Status == status);
        }

        if (!string.IsNullOrEmpty(_scopeFilter))
        {
            query = query.Where(v => string.Equals(v.BuildingScope, _scopeFilter, StringComparison.OrdinalIgnoreCase));
        }

        // Lọc theo khoảng ngày là lọc "giao nhau": một bảng giá được hiển thị khi
        // khoảng hiệu lực của nó chạm khoảng người dùng chọn. Bảng giá chưa có ngày
        // kết thúc vẫn còn hiệu lực nên không bị loại khỏi khoảng lọc.
        if (_effectiveFromFilter.HasValue)
        {
            var rangeStart = DateOnly.FromDateTime(_effectiveFromFilter.Value);
            query = query.Where(v => v.EffectiveTo == null || v.EffectiveTo.Value >= rangeStart);
        }

        if (_effectiveToFilter.HasValue)
        {
            var rangeEnd = DateOnly.FromDateTime(_effectiveToFilter.Value);
            query = query.Where(v => v.EffectiveFrom <= rangeEnd);
        }

        _filteredVersions = query.ToList();

        if (_page > TotalPages)
        {
            _page = TotalPages;
        }

        if (_page < 1)
        {
            _page = 1;
        }
    }

    private void OnFilterChanged()
    {
        _page = 1;
        ApplyFilters();
    }

    private static bool Contains(string? value, string keyword) =>
        !string.IsNullOrWhiteSpace(value) &&
        value.Contains(keyword, StringComparison.CurrentCultureIgnoreCase);

    private void ResetFilters()
    {
        _statusFilter = "all";
        _scopeFilter = string.Empty;
        _keywordFilter = string.Empty;
        _effectiveFromFilter = null;
        _effectiveToFilter = null;
        _page = 1;
        ApplyFilters();
    }

    private void ChangePageSize(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var size) && size > 0)
        {
            _pageSize = size;
            _page = 1;
        }
    }

    private void GoToPreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void GoToNextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private IEnumerable<PriceVersionDto> PagedVersions =>
        _filteredVersions.Skip((_page - 1) * _pageSize).Take(_pageSize);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filteredVersions.Count / (double)_pageSize));

    private int FirstItem => _filteredVersions.Count == 0 ? 0 : (_page - 1) * _pageSize + 1;

    private int LastItem => Math.Min(_page * _pageSize, _filteredVersions.Count);

    private static string GetStatusBadgeClass(PriceVersionStatus status) => status switch
    {
        PriceVersionStatus.Active => "badge-active",
        PriceVersionStatus.Upcoming => "badge-upcoming",
        _ => "badge-expired"
    };

    private static string GetStatusResourceKey(PriceVersionStatus status) => status switch
    {
        PriceVersionStatus.Active => "StatusActive",
        PriceVersionStatus.Upcoming => "StatusUpcoming",
        _ => "StatusExpired"
    };

    private static string GetUnitResourceKey(ServiceUnitCategory unit) => unit switch
    {
        ServiceUnitCategory.Room => "UnitRoom",
        ServiceUnitCategory.Person => "UnitPerson",
        ServiceUnitCategory.Vehicle => "UnitVehicle",
        ServiceUnitCategory.Visit => "UnitVisit",
        ServiceUnitCategory.KilowattHour => "UnitKwh",
        ServiceUnitCategory.CubicMeter => "UnitM3",
        _ => "NoData",
    };

    private async Task HandleSavePrice(UpdatePriceRequest req)
    {
        var res = await PageService.UpdateServicePriceAsync(req);
        if (res.Success)
        {
            var filters = (_statusFilter, _scopeFilter, _keywordFilter, _effectiveFromFilter, _effectiveToFilter, _page);
            await LoadDataAsync();
            (_statusFilter, _scopeFilter, _keywordFilter, _effectiveFromFilter, _effectiveToFilter, _page) = filters;
            ApplyFilters();
            Toast.Success(_isSampleData ? L["ToastPriceUpdatedSuccess"] : L["ToastPriceUpdatedSuccessSql"]);
            _isPriceModalOpen = false;
        }
        else
        {
            Toast.Error(res.ErrorMessage ?? L["ErrorUnknown"]);
        }
    }
}
