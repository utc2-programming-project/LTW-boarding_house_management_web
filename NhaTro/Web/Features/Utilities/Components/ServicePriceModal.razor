@inject IStringLocalizer<UtilityResources> L

@if (IsOpen && Service is not null)
{
    <div class="modal-backdrop" @onclick="HandleClose" role="dialog" aria-modal="true" aria-labelledby="price-modal-title">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <header class="modal-header">
                <div class="modal-header-icon">
                    <LucideIcon Name="receipt" />
                </div>
                <div class="modal-header-text">
                    <h2 id="price-modal-title">@L["UpdateModalTitle"]</h2>
                    <p>@L["UpdateModalSubtitle"]</p>
                </div>
                <button type="button" class="modal-close-btn" @onclick="HandleClose" aria-label="@L["CloseBtn"]">
                    <LucideIcon Name="close" />
                </button>
            </header>

            <div class="modal-body">
                <div class="service-summary-card">
                    <div class="summary-item">
                        <span class="summary-label">@L["ThServiceName"]</span>
                        <strong class="summary-value">@Service.Name</strong>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">@L["CurrentPriceDisplay"]</span>
                        <span class="summary-value tabular-nums">@MoneyFormatter.Format(Service.CurrentRate) / @L[GetUnitResourceKey(Service.Unit)]</span>
                    </div>
                </div>

                <div class="form-field-group">
                    <label class="field-label" for="new-rate-input">
                        @L["NewPriceLabel"] <span class="required-star">*</span>
                    </label>
                    <div class="input-with-affix">
                        <input id="new-rate-input"
                               type="number"
                               min="1"
                               step="1000"
                               class="input tabular-nums @(_rateError.HasValue ? "invalid" : "")"
                               @bind="_newRate"
                               @bind:after="ValidateRate"
                               placeholder="" />
                        <span class="input-affix">₫</span>
                    </div>
                    @if (_rateError.HasValue)
                    {
                        <span class="field-error-text" role="alert">@L[$"Error{_rateError.Value}"]</span>
                    }
                </div>

                <div class="grid-2-cols">
                    <div class="form-field-group">
                        <label class="field-label" for="unit-select">@L["ThUnit"]</label>
                        <select id="unit-select" class="input" @bind="_unit">
                            @foreach (var unit in Enum.GetValues<ServiceUnitCategory>())
                            {
                                <option value="@unit">@L[GetUnitResourceKey(unit)]</option>
                            }
                        </select>
                    </div>

                    <div class="form-field-group">
                        <label class="field-label" for="building-scope-readonly">@L["BuildingScopeLabel"]</label>
                        <input id="building-scope-readonly"
                               type="text"
                               class="input"
                               readonly
                               disabled
                               value="@(Service?.BuildingName ?? (Service?.BuildingId == "all" ? L["AllBuildings"] : string.Empty))" />
                    </div>
                </div>

                <div class="grid-2-cols">
                    <div class="form-field-group">
                        <label class="field-label" for="effective-from-input">
                            @L["EffectiveFromLabel"] <span class="required-star">*</span>
                        </label>
                        <input id="effective-from-input"
                               type="date"
                               class="input @(_dateError == UtilityErrorCode.EffectiveFromIsRequired ? "invalid" : "")"
                               @bind="_effectiveFrom"
                               @bind:after="ValidateDates" />
                        @if (_dateError == UtilityErrorCode.EffectiveFromIsRequired)
                        {
                            <span class="field-error-text" role="alert">@L[$"Error{_dateError.Value}"]</span>
                        }
                    </div>

                    <div class="form-field-group">
                        <label class="field-label" for="effective-to-input">@L["EffectiveToLabel"]</label>
                        <input id="effective-to-input"
                               type="date"
                               class="input @(_dateError.HasValue ? "invalid" : "")"
                               @bind="_effectiveTo"
                               @bind:after="ValidateDates" />
                        @if (_dateError.HasValue)
                        {
                            <span class="field-error-text" role="alert">@L[$"Error{_dateError.Value}"]</span>
                        }
                    </div>
                </div>

                <div class="form-field-group">
                    <label class="field-label" for="note-input">@L["NoteLabel"]</label>
                    <input id="note-input"
                           type="text"
                           class="input"
                           @bind="_note"
                           maxlength="500"
                           placeholder="@L["NotePlaceholder"]" />
                </div>
                @if (!CanWrite)
                {
                    <div class="field-error-text" role="alert" style="margin-top: 0.75rem; color: var(--warning-text); background-color: var(--warning-bg); border: 1px solid var(--warning-border); padding: 0.5rem 0.75rem; border-radius: 0.375rem; font-size: 0.875rem;">
                        @L["WriteActionBlockedNotice"]
                    </div>
                }
            </div>

            <footer class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="HandleClose" disabled="@_isSaving">
                    @L["CancelBtn"]
                </button>
                <button id="service-price-save-submit-btn" type="button" class="btn btn-primary" @onclick="HandleSubmit" disabled="@(!CanWrite || _isSaving)" title="@(!CanWrite ? L["WriteActionBlockedNotice"] : "")">
                    @if (_isSaving)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                        <span>@L["SavingBtn"]</span>
                    }
                    else
                    {
                        <LucideIcon Name="check" />
                        <span>@L["SavePriceBtn"]</span>
                    }
                </button>
            </footer>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public ServiceItemDto? Service { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<UpdatePriceRequest> OnSave { get; set; }
    [Parameter] public bool CanWrite { get; set; } = false;

    private decimal _newRate;
    private ServiceUnitCategory _unit = ServiceUnitCategory.Room;
    private DateOnly _effectiveFrom;
    private DateOnly? _effectiveTo;
    private string? _note;
    private bool _isSaving;
    private UtilityErrorCode? _rateError;
    private UtilityErrorCode? _dateError;
    private string? _initializedServiceId;
    private bool _wasOpen;

    protected override void OnParametersSet()
    {
        if (!IsOpen)
        {
            _wasOpen = false;
            return;
        }

        if (Service is null || (_wasOpen && _initializedServiceId == Service.Id)) return;

        _wasOpen = true;
        _initializedServiceId = Service.Id;
        _newRate = Service.CurrentRate;
        _unit = Service.Unit;
        _effectiveFrom = DateOnly.FromDateTime(DateTime.Today);
        _effectiveTo = null;
        _note = string.Empty;
        _rateError = null;
        _dateError = null;
    }

    private void ValidateRate()
    {
        _rateError = UtilityDraftRules.ValidateUpdatePrice(CreateRequest())
            .FirstOrDefault(issue => issue.Error == UtilityErrorCode.PriceMustBePositive)?.Error;
    }

    private void ValidateDates()
    {
        _dateError = UtilityDraftRules.ValidateUpdatePrice(CreateRequest())
            .FirstOrDefault(issue => issue.Error is UtilityErrorCode.EffectiveFromIsRequired or UtilityErrorCode.EffectiveToMustBeAfterEffectiveFrom)?.Error;
    }

    private async Task HandleSubmit()
    {
        ValidateRate();
        ValidateDates();

        if (!CanWrite || _isSaving || _rateError.HasValue || _dateError.HasValue)
        {
            return;
        }

        _isSaving = true;
        try
        {
            await OnSave.InvokeAsync(CreateRequest());
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task HandleClose()
    {
        if (!_isSaving)
        {
            await OnClose.InvokeAsync();
        }
    }

    private UpdatePriceRequest CreateRequest() => new()
    {
        ServiceId = Service?.Id ?? string.Empty,
        NewRate = _newRate,
        Unit = _unit,
        EffectiveFrom = _effectiveFrom,
        EffectiveTo = _effectiveTo,
        Note = _note,
    };

    private static string GetUnitResourceKey(ServiceUnitCategory unit) => unit switch
    {
        ServiceUnitCategory.Room => "UnitRoom",
        ServiceUnitCategory.Person => "UnitPerson",
        ServiceUnitCategory.Vehicle => "UnitVehicle",
        ServiceUnitCategory.Visit => "UnitVisit",
        ServiceUnitCategory.KilowattHour => "UnitKwh",
        ServiceUnitCategory.CubicMeter => "UnitM3",
        _ => "NoData",
    };
}
