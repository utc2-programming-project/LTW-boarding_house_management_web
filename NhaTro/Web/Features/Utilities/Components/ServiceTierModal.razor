@inject IStringLocalizer<UtilityResources> L

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="HandleClose" role="dialog" aria-modal="true" aria-labelledby="tier-modal-title">
        <div class="modal-dialog modal-dialog-tier" @onclick:stopPropagation="true">
            <header class="modal-header">
                <div class="modal-header-icon blue-icon">
                    <LucideIcon Name="shield-check" />
                </div>
                <div class="modal-header-text">
                    <h2 id="tier-modal-title">@L["TierModalTitle"] @Service?.Name</h2>
                    <p>@L["TierModalSubtitle"]</p>
                </div>
                <button type="button" class="modal-close-btn" @onclick="HandleClose" aria-label="@L["CloseBtn"]">
                    <LucideIcon Name="close" />
                </button>
            </header>

            <div class="modal-body">
                <div class="alert-info-banner">
                    <LucideIcon Name="info" />
                    <span>@L["TierModalInfo"]</span>
                </div>

                <div class="table-container">
                    <table class="tier-table">
                        <thead>
                            <tr>
                                <th>@L["TierColTier"]</th>
                                <th>@L["TierColQuota"]</th>
                                <th class="text-right">@L["TierColRate"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Service is null || Service.Tiers.Count == 0)
                            {
                                <tr>
                                    <td colspan="3">@L["TierModalEmpty"]</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var tier in Service.Tiers)
                                {
                                    <tr>
                                        <td class="font-semibold text-slate-800">@string.Format(L["TierFormulaLabel"], tier.TierNumber)</td>
                                        <td>
                                            @if (tier.To.HasValue)
                                            {
                                                @string.Format(L["TierQuotaRange"], tier.From.ToString("N0"), tier.To.Value.ToString("N0"), UnitLabel())
                                            }
                                            else
                                            {
                                                @string.Format(L["TierQuotaOpen"], tier.From.ToString("N0"), UnitLabel())
                                            }
                                        </td>
                                        <td class="text-right font-bold tabular-nums text-indigo-700">
                                            @MoneyFormatter.Format(tier.UnitPrice)
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <footer class="modal-footer justify-end">
                <button type="button" class="btn btn-secondary" @onclick="HandleClose">
                    @L["CloseBtn"]
                </button>
            </footer>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public ServiceItemDto? Service { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string UnitLabel() => Service is null ? string.Empty : L[GetUnitResourceKey(Service.Unit)].Value;

    private static string GetUnitResourceKey(ServiceUnitCategory unit) => unit switch
    {
        ServiceUnitCategory.Room => "UnitRoom",
        ServiceUnitCategory.Person => "UnitPerson",
        ServiceUnitCategory.Vehicle => "UnitVehicle",
        ServiceUnitCategory.Visit => "UnitVisit",
        ServiceUnitCategory.KilowattHour => "UnitKwh",
        ServiceUnitCategory.CubicMeter => "UnitM3",
        _ => "NoData",
    };

    private async Task HandleClose() => await OnClose.InvokeAsync();
}

