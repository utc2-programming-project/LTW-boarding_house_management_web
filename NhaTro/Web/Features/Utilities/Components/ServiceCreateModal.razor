@inject IStringLocalizer<UtilityResources> L

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="HandleClose" role="dialog" aria-modal="true" aria-labelledby="create-modal-title">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <header class="modal-header">
                <div class="modal-header-icon">
                    <LucideIcon Name="plus" />
                </div>
                <div class="modal-header-text">
                    <h2 id="create-modal-title">@L["AddModalTitle"]</h2>
                    <p>@L["AddModalSubtitle"]</p>
                </div>
                <button type="button" class="modal-close-btn" @onclick="HandleClose" aria-label="@L["CloseBtn"]">
                    <LucideIcon Name="close" />
                </button>
            </header>

            <div class="modal-body">
                <div class="form-field-group">
                    <label class="field-label" for="service-name-input">
                        @L["ServiceNameLabel"] <span class="required-star">*</span>
                    </label>
                    <input id="service-name-input"
                           type="text"
                           class="input @(_nameError.HasValue ? "invalid" : "")"
                           @bind="_name"
                           @bind:after="ValidateName"
                           placeholder="@L["ServiceNamePlaceholder"]" />
                    @if (_nameError.HasValue)
                    {
                        <span class="field-error-text" role="alert">@L[$"Error{_nameError.Value}"]</span>
                    }
                </div>

                <div class="grid-2-cols">
                    <div class="form-field-group">
                        <label class="field-label" for="service-type-select">@L["ServiceTypeLabel"]</label>
                        <select id="service-type-select" class="input" @bind="_type">
                            <option value="@ServiceTypeCategory.FixedMonthly">@L["FixedMonthlyType"]</option>
                            <option value="@ServiceTypeCategory.Custom">@L["CustomType"]</option>
                            <option value="@ServiceTypeCategory.Meter">@L["MeterType"]</option>
                        </select>
                    </div>

                    <div class="form-field-group">
                        <label class="field-label" for="create-unit-select">@L["ServiceUnitLabel"]</label>
                        <select id="create-unit-select" class="input" @bind="_unit">
                            @foreach (var unit in Enum.GetValues<ServiceUnitCategory>())
                            {
                                <option value="@unit">@L[GetUnitResourceKey(unit)]</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="grid-2-cols">
                    <div class="form-field-group">
                        <label class="field-label" for="create-rate-input">
                            @L["ServiceRateLabel"] <span class="required-star">*</span>
                        </label>
                        <div class="input-with-affix">
                            <input id="create-rate-input"
                                   type="number"
                                   min="1"
                                   step="1000"
                                   class="input tabular-nums @(_rateError.HasValue ? "invalid" : "")"
                                   @bind="_rate"
                                   @bind:after="ValidateRate"
                                   placeholder="" />
                            <span class="input-affix">₫</span>
                        </div>
                        @if (_rateError.HasValue)
                        {
                            <span class="field-error-text" role="alert">@L[$"Error{_rateError.Value}"]</span>
                        }
                    </div>

                    <div class="form-field-group">
                        <label class="field-label" for="create-building-select">@L["ServiceBuildingLabel"]</label>
                        <select id="create-building-select"
                                class="input @(_scopeError.HasValue ? "invalid" : "")"
                                @bind="_buildingId"
                                @bind:after="ValidateScope">
                            @foreach (var b in Buildings.Where(b => b.Id != "all"))
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                        @if (_scopeError.HasValue)
                        {
                            <span class="field-error-text" role="alert">@L[$"Error{_scopeError.Value}"]</span>
                        }
                    </div>
                </div>

                <div class="grid-2-cols">
                    <div class="form-field-group">
                        <label class="field-label" for="create-effective-from-input">
                            @L["EffectiveFromLabel"] <span class="required-star">*</span>
                        </label>
                        <input id="create-effective-from-input"
                               type="date"
                               class="input @(_dateError.HasValue ? "invalid" : "")"
                               @bind="_effectiveFrom"
                               @bind:after="ValidateDate" />
                        @if (_dateError.HasValue)
                        {
                            <span class="field-error-text" role="alert">@L[$"Error{_dateError.Value}"]</span>
                        }
                    </div>

                    <div class="form-field-group">
                        <label class="field-label" for="create-effective-to-input">@L["EffectiveToLabel"]</label>
                        <input id="create-effective-to-input"
                               type="date"
                               class="input @(_effectiveToError.HasValue ? "invalid" : "")"
                               @bind="_effectiveTo"
                               @bind:after="ValidateDate" />
                        @if (_effectiveToError.HasValue)
                        {
                            <span class="field-error-text" role="alert">@L[$"Error{_effectiveToError.Value}"]</span>
                        }
                    </div>
                </div>

                <div class="grid-2-cols">
                    <div class="form-field-group">
                        <label class="field-label" for="service-desc-input">@L["ServiceDescLabel"]</label>
                        <input id="service-desc-input"
                               type="text"
                               class="input"
                               @bind="_description"
                               maxlength="500"
                               placeholder="@L["ServiceDescPlaceholder"]" />
                    </div>

                    <div class="form-field-group">
                        <label class="field-label" for="create-note-input">@L["NoteLabel"]</label>
                        <input id="create-note-input"
                               type="text"
                               class="input"
                               @bind="_note"
                               maxlength="500"
                               placeholder="@L["NotePlaceholder"]" />
                    </div>
                </div>
                @if (!CanWrite)
                {
                    <div class="field-error-text" role="alert" style="margin-top: 0.75rem; color: var(--warning-text); background-color: var(--warning-bg); border: 1px solid var(--warning-border); padding: 0.5rem 0.75rem; border-radius: 0.375rem; font-size: 0.875rem;">
                        @L["WriteActionBlockedNotice"]
                    </div>
                }
            </div>

            <footer class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="HandleClose" disabled="@_isSaving">
                    @L["CancelBtn"]
                </button>
                <button id="service-create-submit-btn" type="button" class="btn btn-primary" @onclick="HandleSubmit" disabled="@(!CanWrite || _isSaving)" title="@(!CanWrite ? L["WriteActionBlockedNotice"] : "")">
                    @if (_isSaving)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                        <span>@L["SavingBtn"]</span>
                    }
                    else
                    {
                        <LucideIcon Name="plus" />
                        <span>@L["CreateBtn"]</span>
                    }
                </button>
            </footer>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<CreateServiceRequest> OnCreate { get; set; }
    [Parameter] public IReadOnlyList<BuildingOptionDto> Buildings { get; set; } = [];
    [Parameter] public bool CanWrite { get; set; } = false;

    private string _name = string.Empty;
    private ServiceTypeCategory _type = ServiceTypeCategory.FixedMonthly;
    private ServiceUnitCategory _unit = ServiceUnitCategory.Room;
    private decimal _rate = 50_000m;
    private string _buildingId = "b1";
    private DateOnly _effectiveFrom;
    private DateOnly? _effectiveTo;
    private string? _description;
    private string? _note;
    private bool _isSaving;
    private UtilityErrorCode? _nameError;
    private UtilityErrorCode? _rateError;
    private UtilityErrorCode? _dateError;
    private UtilityErrorCode? _effectiveToError;
    private UtilityErrorCode? _scopeError;
    private bool _wasOpen;

    protected override void OnParametersSet()
    {
        if (!IsOpen)
        {
            _wasOpen = false;
            return;
        }

        if (_wasOpen) return;
        _wasOpen = true;
        _name = string.Empty;
        _type = ServiceTypeCategory.FixedMonthly;
        _unit = ServiceUnitCategory.Room;
        _rate = 50_000m;
        _buildingId = Buildings.FirstOrDefault(building => building.Id != "all")?.Id ?? string.Empty;
        _effectiveFrom = DateOnly.FromDateTime(DateTime.Today);
        _effectiveTo = null;
        _description = string.Empty;
        _note = string.Empty;
        _nameError = null;
        _rateError = null;
        _dateError = null;
        _effectiveToError = null;
        _scopeError = null;
    }

    private void ValidateName()
    {
        _nameError = UtilityDraftRules.ValidateCreateService(CreateRequest())
            .FirstOrDefault(issue => issue.Error == UtilityErrorCode.NameIsRequired)?.Error;
    }

    private void ValidateRate()
    {
        _rateError = UtilityDraftRules.ValidateCreateService(CreateRequest())
            .FirstOrDefault(issue => issue.Error == UtilityErrorCode.PriceMustBePositive)?.Error;
    }

    private void ValidateDate()
    {
        var issues = UtilityDraftRules.ValidateCreateService(CreateRequest());
        _dateError = issues.FirstOrDefault(issue => issue.Error == UtilityErrorCode.EffectiveFromIsRequired)?.Error;
        _effectiveToError = issues.FirstOrDefault(issue => issue.Error == UtilityErrorCode.EffectiveToMustBeAfterEffectiveFrom)?.Error;
    }

    private void ValidateScope()
    {
        _scopeError = !string.IsNullOrWhiteSpace(_buildingId)
            && _buildingId != "all"
            && Buildings.Any(building => building.Id == _buildingId && building.Id != "all")
            ? null
            : UtilityErrorCode.InvalidBuildingScope;
    }

    private async Task HandleSubmit()
    {
        ValidateName();
        ValidateRate();
        ValidateDate();
        ValidateScope();

        if (!CanWrite || _isSaving || _nameError.HasValue || _rateError.HasValue || _dateError.HasValue || _effectiveToError.HasValue || _scopeError.HasValue)
        {
            return;
        }

        _isSaving = true;
        try
        {
            await OnCreate.InvokeAsync(CreateRequest());
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task HandleClose()
    {
        if (!_isSaving)
        {
            await OnClose.InvokeAsync();
        }
    }

    private CreateServiceRequest CreateRequest() => new()
    {
        Name = _name,
        Type = _type,
        Unit = _unit,
        Rate = _rate,
        BuildingId = _buildingId,
        EffectiveFrom = _effectiveFrom,
        EffectiveTo = _effectiveTo,
        Description = _description,
        Note = _note,
    };

    private static string GetUnitResourceKey(ServiceUnitCategory unit) => unit switch
    {
        ServiceUnitCategory.Room => "UnitRoom",
        ServiceUnitCategory.Person => "UnitPerson",
        ServiceUnitCategory.Vehicle => "UnitVehicle",
        ServiceUnitCategory.Visit => "UnitVisit",
        ServiceUnitCategory.KilowattHour => "UnitKwh",
        ServiceUnitCategory.CubicMeter => "UnitM3",
        _ => "NoData",
    };
}
