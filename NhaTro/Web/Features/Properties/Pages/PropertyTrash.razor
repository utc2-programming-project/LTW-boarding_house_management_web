@page "/properties/trash"
@attribute [Authorize(Roles = Roles.ChuTro)]
@rendermode InteractiveServer
@inject PropertyPageService PageService
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject IStringLocalizer<Shared> L
@inject ILogger<PropertyTrash> Logger

<PageTitle>@L["P2PropertyTrashTitle"] · @L["AppName"]</PageTitle>

<div class="page-stack">
    <PageHeading Title="@L["P2PropertyTrashTitle"]" HelpText="@L["P2PropertyTrashSubtitle"]">
        <Actions>
            <button class="btn btn-danger" type="button" @onclick="OpenEmptyTrash">
                <LucideIcon Name="trash" />@L["EmptyTrash"]
            </button>
            <button class="btn btn-secondary" type="button" @onclick="GoToProperties">
                <LucideIcon Name="building" />@L["P2PropertiesTitle"]
            </button>
        </Actions>
    </PageHeading>

    <div class="filter-bar filter-bar--panel">
        <div class="filter-bar__row">
            <div class="filter-bar__search">
                <label class="sr-only" for="property-trash-search">@L["P2PropertyName"]</label>
                <span class="filter-bar__icon" aria-hidden="true"><LucideIcon Name="search" /></span>
                <input id="property-trash-search" type="search" class="input"
                       placeholder="@L["P2SearchProperties"]" @bind="_keyword" @bind:after="ReloadAsync" />
            </div>
            <div class="filter-bar__actions">
                <div class="filter-bar__state">
                    <label class="sr-only" for="property-trash-page-size">@L["P2RowsPerPage"]</label>
                    <select id="property-trash-page-size" class="input" value="@_pageSize" @onchange="ChangePageSize">
                        <option value="10">@string.Format(L["RowsPerPageOption"].Value, 10)</option>
                        <option value="20">@string.Format(L["RowsPerPageOption"].Value, 20)</option>
                        <option value="50">@string.Format(L["RowsPerPageOption"].Value, 50)</option>
                    </select>
                </div>
                <FilterResetButton OnClick="ClearSearchAsync" />
            </div>
        </div>
    </div>

    <DataTable @ref="_table" @key="_tableKey" TItem="PropertyTrashItem" Columns="_columns"
               ItemsProvider="LoadDeletedAsync" PageSize="_pageSize" AllowOverflow="true"
               Caption="@L["P2PropertyTrashTable"]" Labels="_tableLabels">
        <EmptyActions>
            <button class="btn btn-secondary" type="button" @onclick="GoToProperties">@L["P2PropertiesTitle"]</button>
        </EmptyActions>
    </DataTable>
</div>

<ConfirmDialog Visible="_restoreVisible" Title="@L["P2PropertyTrashRestoreTitle"]"
               Message="@L["P2PropertyTrashRestoreConfirm", _restoreProperty?.Name ?? string.Empty]"
               ConfirmText="@L["Restore"]" CancelText="@L["Cancel"]"
               BusyText="@L["P2PropertyTrashRestoring"]"
               OnConfirm="RestoreAsync" OnCancel="CancelRestore" />

<PurgeConfirmDialog Visible="_purgeVisible" Title="@L["PurgeTitle"]"
                    Message="@string.Format(L["PurgeMessage"], _purgeItem?.Name ?? string.Empty)"
                    ExpectedText="@(_purgeItem?.Name ?? string.Empty)"
                    PromptText="@string.Format(L["PurgeTypePrompt"], _purgeItem?.Name ?? string.Empty)"
                    MismatchText="@L["PurgeMismatch"]"
                    ConfirmText="@L["Purge"]" CancelText="@L["Cancel"]"
                    OnConfirm="PurgeAsync" OnCancel="CancelPurge" />

<PurgeConfirmDialog Visible="_emptyVisible" Title="@L["EmptyTrashTitle"]"
                    Message="@L["EmptyTrashMessage"]"
                    ExpectedText="@L["TrashEmptyPhrase"]"
                    PromptText="@string.Format(L["PurgeTypePrompt"], L["TrashEmptyPhrase"].Value)"
                    MismatchText="@L["PurgeMismatch"]"
                    ConfirmText="@L["EmptyTrash"]" CancelText="@L["Cancel"]"
                    OnConfirm="EmptyTrashAsync" OnCancel="CancelEmptyTrash" />

@code {
    private DataTable<PropertyTrashItem>? _table;
    private IReadOnlyList<DataTableColumn<PropertyTrashItem>> _columns = [];
    private DataTableLabels _tableLabels = new();
    private PropertyTrashItem? _restoreProperty;
    private PropertyTrashItem? _purgeItem;
    private bool _restoreVisible;
    private bool _purgeVisible;
    private bool _emptyVisible;
    private int _pageSize = 20;
    private int _tableKey;
    private string _keyword = string.Empty;

    protected override void OnInitialized()
    {
        _tableLabels = DataTableLabelLocalizer.Create(L);
        _columns = BuildColumns();
    }

    private IReadOnlyList<DataTableColumn<PropertyTrashItem>> BuildColumns()
    {
        RenderFragment<PropertyTrashItem> actions = item => @<TrashRowMenu RestoreText="@L["Restore"]" PurgeText="@L["Purge"]"
            OnRestore="() => RequestRestore(item)" OnPurge="() => RequestPurge(item)" />;

        return
        [
            new() { Key = "name", Title = L["P2PropertyName"], Value = item => item.Name },
            new() { Key = "address", Title = L["P2Address"], Value = item => string.IsNullOrWhiteSpace(item.Address) ? L["P2NotProvided"].Value : item.Address },
            new() { Key = "trashedRooms", Title = L["P2PropertyTrashRoomCount"], Value = item => item.TrashedRoomCount.ToString(CultureInfo.CurrentCulture), IsNumeric = true },
            new() { Key = "deletedAt", Title = L["P2TrashDeletedAt"], Value = item => DateFormatter.FormatDateTime(item.DeletedAt) },
            new() { Key = "actions", Title = L["P2Actions"], Template = actions }
        ];
    }

    private async Task<PagedResult<PropertyTrashItem>> LoadDeletedAsync(DataTableRequest request) =>
        await PageService.ListDeletedAsync(new PropertyFilter
        {
            Page = request.Page,
            PageSize = request.PageSize,
            Keyword = string.IsNullOrWhiteSpace(_keyword) ? null : _keyword.Trim()
        });

    private Task ClearSearchAsync()
    {
        _keyword = string.Empty;
        return ReloadAsync();
    }

    private Task ReloadAsync()
    {
        // Tạo lại bảng để tìm kiếm luôn bắt đầu từ trang 1 (DataTable giữ trang nội bộ).
        _tableKey++;
        return Task.CompletedTask;
    }

    private Task ChangePageSize(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value) && value is 10 or 20 or 50)
        {
            _pageSize = value;
            _tableKey++;
        }

        return Task.CompletedTask;
    }

    private void RequestRestore(PropertyTrashItem item)
    {
        _restoreProperty = item;
        _restoreVisible = true;
    }

    private void CancelRestore()
    {
        _restoreVisible = false;
        _restoreProperty = null;
    }

    private async Task RestoreAsync()
    {
        if (_restoreProperty is null)
        {
            CancelRestore();
            return;
        }

        try
        {
            var result = await PageService.RestoreAsync(_restoreProperty.Id);
            if (result.Succeeded)
            {
                Toasts.Success(L["P2PropertyTrashRestored"]);
                CancelRestore();
                if (_table is not null)
                {
                    await _table.ReloadAsync();
                }

                return;
            }

            Toasts.Error(result.ErrorCode switch
            {
                PropertyErrorCodes.Forbidden => L["P2Forbidden"],
                PropertyErrorCodes.PropertyNotFound => L["P2PropertyNotFound"],
                _ => L["P2PropertyTrashRestoreFailed"]
            });
            CancelRestore();
        }
        catch (UnauthorizedAccessException)
        {
            Toasts.Error(L["P2Forbidden"]);
            CancelRestore();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "P2 property restore failed");
            Toasts.Error(L["P2PropertyTrashRestoreFailed"]);
            CancelRestore();
        }
    }

    private void RequestPurge(PropertyTrashItem item)
    {
        _purgeItem = item;
        _purgeVisible = true;
    }

    private void CancelPurge()
    {
        _purgeVisible = false;
        _purgeItem = null;
    }

    private void OpenEmptyTrash() => _emptyVisible = true;

    private void CancelEmptyTrash() => _emptyVisible = false;

    private async Task PurgeAsync()
    {
        if (_purgeItem is null)
        {
            CancelPurge();
            return;
        }

        var result = await PageService.PurgeAsync(_purgeItem.Id);
        CancelPurge();
        if (!result.Succeeded)
        {
            Toasts.Error(result.ErrorCode == PropertyErrorCodes.PropertyHasDependencies
                ? L["PurgeHasDependencies"]
                : L["PurgeFailed"]);
            return;
        }

        Toasts.Success(L["PurgeSuccess"]);
        if (_table is not null) await _table.ReloadAsync();
    }

    private async Task EmptyTrashAsync()
    {
        var summary = await PageService.PurgeAllAsync();
        CancelEmptyTrash();
        if (summary.Purged == 0 && summary.Skipped == 0)
        {
            Toasts.Success(L["EmptyTrashNothing"]);
        }
        else
        {
            Toasts.Success(string.Format(L["EmptyTrashSuccess"], summary.Purged, summary.Skipped));
        }

        if (_table is not null) await _table.ReloadAsync();
    }

    private void GoToProperties() => Navigation.NavigateTo("/properties");
}
