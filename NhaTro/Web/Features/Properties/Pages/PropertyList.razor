@page "/properties"
@attribute [Authorize(Roles = Roles.ChuTro + "," + Roles.QuanLy)]
@rendermode InteractiveServer
@inject PropertyPageService PageService
@inject PropertySetupDraftStore DraftStore
@inject P2CallerProvider CallerProvider
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject IStringLocalizer<Shared> L
@inject ILogger<PropertyList> Logger

<PageTitle>@L["P2PropertiesTitle"] · @L["AppName"]</PageTitle>

<div class="p2-page">
    <PageHeading Title="@L["P2PropertiesTitle"]" HelpText="@L["P2PropertiesSubtitle"]">
        <Actions>
            @if (_isOwner)
            {
                <div class="p2-page-actions">
                    <a class="btn btn-secondary" href="/properties/trash">
                        <LucideIcon Name="trash" />@L["P2PropertyTrashOpen"]
                    </a>
                    <button class="btn btn-primary" type="button" @onclick="OpenCreate">
                        <LucideIcon Name="plus" />@L["P2AddProperty"]
                    </button>
                </div>
            }
        </Actions>
    </PageHeading>

    @if (_draft is not null)
    {
        <section class="p2-alert warning setup-draft-banner" role="status">
            <div>
                <strong>@L["P2SetupDraftBannerTitle"]</strong>
                <p>@L["P2SetupDraftBannerBody", string.IsNullOrWhiteSpace(_draft.Name) ? L["P2SetupDraftUnnamed"].Value : _draft.Name]</p>
            </div>
            <div class="setup-draft-actions">
                <button class="btn btn-primary" type="button" @onclick="ResumeDraft">@L["P2SetupDraftResume"]</button>
                <button class="btn btn-secondary" type="button" @onclick="DiscardDraftAsync">@L["P2SetupDraftDiscard"]</button>
            </div>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(_pageError))
    {
        <div class="p2-alert error" role="alert">
            <span>@_pageError</span>
            <button class="btn btn-secondary" type="button" @onclick="InitializeAsync">@L["Retry"]</button>
        </div>
    }
    else if (_ready)
    {
        @if (_summary is not null)
        {
            <section class="stat-grid" aria-label="@L["P2PropertyStatSummary"]">
                <article class="stat-card">
                    <div class="stat-card__top">
                        <span class="stat-label">
                            @L["P2PropertyStatTotal"]
                            <button type="button" class="stat-help" data-tip="@L["P2PropertyStatTotalHint"]" aria-label="@L["P2PropertyStatTotalHint"]">?</button>
                        </span>
                        <span class="stat-icon stat-icon--accent"><LucideIcon Name="building" /></span>
                    </div>
                    <div class="stat-value">@_summary.Total <small>@L["P2PropertyStatUnit"]</small></div>
                </article>
                <article class="stat-card">
                    <div class="stat-card__top">
                        <span class="stat-label">@L["P2Active"]</span>
                        <span class="stat-icon stat-icon--success"><LucideIcon Name="circle-check" /></span>
                    </div>
                    <div class="stat-value">@_summary.Active <small>@L["P2PropertyStatUnit"]</small></div>
                </article>
                <article class="stat-card">
                    <div class="stat-card__top">
                        <span class="stat-label">@L["P2Inactive"]</span>
                        <span class="stat-icon stat-icon--neutral"><LucideIcon Name="pause-circle" /></span>
                    </div>
                    <div class="stat-value">@_summary.Inactive <small>@L["P2PropertyStatUnit"]</small></div>
                </article>
                <article class="stat-card">
                    <div class="stat-card__top">
                        <span class="stat-label">
                            @L["P2TotalRooms"]
                            <button type="button" class="stat-help" data-tip="@L["P2PropertyStatRoomsHint"]" aria-label="@L["P2PropertyStatRoomsHint"]">?</button>
                        </span>
                        <span class="stat-icon stat-icon--info"><LucideIcon Name="door" /></span>
                    </div>
                    <div class="stat-value">@_summary.Rooms <small>@L["P2RoomUnit"]</small></div>
                </article>
            </section>
        }

        <section aria-label="@L["P2PropertyFilters"]">
            <form class="filter-bar filter-bar--panel" novalidate @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault>
                <div class="filter-bar__row">
                    <div class="filter-bar__search">
                        <label class="sr-only" for="property-keyword">@L["P2SearchProperties"]</label>
                        <span class="filter-bar__icon" aria-hidden="true"><LucideIcon Name="search" /></span>
                        <input id="property-keyword" class="input" type="search" maxlength="200" autocomplete="off"
                               placeholder="@L["P2SearchProperties"]" @bind="_keyword" @bind:event="oninput"
                               @bind:after="ApplyFiltersAsync" />
                    </div>
                    <div class="filter-bar__field filter-bar__select">
                        <label class="sr-only" for="property-active">@L["P2Activity"]</label>
                        <select id="property-active" class="input" @bind="_activeFilter" @bind:after="ApplyFiltersAsync">
                            <option value="">@L["P2AllActivity"]</option>
                            <option value="true">@L["P2Active"]</option>
                            <option value="false">@L["P2Inactive"]</option>
                        </select>
                    </div>
                    <div class="filter-bar__field filter-bar__select">
                        <label class="sr-only" for="property-sort">@L["P2SortBy"]</label>
                        <select id="property-sort" class="input" @bind="_sortFilter" @bind:after="ApplyFiltersAsync">
                            <option value="name">@L["P2SortName"]</option>
                            <option value="newest">@L["P2SortNewest"]</option>
                            <option value="oldest">@L["P2SortOldest"]</option>
                            <option value="roomCountDesc">@L["P2SortRoomCountDesc"]</option>
                            <option value="roomCountAsc">@L["P2SortRoomCountAsc"]</option>
                        </select>
                    </div>
                    <div class="filter-bar__actions">
                        <div class="filter-bar__state">
                            <label class="sr-only" for="property-page-size">@L["P2RowsPerPage"]</label>
                            <select id="property-page-size" class="input" value="@_pageSize" @onchange="ChangePageSize">
                                <option value="10">@string.Format(L["RowsPerPageOption"].Value, 10)</option>
                                <option value="20">@string.Format(L["RowsPerPageOption"].Value, 20)</option>
                                <option value="50">@string.Format(L["RowsPerPageOption"].Value, 50)</option>
                            </select>
                        </div>
                        <FilterAdvancedToggle @bind-Expanded="_showAdvanced" ActiveCount="AdvancedFilterCount" PanelId="property-advanced-panel" />
                        <button class="btn btn-secondary filter-bar__reset" type="button" @onclick="ResetFiltersAsync">
                            <LucideIcon Name="refresh-cw" /> @L["P2ResetFilters"]
                        </button>
                    </div>
                </div>
                <div class="filter-bar__advanced" id="property-advanced-panel" hidden="@(!_showAdvanced)">
                    <div class="filter-bar__stack">
                        <label for="property-min-rooms">@L["P2MinRooms"]</label>
                        <input id="property-min-rooms" class="input" type="number" min="0" inputmode="numeric"
                               placeholder="@L["P2MinRoomsPlaceholder"]" @bind="_minRoomCount" />
                    </div>
                    <div class="filter-bar__stack">
                        <label for="property-max-rooms">@L["P2MaxRooms"]</label>
                        <input id="property-max-rooms" class="input" type="number" min="0" inputmode="numeric"
                               placeholder="@L["P2MaxRoomsPlaceholder"]" @bind="_maxRoomCount" />
                    </div>
                    <button class="btn btn-primary filter-bar__submit" type="submit">@L["P2ApplyFilters"]</button>
                </div>
            </form>
        </section>

        <DataTable @key="_tableKey" @ref="_table" TItem="PropertyListItem" Columns="_columns"
                   ItemsProvider="LoadPropertiesAsync" PageSize="_pageSize"
                   Caption="@L["P2PropertiesTable"]" Labels="_tableLabels"
                   HasActiveFilters="_hasActiveFilters" OnClearFilters="ClearFiltersFromTableAsync">
            <EmptyActions>
                @if (_isOwner)
                {
                    <button class="btn btn-primary" type="button" @onclick="OpenCreate">@L["P2AddProperty"]</button>
                }
            </EmptyActions>
        </DataTable>
    }
</div>

@if (_formVisible)
{
    <PropertyFormDialog @key="_formKey" Visible="true" PropertyId="_formPropertyId"
                        OnClose="CloseForm" OnSaved="OnPropertySavedAsync" />
}
@if (_selectedProperty is not null)
{
    <PropertyDetailsDialog Property="_selectedProperty" IsOwner="_isOwner"
                           OnClose="CloseDetails" OnEdit="EditSelected" OnViewRooms="ViewRooms"
                           OnContinueSetup="ContinueSetup" />
}
<ConfirmDialog Visible="_deleteVisible" Title="@L["P2DeletePropertyTitle"]"
               Message="@L["P2DeletePropertyConfirm", _deleteProperty?.Name ?? string.Empty]"
               ConfirmText="@L["P2MoveToTrash"]" CancelText="@L["Cancel"]" BusyText="@L["Deleting"]"
               Danger="true" OnConfirm="DeletePropertyAsync" OnCancel="CancelDelete" />

@code {
    private bool _helpPinned;
    private bool _helpActive;
    private bool _helpDismissed;
    private bool HelpVisible => !_helpDismissed && (_helpPinned || _helpActive);

    private void ShowHelp() { _helpActive = true; _helpDismissed = false; }
    private void LeaveHelp() => _helpActive = false;
    private void CloseHelp() { _helpActive = false; _helpPinned = false; _helpDismissed = false; }
    private void ToggleHelp() { _helpPinned = !_helpPinned; _helpDismissed = !_helpPinned; }
    private void HoldHelp(PointerEventArgs args)
    {
        if (args.PointerType == "touch") ShowHelp();
    }
    private void HandleHelpKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") { _helpPinned = false; _helpDismissed = true; }
    }

    private DataTable<PropertyListItem>? _table;
    private IReadOnlyList<DataTableColumn<PropertyListItem>> _columns = [];
    private DataTableLabels _tableLabels = new();
    private PropertyListItem? _selectedProperty;
    private string _keyword = string.Empty;
    private string _activeFilter = string.Empty;
    private string _minRoomCount = string.Empty;
    private string _maxRoomCount = string.Empty;
    private string _sortFilter = "name";
    private string? _pageError;
    private int _tableKey;
    private int _formKey;
    private int _pageSize = 20;
    private int? _formPropertyId;
    private bool _formVisible;
    private bool _deleteVisible;
    private PropertyListItem? _deleteProperty;
    private bool _ready;
    private bool _isOwner;
    private bool _hasActiveFilters;
    private bool _showAdvanced;
    private PropertySetupDraft? _draft;
    private PropertyListSummary? _summary;
    private string? _userId;

    private int AdvancedFilterCount =>
        (string.IsNullOrWhiteSpace(_minRoomCount) ? 0 : 1)
        + (string.IsNullOrWhiteSpace(_maxRoomCount) ? 0 : 1);

    protected override async Task OnInitializedAsync()
    {
        _tableLabels = DataTableLabelLocalizer.Create(L);
        _columns = BuildColumns();
        await InitializeAsync();
    }

    private async Task InitializeAsync()
    {
        _pageError = null;
        try
        {
            var role = await PageService.GetCurrentRoleAsync();
            if (role is not Roles.ChuTro and not Roles.QuanLy)
            {
                _pageError = L["P2Forbidden"];
                _ready = false;
                return;
            }
            _isOwner = role == Roles.ChuTro;
            _ready = true;

            try
            {
                _summary = await PageService.GetSummaryAsync();
            }
            catch (Exception ex)
            {
                // Dải KPI chỉ là phụ trợ: lỗi tải số liệu không chặn bảng danh sách.
                Logger.LogError(ex, "P2 property summary failed");
            }
        }
        catch (Exception ex)
        {
            _ready = false;
            _pageError = L["P2LoadFailed"];
            Logger.LogError(ex, "P2 property page initialization failed");
        }
    }

    private IReadOnlyList<DataTableColumn<PropertyListItem>> BuildColumns()
    {
        RenderFragment<PropertyListItem> name = item => @<button class="p2-link-button" type="button" @onclick="() => OpenDetails(item)">@item.Name</button>;
        RenderFragment<PropertyListItem> activity = item => @<StatusBadge Text="@(item.IsActive ? L["P2Active"].Value : L["P2Inactive"].Value)" Tone="@(item.IsActive ? BadgeTone.Success : BadgeTone.Neutral)" />;
        RenderFragment<PropertyListItem> actions = item => @<div class="p2-row-actions">
            <button class="icon-button" type="button" aria-label="@L["P2ViewDetails"]" title="@L["P2ViewDetails"]" @onclick="() => OpenDetails(item)"><LucideIcon Name="eye" /></button>
            @if (_isOwner)
            {
                <button class="icon-button" type="button" aria-label="@L["P2Edit"]" title="@L["P2Edit"]" @onclick="() => OpenEdit(item.Id)"><LucideIcon Name="edit" /></button>
                <button class="icon-button danger-action" type="button" aria-label="@L["P2DeleteProperty"]" title="@L["P2DeleteProperty"]" @onclick="() => RequestDelete(item)"><LucideIcon Name="trash" /></button>
            }
        </div>;

        return
        [
            new() { Key = "name", Title = L["P2PropertyName"], Template = name, Sortable = false },
            new() { Key = "address", Title = L["P2Address"], Value = item => string.IsNullOrWhiteSpace(item.Address) ? L["P2NotProvided"].Value : item.Address },
            new() { Key = "roomCount", Title = L["P2RoomCount"], Value = item => item.RoomCount.ToString(CultureInfo.CurrentCulture), IsNumeric = true },
            new() { Key = "activity", Title = L["P2Activity"], Template = activity },
            new() { Key = "actions", Title = L["P2Actions"], Template = actions }
        ];
    }

    private async Task<PagedResult<PropertyListItem>> LoadPropertiesAsync(DataTableRequest request)
    {
        var active = bool.TryParse(_activeFilter, out var parsed) ? parsed : (bool?)null;
        var minRooms = int.TryParse(_minRoomCount, out var min) && min >= 0 ? min : (int?)null;
        var maxRooms = int.TryParse(_maxRoomCount, out var max) && max >= 0 ? max : (int?)null;
        return await PageService.ListAsync(new PropertyFilter
        {
            Keyword = _keyword,
            IsActive = active,
            MinRoomCount = minRooms,
            MaxRoomCount = maxRooms,
            SortBy = _sortFilter,
            Page = request.Page,
            PageSize = request.PageSize
        });
    }

    private Task ApplyFiltersAsync()
    {
        _hasActiveFilters = !string.IsNullOrWhiteSpace(_keyword)
            || !string.IsNullOrWhiteSpace(_activeFilter)
            || !string.IsNullOrWhiteSpace(_minRoomCount)
            || !string.IsNullOrWhiteSpace(_maxRoomCount)
            || _sortFilter != "name";
        _tableKey++;
        return Task.CompletedTask;
    }

    private Task ResetFiltersAsync()
    {
        _keyword = string.Empty;
        _activeFilter = string.Empty;
        _minRoomCount = string.Empty;
        _maxRoomCount = string.Empty;
        _sortFilter = "name";
        _showAdvanced = false;
        _hasActiveFilters = false;
        _tableKey++;
        return Task.CompletedTask;
    }

    private Task ClearFiltersFromTableAsync()
    {
        _keyword = string.Empty;
        _activeFilter = string.Empty;
        _minRoomCount = string.Empty;
        _maxRoomCount = string.Empty;
        _sortFilter = "name";
        _showAdvanced = false;
        _hasActiveFilters = false;
        return Task.CompletedTask;
    }

    private Task ChangePageSize(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value) && value is 10 or 20 or 50)
        {
            _pageSize = value;
            _tableKey++;
        }
        return Task.CompletedTask;
    }

    private void OpenCreate() => Navigation.NavigateTo("/properties/new");
    private void OpenEdit(int id) { _formPropertyId = id; _formKey++; _formVisible = true; }
    private void OpenDetails(PropertyListItem item) => _selectedProperty = item;
    private void CloseForm() => _formVisible = false;
    private void CloseDetails() => _selectedProperty = null;
    private void EditSelected() { if (_selectedProperty is not null) OpenEdit(_selectedProperty.Id); _selectedProperty = null; }
    private void ViewRooms(int propertyId) => Navigation.NavigateTo($"/rooms?propertyId={propertyId}");
    private void ContinueSetup(int propertyId) => Navigation.NavigateTo($"/properties/{propertyId}/setup");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_isOwner) return;

        try
        {
            var caller = await CallerProvider.GetCallerAsync();
            _userId = caller.UserId;
            _draft = await DraftStore.LoadAsync(caller.UserId);
            if (_draft is not null) StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "PLAN-010: không đọc được bản nháp thiết lập nhà trọ");
        }
    }

    private void ResumeDraft()
    {
        if (_draft?.PropertyId is int id)
        {
            Navigation.NavigateTo($"/properties/{id}/setup");
            return;
        }

        Navigation.NavigateTo("/properties/new");
    }

    private async Task DiscardDraftAsync()
    {
        if (!string.IsNullOrWhiteSpace(_userId))
        {
            await DraftStore.ClearAsync(_userId);
        }

        _draft = null;
    }

    private async Task OnPropertySavedAsync()
    {
        _formVisible = false;
        Toasts.Success(L["P2SaveSucceeded"]);
        if (_table is not null) await _table.ReloadAsync();
    }

    private void RequestDelete(PropertyListItem item)
    {
        if (!_isOwner) return;
        _deleteProperty = item;
        _deleteVisible = true;
        _selectedProperty = null;
    }

    private void CancelDelete()
    {
        _deleteVisible = false;
        _deleteProperty = null;
    }

    private async Task DeletePropertyAsync()
    {
        if (!_isOwner || _deleteProperty is null)
        {
            CancelDelete();
            return;
        }

        try
        {
            var result = await PageService.DeleteAsync(_deleteProperty.Id);
            if (result.Succeeded)
            {
                Toasts.Success(L["P2PropertyDeleted"]);
                CancelDelete();
                if (_table is not null) await _table.ReloadAsync();
                return;
            }

            Toasts.Error(result.ErrorCode switch
            {
                PropertyErrorCodes.PropertyHasRooms => L["P2PropertyHasRooms"],
                PropertyErrorCodes.Forbidden => L["P2Forbidden"],
                PropertyErrorCodes.PropertyNotFound => L["P2PropertyNotFound"],
                _ => L["P2SaveFailed"]
            });
            CancelDelete();
        }
        catch (UnauthorizedAccessException)
        {
            Toasts.Error(L["P2Forbidden"]);
            CancelDelete();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "P2 property delete failed");
            Toasts.Error(L["P2SaveFailed"]);
            CancelDelete();
        }
    }
}
