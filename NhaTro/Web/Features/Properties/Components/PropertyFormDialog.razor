@inject PropertyPageService PageService
@inject IStringLocalizer<Shared> L
@inject ILogger<PropertyFormDialog> Logger

<FeatureDialog Visible="Visible" Title="@(IsEdit ? L["P2EditProperty"].Value : L["P2AddProperty"].Value)"
               CloseLabel="@L["Close"]" Busy="_saving" OnClose="OnClose" CssClass="property-form-dialog">
    <EditForm Model="_model" OnSubmit="HandleSubmitAsync">
        <div class="p2-form-body">
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="p2-alert error" role="alert">
                    <span>@_error</span>
                    @if (_loadFailed)
                    {
                        <button class="btn btn-secondary" type="button" @onclick="RetryLoadAsync">@L["Retry"]</button>
                    }
                </div>
            }
            @if (_loading)
            {
                <div class="p2-inline-loading" role="status" aria-live="polite">@L["P2Loading"]</div>
            }
            else
            {
                <div class="p2-form-grid">
                    <div class="p2-field full">
                        <label for="property-name">@L["P2PropertyName"] <span class="required" aria-hidden="true">*</span></label>
                        <InputText id="property-name" @bind-Value="_model.Name" maxlength="200" autocomplete="organization" aria-describedby="property-name-error" />
                        <span class="p2-field-error" id="property-name-error" aria-live="polite">@ErrorFor(nameof(_model.Name))</span>
                    </div>
                    <div class="p2-field full">
                        <label for="property-address">@L["P2Address"]</label>
                        <InputTextArea id="property-address" @bind-Value="_model.Address" maxlength="500" rows="3" aria-describedby="property-address-error" />
                        <span class="p2-field-error" id="property-address-error" aria-live="polite">@ErrorFor(nameof(_model.Address))</span>
                    </div>
                    <label class="p2-check-field" for="property-is-active">
                        <InputCheckbox id="property-is-active" @bind-Value="_model.IsActive" />
                        <span>@L["P2Active"]</span>
                    </label>
                </div>
            }
        </div>
        <footer class="p2-form-footer">
            <button class="btn btn-secondary" type="button" disabled="@_saving" @onclick="OnClose">@L["Cancel"]</button>
            <button class="btn btn-primary" type="submit" disabled="@(_loading || _saving)" aria-busy="@(_saving ? "true" : null)">
                @(_saving ? L["P2Saving"] : L["Save"])
            </button>
        </footer>
    </EditForm>
</FeatureDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public int? PropertyId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private PropertySave _model = new();
    private readonly Dictionary<string, string> _errors = new();
    private bool _loading;
    private bool _saving;
    private bool _loadFailed;
    private string? _error;
    private bool IsEdit => PropertyId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        if (PropertyId is not int id) return;
        _loading = true;
        try
        {
            var result = await PageService.GetAsync(id);
            if (!result.Succeeded || result.Property is null)
            {
                _error = MapError(result.ErrorCode);
                _loadFailed = true;
                return;
            }

            _model = new PropertySave
            {
                Name = result.Property.Name,
                Address = result.Property.Address,
                IsActive = result.Property.IsActive
            };
        }
        catch (Exception ex)
        {
            _error = L["P2LoadFailed"];
            _loadFailed = true;
            Logger.LogError(ex, "P2 property detail load failed");
        }
        finally
        {
            _loading = false;
        }
    }

    private string? ErrorFor(string field) => _errors.GetValueOrDefault(field);

    private async Task HandleSubmitAsync(EditContext _)
    {
        _errors.Clear();
        _error = null;
        _model.Normalize();
        if (string.IsNullOrWhiteSpace(_model.Name)) _errors[nameof(_model.Name)] = L["P2ValidationPropertyNameRequired"];
        else if (_model.Name.Length > 200) _errors[nameof(_model.Name)] = L["P2ValidationNameLength"];
        if ((_model.Address?.Length ?? 0) > 500) _errors[nameof(_model.Address)] = L["P2ValidationAddressLength"];
        if (_errors.Count > 0) return;

        _saving = true;
        try
        {
            var result = IsEdit
                ? await PageService.UpdateAsync(PropertyId!.Value, _model)
                : await PageService.CreateAsync(_model);

            if (result.Succeeded)
            {
                await OnSaved.InvokeAsync();
                return;
            }

            _error = MapError(result.ErrorCode);
            _loadFailed = false;
        }
        catch (UnauthorizedAccessException)
        {
            _error = L["P2Forbidden"];
            _loadFailed = false;
        }
        catch (Exception ex)
        {
            _error = L["P2SaveFailed"];
            _loadFailed = false;
            Logger.LogError(ex, "P2 property save failed");
        }
        finally
        {
            _saving = false;
        }
    }

    private string MapError(string? code) => code switch
    {
        PropertyErrorCodes.InvalidRequest => L["P2ValidationInvalidRequest"],
        PropertyErrorCodes.Forbidden => L["P2Forbidden"],
        PropertyErrorCodes.PropertyNotFound => L["P2PropertyNotFound"],
        _ => L["P2SaveFailed"]
    };

    private async Task RetryLoadAsync()
    {
        if (PropertyId is not int id) return;
        _error = null;
        _loadFailed = false;
        _loading = true;
        try
        {
            var result = await PageService.GetAsync(id);
            if (!result.Succeeded || result.Property is null)
            {
                _error = MapError(result.ErrorCode);
                _loadFailed = true;
                return;
            }
            _model = new PropertySave { Name = result.Property.Name, Address = result.Property.Address, IsActive = result.Property.IsActive };
        }
        catch (Exception ex)
        {
            _error = L["P2LoadFailed"];
            _loadFailed = true;
            Logger.LogError(ex, "P2 property detail retry failed");
        }
        finally { _loading = false; }
    }
}
