@inject PropertyPageService PageService
@inject IStringLocalizer<Shared> L
@inject ILogger<PropertyFormDialog> Logger

<FeatureDialog @ref="_featureDialog" Visible="Visible" Title="@(IsEdit ? L["P2EditProperty"].Value : L["P2AddProperty"].Value)"
               CloseLabel="@L["Close"]" Busy="_saving" OnClose="HandleDialogClose" CssClass="property-form-dialog">
    <EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync">
        <div class="p2-form-body">
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="p2-alert error" role="alert">
                    <span>@_error</span>
                    @if (_loadFailed)
                    {
                        <button class="btn btn-secondary" type="button" @onclick="RetryLoadAsync">@L["Retry"]</button>
                    }
                </div>
            }
            @if (_loading)
            {
                <div class="p2-inline-loading" role="status" aria-live="polite">@L["P2Loading"]</div>
            }
            else if (!_loadFailed)
            {
                <div class="p2-form-grid">
                    <div class="p2-field full">
                        <label for="property-name">@L["P2PropertyName"] <span class="required" aria-hidden="true">*</span></label>
                        <InputText id="property-name" @bind-Value="_model.Name" maxlength="200" autocomplete="organization" aria-describedby="property-name-error" aria-invalid="@(_editContext.HasError(() => _model.Name) ? "true" : "false")" />
                        <span class="p2-field-error" id="property-name-error" aria-live="polite">@ErrorFor(nameof(_model.Name))</span>
                    </div>
                    <div class="p2-field full">
                        <label for="property-address-street">@L["P2Address"]</label>
                        <AddressInput Id="property-address" @bind-Value="_model.Address"
                                      MaxLength="500"
                                      AriaDescribedBy="property-address-error"
                                      AriaInvalid="@_editContext.HasError(() => _model.Address)" />
                        <span class="p2-field-error" id="property-address-error" aria-live="polite">@ErrorFor(nameof(_model.Address))</span>
                    </div>
                    <label class="p2-check-field" for="property-is-active">
                        <InputCheckbox id="property-is-active" @bind-Value="_model.IsActive" />
                        <span>@L["P2Active"]</span>
                    </label>
                </div>
            }
        </div>
        @if (!_loadFailed)
        {
            <footer class="p2-form-footer">
                <button class="btn btn-secondary" type="button" disabled="@_saving" @onclick="CloseDialogAsync">@L["Cancel"]</button>
                <button class="btn btn-primary" type="submit" disabled="@(_loading || _loadFailed || _saving)" aria-busy="@(_saving ? "true" : null)">
                    @(_saving ? L["P2Saving"] : L["Save"])
                </button>
            </footer>
        }
    </EditForm>
</FeatureDialog>

<FeatureDialog Visible="_discardVisible" Title="@L["P2DiscardTitle"]"
               CloseLabel="@L["Close"]" OnClose="CancelDiscard" CssClass="room-confirm-dialog">
    <div class="room-confirm">
        <p>@L["P2DiscardBody"]</p>
        <div class="room-confirm-actions">
            <button class="btn btn-secondary" type="button" autofocus @onclick="CancelDiscard">@L["P2DiscardKeep"]</button>
            <button class="btn btn-danger" type="button" @onclick="DiscardChangesAsync">@L["P2DiscardConfirm"]</button>
        </div>
    </div>
</FeatureDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public int? PropertyId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private FeatureDialog? _featureDialog;
    private PropertySave _model = new();
    private EditContext _editContext = default!;
    private ValidationMessageStore _messages = default!;
    private bool _loading;
    private bool _saving;
    private bool _loadFailed;
    private bool _discardVisible;
    private string? _error;
    private bool IsEdit => PropertyId.HasValue;

    protected override void OnInitialized() => ResetValidation();
    private void ResetValidation()
    {
        _editContext = new EditContext(_model);
        _messages = new ValidationMessageStore(_editContext);
        _editContext.OnFieldChanged += (_, args) =>
        {
            _messages.Clear(args.FieldIdentifier);
            _editContext.NotifyValidationStateChanged();
        };
    }

    protected override async Task OnInitializedAsync()
    {
        if (PropertyId is not int id) return;
        _loading = true;
        try
        {
            var result = await PageService.GetAsync(id);
            if (!result.Succeeded || result.Property is null)
            {
                _error = MapError(result.ErrorCode);
                _loadFailed = true;
                return;
            }

            _model = new PropertySave
            {
                Name = result.Property.Name,
                Address = result.Property.Address,
                IsActive = result.Property.IsActive
            };
            ResetValidation();
        }
        catch (Exception ex)
        {
            _error = L["P2LoadFailed"];
            _loadFailed = true;
            Logger.LogError(ex, "P2 property detail load failed");
        }
        finally
        {
            _loading = false;
        }
    }

    private string? ErrorFor(string field) => _messages[new FieldIdentifier(_model, field)].FirstOrDefault();

    private async Task HandleSubmitAsync(EditContext _)
    {
        if (_loading || _loadFailed || _saving) return;

        _messages.Clear();
        _editContext.NotifyValidationStateChanged();
        _error = null;
        _model.Normalize();
        if (string.IsNullOrWhiteSpace(_model.Name)) AddError(nameof(_model.Name), L["P2ValidationPropertyNameRequired"]);
        else if (_model.Name.Length > 200) AddError(nameof(_model.Name), L["P2ValidationNameLength"]);
        if ((_model.Address?.Length ?? 0) > 500) AddError(nameof(_model.Address), L["P2ValidationAddressLength"]);
        _editContext.NotifyValidationStateChanged();
        if (_editContext.GetValidationMessages().Any()) return;

        _saving = true;
        try
        {
            var result = IsEdit
                ? await PageService.UpdateAsync(PropertyId!.Value, _model)
                : await PageService.CreateAsync(_model);

            if (result.Succeeded)
            {
                if (_featureDialog is not null) await _featureDialog.CloseNativeAsync();
                await OnSaved.InvokeAsync();
                return;
            }

            _error = MapError(result.ErrorCode);
            _editContext.NotifyValidationStateChanged();
            _loadFailed = false;
        }
        catch (UnauthorizedAccessException)
        {
            _error = L["P2Forbidden"];
            _loadFailed = false;
        }
        catch (Exception ex)
        {
            _error = L["P2SaveFailed"];
            _loadFailed = false;
            Logger.LogError(ex, "P2 property save failed");
        }
        finally
        {
            _saving = false;
        }
    }

    private string MapError(string? code) => code switch
    {
        PropertyErrorCodes.InvalidRequest => L["P2ValidationInvalidRequest"],
        PropertyErrorCodes.Forbidden => L["P2Forbidden"],
        PropertyErrorCodes.PropertyNotFound => L["P2PropertyNotFound"],
        _ => L["P2SaveFailed"]
    };

    private async Task RetryLoadAsync()
    {
        if (PropertyId is not int id) return;
        _error = null;
        _loadFailed = false;
        _loading = true;
        try
        {
            var result = await PageService.GetAsync(id);
            if (!result.Succeeded || result.Property is null)
            {
                _error = MapError(result.ErrorCode);
                _loadFailed = true;
                return;
            }
            _model = new PropertySave { Name = result.Property.Name, Address = result.Property.Address, IsActive = result.Property.IsActive };
            ResetValidation();
        }
        catch (Exception ex)
        {
            _error = L["P2LoadFailed"];
            _loadFailed = true;
            Logger.LogError(ex, "P2 property detail retry failed");
        }
        finally { _loading = false; }
    }

    private void AddError(string field, string message) => _messages.Add(new FieldIdentifier(_model, field), message);

    private async Task HandleDialogClose()
    {
        if (_saving) return;

        if (_editContext.IsModified())
        {
            _discardVisible = true;
            return;
        }

        await CloseWithoutConfirmAsync();
    }

    private Task CloseDialogAsync() => HandleDialogClose();

    private async Task DiscardChangesAsync()
    {
        _discardVisible = false;
        await CloseWithoutConfirmAsync();
    }

    private Task CancelDiscard()
    {
        _discardVisible = false;
        return Task.CompletedTask;
    }

    private async Task CloseWithoutConfirmAsync()
    {
        if (_featureDialog is not null) await _featureDialog.CloseNativeAsync();
        await OnClose.InvokeAsync();
    }
}
