@page "/tenants"
@attribute [Authorize(Roles = Roles.ChuTro + "," + Roles.QuanLy)]
@rendermode InteractiveServer
@implements IDisposable
@inject IJSRuntime JS
@inject TenantPageService TenantPages
@inject ToastService Toasts
@inject IStringLocalizer<Shared> L
@using Web.Infrastructure.Time
@inject TimeProvider Clock

<PageTitle>@L["TenantsTitle"] · @L["AppName"]</PageTitle>

<section class="tenant-list-page page-stack" aria-labelledby="tenants-title">
    <PageHeading Title="@L["TenantsTitle"]" TitleId="tenants-title" HelpText="@L["TenantsSubtitle"]">
        <Actions>
            @if (_canRevealIdNumber)
            {
                <a class="btn btn-secondary" href="/tenants/trash">
                    <LucideIcon Name="trash" /> @L["TenantTrashOpen"]
                </a>
                <button type="button" class="btn btn-secondary" @onclick="ExportAsync" disabled="@_exporting">
                    @if (_exporting) { <span class="spinner" aria-hidden="true"></span> }
                    else { <LucideIcon Name="download" /> }
                    @L["TenantExport"]
                </button>
            }
            <button type="button" class="btn btn-secondary" @onclick="OpenInvite">
                <LucideIcon Name="mail" /> @L["InviteTenantButton"]
            </button>
            <button type="button" class="btn btn-secondary" @onclick="OpenQr">
                <LucideIcon Name="qr-code" /> @L["QrOpenButton"]
            </button>
            <button type="button" class="btn btn-primary" @onclick="OpenCreate">
                <LucideIcon Name="plus" /> @L["TenantAdd"]
            </button>
        </Actions>
    </PageHeading>

    @if (_summaryError)
    {
        <div class="tenant-summary-error" role="alert">
            <span>@L["TenantSummaryLoadFailed"]</span>
            <button type="button" class="btn btn-secondary btn-sm" @onclick="LoadSummaryAsync">@L["Retry"]</button>
        </div>
    }

    @if (!_summaryError && _summary is null)
    {
        <LoadingOverlay Visible="true" Text="@L["TableLoading"]" />
    }
    else if (!_summaryError)
    {
        <section class="stat-grid @(_canRevealIdNumber ? null : "stat-grid--three")" aria-label="@L["TenantSummary"]">
            <article class="stat-card">
                <div class="stat-card__top">
                    <span class="stat-label">
                        @L["TenantStatTotal"]
                        <HelpTip Text="@L["TenantAllRecordsHint"]" />
                    </span>
                    <span class="stat-icon stat-icon--accent"><LucideIcon Name="users" /></span>
                </div>
                <div class="stat-value">@SummaryValue(_summary!.TotalCount) <small>@L["TenantPeople"]</small></div>
            </article>
            <article class="stat-card">
                <div class="stat-card__top">
                    <span class="stat-label">
                        @L["TenantStatActive"]
                        <HelpTip Text="@ActiveRateTip" />
                    </span>
                    <span class="stat-icon stat-icon--success"><LucideIcon Name="user" /></span>
                </div>
                <div class="stat-value">@SummaryValue(_summary!.ActiveCount) <small>@L["TenantRecords"]</small></div>
            </article>
            @if (_canRevealIdNumber)
            {
                <article class="stat-card">
                    <div class="stat-card__top">
                        <span class="stat-label">
                            @L["TenantStatAccounts"]
                            <HelpTip Text="@AccountRateTip" />
                        </span>
                        <span class="stat-icon stat-icon--info"><LucideIcon Name="key" /></span>
                    </div>
                    <div class="stat-value">@SummaryValue(_summary!.LinkedAccountCount) <small>@L["TenantAccounts"]</small></div>
                </article>
            }
            <article class="stat-card">
                <div class="stat-card__top">
                    <span class="stat-label">
                        @L["TenantStatIdCoverage"]
                        <HelpTip Text="@L["TenantSecurityHint"]" />
                    </span>
                    <span class="stat-icon stat-icon--neutral"><LucideIcon Name="shield-check" /></span>
                </div>
                <div class="stat-value"><span class="stat-percent">@Percent(_summary!.WithIdNumberCount, _summary!.TotalCount)<small>%</small></span></div>
            </article>
        </section>
    }

    @if (_loadingDetail)
    {
        <div class="tenant-detail-loading">
            <LoadingOverlay Visible="true" Text="@L["TableLoading"]" />
        </div>
    }

    <section class="filter-bar filter-bar--panel" aria-label="@L["TenantFilters"]">
        <div class="filter-bar__row">
            <div class="filter-bar__search">
                <label class="sr-only" for="tenant-search">@L["TenantSearch"]</label>
                <span class="filter-bar__icon" aria-hidden="true"><LucideIcon Name="search" /></span>
                <input id="tenant-search" class="input" @bind="_keyword" @bind:event="oninput" @bind:after="OnKeywordChangedAsync"
                       placeholder="@L["TenantSearchHint"]" autocomplete="off" />
            </div>
            <div class="filter-bar__field filter-bar__select">
                <label class="sr-only" for="tenant-status-filter">@L["TenantStatusFilter"]</label>
                <select id="tenant-status-filter" class="input" @bind="_statusFilter" @bind:after="ResetTableAsync">
                    <option value="">@L["TenantStatusAll"]</option>
                    <option value="active">@L["TenantStatusActive"]</option>
                    <option value="inactive">@L["TenantStatusInactive"]</option>
                </select>
            </div>
            <div class="filter-bar__field filter-bar__select">
                <label class="sr-only" for="tenant-sort-filter">@L["TenantSort"]</label>
                <select id="tenant-sort-filter" class="input" @bind="_sortFilter" @bind:after="ResetTableAsync">
                    <option value="created">@L["TenantSortCreatedDesc"]</option>
                    <option value="name-asc">@L["TenantSortNameAsc"]</option>
                    <option value="name-desc">@L["TenantSortNameDesc"]</option>
                </select>
            </div>
            <div class="filter-bar__actions">
                <div class="filter-bar__state">
                    <label class="sr-only" for="tenant-page-size">@L["TenantRowsPerPage"]</label>
                    <select id="tenant-page-size" class="input" @bind="_pageSize" @bind:after="ResetTableAsync" aria-label="@L["TenantRowsPerPage"]">
                        <option value="10">@string.Format(L["RowsPerPageOption"].Value, 10)</option>
                        <option value="20">@string.Format(L["RowsPerPageOption"].Value, 20)</option>
                        <option value="50">@string.Format(L["RowsPerPageOption"].Value, 50)</option>
                    </select>
                </div>
                <FilterAdvancedToggle @bind-Expanded="_showAdvanced" ActiveCount="AdvancedFilterCount" PanelId="tenant-advanced-panel" />
                <FilterResetButton OnClick="ResetFiltersAsync" />
            </div>
        </div>
        <div class="filter-bar__advanced" id="tenant-advanced-panel" hidden="@(!_showAdvanced)">
            @if (_canRevealIdNumber)
            {
                <div class="filter-bar__field filter-bar__select">
                    <label class="sr-only" for="tenant-account-filter">@L["TenantAccountFilter"]</label>
                    <select id="tenant-account-filter" class="input" @bind="_accountFilter" @bind:after="ResetTableAsync">
                        <option value="">@L["TenantAccountAll"]</option>
                        <option value="linked">@L["TenantAccountYes"]</option>
                        <option value="unlinked">@L["TenantAccountNo"]</option>
                    </select>
                </div>
            }
            <div class="filter-bar__field filter-bar__select">
                <label class="sr-only" for="tenant-rental-filter">@L["TenantRentalFilter"]</label>
                <select id="tenant-rental-filter" class="input" @bind="_rentalFilter" @bind:after="ResetTableAsync">
                    <option value="">@L["TenantRentalAll"]</option>
                    <option value="renting">@L["TenantRentalActive"]</option>
                    <option value="not-renting">@L["TenantRentalNone"]</option>
                </select>
            </div>
        </div>
    </section>

    <DataTable @key="_tableKey" @ref="_table" TItem="TenantListItemDto" Columns="_columns"
               ItemsProvider="LoadTenantsAsync" PageSize="_pageSize" Caption="@L["TenantsTitle"]"
               HasActiveFilters="HasActiveTenantFilters" OnClearFilters="ClearTenantFiltersAsync"
               Labels="DataTableLabelLocalizer.Create(L)">
        <EmptyActions>
            <button type="button" class="btn btn-primary" @onclick="OpenCreate">
                <LucideIcon Name="plus" /> @L["TenantAdd"]
            </button>
        </EmptyActions>
    </DataTable>
</section>

<TenantDetailsDialog Visible="_showDetails" Tenant="_selectedTenant" CanManage="true"
                     CanViewAccount="_canRevealIdNumber"
                     OnClose="CloseDetailsAsync" OnEdit="OpenEditAsync" OnSetActive="RequestStatusChangeAsync"
                     OnDelete="RequestDeleteAsync"
                     OnLinkAccount="OpenLinkAccountAsync" OnUnlinkAccount="RequestUnlinkAccountAsync" />
<TenantFormDialog Visible="_showForm" Tenant="_formTenant" CanManage="true"
                   CanRevealIdNumber="_canRevealIdNumber" OnClose="CloseFormAsync" OnSaved="RefreshAsync" />
<TenantAccountLinkDialog Visible="_showLinkAccount" Tenant="_selectedTenant"
                          OnClose="CloseLinkAccountAsync" OnLinked="RefreshDetailsAsync" />
<TenantInviteDialog Visible="_showInvite" OnClose="CloseInvite" OnSent="RefreshAsync" />
<TenantQrDialog Visible="_showQr" OnClose="CloseQr" />

<ConfirmDialog Visible="_showStatusConfirm"
               Title="@(_nextIsActive ? L["TenantActivateTitle"] : L["TenantDeactivateTitle"])"
               Message="@(_nextIsActive ? L["TenantActivate"] : L["TenantDeactivate"])"
               ConfirmText="@L["Confirm"]" CancelText="@L["Cancel"]" Danger="@(!_nextIsActive)"
               OnConfirm="ConfirmStatusChangeAsync" OnCancel="CancelStatusChangeAsync" />
<ConfirmDialog Visible="_showUnlinkConfirm" Title="@L["TenantUnlinkTitle"]"
               Message="@L["TenantUnlinkMessage"]" ConfirmText="@L["TenantUnlinkAccount"]"
               CancelText="@L["Cancel"]" Danger="true"
               OnConfirm="ConfirmUnlinkAccountAsync" OnCancel="CancelUnlinkAccountAsync" />
<ConfirmDialog Visible="_showDeleteConfirm" Title="@L["TenantDeleteTitle"]"
               Message="@L["TenantDeleteMessage"]" ConfirmText="@L["TenantDelete"]"
               CancelText="@L["Cancel"]" BusyText="@L["TenantDeleting"]" Danger="true"
               OnConfirm="ConfirmDeleteAsync" OnCancel="CancelDeleteAsync" />

@code {
    private const int ExportPageSize = 100;
    private CancellationTokenSource? _keywordDebounce;
    private DataTable<TenantListItemDto>? _table;
    private IReadOnlyList<DataTableColumn<TenantListItemDto>> _columns = [];
    private TenantListSummaryDto? _summary;
    private TenantDetailDto? _selectedTenant;
    private TenantDetailDto? _formTenant;
    private string? _keyword;
    private string? _lastAppliedKeywordQuery;
    private int? _lastAppliedTenantId;

    /// <summary>Từ khóa từ link chéo (?q=Nguyễn A): điền sẵn ô tìm kiếm.</summary>
    [SupplyParameterFromQuery(Name = "q")]
    public string? KeywordQuery { get; set; }

    /// <summary>Id khách từ link chéo (?tenantId=8): mở ngay hồ sơ chi tiết.</summary>
    [SupplyParameterFromQuery(Name = "tenantId")]
    public int? TenantIdQuery { get; set; }
    private string _statusFilter = string.Empty;
    private string _accountFilter = string.Empty;
    private string _rentalFilter = string.Empty;
    private string _sortFilter = "created";
    private int _pageSize = 20;
    private int _tableKey;
    private bool _showAdvanced;
    private bool _canRevealIdNumber;
    private int? _openMenuId;
    private bool _summaryError;
    private bool _exporting;
    private bool _loadingDetail;
    private bool _showDetails;
    private bool _showForm;
    private bool _showLinkAccount;
    private bool _showInvite;
    private bool _showQr;
    private bool _showStatusConfirm;
    private bool _showUnlinkConfirm;
    private bool _showDeleteConfirm;
    private bool _nextIsActive;

    protected override async Task OnInitializedAsync()
    {
        _canRevealIdNumber = await TenantPages.GetCurrentRoleAsync() == Roles.ChuTro;
        BuildColumns();
        _lastAppliedKeywordQuery = KeywordQuery;
        _lastAppliedTenantId = TenantIdQuery;
        _keyword = string.IsNullOrWhiteSpace(KeywordQuery) ? null : KeywordQuery.Trim();
        await LoadSummaryAsync();
        await OpenTenantFromQueryAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Link từ bảng khác (?q=, ?tenantId=): Blazor dùng lại trang nên phải tự áp dụng lại.
        var queryChanged = !string.Equals(_lastAppliedKeywordQuery, KeywordQuery, StringComparison.Ordinal);
        var tenantChanged = _lastAppliedTenantId != TenantIdQuery;
        if (!queryChanged && !tenantChanged)
        {
            return;
        }

        _lastAppliedKeywordQuery = KeywordQuery;
        _lastAppliedTenantId = TenantIdQuery;
        if (queryChanged)
        {
            _keyword = string.IsNullOrWhiteSpace(KeywordQuery) ? null : KeywordQuery.Trim();
            _tableKey++;
        }

        await OpenTenantFromQueryAsync();
    }

    // ?tenantId=8: mở hồ sơ khách thuê đúng người, không cần gõ lại ô tìm kiếm.
    private async Task OpenTenantFromQueryAsync()
    {
        if (TenantIdQuery is { } tenantId && tenantId > 0)
        {
            await OpenDetailsAsync(tenantId);
        }
    }

    private void BuildColumns()
    {
        var columns = new List<DataTableColumn<TenantListItemDto>>
        {
            new()
            {
                Key = "name",
                Title = L["TenantColumnName"],
                Template = tenant => @<div class="tenant-name-cell">
                    <span class="tenant-avatar" aria-hidden="true">@Initial(tenant.FullName)</span>
                    <span class="tenant-name-text">
                        <button type="button" class="tenant-name-button" @onclick="() => OpenDetailsAsync(tenant.Id)">@tenant.FullName</button>
                        <small>@string.Format(L["TenantRecordNumber"], tenant.Id)</small>
                        @if (tenant.HasPendingApproval)
                        {
                            <StatusBadge Text="@L["P2ApprovalPending"]" Tone="@BadgeTone.Warning" />
                        }
                    </span>
                </div>,
            },
            new()
            {
                Key = "phone",
                Title = L["TenantColumnPhone"],
                Value = tenant => tenant.PhoneNumber,
            },
            new()
            {
                Key = "room",
                Title = L["TenantColumnRoom"],
                Template = tenant => @<text>
                    @if (string.IsNullOrWhiteSpace(tenant.RoomName))
                    {
                        <span>@L["NoData"]</span>
                    }
                    else
                    {
                        <a class="cell-link is-quiet" href="@AppLinks.RoomsByCode(tenant.RoomName)"
                           title="@L["CellLinkOpenRoom"]">@tenant.RoomName</a>
                    }
                </text>,
            },
            new()
            {
                Key = "idNumber",
                Title = L["TenantColumnIdNumber"],
                Template = tenant => @<span class="tenant-id-mask" title="@L["TenantIdMaskedHint"]">@(string.IsNullOrWhiteSpace(tenant.IdNumberMasked) ? L["NoData"] : tenant.IdNumberMasked)</span>,
            },
            new()
            {
                Key = "status",
                Title = L["TenantColumnStatus"],
                Template = tenant => @<StatusBadge Tone="@(tenant.IsActive ? BadgeTone.Success : BadgeTone.Neutral)"
                                                   Text="@(tenant.IsActive ? L["TenantStatusActive"] : L["TenantStatusInactive"])" />,
            },
        };

        if (_canRevealIdNumber)
        {
            columns.Add(new DataTableColumn<TenantListItemDto>
            {
                Key = "account",
                Title = L["TenantColumnAccount"],
                Template = tenant => @<StatusBadge Tone="@(tenant.HasAccount == true ? BadgeTone.Info : BadgeTone.Neutral)"
                                                   Text="@(tenant.HasAccount == true ? L["TenantAccountYes"] : L["TenantAccountNo"])" />,
            });
        }

        columns.Add(new DataTableColumn<TenantListItemDto>
        {
            Key = "actions",
            Title = L["TenantColumnActions"],
            Template = tenant => @<div class="p2-row-actions">
                <button type="button" class="tenant-icon-button p2-menu-trigger @(IsMenuOpen(tenant.Id) ? "is-open" : null)"
                        title="@L["TenantColumnActions"]" aria-label="@($"{L["TenantColumnActions"]}: {tenant.FullName}")"
                        aria-haspopup="menu" aria-expanded="@(IsMenuOpen(tenant.Id) ? "true" : "false")"
                        aria-controls="@($"tenant-row-menu-{tenant.Id}")"
                        @onclick="() => ToggleRowMenu(tenant.Id)">
                    <LucideIcon Name="ellipsis" />
                </button>
                @if (IsMenuOpen(tenant.Id))
                {
                    <div id="@($"tenant-row-menu-{tenant.Id}")" class="p2-row-menu" role="menu" aria-label="@L["TenantColumnActions"]" data-row-menu>
                        <button class="p2-row-menu-item" type="button" role="menuitem" @onclick="() => MenuDetailsAsync(tenant)">
                            <LucideIcon Name="eye" /><span>@L["TenantViewDetails"]</span>
                        </button>
                        <button class="p2-row-menu-item" type="button" role="menuitem" @onclick="() => MenuEditAsync(tenant)">
                            <LucideIcon Name="pen" /><span>@L["TenantEdit"]</span>
                        </button>
                        <button class="p2-row-menu-item" type="button" role="menuitem" @onclick="() => MenuStatusAsync(tenant)">
                            <LucideIcon Name="@(tenant.IsActive ? "user-off" : "user-check")" />
                            <span>@(tenant.IsActive ? L["TenantDeactivateButton"] : L["TenantActivateButton"])</span>
                        </button>
                        <div class="p2-row-menu-sep" role="separator"></div>
                        <button class="p2-row-menu-item danger" type="button" role="menuitem" @onclick="() => MenuDeleteAsync(tenant)">
                            <LucideIcon Name="trash" /><span>@L["TenantDelete"]</span>
                        </button>
                    </div>
                }
            </div>,
        });

        _columns = columns;
    }

    private async Task<Web.Common.Models.PagedResult<TenantListItemDto>> LoadTenantsAsync(DataTableRequest request)
    {
        _openMenuId = null;
        var filter = new TenantFilterRequest
        {
            Keyword = _keyword,
            IsActive = _statusFilter switch { "active" => true, "inactive" => false, _ => null },
            HasAccount = _canRevealIdNumber ? _accountFilter switch { "linked" => true, "unlinked" => false, _ => null } : null,
            HasActiveContract = _rentalFilter switch { "renting" => true, "not-renting" => false, _ => null },
            Page = request.Page,
            PageSize = request.PageSize,
            SortBy = _sortFilter == "created" ? TenantSortBy.CreatedAt : TenantSortBy.FullName,
            SortDirection = _sortFilter == "name-desc" || _sortFilter == "created" ? SortDirection.Desc : SortDirection.Asc,
        };
        return await TenantPages.ListAsync(filter);
    }

    private async Task LoadSummaryAsync()
    {
        _summaryError = false;
        try
        {
            _summary = await TenantPages.GetSummaryAsync();
        }
        catch
        {
            _summaryError = true;
        }
    }

    public void Dispose()
    {
        _keywordDebounce?.Cancel();
        _keywordDebounce?.Dispose();
    }

    private async Task OnKeywordChangedAsync()
    {
        _keywordDebounce?.Cancel();
        _keywordDebounce?.Dispose();
        _keywordDebounce = new CancellationTokenSource();
        var token = _keywordDebounce.Token;
        try
        {
            await Task.Delay(300, token);
            await ResetTableAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task ResetTableAsync()
    {
        _tableKey++;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetFiltersAsync()
    {
        _keyword = null;
        _statusFilter = string.Empty;
        _accountFilter = string.Empty;
        _rentalFilter = string.Empty;
        _sortFilter = "created";
        _showAdvanced = false;
        await ResetTableAsync();
    }

    private int AdvancedFilterCount =>
        (string.IsNullOrEmpty(_accountFilter) ? 0 : 1) + (string.IsNullOrEmpty(_rentalFilter) ? 0 : 1);

    private bool HasActiveTenantFilters =>
        !string.IsNullOrWhiteSpace(_keyword)
        || !string.IsNullOrEmpty(_statusFilter)
        || !string.IsNullOrEmpty(_accountFilter)
        || !string.IsNullOrEmpty(_rentalFilter);

    private async Task ClearTenantFiltersAsync()
    {
        _keyword = null;
        _statusFilter = string.Empty;
        _accountFilter = string.Empty;
        _rentalFilter = string.Empty;
        _showAdvanced = false;
        _sortFilter = "created";
        // Tạo lại bảng để xoá cả trạng thái sort nội bộ (mũi tên trên header) và về trang 1.
        await ResetTableAsync();
    }

    private void OpenCreate()
    {
        _formTenant = null;
        _showForm = true;
    }

    private void OpenInvite() => _showInvite = true;

    private void OpenQr() => _showQr = true;

    private Task CloseQr()
    {
        _showQr = false;
        return Task.CompletedTask;
    }

    private Task CloseInvite()
    {
        _showInvite = false;
        return Task.CompletedTask;
    }

    private bool IsMenuOpen(int id) => _openMenuId == id;
    private void ToggleRowMenu(int id) => _openMenuId = _openMenuId == id ? null : id;
    private async Task MenuDetailsAsync(TenantListItemDto tenant) { _openMenuId = null; await OpenDetailsAsync(tenant.Id); }
    private async Task MenuEditAsync(TenantListItemDto tenant) { _openMenuId = null; await OpenEditFromListAsync(tenant.Id); }
    private async Task MenuStatusAsync(TenantListItemDto tenant) { _openMenuId = null; await OpenStatusFromListAsync(tenant.Id, !tenant.IsActive); }
    private async Task MenuDeleteAsync(TenantListItemDto tenant) { _openMenuId = null; await OpenDeleteFromListAsync(tenant.Id); }

    private async Task OpenEditFromListAsync(int id)
    {
        if (await LoadDetailAsync(id))
        {
            _formTenant = _selectedTenant;
            _showDetails = false;
            _showForm = true;
        }
    }

    private async Task OpenDetailsAsync(int id)
    {
        if (await LoadDetailAsync(id)) _showDetails = true;
    }

    private async Task<bool> LoadDetailAsync(int id)
    {
        _loadingDetail = true;
        try
        {
            var result = await TenantPages.GetAsync(id);
            if (!result.Succeeded || result.Tenant is null)
            {
                Toasts.Error(ErrorMessage(result.ErrorCode));
                return false;
            }

            _selectedTenant = result.Tenant;
            return true;
        }
        catch (UnauthorizedAccessException)
        {
            Toasts.Error(L["TenantErrorForbidden"]);
            return false;
        }
        catch
        {
            Toasts.Error(L["TenantErrorGeneric"]);
            return false;
        }
        finally
        {
            _loadingDetail = false;
        }
    }

    private async Task OpenEditAsync(TenantDetailDto tenant)
    {
        _formTenant = tenant;
        _showDetails = false;
        _showForm = true;
        await Task.CompletedTask;
    }

    private Task CloseDetailsAsync()
    {
        _showDetails = false;
        return Task.CompletedTask;
    }

    private Task CloseFormAsync()
    {
        _showForm = false;
        return Task.CompletedTask;
    }

    private Task OpenLinkAccountAsync()
    {
        _showLinkAccount = true;
        return Task.CompletedTask;
    }

    private Task CloseLinkAccountAsync()
    {
        _showLinkAccount = false;
        return Task.CompletedTask;
    }

    private async Task RefreshAsync()
    {
        await LoadSummaryAsync();
        if (_table is not null) await _table.ReloadAsync();
    }

    private async Task RefreshDetailsAsync()
    {
        if (_selectedTenant is not null && await LoadDetailAsync(_selectedTenant.Id))
        {
            _showDetails = true;
        }
        await RefreshAsync();
    }

    private async Task RequestStatusChangeAsync(bool isActive)
    {
        _nextIsActive = isActive;
        _showStatusConfirm = true;
        await Task.CompletedTask;
    }

    private async Task OpenStatusFromListAsync(int id, bool isActive)
    {
        if (await LoadDetailAsync(id))
        {
            _nextIsActive = isActive;
            _showStatusConfirm = true;
        }
    }

    private async Task ConfirmStatusChangeAsync()
    {
        _showStatusConfirm = false;
        if (_selectedTenant is null) return;

        TenantResult result;
        try
        {
            result = await TenantPages.SetActiveAsync(
                _selectedTenant.Id, _nextIsActive, _selectedTenant.RowVersion);
        }
        catch
        {
            Toasts.Error(L["TenantErrorGeneric"]);
            return;
        }
        if (!result.Succeeded)
        {
            if (result.ErrorCode == TenantErrorCodes.ApprovalRequired)
            {
                // Quản lý ở chế độ "Duyệt": yêu cầu đã vào hàng đợi, dữ liệu chưa đổi.
                Toasts.Success(L["TenantStatusApprovalSubmitted"]);
                await RefreshAsync();
                return;
            }

            Toasts.Error(ErrorMessage(result.ErrorCode));
            if (result.ErrorCode == TenantErrorCodes.ConcurrencyConflict)
            {
                await RefreshDetailsAsync();
            }
            return;
        }

        _selectedTenant = result.Tenant;
        Toasts.Success(L["TenantStatusUpdated"]);
        await RefreshAsync();
    }

    private Task CancelStatusChangeAsync()
    {
        _showStatusConfirm = false;
        return Task.CompletedTask;
    }

    private Task RequestUnlinkAccountAsync()
    {
        _showUnlinkConfirm = true;
        return Task.CompletedTask;
    }

    private async Task ConfirmUnlinkAccountAsync()
    {
        _showUnlinkConfirm = false;
        if (_selectedTenant is null) return;

        TenantResult result;
        try
        {
            result = await TenantPages.UnlinkAccountAsync(_selectedTenant.Id, _selectedTenant.RowVersion);
        }
        catch
        {
            Toasts.Error(L["TenantErrorGeneric"]);
            return;
        }
        if (!result.Succeeded)
        {
            Toasts.Error(ErrorMessage(result.ErrorCode));
            if (result.ErrorCode == TenantErrorCodes.ConcurrencyConflict) await RefreshDetailsAsync();
            return;
        }

        Toasts.Success(L["TenantAccountUnlinked"]);
        await RefreshDetailsAsync();
    }

    private Task CancelUnlinkAccountAsync()
    {
        _showUnlinkConfirm = false;
        return Task.CompletedTask;
    }

    private async Task OpenDeleteFromListAsync(int id)
    {
        if (await LoadDetailAsync(id))
        {
            _showDeleteConfirm = true;
        }
    }

    private Task RequestDeleteAsync(TenantDetailDto tenant)
    {
        _selectedTenant = tenant;
        _showDetails = false;
        _showDeleteConfirm = true;
        return Task.CompletedTask;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_selectedTenant is null)
        {
            _showDeleteConfirm = false;
            return;
        }

        TenantResult result;
        try
        {
            result = await TenantPages.DeleteAsync(_selectedTenant.Id, _selectedTenant.RowVersion);
        }
        catch (UnauthorizedAccessException)
        {
            _showDeleteConfirm = false;
            Toasts.Error(L["TenantErrorForbidden"]);
            return;
        }
        catch
        {
            _showDeleteConfirm = false;
            Toasts.Error(L["TenantErrorGeneric"]);
            return;
        }

        _showDeleteConfirm = false;

        if (!result.Succeeded)
        {
            if (result.ErrorCode == TenantErrorCodes.ApprovalRequired)
            {
                // Quản lý ở chế độ "Duyệt": yêu cầu đã vào hàng đợi, dữ liệu chưa đổi.
                Toasts.Success(L["TenantDeleteApprovalSubmitted"]);
                // Nạp lại để badge "Chờ duyệt" xuất hiện ngay trên dòng vừa xoá.
                await RefreshAsync();
                return;
            }

            Toasts.Error(ErrorMessage(result.ErrorCode));
            if (result.ErrorCode == TenantErrorCodes.ConcurrencyConflict) await RefreshDetailsAsync();
            return;
        }

        Toasts.Success(L["TenantDeleted"]);
        _selectedTenant = null;
        await RefreshAsync();
    }

    private Task CancelDeleteAsync()
    {
        _showDeleteConfirm = false;
        return Task.CompletedTask;
    }

    private async Task ExportAsync()
    {
        if (_exporting) return;
        _exporting = true;

        try
        {
            var firstPage = await TenantPages.ListAsync(CreateExportFilter(page: 1));
            var rows = firstPage.Items.ToList();
            var pageCount = (int)Math.Ceiling(firstPage.TotalCount / (double)ExportPageSize);
            for (var page = 2; page <= pageCount; page++)
            {
                var result = await TenantPages.ListAsync(CreateExportFilter(page));
                rows.AddRange(result.Items);
            }

            var content = TenantCsvExporter.Build(rows, _canRevealIdNumber, key => L[key]);
            var exportNow = VietnamTime.ToVietnam(Clock.GetUtcNow().UtcDateTime);
            var fileName = $"tenants_{exportNow:yyyyMMdd_HHmm}.csv";
            await JS.InvokeVoidAsync("appTenantExport.download", fileName, content);
            Toasts.Success(string.Format(L["TenantExported"], rows.Count));
        }
        catch
        {
            Toasts.Error(L["TenantExportFailed"]);
        }
        finally
        {
            _exporting = false;
        }
    }

    private TenantFilterRequest CreateExportFilter(int page) => new()
    {
        Keyword = _keyword,
        IsActive = _statusFilter switch { "active" => true, "inactive" => false, _ => null },
        HasAccount = _accountFilter switch { "linked" => true, "unlinked" => false, _ => null },
        HasActiveContract = _rentalFilter switch { "renting" => true, "not-renting" => false, _ => null },
        Page = page,
        PageSize = ExportPageSize,
        SortBy = _sortFilter == "created" ? TenantSortBy.CreatedAt : TenantSortBy.FullName,
        SortDirection = _sortFilter == "name-desc" || _sortFilter == "created" ? SortDirection.Desc : SortDirection.Asc,
    };

    private string SummaryValue(int? value) => value?.ToString("N0", NumberFormatter.Display) ?? L["NoData"].Value;

    private string Percent(int? value, int? total) =>
        total is > 0 && value is not null ? NumberFormatter.Trimmed((double)value.Value / total.Value * 100) : "0";

    // Tooltip "?" của 2 thẻ có tỉ lệ: ghép lại đúng câu mô tả cũ.
    private string ActiveRateTip =>
        $"{L["TenantActiveRateHint"]}: {Percent(_summary!.ActiveCount, _summary!.TotalCount)}%";

    private string AccountRateTip =>
        $"{Percent(_summary!.LinkedAccountCount, _summary!.TotalCount)}% {L["TenantAccountRateHint"]}";

    private static string Initial(string value) =>
        string.IsNullOrWhiteSpace(value) ? "?" : value.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries)[^1][..1].ToUpperInvariant();

    private string ErrorMessage(string? code) => code switch
    {
        TenantErrorCodes.DuplicateTenant => L["TenantErrorDuplicateId"],
        TenantErrorCodes.TenantNotFound => L["TenantErrorNotFound"],
        TenantErrorCodes.AccountAlreadyLinked => L["TenantErrorAccountLinked"],
        TenantErrorCodes.ConcurrencyConflict => L["TenantErrorConflict"],
        TenantErrorCodes.TenantInUse => L["TenantErrorInUse"],
        TenantErrorCodes.Forbidden => L["TenantErrorForbidden"],
        TenantErrorCodes.ApprovalRequired => L["TenantErrorApprovalRequired"],
        _ => L["TenantErrorGeneric"],
    };

}
