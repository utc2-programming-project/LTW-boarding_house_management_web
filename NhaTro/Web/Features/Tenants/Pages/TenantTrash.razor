@page "/tenants/trash"
@page "/trash"
@attribute [Authorize(Roles = Roles.ChuTro)]
@rendermode InteractiveServer
@inject TenantPageService TenantPages
@inject ToastService Toasts
@inject IStringLocalizer<Shared> L

<PageTitle>@L["TenantTrashTitle"] · @L["AppName"]</PageTitle>

<section class="page-stack" aria-labelledby="tenant-trash-title">
    <PageHeading Title="@L["TenantTrashTitle"]" TitleId="tenant-trash-title" HelpText="@L["TenantTrashSubtitle"]">
        <Actions>
            <button type="button" class="btn btn-danger" @onclick="() => _showEmptyConfirm = true">
                <LucideIcon Name="trash" /> @L["EmptyTrash"]
            </button>
            <a class="btn btn-secondary" href="/tenants">
                <LucideIcon Name="arrow-left" /> @L["TenantTrashBack"]
            </a>
        </Actions>
    </PageHeading>

    <div class="tenant-trash-note" role="note">
        <LucideIcon Name="shield-check" />
        <span>@L["TenantTrashRetentionNote"]</span>
    </div>

    <div class="filter-bar filter-bar--panel">
        <div class="filter-bar__row">
            <div class="filter-bar__search">
                <label class="sr-only" for="tenant-trash-search">@L["TenantTrashSearch"]</label>
                <span class="filter-bar__icon" aria-hidden="true"><LucideIcon Name="search" /></span>
                <InputText id="tenant-trash-search" class="input" @bind-Value="_keyword"
                           @bind-Value:after="SearchAsync" placeholder="@L["TenantTrashSearchHint"]" autocomplete="off" />
            </div>
            <div class="filter-bar__actions">
                <span class="filter-bar__meta">@string.Format(L["TenantTrashCount"], _total)</span>
                <div class="filter-bar__state">
                    <label class="sr-only" for="tenant-trash-page-size">@L["P2RowsPerPage"]</label>
                    <select id="tenant-trash-page-size" class="input" value="@_pageSize" @onchange="ChangePageSizeAsync">
                        <option value="10">@string.Format(L["RowsPerPageOption"].Value, 10)</option>
                        <option value="20">@string.Format(L["RowsPerPageOption"].Value, 20)</option>
                        <option value="50">@string.Format(L["RowsPerPageOption"].Value, 50)</option>
                    </select>
                </div>
                <FilterResetButton OnClick="ClearKeywordAsync" />
            </div>
        </div>
    </div>

    @if (_error)
    {
        <div class="tenant-trash-alert" role="alert">
            <span>@L["TenantTrashLoadFailed"]</span>
            <button type="button" class="btn btn-secondary btn-sm" @onclick="LoadAsync">@L["Retry"]</button>
        </div>
    }
    else if (_loading)
    {
        <div class="tenant-trash-loading">
            <LoadingOverlay Visible="true" Text="@L["TableLoading"]" />
        </div>
    }
    else if (_items.Count == 0 && !string.IsNullOrWhiteSpace(_keyword))
    {
        <EmptyStateCard Title="@L["TableNoResults"]" Description="@L["TableNoResultsDescription"]">
            <button type="button" class="btn btn-secondary" @onclick="ClearSearchAsync">@L["TableClearFilters"]</button>
        </EmptyStateCard>
    }
    else if (_items.Count == 0)
    {
        <EmptyStateCard Title="@L["TenantTrashEmptyTitle"]" Description="@L["TenantTrashEmptyDescription"]" />
    }
    else
    {
        <div class="tenant-trash-table-wrap">
            <table class="tenant-trash-table">
                <caption class="sr-only">@L["TenantTrashTitle"]</caption>
                <thead>
                    <tr>
                        <th scope="col">@L["TenantColumnName"]</th>
                        <th scope="col">@L["TenantColumnPhone"]</th>
                        <th scope="col">@L["TenantTrashColumnDeletedAt"]</th>
                        <th scope="col">@L["TenantColumnAccount"]</th>
                        <th scope="col">@L["TenantTrashColumnDocuments"]</th>
                        <th scope="col">@L["TenantColumnActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr @key="item.Id">
                            <td>
                                <div class="tenant-trash-name">
                                    <span class="tenant-trash-avatar" aria-hidden="true">@Initial(item.FullName)</span>
                                    <span>
                                        <strong>@item.FullName</strong>
                                        <small>@string.Format(L["TenantRecordNumber"], item.Id)</small>
                                    </span>
                                </div>
                            </td>
                            <td class="tenant-trash-mono">@item.PhoneNumber</td>
                            <td>@DateFormatter.FormatDateTime(item.DeletedAt?.UtcDateTime)</td>
                            <td>
                                <StatusBadge Tone="@(item.HasAccount ? BadgeTone.Info : BadgeTone.Neutral)"
                                             Text="@(item.HasAccount ? L["TenantAccountYes"] : L["TenantAccountNo"])" />
                            </td>
                            <td>@item.DocumentCount</td>
                            <td>
                                <TrashRowMenu RestoreText="@L["TenantTrashRestore"]" PurgeText="@L["Purge"]"
                                              OnRestore="() => RequestRestore(item)" OnPurge="() => RequestPurge(item)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <TablePager Page="_page" TotalPages="PageCount" From="FirstItem" To="LastItem" Total="_total"
                    PageChanged="GoToPageAsync" />
    }
</section>

<ConfirmDialog Visible="_showRestoreConfirm" Title="@L["TenantTrashRestoreTitle"]"
               Message="@L["TenantTrashRestoreMessage"]" ConfirmText="@L["TenantTrashRestore"]"
               CancelText="@L["Cancel"]" BusyText="@L["TenantTrashRestoring"]"
               OnConfirm="ConfirmRestoreAsync" OnCancel="CancelRestore" />

<PurgeConfirmDialog Visible="_showPurgeConfirm" Title="@L["PurgeTitle"]"
                    Message="@string.Format(L["PurgeMessage"], _purgeTarget?.FullName ?? string.Empty)"
                    ExpectedText="@(_purgeTarget?.FullName ?? string.Empty)"
                    PromptText="@string.Format(L["PurgeTypePrompt"], _purgeTarget?.FullName ?? string.Empty)"
                    MismatchText="@L["PurgeMismatch"]"
                    ConfirmText="@L["Purge"]" CancelText="@L["Cancel"]"
                    OnConfirm="ConfirmPurgeAsync" OnCancel="CancelPurge" />

<PurgeConfirmDialog Visible="_showEmptyConfirm" Title="@L["EmptyTrashTitle"]"
                    Message="@L["EmptyTrashMessage"]"
                    ExpectedText="@L["TrashEmptyPhrase"]"
                    PromptText="@string.Format(L["PurgeTypePrompt"], L["TrashEmptyPhrase"].Value)"
                    MismatchText="@L["PurgeMismatch"]"
                    ConfirmText="@L["EmptyTrash"]" CancelText="@L["Cancel"]"
                    OnConfirm="EmptyTrashAsync" OnCancel="() => _showEmptyConfirm = false" />

@code {
    private IReadOnlyList<TenantTrashItemDto> _items = [];
    private TenantTrashItemDto? _restoreTarget;
    private TenantTrashItemDto? _purgeTarget;
    private bool _showPurgeConfirm;
    private bool _showEmptyConfirm;
    private string? _keyword;
    private int _page = 1;
    private int _pageSize = 20;
    private int _total;
    private bool _loading = true;
    private bool _error;
    private bool _showRestoreConfirm;
    private CancellationTokenSource? _searchCts;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize));

    private int FirstItem => _total == 0 ? 0 : (_page - 1) * _pageSize + 1;

    private int LastItem => Math.Min(_page * _pageSize, _total);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = false;
        try
        {
            var result = await TenantPages.ListTrashAsync(new TenantTrashFilterRequest
            {
                Keyword = _keyword,
                Page = _page,
                PageSize = _pageSize,
            });
            _items = result.Items;
            _total = result.TotalCount;

            // Dữ liệu co lại (vd. vừa khôi phục dòng cuối): lùi về trang còn dữ liệu.
            if (_items.Count == 0 && _page > 1)
            {
                _page = PageCount;
                await LoadAsync();
                return;
            }
        }
        catch
        {
            _error = true;
            _items = [];
            _total = 0;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchAsync()
    {
        _searchCts?.Cancel();
        var cts = _searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _page = 1;
        await LoadAsync();
    }

    private Task ChangePageSizeAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var value) || value is not (10 or 20 or 50))
        {
            return Task.CompletedTask;
        }

        _pageSize = value;
        _page = 1;
        return LoadAsync();
    }

    private Task ClearKeywordAsync()
    {
        _keyword = null;
        return SearchAsync();
    }

    private Task ClearSearchAsync()
    {
        _keyword = null;
        _page = 1;
        return LoadAsync();
    }

    private Task GoToPageAsync(int page)
    {
        var target = PaginationHelper.ClampPage(page, PageCount);
        if (target == _page) return Task.CompletedTask;
        _page = target;
        return LoadAsync();
    }

    private Task RequestRestore(TenantTrashItemDto item)
    {
        _restoreTarget = item;
        _showRestoreConfirm = true;
        return Task.CompletedTask;
    }

    private Task CancelRestore()
    {
        _showRestoreConfirm = false;
        _restoreTarget = null;
        return Task.CompletedTask;
    }

    private async Task ConfirmRestoreAsync()
    {
        if (_restoreTarget is null)
        {
            _showRestoreConfirm = false;
            return;
        }

        TenantResult result;
        try
        {
            result = await TenantPages.RestoreAsync(_restoreTarget.Id, _restoreTarget.RowVersion);
        }
        catch (UnauthorizedAccessException)
        {
            _showRestoreConfirm = false;
            Toasts.Error(L["TenantErrorForbidden"]);
            return;
        }
        catch
        {
            _showRestoreConfirm = false;
            Toasts.Error(L["TenantTrashRestoreFailed"]);
            return;
        }

        _showRestoreConfirm = false;
        if (!result.Succeeded)
        {
            Toasts.Error(result.ErrorCode switch
            {
                TenantErrorCodes.TenantNotFound => L["TenantErrorNotFound"],
                TenantErrorCodes.ConcurrencyConflict => L["TenantErrorConflict"],
                TenantErrorCodes.DuplicateTenant => L["TenantErrorDuplicateId"],
                TenantErrorCodes.AccountAlreadyLinked => L["TenantErrorAccountLinked"],
                TenantErrorCodes.Forbidden => L["TenantErrorForbidden"],
                _ => L["TenantTrashRestoreFailed"],
            });
            if (result.ErrorCode == TenantErrorCodes.ConcurrencyConflict) await LoadAsync();
            return;
        }

        Toasts.Success(L["TenantTrashRestored"]);
        _restoreTarget = null;
        await LoadAsync();
    }

    private Task RequestPurge(TenantTrashItemDto item)
    {
        _purgeTarget = item;
        _showPurgeConfirm = true;
        return Task.CompletedTask;
    }

    private Task CancelPurge()
    {
        _showPurgeConfirm = false;
        _purgeTarget = null;
        return Task.CompletedTask;
    }

    private async Task ConfirmPurgeAsync()
    {
        if (_purgeTarget is null)
        {
            _showPurgeConfirm = false;
            return;
        }

        TenantResult result;
        try
        {
            result = await TenantPages.PurgeAsync(_purgeTarget.Id, _purgeTarget.RowVersion);
        }
        catch (UnauthorizedAccessException)
        {
            _showPurgeConfirm = false;
            Toasts.Error(L["TenantErrorForbidden"]);
            return;
        }
        catch
        {
            _showPurgeConfirm = false;
            Toasts.Error(L["PurgeFailed"]);
            return;
        }

        _showPurgeConfirm = false;
        if (!result.Succeeded)
        {
            Toasts.Error(result.ErrorCode switch
            {
                TenantErrorCodes.TenantHasDependencies => L["PurgeHasDependencies"],
                TenantErrorCodes.NotInTrash => L["PurgeNotInTrash"],
                TenantErrorCodes.ConcurrencyConflict => L["TenantErrorConflict"],
                TenantErrorCodes.Forbidden => L["TenantErrorForbidden"],
                _ => L["PurgeFailed"],
            });
            if (result.ErrorCode == TenantErrorCodes.ConcurrencyConflict) await LoadAsync();
            return;
        }

        Toasts.Success(L["PurgeSuccess"]);
        _purgeTarget = null;
        await LoadAsync();
    }

    private async Task EmptyTrashAsync()
    {
        _showEmptyConfirm = false;
        try
        {
            var summary = await TenantPages.PurgeAllAsync();
            if (summary.Purged == 0 && summary.Skipped == 0)
            {
                Toasts.Success(L["EmptyTrashNothing"]);
            }
            else
            {
                Toasts.Success(string.Format(L["EmptyTrashSuccess"], summary.Purged, summary.Skipped));
            }
        }
        catch
        {
            Toasts.Error(L["PurgeFailed"]);
        }

        await LoadAsync();
    }

    private static string Initial(string value) =>
        string.IsNullOrWhiteSpace(value)
            ? "?"
            : value.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries)[^1][..1].ToUpperInvariant();
}
