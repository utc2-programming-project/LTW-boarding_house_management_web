@page "/my/room"
@page "/tenant/my-room"
@attribute [Authorize(Roles = Roles.KhachThue)]
@rendermode InteractiveServer
@using Web.Features.Contracts
@using Web.Features.Contracts.DTOs
@using Web.Features.Contracts.Enums
@using Web.Features.Contracts.Rules
@using Web.Features.Contracts.Services
@using Web.Infrastructure.Time
@inject TenantDocumentPageService DocumentService
@inject IContractRenewalService RenewalService
@inject ToastService Toasts
@inject ILogger<MyLeasedRoomView> Logger
@inject IStringLocalizer<Shared> L

<PageTitle>@L["MyRoomTitle"] · @L["AppName"]</PageTitle>

<div class="leased-room-page">
    @if (_loading)
    {
        <PageHeading Title="@L["LeasedRoomContractHeading"]" TitleId="leased-room-title" HelpText="@L["LeasedRoomHelp"]" />
        <div class="leased-room-state">
            <LoadingOverlay Visible="true" Text="@L["TableLoading"]" />
        </div>
    }
    else if (_loadFailed)
    {
        <PageHeading Title="@L["LeasedRoomContractHeading"]" TitleId="leased-room-title" HelpText="@L["LeasedRoomHelp"]" />
        <div class="leased-room-state">
            <EmptyStateCard Title="@L["MyRoomTitle"]" Description="@L["MyRoomLoadFailed"]">
                <button type="button" class="btn btn-secondary" @onclick="LoadRoomAsync">@L["Retry"]</button>
            </EmptyStateCard>
        </div>
    }
    else if (_leasedRoom is null)
    {
        <PageHeading Title="@L["LeasedRoomContractHeading"]" TitleId="leased-room-title" HelpText="@L["LeasedRoomHelp"]" />
        <div class="leased-room-state">
            <EmptyStateCard Title="@L["EmptyMyRoomTitle"]" Description="@L["EmptyMyRoomDesc"]">
                <Icon>
                    <LucideIcon Name="home" />
                </Icon>
                <ChildContent>
                    <a href="/my/tenant-profile" class="btn btn-secondary">
                        <LucideIcon Name="user" />
                        @L["MyTenantProfile"]
                    </a>
                </ChildContent>
            </EmptyStateCard>
        </div>
    }
    else
    {
        <PageHeading Title="@L["LeasedRoomContractHeading"]" TitleId="leased-room-title" HelpText="@L["LeasedRoomHelp"]">
            <HeadingSuffix>
                <span class="leased-room-status-badge">@GetContractStatusLabel()</span>
            </HeadingSuffix>
            <HeadingMeta>
                <p class="leased-room-subtitle">
                    @L["P2RoomsTitle"]: @(!string.IsNullOrWhiteSpace(_leasedRoom.RoomCode) ? _leasedRoom.RoomCode : L["NoData"].Value)
                    · @L["Properties"]: @(!string.IsNullOrWhiteSpace(_leasedRoom.PropertyName) ? _leasedRoom.PropertyName : L["NoData"].Value)
                </p>
            </HeadingMeta>
            <Actions>
                <div class="leased-room-actions">
                    <a href="@($"/contracts/{_leasedRoom.ContractId}")"
                       class="btn btn-secondary">
                        <LucideIcon Name="file-text" />
                        <span>@L["P2ViewDetails"]</span>
                    </a>

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="OpenRenewModal">
                        <LucideIcon Name="refresh-cw" />
                        <span>@L["RenewContract"]</span>
                    </button>

                    <a href="/my/documents"
                       class="btn btn-primary">
                        <LucideIcon Name="folder" />
                        <span>@L["TenantDocumentsTitle"]</span>
                    </a>
                </div>
            </Actions>
        </PageHeading>

        <div class="leased-room-banner">
            <div class="leased-room-banner-copy">
                <LucideIcon Name="shield" />
                <p>@L["ContractVerifiedNotice"]</p>
            </div>
            <div class="leased-room-banner-meta">
                <LucideIcon Name="lock" />
                <span>@L["IssuedByManagement"]</span>
            </div>
        </div>

        <section class="leased-room-bento" aria-label="@L["LeasedRoomInfo"]">
            <article class="leased-room-bento-card">
                <div class="leased-room-bento-header">
                    <span class="leased-room-bento-label">@L["LeasedRoomInfo"]</span>
                    <span class="leased-room-bento-icon leased-room-icon-indigo"><LucideIcon Name="home" /></span>
                </div>
                <div class="leased-room-bento-value">@(!string.IsNullOrWhiteSpace(_leasedRoom.RoomCode) ? _leasedRoom.RoomCode : L["NoData"].Value) · @(!string.IsNullOrWhiteSpace(_leasedRoom.PropertyName) ? _leasedRoom.PropertyName : L["NoData"].Value)</div>
                <div class="leased-room-bento-footer">
                    @if (_leasedRoom.Floor.HasValue)
                    {
                        <span>@L["RoomFloor"]: <span class="tabular-nums">@_leasedRoom.Floor.Value</span> · </span>
                    }
                    else
                    {
                        <span>@L["RoomFloor"]: @L["NoData"] · </span>
                    }
                    @if (_leasedRoom.AreaM2.HasValue)
                    {
                        <span>@L["RoomArea"]: <span class="tabular-nums">@NumberFormatter.Trimmed(_leasedRoom.AreaM2.Value)</span> m²</span>
                    }
                    else
                    {
                        <span>@L["RoomArea"]: @L["NoData"]</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_leasedRoom.PropertyAddress))
                    {
                        <span> · @_leasedRoom.PropertyAddress</span>
                    }
                    else
                    {
                        <span> · @L["NoData"]</span>
                    }
                </div>
            </article>

            <article class="leased-room-bento-card">
                <div class="leased-room-bento-header">
                    <span class="leased-room-bento-label">@L["ContractSigningStatus"]</span>
                    <span class="leased-room-bento-icon leased-room-icon-green"><LucideIcon Name="check-circle-2" /></span>
                </div>
                <div class="leased-room-bento-value leased-room-status-value">@GetContractStatusLabel()</div>
                <div class="leased-room-bento-footer">
                    <a href="@($"/contracts/{_leasedRoom.ContractId}")" class="leased-room-contract-link">
                        @L["ContractNumberLabel", _leasedRoom.ContractNumber]
                    </a>
                </div>
            </article>

            <article class="leased-room-bento-card">
                <div class="leased-room-bento-header">
                    <span class="leased-room-bento-label">@L["RentalDuration"]</span>
                    <span class="leased-room-bento-icon leased-room-icon-blue"><LucideIcon Name="calendar" /></span>
                </div>
                <div class="leased-room-bento-value">
                    @if (GetDurationMonths(_leasedRoom.StartDate, _leasedRoom.EndDate) is { } durationMonths)
                    {
                        <span class="tabular-nums">@L["DurationInMonths", durationMonths]</span>
                    }
                    else
                    {
                        @L["NoData"]
                    }
                </div>
                <div class="leased-room-bento-footer leased-room-date-range">
                    <span>
                        <span class="leased-room-date-label">@L["LeaseStartDateLabel"]:</span>
                        <span class="tabular-nums">@DateFormatter.Format(DateOnly.FromDateTime(_leasedRoom.StartDate))</span>
                    </span>
                    <span>
                        <span class="leased-room-date-label">@L["LeaseEndDateLabel"]:</span>
                        <span class="tabular-nums">@DateFormatter.Format(DateOnly.FromDateTime(_leasedRoom.EndDate))</span>
                    </span>
                </div>
            </article>
        </section>

        <section class="leased-room-panel" aria-labelledby="leased-room-terms-title">
            <div class="leased-room-panel-header">
                <h2 id="leased-room-terms-title">@L["CoreAgreementTerms"]</h2>
                <a href="@($"/contracts/{_leasedRoom.ContractId}")" class="leased-room-contract-link">
                    @L["ContractNumberLabel", _leasedRoom.ContractNumber]
                </a>
            </div>

            <div class="leased-room-terms-grid">
                <div class="leased-room-term">
                    <span class="leased-room-term-label">@L["MonthlyRentLabel"]</span>
                    <p class="leased-room-term-value leased-room-term-numeric">
                        @MoneyFormatter.Format(_leasedRoom.MonthlyRent) / @L["MonthUnit"]
                    </p>
                    <p class="leased-room-term-note">@L["MonthlyRentNote"]</p>
                </div>

                <div class="leased-room-term">
                    <span class="leased-room-term-label">@L["RoomDeposit"]</span>
                    <p class="leased-room-term-value leased-room-term-numeric">@MoneyFormatter.Format(_leasedRoom.DepositAmount)</p>
                    <p class="leased-room-term-note">
                        @L["DepositAmount"]:
                        @if (_leasedRoom.PaidDepositAmount is { } paidDeposit)
                        {
                            <span class="tabular-nums">@MoneyFormatter.Format(paidDeposit)</span>
                        }
                        else
                        {
                            @L["NoData"].Value
                        }
                    </p>
                    <p class="leased-room-term-note">
                        @L["DepositPaidDateLabel"]:
                        @if (_leasedRoom.DepositPaidDate is { } paidDate)
                        {
                            <span class="tabular-nums">@DateFormatter.Format(DateOnly.FromDateTime(paidDate))</span>
                        }
                        else
                        {
                            @L["NoData"].Value
                        }
                    </p>
                </div>

                <div class="leased-room-term" style="grid-column: 1 / -1;">
                    <span class="leased-room-term-label">@L["ContractTermsAndRulesLabel"]</span>
                    <p class="leased-room-description">@L["ContractTermsAndRulesDesc", _leasedRoom.ContractNumber]</p>
                    <a href="@($"/contracts/{_leasedRoom.ContractId}")" class="btn btn-secondary btn-sm" style="margin-top: 8px; width: fit-content;">
                        <LucideIcon Name="file-text" />
                        <span>@L["P2ViewDetails"]</span>
                    </a>
                </div>
            </div>
        </section>

        <section class="leased-room-panel leased-room-roommates" aria-labelledby="leased-room-roommates-title">
            <div class="leased-room-panel-header leased-room-roommates-header">
                <div>
                    <h2 id="leased-room-roommates-title">@L["Roommates"]</h2>
                    <p>@L["RoommatesDesc"]</p>
                </div>
                <span class="leased-room-count"><span class="tabular-nums">@_leasedRoom.Roommates.Count</span> @L["TenantPeople"]</span>
            </div>

            @if (_leasedRoom.Roommates.Count == 0)
            {
                <p class="leased-room-empty">@L["NoRoommates"]</p>
            }
            else
            {
                <div class="leased-room-roommate-list">
                    @foreach (var mate in _leasedRoom.Roommates)
                    {
                        <div class="leased-room-roommate">
                            <div class="leased-room-avatar" aria-hidden="true">@Initial(mate.FullName)</div>
                            <div class="leased-room-roommate-details">
                                <div class="leased-room-roommate-name">
                                    <span>@(!string.IsNullOrWhiteSpace(mate.FullName) ? mate.FullName : L["NoData"].Value)</span>
                                    @if (mate.IsCurrentUser)
                                    {
                                        <span class="leased-room-self">@L["ThisIsYou"]</span>
                                    }
                                </div>
                                <span class="leased-room-roommate-phone tabular-nums">@(!string.IsNullOrWhiteSpace(mate.PhoneNumber) ? mate.PhoneNumber : L["NoData"].Value)</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>

<!-- Renew Modal Popup -->
@if (_renewModalOpen && _leasedRoom is not null)
{
    <div class="leased-room-dialog-overlay" role="presentation" data-dialog-dismiss
         @onclick="CloseRenewModal">
        <div class="leased-room-dialog" role="dialog" aria-modal="true" aria-labelledby="renew-contract-title"
             @onclick:stopPropagation="true">
            <div class="leased-room-dialog-header">
                <div>
                    <h2 id="renew-contract-title">@L["RenewContractTitle"]</h2>
                    <p>@L["RoomLabel", _leasedRoom.RoomCode]</p>
                </div>
                <button type="button" class="icon-button" aria-label="@L["Close"]"
                        disabled="@_renewSubmitting"
                        @onclick="CloseRenewModal">
                    <LucideIcon Name="x" />
                </button>
            </div>

            <div class="renew-tabs" role="tablist" aria-label="@L["RenewTabsLabel"]">
                <button type="button" role="tab" id="renew-tab-request" aria-controls="renew-panel-request"
                        class="renew-tab @(_onHistoryTab ? string.Empty : "renew-tab-active")"
                        aria-selected="@(!_onHistoryTab)" @onclick="ShowRequestTab">
                    @L["RenewTabRequest"]
                </button>
                <button type="button" role="tab" id="renew-tab-history" aria-controls="renew-panel-history"
                        class="renew-tab @(_onHistoryTab ? "renew-tab-active" : string.Empty)"
                        aria-selected="@_onHistoryTab" @onclick="ShowHistoryTab">
                    @L["RenewTabHistory"]
                </button>
            </div>

            <div class="leased-room-dialog-body">
                @* Panel gửi yêu cầu luôn nằm trong DOM để làm khung định chiều cao hộp thoại;
                   sang tab lịch sử nó chỉ bị visibility:hidden, nhờ vậy hộp thoại không dài thêm.
                   Cơ chế cuộn nằm ở .renew-panel / .renew-panel-history trong file CSS. *@
                <div role="tabpanel" id="renew-panel-request" aria-labelledby="renew-tab-request"
                     class="renew-panel @(_onHistoryTab ? "renew-panel-hidden" : string.Empty)">
                    <div class="renew-unavailable-notice" role="note">
                        <LucideIcon Name="info" />
                        <span>@L["RenewNotice"]</span>
                    </div>

                    @if (HasPendingRenewal)
                    {
                        <p class="leased-room-dialog-hint">@L["RenewPendingBlocksNew"]</p>
                    }
                    else
                    {
                        <div class="leased-room-dialog-field">
                            <label for="renew-months">@L["RenewMonthsLabel"] <span class="required-star">*</span></label>
                            <input id="renew-months" class="leased-room-dialog-input"
                                   type="number" inputmode="numeric" step="1"
                                   min="@ContractRenewalRules.MinRequestedMonths" max="@MaxRenewMonths"
                                   aria-describedby="renew-months-hint"
                                   disabled="@_renewSubmitting"
                                   @bind="_renewMonthsText" @bind:event="oninput" />
                            <p id="renew-months-hint" class="leased-room-dialog-hint">
                                @L["RenewMonthsHint", ContractRenewalRules.MinRequestedMonths, MaxRenewMonths]
                            </p>
                            @if (_renewMonthsError is not null)
                            {
                                <p class="leased-room-dialog-error" role="alert">
                                    <LucideIcon Name="alert" />
                                    <span>@_renewMonthsError</span>
                                </p>
                            }
                        </div>

                        <div class="leased-room-dialog-field">
                            <label for="renew-note">@L["RenewNoteLabel"] <span class="optional-hint">(@L["Optional"])</span></label>
                            <textarea id="renew-note" class="leased-room-dialog-note" rows="3"
                                      maxlength="@ContractRenewalRules.MaxNoteLength"
                                      disabled="@_renewSubmitting"
                                      @bind="_renewNote" @bind:event="oninput"></textarea>
                        </div>

                        @if (_renewSubmitError is not null)
                        {
                            <p class="leased-room-dialog-error" role="alert">
                                <LucideIcon Name="alert" />
                                <span>@_renewSubmitError</span>
                            </p>
                        }
                    }
                </div>

                @if (_onHistoryTab)
                {
                    <div role="tabpanel" id="renew-panel-history" aria-labelledby="renew-tab-history" class="renew-panel renew-panel-history">
                        @if (_renewalHistory.Count == 0)
                        {
                            <p class="leased-room-dialog-hint">@L["RenewHistoryEmpty"]</p>
                        }
                        else
                        {
                            @foreach (var item in _renewalHistory)
                            {
                                <div class="renew-pending-card">
                                    <div class="renew-pending-row">
                                        <span class="renew-pending-label">@L["RenewPendingStatusLabel"]</span>
                                        <span class="renew-pending-value">@RenewalStatusLabel(item)</span>
                                    </div>
                                    <div class="renew-pending-row">
                                        <span class="renew-pending-label">@L["RenewMonthsLabel"]</span>
                                        <span class="renew-pending-value tabular-nums">@L["DurationInMonths", item.RequestedMonths]</span>
                                    </div>
                                    <div class="renew-pending-row">
                                        <span class="renew-pending-label">@L["RenewPendingSentAtLabel"]</span>
                                        <span class="renew-pending-value tabular-nums">@DateFormatter.Format(DateOnly.FromDateTime(VietnamTime.ToVietnam(item.RequestedAt)))</span>
                                    </div>
                                    @if (item.DecidedAt is { } decidedAt)
                                    {
                                        <div class="renew-pending-row">
                                            <span class="renew-pending-label">@L["RenewDecidedAtLabel"]</span>
                                            <span class="renew-pending-value tabular-nums">@DateFormatter.Format(DateOnly.FromDateTime(VietnamTime.ToVietnam(decidedAt)))</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.RejectReason))
                                    {
                                        <div class="renew-pending-note">
                                            <span class="renew-pending-label">@L["RenewRejectReasonLabel"]</span>
                                            <p>@item.RejectReason</p>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.Note))
                                    {
                                        <div class="renew-pending-note">
                                            <span class="renew-pending-label">@L["RenewNoteLabel"]</span>
                                            <p>@item.Note</p>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </div>

            <div class="leased-room-dialog-actions">
                <button type="button" class="btn btn-secondary"
                        disabled="@_renewSubmitting"
                        @onclick="CloseRenewModal">
                    @L["Close"]
                </button>
                @if (!_onHistoryTab && !HasPendingRenewal)
                {
                    <button type="button" class="btn btn-primary"
                            disabled="@_renewSubmitting"
                            @onclick="SubmitRenewAsync">
                        @if (_renewSubmitting)
                        {
                            <span class="spinner" aria-hidden="true"></span>
                            <span>@L["RenewSubmitting"]</span>
                        }
                        else
                        {
                            <LucideIcon Name="send" />
                            <span>@L["RenewSubmit"]</span>
                        }
                    </button>
                }
                else if (!_onHistoryTab)
                {
                    <button type="button" class="btn btn-primary" @onclick="ShowHistoryTab">
                        <LucideIcon Name="file-text" />
                        <span>@L["RenewTabHistory"]</span>
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    private const int MaxRenewMonths = ContractRenewalRules.MaxRequestedMonths;

    private bool _loading = true;
    private bool _loadFailed;
    private LeasedRoomDetailDto? _leasedRoom;

    private bool _renewModalOpen;
    private string _renewMonthsText = string.Empty;
    private string? _renewNote;
    private string? _renewMonthsError;
    private string? _renewSubmitError;
    private bool _renewSubmitting;
    private IReadOnlyList<ContractRenewalRequestDto> _renewalHistory = [];
    private bool _onHistoryTab;

    private bool HasPendingRenewal => _renewalHistory.Any(request => request.IsPending);

    protected override async Task OnInitializedAsync()
    {
        await LoadRoomAsync();
    }

    private async Task LoadRoomAsync()
    {
        _loading = true;
        _loadFailed = false;
        try
        {
            _leasedRoom = await DocumentService.GetMyLeasedRoomAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the current leased room.");
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadRenewalHistoryAsync()
    {
        _renewalHistory = [];
        if (_leasedRoom is null)
        {
            return;
        }

        try
        {
            var caller = await DocumentService.GetCallerAsync();
            var result = await RenewalService.ListForContractAsync(caller, _leasedRoom.ContractId);
            _renewalHistory = result.Succeeded ? result.Items : [];
        }
        catch (Exception ex)
        {
            // Lịch sử chỉ bổ sung thông tin; không làm hỏng trang phòng đang thuê.
            Logger.LogError(ex, "Failed to load the renewal request history.");
        }
    }

    private string RenewalStatusLabel(ContractRenewalRequestDto request) => request.Status switch
    {
        RenewalRequestStatus.Approved => L["RenewStatusApproved"].Value,
        RenewalRequestStatus.Rejected => L["RenewStatusRejected"].Value,
        _ => L["RenewStatusPending"].Value,
    };

    private async Task OpenRenewModal()
    {
        _renewMonthsError = null;
        _renewSubmitError = null;
        await LoadRenewalHistoryAsync();
        // Đã từng gửi thì mở sẵn tab kết quả để khách thấy ngay trạng thái cũ.
        _onHistoryTab = _renewalHistory.Count > 0;
        _renewModalOpen = true;
    }

    private void ShowRequestTab() => _onHistoryTab = false;

    private void ShowHistoryTab() => _onHistoryTab = true;

    private void CloseRenewModal()
    {
        if (!_renewSubmitting)
        {
            _renewModalOpen = false;
        }
    }

    private async Task SubmitRenewAsync()
    {
        if (_leasedRoom is null || _renewSubmitting)
        {
            return;
        }

        _renewMonthsError = null;
        _renewSubmitError = null;

        if (!int.TryParse(_renewMonthsText, NumberStyles.Integer, CultureInfo.InvariantCulture, out var requestedMonths)
            || requestedMonths < ContractRenewalRules.MinRequestedMonths)
        {
            _renewMonthsError = L["RenewMonthsRequired"].Value;
            return;
        }

        if (requestedMonths > MaxRenewMonths)
        {
            _renewMonthsError = L["RenewMonthsTooLarge", MaxRenewMonths].Value;
            return;
        }

        _renewSubmitting = true;
        try
        {
            var caller = await DocumentService.GetCallerAsync();
            var result = await RenewalService.SubmitAsync(
                caller, _leasedRoom.ContractId, requestedMonths, _renewNote);

            if (result.Succeeded)
            {
                Toasts.Success(L["RenewRequestSuccess", requestedMonths].Value);
                await LoadRenewalHistoryAsync();
                _onHistoryTab = true;
                _renewMonthsText = string.Empty;
                _renewNote = null;
                return;
            }

            _renewSubmitError = RenewErrorText(result);
            if (result.ErrorCode == ContractRenewalErrorCodes.DuplicatePending)
            {
                await LoadRenewalHistoryAsync();
                _onHistoryTab = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to submit a contract renewal request.");
            _renewSubmitError = L["RenewRequestFailed"].Value;
        }
        finally
        {
            _renewSubmitting = false;
        }
    }

    private string RenewErrorText(ContractRenewalResult result) => result.ErrorCode switch
    {
        ContractRenewalErrorCodes.Forbidden => L["RenewErrorForbidden"].Value,
        ContractRenewalErrorCodes.ContractNotFound => L["RenewErrorContractNotFound"].Value,
        ContractRenewalErrorCodes.InvalidStatus => L["RenewErrorInvalidStatus"].Value,
        ContractRenewalErrorCodes.InvalidMonths => L["RenewMonthsRequired"].Value,
        ContractRenewalErrorCodes.NoteTooLong => L["RenewErrorNoteTooLong"].Value,
        ContractRenewalErrorCodes.DuplicatePending => L["RenewErrorDuplicatePending"].Value,
        _ => L["RenewRequestFailed"].Value
    };

    private static int? GetDurationMonths(DateTime start, DateTime end) =>
        LeaseDurationRules.FullMonths(start, end);

    private string GetContractStatusLabel() => _leasedRoom?.StatusLabel switch
    {
        "Approved" or "Active" => L["ContractStatusApproved"],
        "Pending" or "PendingApproval" => L["ContractStatusPending"],
        "Rejected" => L["ContractStatusRejected"],
        "Expired" or "Liquidated" => L["ContractStatusExpired"],
        "Cancelled" => L["ContractStatusCancelled"],
        _ => L["NoData"]
    };

    private static string Initial(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "K";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts[^1][..1].ToUpperInvariant();
    }
}
