@using Web.Features.Tenants.Documents
@inject IStringLocalizer<Shared> L

@if (Visible && Document is not null)
{
    <div role="dialog" aria-modal="true" aria-labelledby="preview-title" data-dialog-dismiss
         style="position: fixed; inset: 0; z-index: 400; display: flex; align-items: center; justify-content: center; padding: 1rem; background-color: var(--overlay);"
         @onclick="OnClose">
        <div style="position: relative; z-index: 410; width: 100%; max-width: 680px; background-color: var(--surface); border-radius: 16px; box-shadow: 0 24px 64px var(--shadow-dialog); overflow: hidden; display: flex; flex-direction: column; max-height: 90vh;"
             @onclick:stopPropagation="true">
            
            <!-- Header -->
            <div style="background-color: var(--page-bg); padding: 16px 24px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="width: 36px; height: 36px; border-radius: 8px; background-color: var(--accent-soft); color: var(--primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        @if (IsImage(Document.FileName))
                        {
                            <LucideIcon Name="image" />
                        }
                        else
                        {
                            <LucideIcon Name="file-text" />
                        }
                    </div>
                    <div>
                        <h3 id="preview-title" style="font-size: 16px; font-weight: 700; color: var(--text-primary); margin: 0; line-height: 1.3;">
                            @Document.FileName
                        </h3>
                        <p style="font-size: 12px; color: var(--text-muted); margin: 2px 0 0 0;">
                            @GetCategoryName(Document.Description) · @NumberFormatter.FileSize(Document.FileSizeBytes)
                        </p>
                    </div>
                </div>

                <div style="display: flex; align-items: center; gap: 8px;">
                    @if (CanDownload)
                    {
                        <a href="/api/tenants/@TenantId/documents/@Document.Id" target="_blank" rel="noopener noreferrer" download="@Document.FileName"
                           style="display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 14px; border-radius: 8px; background-color: var(--primary); color: var(--on-primary); font-size: 13px; font-weight: 500; text-decoration: none; box-shadow: var(--shadow-card);">
                            <LucideIcon Name="download" />
                            <span>@L["DownloadDocumentSecure"]</span>
                        </a>
                    }
                    <button type="button"
                            style="width: 44px; height: 44px; border-radius: 8px; color: var(--text-muted); background: transparent; border: none; display: flex; align-items: center; justify-content: center; cursor: pointer;"
                            aria-label="@L["Close"]"
                            @onclick="OnClose">
                        <LucideIcon Name="x" />
                    </button>
                </div>
            </div>

            <!-- Preview Area -->
            <div style="padding: 24px; overflow-y: auto; background-color: var(--surface-subtle); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px;">
                @if (!string.IsNullOrWhiteSpace(DocumentUrl) && IsImage(Document.FileName))
                {
                    <img src="@DocumentUrl"
                         alt="@Document.FileName"
                         style="max-width: 100%; max-height: 65vh; object-fit: contain; border-radius: 8px; border: 1px solid var(--border); background-color: var(--surface);" />
                }
                else
                {
                    <div style="width: 100%; max-width: 500px; min-height: 220px; background-color: var(--surface); border-radius: 12px; border: 1px solid var(--border); padding: 32px 24px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; text-align: center;">
                        <div style="width: 56px; height: 56px; border-radius: 12px; background-color: var(--accent-soft); color: var(--primary); display: flex; align-items: center; justify-content: center;">
                            <LucideIcon Name="file-text" />
                        </div>
                        <p style="margin: 0; font-size: 14px; font-weight: 600; color: var(--text-primary); overflow-wrap: anywhere;">
                            @Document.FileName
                        </p>
                        <p style="margin: 0; font-size: 13px; color: var(--text-secondary);">
                            @L["PreviewNotAvailable"]
                        </p>
                    </div>
                }

                @if (NoteText is { } note)
                {
                    <div style="width: 100%; max-width: 500px; padding: 12px; border-radius: 8px; background-color: var(--page-bg); border: 1px solid var(--border); font-size: 12px; color: var(--text-secondary);">
                        <span style="font-weight: 600; color: var(--text-primary);">@L["Notes"]:</span> @note
                    </div>
                }
            </div>

            <!-- Modal Footer -->
            <div style="background-color: var(--page-bg); padding: 12px 24px; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; font-size: 12px; color: var(--text-muted);">
                <span>@L["DocumentCode"]: @Document.Id.ToString()[..8].ToUpperInvariant()</span>
                <button type="button"
                        style="min-height: 44px; padding: 6px 16px; border-radius: 8px; background-color: var(--surface); border: 1px solid var(--neutral-border); color: var(--text-secondary); font-weight: 500; cursor: pointer;"
                        @onclick="OnClose">
                    @L["Close"]
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public int TenantId { get; set; }
    [Parameter] public bool CanDownload { get; set; } = true;
    [Parameter] public TenantDocumentMetadataDto? Document { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string DocumentUrl =>
        TenantId > 0 && Document is not null
            ? $"/api/tenants/{TenantId}/documents/{Document.Id}"
            : string.Empty;

    private string? NoteText
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Document?.Description)) return null;

            var text = Document!.Description.Trim();
            if (text.StartsWith('['))
            {
                var end = text.IndexOf(']');
                if (end > 1) text = text[(end + 1)..].Trim();
            }

            return string.IsNullOrWhiteSpace(text) ? null : text;
        }
    }

    private static bool IsImage(string fileName)
    {
        var ext = Path.GetExtension(fileName).ToLowerInvariant();
        return ext is ".jpg" or ".jpeg" or ".png";
    }

    private string GetCategoryName(string? description) =>
        L[TenantDocumentCategoryRules.LabelResourceKey(description)];
}
