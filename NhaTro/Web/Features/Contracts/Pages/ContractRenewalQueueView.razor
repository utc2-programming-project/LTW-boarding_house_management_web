@page "/contracts/renewals"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "ContractManage")]
@using Microsoft.AspNetCore.Authorization
@using Web.Common.Utils
@using Web.Features.Contracts
@using Web.Features.Contracts.Components
@using Web.Features.Contracts.DTOs
@using Web.Features.Contracts.Services
@using Web.Infrastructure.Time
@using Web.Components.Shared.Feedback
@inject ContractRenewalPageService Renewals
@inject IStringLocalizer<ContractResources> L
@inject IStringLocalizer<Shared> SL
@inject ToastService Toasts

<PageTitle>@L["RenewalQueueTitle"]</PageTitle>

<section class="renewal-queue-page page-stack" aria-labelledby="renewal-queue-title">
    <PageHeading Title="@L["RenewalQueueTitle"]" TitleId="renewal-queue-title" HelpText="@L["RenewalQueueDescription"]">
        <Actions>
            <button type="button" class="btn btn-secondary" disabled="@_loading" @onclick="LoadAsync"><LucideIcon Name="refresh-cw" />@L["RenewalQueueRefresh"]</button>
            <a class="btn btn-secondary" href="/contracts"><LucideIcon Name="arrow-left" />@L["ContractBackToList"]</a>
        </Actions>
    </PageHeading>

    @if (_items.Count > 0)
    {
        <div class="filter-bar filter-bar--panel">
            <div class="filter-bar__row">
                <div class="filter-bar__search">
                    <label class="sr-only" for="renewal-keyword">@L["RenewalQueueSearchPlaceholder"]</label>
                    <span class="filter-bar__icon" aria-hidden="true"><LucideIcon Name="search" /></span>
                    <input id="renewal-keyword" type="search" class="input" autocomplete="off"
                           placeholder="@L["RenewalQueueSearchPlaceholder"]"
                           @bind="_keyword" @bind:event="oninput" @bind:after="ResetPage" />
                </div>
                <div class="filter-bar__field filter-bar__select">
                    <label class="sr-only" for="renewal-property">@L["ContractPropertyLabel"]</label>
                    <select id="renewal-property" class="input" value="@_propertyFilter" @onchange="HandlePropertyChanged">
                        <option value="all">@L["ContractFilterPropertyAll"]</option>
                        @foreach (var propertyName in PropertyOptions)
                        {
                            <option value="@propertyName">@propertyName</option>
                        }
                    </select>
                </div>
                <div class="filter-bar__actions">
                    <div class="filter-bar__state">
                        <label class="sr-only" for="renewal-page-size">@SL["P2RowsPerPage"]</label>
                        <select id="renewal-page-size" class="input" value="@_pageSize" @onchange="ChangePageSize">
                            <option value="10">@string.Format(SL["RowsPerPageOption"].Value, 10)</option>
                            <option value="20">@string.Format(SL["RowsPerPageOption"].Value, 20)</option>
                            <option value="50">@string.Format(SL["RowsPerPageOption"].Value, 50)</option>
                        </select>
                    </div>
                    <FilterResetButton OnClick="ResetFilters" />
                </div>
            </div>
        </div>
    }

    @if (_loading)
    {
        <LoadingOverlay Visible="true" Text="@L["TableLoading"]" />
    }
    else if (_failed)
    {
        <EmptyStateCard Title="@L["RenewalQueueLoadErrorTitle"]" Description="@L["RenewalQueueLoadErrorDescription"]">
            <button class="btn btn-secondary" @onclick="LoadAsync">@L["ContractRetry"]</button>
        </EmptyStateCard>
    }
    else if (_items.Count == 0)
    {
        <EmptyStateCard Title="@L["RenewalQueueEmptyTitle"]" Description="@L["RenewalQueueEmptyDescription"]" />
    }
    else if (FilteredItems.Count == 0)
    {
        <EmptyStateCard Title="@L["RenewalQueueFilterEmptyTitle"]" Description="@L["RenewalQueueFilterEmptyDescription"]">
            <button type="button" class="btn btn-secondary" @onclick="ResetFilters">
                <LucideIcon Name="refresh-cw" /> @L["RenewalQueueResetFilters"]
            </button>
        </EmptyStateCard>
    }
    else
    {
        <div class="renewal-table-wrap">
            <table class="renewal-table">
                <thead><tr>
                    <th>@L["ContractNumberLabel"]</th><th>@L["RenewalRequesterLabel"]</th><th>@L["ContractRoomLabel"]</th>
                    <th>@L["ContractPropertyLabel"]</th><th class="numeric">@L["RenewalMonthsLabel"]</th>
                    <th>@L["RenewalCurrentEndLabel"]</th><th>@L["RenewalProposedEndLabel"]</th><th>@L["RenewalSentAtLabel"]</th>
                    <th>@L["ContractActionsLabel"]</th>
                </tr></thead>
                <tbody>
                @foreach (var item in PagedItems)
                {
                    <tr>
                        <td><a href="@($"/contracts/{item.ContractId}")">@item.ContractNumber</a></td>
                        <td>@item.RequesterName</td><td>@item.RoomCode</td><td>@item.PropertyName</td>
                        <td class="numeric tabular-nums">@L["RenewalMonthsValue", item.RequestedMonths]</td>
                        <td class="tabular-nums">@DateFormatter.Format(DateOnly.FromDateTime(item.CurrentEndDate))</td>
                        <td class="tabular-nums">@DateFormatter.Format(DateOnly.FromDateTime(item.ProposedEndDate))</td>
                        <td class="tabular-nums">@DateFormatter.Format(DateOnly.FromDateTime(VietnamTime.ToVietnam(item.RequestedAt)))</td>
                        <td class="renewal-row-actions">
                            <button class="btn btn-primary" @onclick="() => OpenDecision(item)">@L["RenewalDecideAction"]</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <TablePager Page="_page" TotalPages="TotalPages" From="FirstItem" To="LastItem" Total="FilteredItems.Count"
                    PageChanged="GoToPage" />
    }
</section>

<ContractRenewalDecisionModal Visible="_decisionOpen" IsBusy="_decisionBusy" Request="_decisionRequest"
                               OnClose="CloseDecision" OnDecide="DecideAsync" />

@code {
    private IReadOnlyList<RenewalRequestItemDto> _items = [];
    private bool _loading = true;
    private bool _failed;
    private bool _decisionOpen;
    private bool _decisionBusy;
    private RenewalRequestItemDto? _decisionRequest;
    private string? _keyword;
    private string _propertyFilter = "all";
    private int _page = 1;
    private int _pageSize = 20;

    private IEnumerable<string> PropertyOptions => _items
        .Select(item => item.PropertyName)
        .Where(name => !string.IsNullOrWhiteSpace(name))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(name => name, StringComparer.CurrentCultureIgnoreCase);

    private IReadOnlyList<RenewalRequestItemDto> FilteredItems
    {
        get
        {
            IEnumerable<RenewalRequestItemDto> query = _items;

            if (!string.IsNullOrWhiteSpace(_keyword))
            {
                var keyword = _keyword.Trim();
                query = query.Where(item =>
                    Contains(item.ContractNumber, keyword)
                    || Contains(item.RequesterName, keyword)
                    || Contains(item.RoomCode, keyword)
                    || Contains(item.PropertyName, keyword));
            }

            if (_propertyFilter != "all")
            {
                query = query.Where(item => string.Equals(item.PropertyName, _propertyFilter, StringComparison.OrdinalIgnoreCase));
            }

            return query.ToList();
        }
    }

    private IReadOnlyList<RenewalRequestItemDto> PagedItems => FilteredItems
        .Skip((_page - 1) * _pageSize)
        .Take(_pageSize)
        .ToList();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredItems.Count / (double)_pageSize));

    private int FirstItem => FilteredItems.Count == 0 ? 0 : (_page - 1) * _pageSize + 1;

    private int LastItem => Math.Min(_page * _pageSize, FilteredItems.Count);

    private static bool Contains(string? value, string keyword) =>
        !string.IsNullOrWhiteSpace(value) && value.Contains(keyword, StringComparison.CurrentCultureIgnoreCase);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private void ResetPage() => _page = 1;

    private void HandlePropertyChanged(ChangeEventArgs e)
    {
        _propertyFilter = e.Value?.ToString() ?? "all";
        _page = 1;
    }

    private void ResetFilters()
    {
        _keyword = null;
        _propertyFilter = "all";
        _page = 1;
    }

    private void ChangePageSize(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size is 10 or 20 or 50)
        {
            _pageSize = size;
            _page = 1;
        }
    }

    private void GoToPage(int page) => _page = PaginationHelper.ClampPage(page, TotalPages);

    private async Task LoadAsync()
    {
        _loading = true;
        _failed = false;
        try
        {
            var result = await Renewals.ListPendingAsync();
            if (result.Succeeded)
            {
                _items = result.Items;
            }
            else
            {
                _failed = true;
                Toasts.Error(ErrorText(result.ErrorCode));
            }
        }
        catch
        {
            _failed = true;
            Toasts.Error(L["RenewalQueueLoadErrorDescription"]);
        }
        finally
        {
            _loading = false;
        }

        if (_page > TotalPages)
        {
            _page = TotalPages;
        }
    }

    private void OpenDecision(RenewalRequestItemDto item)
    {
        _decisionRequest = item;
        _decisionOpen = true;
    }

    private Task CloseDecision()
    {
        if (!_decisionBusy)
        {
            _decisionOpen = false;
        }

        return Task.CompletedTask;
    }

    private async Task DecideAsync(RenewalDecisionRequest decision)
    {
        if (_decisionRequest is null)
        {
            return;
        }

        _decisionBusy = true;
        try
        {
            var result = await Renewals.DecideAsync(_decisionRequest.Id, decision);
            if (!result.Succeeded)
            {
                Toasts.Error(ErrorText(result.ErrorCode));
                return;
            }

            Toasts.Success(DecisionToastText(decision, result));
            _decisionOpen = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toasts.Error(ex is IContractServiceError error
                ? ErrorText(error.ErrorCode)
                : L["RenewalGenericError"].Value);
        }
        finally
        {
            _decisionBusy = false;
        }
    }

    private string DecisionToastText(RenewalDecisionRequest decision, ContractRenewalResult result) =>
        result.AwaitingOwnerApproval
            ? L["RenewalPendingOwnerApproval"].Value
            : L[decision.IsApproved ? "RenewalAcceptSuccess" : "RenewalRejectSuccess"].Value;

    private string ErrorText(string? errorCode)
    {
        if (errorCode is null)
        {
            return L["RenewalGenericError"].Value;
        }

        // Thông điệp P4 là tiếng Việt cố định nên không hiển thị trực tiếp: dùng bản dịch theo ngôn ngữ UI.

        return L[$"RenewalError{errorCode}"].Value;
    }
}
