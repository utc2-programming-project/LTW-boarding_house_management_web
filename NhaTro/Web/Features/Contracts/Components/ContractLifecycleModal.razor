@using Web.Common.Utils
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IStringLocalizer<ContractResources> L

<dialog @ref="_dialog" class="contract-modal" aria-modal="true" aria-labelledby="contract-lifecycle-title" @onclick="CloseAsync">
    <section class="contract-modal-panel" @onclick:stopPropagation="true">
        <h2 id="contract-lifecycle-title">@L[IsRenewal ? "ContractRenewTitle" : "ContractLiquidateTitle"]</h2>
        <p>@L[IsRenewal ? "ContractRenewDescription" : "ContractLiquidateDescription"]</p>
        @if (IsRenewal)
        {
            <label for="contract-renew-end-date">@L["ContractRenewEndDateLabel"]</label>
            <input id="contract-renew-end-date" class="input" type="date"
                   min="@MinEndDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)"
                   @bind="_endDate" @bind:format="yyyy-MM-dd" disabled="@IsBusy" />
            @if (_showDateError) { <p class="contract-field-error" role="alert">@L["ContractErrorInvalidRenewalEndDate"]</p> }
            <p class="contract-modal-hint">@string.Format(L["ContractRenewStartHint"], DateFormatter.Format(DateOnly.FromDateTime(EndDate.AddDays(1))))</p>
        }
        <footer>
            <button type="button" class="btn btn-secondary" disabled="@IsBusy" @onclick="CloseAsync">@L["ContractCancelAction"]</button>
            <button type="button" class="btn btn-primary" disabled="@IsBusy" @onclick="SubmitAsync">
                @L[IsBusy ? "ContractProcessing" : IsRenewal ? "ContractRenewAction" : "ContractLiquidateAction"]
            </button>
        </footer>
    </section>
</dialog>

@code {
    private const string ModulePath = "./Features/Contracts/Components/ContractLifecycleModal.razor.js";

    [Parameter] public bool Visible { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public bool IsRenewal { get; set; }
    [Parameter] public DateTime EndDate { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<DateTime?> OnConfirm { get; set; }

    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private IJSObjectReference? _registration;
    private DotNetObjectReference<ContractLifecycleModal>? _self;
    private DateTime _endDate;
    private bool _showDateError;
    private bool _wasVisible;
    private bool _openInDom;

    private DateTime MinEndDate => EndDate.AddDays(1);

    protected override void OnParametersSet()
    {
        if (Visible && !_wasVisible)
        {
            _endDate = EndDate.AddYears(1);
            _showDateError = false;
        }
        _wasVisible = Visible;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_module is null)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _self = DotNetObjectReference.Create(this);
            _registration = await _module.InvokeAsync<IJSObjectReference>("register", _dialog, _self);
        }

        if (Visible == _openInDom) return;

        await _module.InvokeVoidAsync(Visible ? "open" : "close", _dialog);
        _openInDom = Visible;
    }

    private Task CloseAsync() => IsBusy ? Task.CompletedTask : OnClose.InvokeAsync();

    [JSInvokable]
    public Task RequestCloseAsync() => InvokeAsync(CloseAsync);

    private async Task SubmitAsync()
    {
        if (!IsRenewal)
        {
            await OnConfirm.InvokeAsync(null);
            return;
        }

        _showDateError = _endDate.Date <= EndDate.Date;
        if (_showDateError) return;

        await OnConfirm.InvokeAsync(_endDate.Date);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_registration is not null)
            {
                await _registration.InvokeVoidAsync("dispose");
                await _registration.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }

        _self?.Dispose();
    }
}
