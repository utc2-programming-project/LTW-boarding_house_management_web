@using Web.Features.Contracts.DTOs
@using Web.Features.Contracts
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IStringLocalizer<ContractResources> L

<dialog @ref="_dialog" class="contract-modal" aria-modal="true" aria-labelledby="contract-decision-title" @onclick="CloseAsync">
    <section class="contract-modal-panel" @onclick:stopPropagation="true">
        <h2 id="contract-decision-title">@L["ContractDecisionTitle"]</h2>
        <p>@L["ContractDecisionDescription"]</p>
        <label for="contract-reject-reason">@L["ContractRejectReasonLabel"]</label>
        <textarea id="contract-reject-reason" class="input" maxlength="500" @bind="_reason" disabled="@IsBusy"></textarea>
        @if (_showReasonError) { <p class="contract-field-error" role="alert">@L["ContractErrorRejectReasonRequired"]</p> }
        <footer>
            <button type="button" class="btn btn-secondary" disabled="@IsBusy" @onclick="CloseAsync">@L["ContractCancelAction"]</button>
            <button type="button" class="btn btn-danger" disabled="@IsBusy" @onclick="RejectAsync">@L["ContractRejectAction"]</button>
            <button type="button" class="btn btn-primary" disabled="@IsBusy" @onclick="ApproveAsync">@L[IsBusy ? "ContractProcessing" : "ContractApproveAction"]</button>
        </footer>
    </section>
</dialog>

@code {
    private const string ModulePath = "./Features/Contracts/Components/ContractApproveModal.razor.js";

    [Parameter] public bool Visible { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<ApproveContractRequestDto> OnDecide { get; set; }

    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private IJSObjectReference? _registration;
    private DotNetObjectReference<ContractApproveModal>? _self;
    private string? _reason;
    private bool _showReasonError;
    private bool _wasVisible;
    private bool _openInDom;

    protected override void OnParametersSet()
    {
        if (Visible && !_wasVisible)
        {
            _reason = null;
            _showReasonError = false;
        }
        _wasVisible = Visible;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // VHT-124: native <dialog>.showModal() cung cap focus trap, tra focus ve nut mo
        // va lop top-layer; Esc duoc chuyen ve .NET de ton trong trang thai IsBusy.
        if (_module is null)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _self = DotNetObjectReference.Create(this);
            _registration = await _module.InvokeAsync<IJSObjectReference>("register", _dialog, _self);
        }

        if (Visible == _openInDom) return;

        await _module.InvokeVoidAsync(Visible ? "open" : "close", _dialog);
        _openInDom = Visible;
    }

    private Task CloseAsync() => IsBusy ? Task.CompletedTask : OnClose.InvokeAsync();

    [JSInvokable]
    public Task RequestCloseAsync() => InvokeAsync(CloseAsync);

    private Task ApproveAsync() => OnDecide.InvokeAsync(new ApproveContractRequestDto { IsApproved = true });

    private Task RejectAsync()
    {
        _showReasonError = string.IsNullOrWhiteSpace(_reason);
        return _showReasonError ? Task.CompletedTask : OnDecide.InvokeAsync(new ApproveContractRequestDto { IsApproved = false, RejectReason = _reason });
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_registration is not null)
            {
                await _registration.InvokeVoidAsync("dispose");
                await _registration.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }

        _self?.Dispose();
    }
}
