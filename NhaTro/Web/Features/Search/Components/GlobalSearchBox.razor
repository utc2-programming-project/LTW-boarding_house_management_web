@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using Web.Components.Shared
@using Web.Features.Search.DTOs
@using Web.Features.Search.Services
@inject GlobalSearchService Search
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<SearchResources> L

<div class="topbar-search global-search" role="search" @ref="_root">
    <span class="topbar-search-icon"><LucideIcon Name="search" /></span>
    <input @ref="_input"
           class="topbar-search-input"
           type="search"
           role="combobox"
           aria-label="@L["SearchPlaceholder"]"
           aria-expanded="@(_open ? "true" : "false")"
           aria-controls="global-search-results"
           aria-activedescendant="@ActiveId"
           aria-autocomplete="list"
           autocomplete="off"
           placeholder="@L["SearchPlaceholder"]"
           value="@_query"
           @onfocus="OpenAsync"
           @onclick="ReopenAsync"
           @onblur="Close"
           @oninput="InputAsync"
           @onkeydown="KeyAsync" />

    @if (_open)
    {
        <div class="global-search-popover" @onmousedown:preventDefault="true">
            @if (_loading)
            {
                <p>@L["SearchLoading"]</p>
            }
            else if (_error)
            {
                <p>@L["SearchError"]</p>
            }
            else if (_items.Count == 0)
            {
                <p>@L["SearchNoResults"]</p>
                @if (_partialError)
                {
                    <p class="global-search-partial">@L["SearchPartialError"]</p>
                }
            }

            <div id="global-search-results" role="listbox" hidden="@(_items.Count == 0)">
                @foreach (var section in _sections)
                {
                    <div class="global-search-group" role="group">
                        <p class="global-search-group-title"><LucideIcon Name="@section.Group.Icon" />@GroupLabel(section.Group)</p>
                        @foreach (var row in section.Rows)
                        {
                            var index = row.Index;
                            <a id="search-option-@index"
                               role="option"
                               aria-selected="@(index == _active ? "true" : "false")"
                               class="@(index == _active ? "active" : null)"
                               href="@row.Hit.Href"
                               @onclick="() => Select(row.Hit)">
                                <LucideIcon Name="@row.Hit.Icon" />
                                <span class="global-search-hit">
                                    <span class="global-search-title">@row.Hit.Title</span>
                                    @if (!string.IsNullOrWhiteSpace(row.Hit.Subtitle))
                                    {
                                        <span class="global-search-subtitle">@row.Hit.Subtitle</span>
                                    }
                                </span>
                            </a>
                        }
                        @if (section.Group.HasMore)
                        {
                            <p class="global-search-more">@L["SearchHasMore"]</p>
                        }
                    </div>
                }
            </div>

            @if (_items.Count > 0)
            {
                @if (_partialError)
                {
                    <p class="global-search-partial">@L["SearchPartialError"]</p>
                }
                <a class="global-search-viewall" href="@($"/search?q={Uri.EscapeDataString(_query.Trim())}")" @onclick="Close">@L["SearchViewAll"]</a>
            }
        </div>
    }
</div>

@code {
    private sealed record Row(SearchHitDto Hit, int Index);
    private sealed record Section(SearchGroupResult Group, IReadOnlyList<Row> Rows);

    private CancellationTokenSource? _cts;
    private ElementReference _input, _root;
    private List<SearchHitDto> _items = [];
    private List<Section> _sections = [];
    private string _query = "";
    private bool _open, _loading, _error, _partialError, _registered;
    private int _active = -1;

    // C02: mọi ngưỡng dùng chung nguồn trim này để UI và truy vấn không lệch nhau.
    private bool HasQuery => _query.Trim().Length >= 2;
    private string? ActiveId => _active >= 0 ? $"search-option-{_active}" : null;

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (_registered) return;
        await JS.InvokeVoidAsync("globalSearch.register", _input, _root);
        _registered = true;
    }

    private string GroupLabel(SearchGroupResult group) =>
        string.IsNullOrEmpty(group.GroupLabelKey) ? group.GroupKey : GroupLabel(group.GroupLabelKey);

    private string GroupLabel(string key)
    {
        var value = L[key];
        return value.ResourceNotFound ? key : value.Value;
    }

    private async Task OpenAsync()
    {
        // C01: trạng thái nhàn rỗng thì không mở dropdown.
        if (!HasQuery) return;
        _open = true;
        await RunAsync();
    }

    // Esc chỉ đóng dropdown chứ không xoá từ khoá; bấm lại vào ô phải mở lại kết quả.
    private async Task ReopenAsync()
    {
        if (_open || !HasQuery) return;
        _open = true;
        await RunAsync();
    }

    private async Task InputAsync(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        _open = HasQuery;
        await RunAsync();
    }

    private async Task RunAsync()
    {
        // C03: hủy và giải phóng CTS cũ để không rò rỉ theo từng keystroke.
        var previous = _cts;
        previous?.Cancel();
        previous?.Dispose();
        var cts = _cts = new CancellationTokenSource();

        _items = [];
        _sections = [];
        _active = -1;
        _error = false;
        _partialError = false;
        _loading = HasQuery;
        if (!_loading) return;

        try
        {
            await Task.Delay(250, cts.Token);
            var response = await Search.SearchAsync(new SearchRequest(_query.Trim(), Limit: 5), cts.Token);
            if (cts != _cts) return;

            var index = 0;
            _sections = response.Groups
                .Select(group => new Section(group, group.Hits.Select(hit => new Row(hit, index++)).ToList()))
                .ToList();
            _items = _sections.SelectMany(section => section.Rows).Select(row => row.Hit).ToList();

            var failed = response.FailedGroups?.Count ?? 0;
            _error = failed > 0 && failed >= response.ProviderCount;
            _partialError = failed > 0 && !_error;
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            if (cts == _cts) _error = true;
        }
        finally
        {
            if (cts == _cts) _loading = false;
        }
    }

    private async Task KeyAsync(KeyboardEventArgs e)
    {
        var changed = false;
        if (e.Key == "Escape")
        {
            Close();
        }
        else if (_open && _items.Count > 0 && e.Key == "ArrowDown")
        {
            _active = (_active + 1) % _items.Count;
            changed = true;
        }
        else if (_open && _items.Count > 0 && e.Key == "ArrowUp")
        {
            _active = (_active + _items.Count - 1) % _items.Count;
            changed = true;
        }
        else if (_open && e.Key == "Enter" && _active >= 0 && _active < _items.Count)
        {
            Select(_items[_active]);
        }

        // C04: cuộn item đang chọn vào vùng nhìn khi điều hướng bằng bàn phím.
        if (changed && ActiveId is not null)
        {
            await JS.InvokeVoidAsync("globalSearch.scrollActive", ActiveId);
        }
    }

    private void Select(SearchHitDto item)
    {
        Navigation.NavigateTo(item.Href);
        Close();
    }

    private void Close()
    {
        // Đóng thì xóa luôn kết quả cũ: dropdown đã ẩn nên giữ lại chỉ khiến
        // phím mũi tên/Enter sau khi Esc vẫn điều hướng được vào item vô hình.
        _open = false;
        _active = -1;
        _items = [];
        _sections = [];
        _cts?.Cancel();
    }

    private void OnLocationChanged(object? s, LocationChangedEventArgs e) =>
        _ = InvokeAsync(() => { Close(); StateHasChanged(); });

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
        if (_registered)
        {
            try { await JS.InvokeVoidAsync("globalSearch.unregister", _root); }
            catch (JSDisconnectedException) { }
        }
    }
}
