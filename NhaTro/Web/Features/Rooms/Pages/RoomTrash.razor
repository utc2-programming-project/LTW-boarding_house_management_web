@page "/rooms/trash"
@attribute [Authorize(Roles = Roles.ChuTro)]
@rendermode InteractiveServer
@inject RoomPageService PageService
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject IStringLocalizer<Shared> L
@inject ILogger<RoomTrash> Logger

<PageTitle>@L["P2TrashTitle"] · @L["AppName"]</PageTitle>

<div class="page-stack">
    <PageHeading Title="@L["P2TrashTitle"]" HelpText="@L["P2TrashSubtitle"]">
        <Actions>
            <button class="btn btn-danger" type="button" @onclick="OpenEmptyTrash">
                <LucideIcon Name="trash" />@L["EmptyTrash"]
            </button>
            <button class="btn btn-secondary" type="button" @onclick="GoToRooms">
                <LucideIcon Name="door" />@L["P2RoomsTitle"]
            </button>
        </Actions>
    </PageHeading>

    <div class="filter-bar filter-bar--panel">
        <div class="filter-bar__row">
            <div class="filter-bar__search">
                <label class="sr-only" for="room-trash-search">@L["P2RoomCode"]</label>
                <span class="filter-bar__icon" aria-hidden="true"><LucideIcon Name="search" /></span>
                <input id="room-trash-search" type="search" class="input"
                       placeholder="@L["P2SearchRooms"]" @bind="_keyword" @bind:after="ReloadAsync" />
            </div>
            <div class="filter-bar__actions">
                <div class="filter-bar__state">
                    <label class="sr-only" for="trash-page-size">@L["P2RowsPerPage"]</label>
                    <select id="trash-page-size" class="input" value="@_pageSize" @onchange="ChangePageSize">
                        <option value="10">@string.Format(L["RowsPerPageOption"].Value, 10)</option>
                        <option value="20">@string.Format(L["RowsPerPageOption"].Value, 20)</option>
                        <option value="50">@string.Format(L["RowsPerPageOption"].Value, 50)</option>
                    </select>
                </div>
                <FilterResetButton OnClick="ClearSearchAsync" />
            </div>
        </div>
    </div>

    <DataTable @ref="_table" @key="_tableKey" TItem="RoomTrashItem" Columns="_columns"
               ItemsProvider="LoadDeletedAsync" PageSize="_pageSize" AllowOverflow="true"
               Caption="@L["P2TrashTable"]" Labels="_tableLabels">
        <EmptyActions>
            <button class="btn btn-secondary" type="button" @onclick="GoToRooms">@L["P2RoomsTitle"]</button>
        </EmptyActions>
    </DataTable>
</div>

<ConfirmDialog Visible="_restoreVisible" Title="@L["P2TrashRestoreTitle"]"
               Message="@L["P2TrashRestoreConfirm", _restoreRoom?.Code ?? string.Empty]"
               ConfirmText="@L["Restore"]" CancelText="@L["Cancel"]"
               BusyText="@L["P2TrashRestoring"]"
               OnConfirm="RestoreAsync" OnCancel="CancelRestore" />

<PurgeConfirmDialog Visible="_purgeVisible" Title="@L["PurgeTitle"]"
                    Message="@string.Format(L["PurgeMessage"], _purgeItem?.Code ?? string.Empty)"
                    ExpectedText="@(_purgeItem?.Code ?? string.Empty)"
                    PromptText="@string.Format(L["PurgeTypePrompt"], _purgeItem?.Code ?? string.Empty)"
                    MismatchText="@L["PurgeMismatch"]"
                    ConfirmText="@L["Purge"]" CancelText="@L["Cancel"]"
                    OnConfirm="PurgeAsync" OnCancel="CancelPurge" />

<PurgeConfirmDialog Visible="_emptyVisible" Title="@L["EmptyTrashTitle"]"
                    Message="@L["EmptyTrashMessage"]"
                    ExpectedText="@L["TrashEmptyPhrase"]"
                    PromptText="@string.Format(L["PurgeTypePrompt"], L["TrashEmptyPhrase"].Value)"
                    MismatchText="@L["PurgeMismatch"]"
                    ConfirmText="@L["EmptyTrash"]" CancelText="@L["Cancel"]"
                    OnConfirm="EmptyTrashAsync" OnCancel="CancelEmptyTrash" />

@code {
    private DataTable<RoomTrashItem>? _table;
    private IReadOnlyList<DataTableColumn<RoomTrashItem>> _columns = [];
    private DataTableLabels _tableLabels = new();
    private RoomTrashItem? _restoreRoom;
    private RoomTrashItem? _purgeItem;
    private bool _restoreVisible;
    private bool _purgeVisible;
    private bool _emptyVisible;
    private int _pageSize = 20;
    private int _tableKey;
    private string _keyword = string.Empty;

    protected override void OnInitialized()
    {
        _tableLabels = DataTableLabelLocalizer.Create(L);
        _columns = BuildColumns();
    }

    private IReadOnlyList<DataTableColumn<RoomTrashItem>> BuildColumns()
    {
        RenderFragment<RoomTrashItem> status = item =>
            @<StatusBadge Text="@StatusText(item.Status)" Tone="@StatusTone(item.Status)" />;
        RenderFragment<RoomTrashItem> actions = item => @<TrashRowMenu RestoreText="@L["Restore"]" PurgeText="@L["Purge"]"
            OnRestore="() => RequestRestore(item)" OnPurge="() => RequestPurge(item)" />;

        return
        [
            new() { Key = "code", Title = L["P2RoomCode"], Value = item => item.Code },
            new() { Key = "property", Title = L["P2Property"], Value = item => item.PropertyName },
            new() { Key = "floor", Title = L["P2Floor"], Value = item => item.Floor?.ToString(CultureInfo.CurrentCulture) ?? L["P2NotProvided"].Value, IsNumeric = true },
            new() { Key = "price", Title = L["P2StandardPrice"], Value = item => MoneyFormatter.Format(item.StandardPrice), IsNumeric = true },
            new() { Key = "status", Title = L["P2Status"], Template = status },
            new() { Key = "deletedAt", Title = L["P2TrashDeletedAt"], Value = item => DateFormatter.FormatDateTime(item.DeletedAt) },
            new() { Key = "actions", Title = L["P2Actions"], Template = actions }
        ];
    }

    private async Task<PagedResult<RoomTrashItem>> LoadDeletedAsync(DataTableRequest request) =>
        await PageService.ListDeletedAsync(new RoomFilter
        {
            Page = request.Page,
            PageSize = request.PageSize,
            Keyword = string.IsNullOrWhiteSpace(_keyword) ? null : _keyword.Trim()
        });

    private Task ClearSearchAsync()
    {
        _keyword = string.Empty;
        return ReloadAsync();
    }

    private Task ReloadAsync()
    {
        // Tạo lại bảng để tìm kiếm luôn bắt đầu từ trang 1 (DataTable giữ trang nội bộ).
        _tableKey++;
        return Task.CompletedTask;
    }

    private Task ChangePageSize(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value) && value is 10 or 20 or 50)
        {
            _pageSize = value;
            _tableKey++;
        }

        return Task.CompletedTask;
    }

    private void RequestRestore(RoomTrashItem item)
    {
        _restoreRoom = item;
        _restoreVisible = true;
    }

    private void CancelRestore()
    {
        _restoreVisible = false;
        _restoreRoom = null;
    }

    private async Task RestoreAsync()
    {
        if (_restoreRoom is null)
        {
            CancelRestore();
            return;
        }

        try
        {
            var result = await PageService.RestoreAsync(_restoreRoom.Id);
            if (result.Succeeded)
            {
                Toasts.Success(L["P2TrashRestored"]);
                CancelRestore();
                if (_table is not null)
                {
                    await _table.ReloadAsync();
                }

                return;
            }

            Toasts.Error(result.ErrorCode switch
            {
                RoomErrorCodes.DuplicateRoomCode => L["P2RestoreDuplicateCode"],
                RoomErrorCodes.PropertyDeleted => L["P2RestorePropertyDeleted"],
                RoomErrorCodes.Forbidden => L["P2Forbidden"],
                RoomErrorCodes.RoomNotFound => L["P2RoomNotFound"],
                _ => L["P2TrashRestoreFailed"]
            });
            CancelRestore();
        }
        catch (UnauthorizedAccessException)
        {
            Toasts.Error(L["P2Forbidden"]);
            CancelRestore();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "P2 room restore failed");
            Toasts.Error(L["P2TrashRestoreFailed"]);
            CancelRestore();
        }
    }

    private void RequestPurge(RoomTrashItem item)
    {
        _purgeItem = item;
        _purgeVisible = true;
    }

    private void CancelPurge()
    {
        _purgeVisible = false;
        _purgeItem = null;
    }

    private void OpenEmptyTrash() => _emptyVisible = true;

    private void CancelEmptyTrash() => _emptyVisible = false;

    private async Task PurgeAsync()
    {
        if (_purgeItem is null)
        {
            CancelPurge();
            return;
        }

        var result = await PageService.PurgeAsync(_purgeItem.Id);
        CancelPurge();
        if (!result.Succeeded)
        {
            Toasts.Error(result.ErrorCode == RoomErrorCodes.RoomHasDependencies
                ? L["PurgeHasDependencies"]
                : L["PurgeFailed"]);
            return;
        }

        Toasts.Success(L["PurgeSuccess"]);
        if (_table is not null) await _table.ReloadAsync();
    }

    private async Task EmptyTrashAsync()
    {
        var summary = await PageService.PurgeAllAsync();
        CancelEmptyTrash();
        if (summary.Purged == 0 && summary.Skipped == 0)
        {
            Toasts.Success(L["EmptyTrashNothing"]);
        }
        else
        {
            Toasts.Success(string.Format(L["EmptyTrashSuccess"], summary.Purged, summary.Skipped));
        }

        if (_table is not null) await _table.ReloadAsync();
    }

    private void GoToRooms() => Navigation.NavigateTo("/rooms");

    private string StatusText(RoomStatus status) => status switch
    {
        RoomStatus.Available => L["P2StatusAvailable"],
        RoomStatus.Rented => L["P2StatusRented"],
        RoomStatus.Maintenance => L["P2StatusMaintenance"],
        _ => L["P2StatusUnknown"]
    };

    private static BadgeTone StatusTone(RoomStatus status) => status switch
    {
        RoomStatus.Available => BadgeTone.Success,
        RoomStatus.Rented => BadgeTone.Info,
        RoomStatus.Maintenance => BadgeTone.Warning,
        _ => BadgeTone.Neutral
    };
}
