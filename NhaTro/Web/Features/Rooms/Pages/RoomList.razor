@page "/rooms"
@attribute [Authorize(Roles = Roles.ChuTro + "," + Roles.QuanLy)]
@rendermode InteractiveServer
@implements IDisposable
@inject RoomPageService PageService
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject IStringLocalizer<Shared> L
@inject ILogger<RoomList> Logger

<PageTitle>@L["P2RoomsTitle"] · @L["AppName"]</PageTitle>

<div class="p2-page">
    <PageHeading Title="@L["P2RoomsTitle"]" HelpText="@L["P2RoomsSubtitle"]">
        <Actions>
            @if (_isOwner)
            {
                <div class="p2-page-actions">
                    <a class="btn btn-secondary" href="/rooms/trash">
                        <LucideIcon Name="trash" />@L["P2RoomTrashOpen"]
                    </a>
                    <button class="btn btn-primary" type="button" @onclick="OpenCreate">
                        <LucideIcon Name="plus" />@L["P2AddRoom"]
                    </button>
                </div>
            }
        </Actions>
    </PageHeading>

    @if (_summaryLoading)
    {
        <div class="p2-alert warning" role="status">
            <span class="p2-alert-message">@L["P2Loading"]</span>
        </div>
    }
    else if (_summaryError is not null)
    {
        <div class="p2-alert warning" role="status">
            <span>@_summaryError</span>
            <button class="btn btn-secondary" type="button" @onclick="LoadSummaryAsync">@L["Retry"]</button>
        </div>
    }

    else if (_summary is not null)
    {
        <section class="stat-grid" aria-label="@L["P2RoomSummary"]">
            <article class="stat-card">
                <div class="stat-card__top">
                    <span class="stat-label">
                        @L["P2TotalRooms"]
                        <button type="button" class="stat-help" data-tip="@L["P2RoomsInScope"]" aria-label="@L["P2RoomsInScope"]">?</button>
                    </span>
                    <span class="stat-icon stat-icon--accent"><LucideIcon Name="door" /></span>
                </div>
                <div class="stat-value">@_summary.Total <small>@L["P2RoomUnit"]</small></div>
            </article>
            <article class="stat-card">
                <div class="stat-card__top">
                    <span class="stat-label">
                        @L["P2Available"]
                        <button type="button" class="stat-help" data-tip="@L["P2ReadyForRent"]" aria-label="@L["P2ReadyForRent"]">?</button>
                    </span>
                    <span class="stat-icon stat-icon--success"><LucideIcon Name="unlock" /></span>
                </div>
                <div class="stat-value">@_summary.Available <small>@L["P2RoomUnit"]</small></div>
            </article>
            <article class="stat-card">
                <div class="stat-card__top">
                    <span class="stat-label">
                        @L["P2Rented"]
                        <button type="button" class="stat-help" data-tip="@L["P2CurrentlyOccupied"]" aria-label="@L["P2CurrentlyOccupied"]">?</button>
                    </span>
                    <span class="stat-icon stat-icon--info"><LucideIcon Name="key" /></span>
                </div>
                <div class="stat-value">@_summary.Rented <small>@L["P2RoomUnit"]</small></div>
            </article>
            <article class="stat-card">
                <div class="stat-card__top">
                    <span class="stat-label">
                        @L["P2Maintenance"]
                        <button type="button" class="stat-help" data-tip="@L["P2UnavailableForRent"]" aria-label="@L["P2UnavailableForRent"]">?</button>
                    </span>
                    <span class="stat-icon stat-icon--warning"><LucideIcon Name="wrench" /></span>
                </div>
                <div class="stat-value">@_summary.Maintenance <small>@L["P2RoomUnit"]</small></div>
            </article>
        </section>
    }

    @if (_needsPropertyFirst)
    {
        <div class="p2-alert warning" role="status">
            <span>@L["P2CreatePropertyFirst"]</span>
            <button class="btn btn-secondary" type="button" @onclick="GoToProperties">@L["P2ManageProperties"]</button>
        </div>
    }

    @if (_propertyLoadError is not null)
    {
        <div class="p2-alert error" role="alert">
            <span>@_propertyLoadError</span>
            <button class="btn btn-secondary" type="button" @onclick="InitializeAsync">@L["Retry"]</button>
        </div>
    }
    else if (_initializing)
    {
        <LoadingOverlay Visible="true" Text="@L["P2Loading"]" />
    }
    else if (_ready)
    {
        <section aria-label="@L["P2RoomFilters"]">
            <form class="filter-bar filter-bar--panel" novalidate @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault>
                <div class="filter-bar__row">
                    <div class="filter-bar__search">
                        <label class="sr-only" for="room-keyword">@L["P2SearchRooms"]</label>
                        <span class="filter-bar__icon" aria-hidden="true"><LucideIcon Name="search" /></span>
                        <input id="room-keyword" class="input" type="search" maxlength="50" autocomplete="off"
                               placeholder="@L["P2SearchRooms"]" @bind="_keyword" @bind:event="oninput"
                               @bind:after="OnKeywordChangedAsync" />
                    </div>
                    <div class="filter-bar__field filter-bar__select">
                        <label class="sr-only" for="room-property">@L["P2Property"]</label>
                        <select id="room-property" class="input" @bind="_propertyFilter" @bind:after="ApplyFiltersAsync">
                            <option value="">@L["P2AllProperties"]</option>
                            @foreach (var property in _properties)
                            {
                                <option value="@property.Id">@property.Name</option>
                            }
                        </select>
                    </div>
                    <div class="filter-bar__field filter-bar__select">
                        <label class="sr-only" for="room-status">@L["P2Status"]</label>
                        <select id="room-status" class="input" @bind="_statusFilter" @bind:after="ApplyFiltersAsync">
                            <option value="">@L["P2AllStatuses"]</option>
                            <option value="@((int)RoomStatus.Available)">@L["P2StatusAvailable"]</option>
                            <option value="@((int)RoomStatus.Rented)">@L["P2StatusRented"]</option>
                            <option value="@((int)RoomStatus.Maintenance)">@L["P2StatusMaintenance"]</option>
                        </select>
                    </div>
                    <div class="filter-bar__field filter-bar__select">
                        <label class="sr-only" for="room-activity">@L["P2Activity"]</label>
                        <select id="room-activity" class="input" @bind="_activeFilter" @bind:after="ApplyFiltersAsync">
                            <option value="">@L["P2AllActivity"]</option>
                            <option value="true">@L["P2Active"]</option>
                            <option value="false">@L["P2Inactive"]</option>
                        </select>
                    </div>
                    <div class="filter-bar__actions">
                        <div class="filter-bar__state">
                            <label class="sr-only" for="room-page-size">@L["P2RowsPerPage"]</label>
                            <select id="room-page-size" class="input" value="@_pageSize" @onchange="ChangePageSize">
                                <option value="10">@string.Format(L["RowsPerPageOption"].Value, 10)</option>
                                <option value="20">@string.Format(L["RowsPerPageOption"].Value, 20)</option>
                                <option value="50">@string.Format(L["RowsPerPageOption"].Value, 50)</option>
                            </select>
                        </div>
                        <FilterAdvancedToggle @bind-Expanded="_showAdvanced" ActiveCount="AdvancedFilterCount" PanelId="room-advanced-panel" />
                        <button class="btn btn-secondary filter-bar__reset" type="button" @onclick="ResetFiltersAsync">
                            <LucideIcon Name="refresh-cw" /> @L["P2ResetFilters"]
                        </button>
                    </div>
                </div>
                <div class="filter-bar__advanced" id="room-advanced-panel" hidden="@(!_showAdvanced)">
                    <div class="filter-bar__stack">
                        <label for="room-min-price">@L["P2MinPrice"]</label>
                        <input id="room-min-price" class="input" type="number" min="0" step="1" inputmode="numeric"
                               placeholder="@L["P2AmountPlaceholder"]" @bind="_minPriceText" />
                    </div>
                    <div class="filter-bar__stack">
                        <label for="room-max-price">@L["P2MaxPrice"]</label>
                        <input id="room-max-price" class="input" type="number" min="0" step="1" inputmode="numeric"
                               placeholder="@L["P2AmountPlaceholder"]" @bind="_maxPriceText" />
                    </div>
                    <div class="filter-bar__stack">
                        <label for="room-floor-filter">@L["P2Floor"]</label>
                        <input id="room-floor-filter" class="input" type="number" min="0" max="1000" step="1" inputmode="numeric"
                               placeholder="@L["P2AllFloors"]" @bind="_floorText" />
                    </div>
                    <div class="filter-bar__stack">
                        <label for="room-min-area">@L["P2AreaFrom"]</label>
                        <input id="room-min-area" class="input" type="number" min="0" step="0.01" inputmode="decimal" @bind="_minAreaText" />
                    </div>
                    <div class="filter-bar__stack">
                        <label for="room-max-area">@L["P2AreaTo"]</label>
                        <input id="room-max-area" class="input" type="number" min="0" step="0.01" inputmode="decimal" @bind="_maxAreaText" />
                    </div>
                    <label class="filter-bar__check" for="room-only-available">
                        <input id="room-only-available" type="checkbox" @bind="_onlyAvailable" />
                        <span>@L["P2OnlyAvailable"]</span>
                    </label>
                    <button class="btn btn-primary filter-bar__submit" type="submit">@L["P2ApplyFilters"]</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_filterError))
                {
                    <p class="filter-error" role="alert">@_filterError</p>
                }
                @if (_propertyFilter.Length > 0 && int.TryParse(_propertyFilter, out var propertyId))
                {
                    <div class="filter-bar__chips">
                        <span>@L["P2FilteringByProperty"]</span>
                        <strong>@(_properties.FirstOrDefault(item => item.Id == propertyId)?.Name ?? L["P2Property"])</strong>
                        <button type="button" class="text-button" @onclick="ClearPropertyFilterAsync">@L["P2ClearFilter"]</button>
                    </div>
                }
            </form>
        </section>

        <DataTable @key="_tableKey" @ref="_table" TItem="RoomListItem" Columns="_columns"
                   ItemsProvider="LoadRoomsAsync" PageSize="_pageSize"
                   Caption="@L["P2RoomsTable"]" Labels="_tableLabels"
                   HasActiveFilters="_hasActiveFilters" OnClearFilters="ClearFiltersFromTableAsync">
            <EmptyActions>
                @if (_isOwner && _properties.Count > 0)
                {
                    <button class="btn btn-primary" type="button" @onclick="OpenCreate">@L["P2AddRoom"]</button>
                }
                else if (_properties.Count == 0)
                {
                    <button class="btn btn-secondary" type="button" @onclick="GoToProperties">@L["P2ManageProperties"]</button>
                }
            </EmptyActions>
        </DataTable>
    }
</div>

@if (_formVisible)
{
    <RoomFormDialog @key="_formKey" Visible="true" RoomId="_formRoomId" IsOwner="_isOwner"
                    Properties="_properties" InitialPropertyId="@SelectedPropertyId"
                    AllowDelete="_isOwner"
                    OnClose="CloseForm" OnSaved="OnRoomSavedAsync" OnDeleted="OnRoomDeletedAsync" />
}
@if (_selectedRoom is not null)
{
    <RoomDetailsDialog Room="_selectedRoom" IsOwner="_isOwner" OnClose="CloseDetails"
                       OnEdit="EditSelected" OnDelete="RequestDelete" />
}
<ConfirmDialog Visible="_deleteVisible" Title="@L["P2DeleteRoomTitle"]"
               Message="@L["P2DeleteRoomConfirm", _deleteRoom?.Code ?? string.Empty]"
               ConfirmText="@L["P2MoveToTrash"]" CancelText="@L["Cancel"]" BusyText="@L["P2Deleting"]"
               Danger="true" OnConfirm="DeleteRoomAsync" OnCancel="CancelDelete" />

@code {
    [SupplyParameterFromQuery(Name = "propertyId")]
    public int? PropertyId { get; set; }

    private CancellationTokenSource? _keywordDebounce;

    private DataTable<RoomListItem>? _table;
    private IReadOnlyList<DataTableColumn<RoomListItem>> _columns = [];
    private DataTableLabels _tableLabels = new();
    private IReadOnlyList<PropertyListItem> _properties = [];
    private RoomSummary? _summary;
    private RoomListItem? _selectedRoom;
    private RoomListItem? _deleteRoom;
    private int? _openMenuId;
    private string _keyword = string.Empty;
    private string _propertyFilter = string.Empty;
    private string _statusFilter = string.Empty;
    private string _activeFilter = string.Empty;
    private string _minPriceText = string.Empty;
    private string _maxPriceText = string.Empty;
    private string _floorText = string.Empty;
    private string _minAreaText = string.Empty;
    private string _maxAreaText = string.Empty;
    private string? _filterError;
    private string? _propertyLoadError;
    private string? _summaryError;
    private bool _summaryLoading;
    private bool _onlyAvailable;
    private bool _showAdvanced;
    private bool _ready;
    private bool _initializing = true;
    private bool _isOwner;
    private bool _formVisible;
    private bool _deleteVisible;
    private bool _needsPropertyFirst;
    private bool _hasActiveFilters;
    private int _tableKey;
    private int _formKey;
    private int _pageSize = 20;
    private int? _formRoomId;
    private int? SelectedPropertyId => int.TryParse(_propertyFilter, out var value) ? value : null;
    private int? _lastAppliedPropertyId;

    private int AdvancedFilterCount =>
        (string.IsNullOrWhiteSpace(_minPriceText) ? 0 : 1)
        + (string.IsNullOrWhiteSpace(_maxPriceText) ? 0 : 1)
        + (string.IsNullOrWhiteSpace(_floorText) ? 0 : 1)
        + (string.IsNullOrWhiteSpace(_minAreaText) ? 0 : 1)
        + (string.IsNullOrWhiteSpace(_maxAreaText) ? 0 : 1)
        + (_onlyAvailable ? 1 : 0);

    protected override async Task OnInitializedAsync()
    {
        _tableLabels = DataTableLabelLocalizer.Create(L);
        _columns = BuildColumns();
        await InitializeAsync();
    }

    protected override Task OnParametersSetAsync()
    {
        // Blazor reuses this page when only the query string changes. Keep the
        // property selector and table in sync with links from the property list.
        if (_lastAppliedPropertyId == PropertyId)
            return Task.CompletedTask;

        _lastAppliedPropertyId = PropertyId;
        if (_ready)
        {
            _propertyFilter = PropertyId?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
            _hasActiveFilters = HasRoomFilters();
            _tableKey++;
        }

        return Task.CompletedTask;
    }

    private async Task InitializeAsync()
    {
        _initializing = true;
        _ready = false;
        _propertyLoadError = null;
        try
        {
            var role = await PageService.GetCurrentRoleAsync();
            if (role is not Roles.ChuTro and not Roles.QuanLy)
            {
                _propertyLoadError = L["P2Forbidden"];
                _ready = false;
                return;
            }
            _isOwner = role == Roles.ChuTro;
            _properties = await PageService.GetPropertyOptionsAsync();
            _propertyFilter = PropertyId?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
            _lastAppliedPropertyId = PropertyId;
            _hasActiveFilters = HasRoomFilters();
            _ready = true;
            await LoadSummaryAsync();
        }
        catch (Exception ex)
        {
            _propertyLoadError = L["P2LoadFailed"];
            Logger.LogError(ex, "P2 room page initialization failed");
        }
        finally
        {
            _initializing = false;
        }
    }

    private async Task LoadSummaryAsync()
    {
        _summaryLoading = true;
        _summaryError = null;
        try { _summary = await PageService.GetSummaryAsync(); }
        catch (Exception ex)
        {
            _summary = null;
            _summaryError = L["P2LoadSummaryFailed"];
            Logger.LogError(ex, "P2 room summary load failed");
        }
        finally
        {
            _summaryLoading = false;
        }
    }

    private IReadOnlyList<DataTableColumn<RoomListItem>> BuildColumns()
    {
        RenderFragment<RoomListItem> code = item => @<button class="p2-link-button" type="button" @onclick="() => OpenDetails(item)">@item.Code</button>;
        RenderFragment<RoomListItem> status = item => @<StatusBadge Text="@StatusText(item.Status)" Tone="@StatusTone(item.Status)" />;
        RenderFragment<RoomListItem> activity = item => @<StatusBadge Text="@(item.IsActive ? L["P2Active"].Value : L["P2Inactive"].Value)" Tone="@(item.IsActive ? BadgeTone.Success : BadgeTone.Neutral)" />;
        RenderFragment<RoomListItem> actions = item => @<div class="p2-row-actions">
            <button class="icon-button p2-menu-trigger @(IsMenuOpen(item.Id) ? "is-open" : null)" type="button"
                    aria-label="@L["P2Actions"]" title="@L["P2Actions"]"
                    aria-haspopup="menu" aria-expanded="@(IsMenuOpen(item.Id) ? "true" : "false")"
                    aria-controls="@($"row-menu-{item.Id}")"
                    @onclick="() => ToggleRowMenu(item.Id)">
                <LucideIcon Name="ellipsis" />
            </button>
            @if (IsMenuOpen(item.Id))
            {
                <div id="@($"row-menu-{item.Id}")" class="p2-row-menu" role="menu" aria-label="@L["P2Actions"]" data-row-menu>
                    <button class="p2-row-menu-item" type="button" role="menuitem" @onclick="() => MenuDetails(item)">
                        <LucideIcon Name="eye" /><span>@L["P2ViewDetails"]</span>
                    </button>
                    <button class="p2-row-menu-item" type="button" role="menuitem" @onclick="() => MenuEdit(item)">
                        <LucideIcon Name="edit" /><span>@L["P2Edit"]</span>
                    </button>
                    @if (_isOwner)
                    {
                        <div class="p2-row-menu-sep" role="separator"></div>
                        <button class="p2-row-menu-item danger" type="button" role="menuitem" @onclick="() => MenuDelete(item)">
                            <LucideIcon Name="trash" /><span>@L["P2MoveToTrash"]</span>
                        </button>
                    }
                </div>
            }
        </div>;

        return
        [
            new() { Key = "code", Title = L["P2RoomCode"], Template = code },
            new() { Key = "property", Title = L["P2Property"], Value = item => item.PropertyName },
            new() { Key = "floor", Title = L["P2Floor"], Value = item => item.Floor?.ToString(CultureInfo.CurrentCulture) ?? L["P2NotProvided"].Value, IsNumeric = true },
            new() { Key = "area", Title = L["P2Area"], Value = FormatArea, IsNumeric = true },
            new() { Key = "price", Title = L["P2StandardPrice"], Value = item => MoneyFormatter.Format(item.StandardPrice), IsNumeric = true },
            new() { Key = "status", Title = L["P2Status"], Template = status },
            new() { Key = "activity", Title = L["P2Activity"], Template = activity },
            new() { Key = "actions", Title = L["P2Actions"], Template = actions }
        ];
    }

    private async Task<PagedResult<RoomListItem>> LoadRoomsAsync(DataTableRequest request)
    {
        _openMenuId = null;
        int? propertyId = int.TryParse(_propertyFilter, out var parsedProperty) ? parsedProperty : null;
        RoomStatus? status = int.TryParse(_statusFilter, out var parsedStatus) && Enum.IsDefined((RoomStatus)parsedStatus)
            ? (RoomStatus)parsedStatus
            : null;
        bool? isActive = bool.TryParse(_activeFilter, out var parsedActive) ? parsedActive : null;
        MoneyFormatter.TryParse(_minPriceText, out var minPrice);
        MoneyFormatter.TryParse(_maxPriceText, out var maxPrice);
        int? floor = int.TryParse(_floorText, out var parsedFloor) ? parsedFloor : null;
        decimal? minArea = decimal.TryParse(_minAreaText, NumberStyles.Number, CultureInfo.CurrentCulture, out var parsedMinArea) ? parsedMinArea : null;
        decimal? maxArea = decimal.TryParse(_maxAreaText, NumberStyles.Number, CultureInfo.CurrentCulture, out var parsedMaxArea) ? parsedMaxArea : null;

        return await PageService.ListAsync(new RoomFilter
        {
            PropertyId = propertyId,
            Status = status,
            Keyword = _keyword,
            IsActive = isActive,
            OnlyAvailable = _onlyAvailable ? true : null,
            MinPrice = string.IsNullOrWhiteSpace(_minPriceText) ? null : minPrice,
            MaxPrice = string.IsNullOrWhiteSpace(_maxPriceText) ? null : maxPrice,
            Floor = floor,
            MinArea = minArea,
            MaxArea = maxArea,
            Page = request.Page,
            PageSize = request.PageSize
        });
    }

    public void Dispose()
    {
        _keywordDebounce?.Cancel();
        _keywordDebounce?.Dispose();
    }

    private async Task OnKeywordChangedAsync()
    {
        _keywordDebounce?.Cancel();
        _keywordDebounce?.Dispose();
        _keywordDebounce = new CancellationTokenSource();
        var token = _keywordDebounce.Token;
        try
        {
            await Task.Delay(300, token);
            await ApplyFiltersAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private Task ApplyFiltersAsync()
    {
        _filterError = null;
        var hasMin = string.IsNullOrWhiteSpace(_minPriceText) || MoneyFormatter.TryParse(_minPriceText, out _);
        var hasMax = string.IsNullOrWhiteSpace(_maxPriceText) || MoneyFormatter.TryParse(_maxPriceText, out _);
        if (!hasMin || !hasMax)
        {
            _filterError = L["P2ValidationPriceNumber"];
            return Task.CompletedTask;
        }

        if ((!string.IsNullOrWhiteSpace(_minPriceText) && MoneyFormatter.TryParse(_minPriceText, out var negativeMin) && negativeMin < 0)
            || (!string.IsNullOrWhiteSpace(_maxPriceText) && MoneyFormatter.TryParse(_maxPriceText, out var negativeMax) && negativeMax < 0))
        {
            _filterError = L["P2ValidationPriceNumber"];
            return Task.CompletedTask;
        }

        if (!string.IsNullOrWhiteSpace(_minPriceText) && !string.IsNullOrWhiteSpace(_maxPriceText)
            && MoneyFormatter.TryParse(_minPriceText, out var min) && MoneyFormatter.TryParse(_maxPriceText, out var max) && min > max)
        {
            _filterError = L["P2ValidationPriceRange"];
            return Task.CompletedTask;
        }

        var hasFloor = string.IsNullOrWhiteSpace(_floorText) || int.TryParse(_floorText, out var floorValue) && floorValue is >= 0 and <= 1000;
        if (!hasFloor)
        {
            _filterError = L["P2ValidationFloor"];
            return Task.CompletedTask;
        }

        var hasMinArea = string.IsNullOrWhiteSpace(_minAreaText) || decimal.TryParse(_minAreaText, NumberStyles.Number, CultureInfo.CurrentCulture, out var areaValue) && areaValue >= 0;
        var hasMaxArea = string.IsNullOrWhiteSpace(_maxAreaText) || decimal.TryParse(_maxAreaText, NumberStyles.Number, CultureInfo.CurrentCulture, out var maxAreaValue) && maxAreaValue >= 0;
        if (!hasMinArea || !hasMaxArea)
        {
            _filterError = L["P2ValidationAreaNumber"];
            return Task.CompletedTask;
        }

        if (!string.IsNullOrWhiteSpace(_minAreaText) && !string.IsNullOrWhiteSpace(_maxAreaText)
            && decimal.TryParse(_minAreaText, NumberStyles.Number, CultureInfo.CurrentCulture, out var areaMin)
            && decimal.TryParse(_maxAreaText, NumberStyles.Number, CultureInfo.CurrentCulture, out var areaMax)
            && areaMin > areaMax)
        {
            _filterError = L["P2ValidationAreaRange"];
            return Task.CompletedTask;
        }

        _hasActiveFilters = HasRoomFilters();
        _tableKey++;
        return Task.CompletedTask;
    }

    private Task ResetFiltersAsync()
    {
        _keyword = string.Empty;
        _propertyFilter = string.Empty;
        _statusFilter = string.Empty;
        _activeFilter = string.Empty;
        _minPriceText = string.Empty;
        _maxPriceText = string.Empty;
        _floorText = string.Empty;
        _minAreaText = string.Empty;
        _maxAreaText = string.Empty;
        _onlyAvailable = false;
        _showAdvanced = false;
        _filterError = null;
        _hasActiveFilters = false;
        _tableKey++;
        Navigation.NavigateTo("/rooms", replace: true);
        return Task.CompletedTask;
    }

    private Task ClearPropertyFilterAsync()
    {
        _propertyFilter = string.Empty;
        _hasActiveFilters = HasRoomFilters();
        _tableKey++;
        Navigation.NavigateTo("/rooms", replace: true);
        return Task.CompletedTask;
    }

    private Task ClearFiltersFromTableAsync()
    {
        _keyword = string.Empty;
        _propertyFilter = string.Empty;
        _statusFilter = string.Empty;
        _activeFilter = string.Empty;
        _minPriceText = string.Empty;
        _maxPriceText = string.Empty;
        _floorText = string.Empty;
        _minAreaText = string.Empty;
        _maxAreaText = string.Empty;
        _onlyAvailable = false;
        _showAdvanced = false;
        _filterError = null;
        _hasActiveFilters = false;
        _lastAppliedPropertyId = null;
        Navigation.NavigateTo("/rooms", replace: true);
        return Task.CompletedTask;
    }

    private bool HasRoomFilters() =>
        !string.IsNullOrWhiteSpace(_keyword)
        || !string.IsNullOrWhiteSpace(_propertyFilter)
        || !string.IsNullOrWhiteSpace(_statusFilter)
        || !string.IsNullOrWhiteSpace(_activeFilter)
        || !string.IsNullOrWhiteSpace(_minPriceText)
        || !string.IsNullOrWhiteSpace(_maxPriceText)
        || !string.IsNullOrWhiteSpace(_floorText)
        || !string.IsNullOrWhiteSpace(_minAreaText)
        || !string.IsNullOrWhiteSpace(_maxAreaText)
        || _onlyAvailable;

    private string FormatArea(RoomListItem item) => item.AreaM2 is { } area
        ? $"{area.ToString("N2", CultureInfo.CurrentCulture)} {L["P2SquareMeter"]}"
        : L["P2NotProvided"].Value;

    private Task ChangePageSize(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value) && value is 10 or 20 or 50)
        {
            _pageSize = value;
            _tableKey++;
        }
        return Task.CompletedTask;
    }

    private string StatusText(RoomStatus status) => status switch
    {
        RoomStatus.Available => L["P2StatusAvailable"],
        RoomStatus.Rented => L["P2StatusRented"],
        RoomStatus.Maintenance => L["P2StatusMaintenance"],
        _ => L["P2StatusUnknown"]
    };

    private static BadgeTone StatusTone(RoomStatus status) => status switch
    {
        RoomStatus.Available => BadgeTone.Success,
        RoomStatus.Rented => BadgeTone.Info,
        RoomStatus.Maintenance => BadgeTone.Warning,
        _ => BadgeTone.Neutral
    };

    private void OpenCreate()
    {
        if (!_isOwner) return;
        if (_properties.Count == 0)
        {
            _needsPropertyFirst = true;
            return;
        }

        _needsPropertyFirst = false;
        _formRoomId = null;
        _formKey++;
        _formVisible = true;
    }
    private bool IsMenuOpen(int id) => _openMenuId == id;
    private void ToggleRowMenu(int id) => _openMenuId = _openMenuId == id ? null : id;
    private void MenuDetails(RoomListItem item) { _openMenuId = null; OpenDetails(item); }
    private void MenuEdit(RoomListItem item) { _openMenuId = null; OpenEdit(item.Id); }
    private void MenuDelete(RoomListItem item) { _openMenuId = null; RequestDelete(item); }

    private void OpenEdit(int id) { _formRoomId = id; _formKey++; _formVisible = true; }
    private void OpenDetails(RoomListItem item) => _selectedRoom = item;
    private void CloseForm() => _formVisible = false;
    private void CloseDetails() => _selectedRoom = null;
    private void EditSelected() { if (_selectedRoom is not null) OpenEdit(_selectedRoom.Id); _selectedRoom = null; }
    private void RequestDelete(RoomListItem item) { if (_isOwner) { _deleteRoom = item; _deleteVisible = true; _selectedRoom = null; } }
    private void CancelDelete() { _deleteVisible = false; _deleteRoom = null; }
    private void GoToProperties() => Navigation.NavigateTo("/properties");

    private async Task OnRoomSavedAsync()
    {
        _formVisible = false;
        Toasts.Success(L["P2SaveSucceeded"]);
        await RefreshAfterMutationAsync();
    }

    private async Task OnRoomDeletedAsync()
    {
        _formVisible = false;
        Toasts.Success(L["P2RoomMovedToTrash"]);
        await RefreshAfterMutationAsync();
    }

    private async Task DeleteRoomAsync()
    {
        if (!_isOwner || _deleteRoom is null) { CancelDelete(); return; }
        try
        {
            var result = await PageService.DeleteAsync(_deleteRoom.Id);
            if (result.Succeeded)
            {
                Toasts.Success(L["P2RoomMovedToTrash"]);
                CancelDelete();
                await RefreshAfterMutationAsync();
                return;
            }

            Toasts.Error(result.ErrorCode switch
            {
                RoomErrorCodes.RoomInUse => L["P2RoomInUse"],
                RoomErrorCodes.Forbidden => L["P2Forbidden"],
                RoomErrorCodes.RoomNotFound => L["P2RoomNotFound"],
                _ => L["P2SaveFailed"]
            });
            CancelDelete();
        }
        catch (UnauthorizedAccessException) { Toasts.Error(L["P2Forbidden"]); CancelDelete(); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "P2 room delete failed");
            Toasts.Error(L["P2SaveFailed"]);
            CancelDelete();
        }
    }

    private async Task RefreshAfterMutationAsync()
    {
        await LoadSummaryAsync();
        if (_table is not null) await _table.ReloadAsync();
    }
}
