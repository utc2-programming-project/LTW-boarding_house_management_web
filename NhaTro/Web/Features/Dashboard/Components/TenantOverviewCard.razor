@inject IStringLocalizer<DashboardResource> L
@if (Kpis is { Total: 0 })
{
    <EmptyStateCard Title="@L["Empty"]" />
}
else if (Kpis is not null)
{
    <dl>
        <dt>@L["TenantTotal"]</dt><dd>@DashboardFormat.FormatNumber(Kpis.Total)</dd>
        <dt>@L["TenantActive"]</dt><dd>@DashboardFormat.FormatNumber(Kpis.Active)</dd>
        <dt>@L["TenantRenting"]</dt><dd>@DashboardFormat.FormatNumber(Kpis.Renting)</dd>
        @if (Kpis.LinkedAccountCount is int linked)
        {
            <dt>@L["TenantLinked"]</dt><dd>@DashboardFormat.FormatNumber(linked)</dd>
        }
    </dl>
}
<p>@L["TenantCurrentData"]</p>
<a href="/tenants">@L["ViewTenants"]</a>
@code {
    [Parameter] public TenantReportKpis? Kpis { get; set; }
}
