@inject DashboardPageService PageService
@inject IStringLocalizer<DashboardResource> L
@inject ToastService Toasts
@inject TimeProvider Time
@inject ILogger<DashboardOverview> Logger

<div class="dashboard-page">
    <PageHeading Title="@L["HomeTitle"]" HelpText="@L["Subtitle"]">
        <Actions>
            @HeaderActions
            <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="RefreshAsync"><LucideIcon Name="refresh" />@L["Refresh"]</button>
        </Actions>
    </PageHeading>
    @HeaderContent
    <div class="filter-bar filter-bar--panel filter-bar--sticky">
        <div class="filter-bar__row">
            <div class="filter-bar__stack filter-bar__select">
                <div class="filter-bar__label">
                    <label for="dashboard-property">@L["Property"]</label>
                    <HelpTip Text="@L["RoomScopeNote"]" />
                </div>
                <select id="dashboard-property" class="input" value="@Filter.PropertyId" @onchange="ChangePropertyAsync" disabled="@(Busy || PropertyState != DashboardLoadState.Loaded)">
                    <option value="">@L["AllProperties"]</option>
                    @foreach (var property in Properties)
                    {
                        <option value="@property.Id">@property.Name@(!property.IsActive ? " – " + L["Inactive"] : "")</option>
                    }
                </select>
            </div>
            <div class="filter-bar__stack filter-bar__select">
                <div class="filter-bar__label">
                    <label for="dashboard-period">@L["PendingPeriod"]</label>
                    <HelpTip Text="@L["CurrentPeriodNote"]" />
                </div>
                <select id="dashboard-period" class="input" value="@Filter.Period" @onchange="ChangePeriodAsync" disabled="@Busy">
                    @foreach (var period in Enum.GetValues<DashboardPeriod>())
                    {
                        <option value="@period">@L[period.ToString()]</option>
                    }
                </select>
            </div>
            <div class="filter-bar__actions">
                <FilterResetButton OnClick="ClearFiltersAsync" Disabled="Busy" />
            </div>
        </div>
    </div>
    @if (PropertyState is DashboardLoadState.Error or DashboardLoadState.Denied)
    {
        <div role="status"><span>@L[PropertyState == DashboardLoadState.Denied ? "PropertiesDenied" : "Error"]</span><button type="button" class="btn btn-secondary" disabled="@Busy" @onclick="LoadPropertiesAsync">@L["Retry"]</button></div>
    }
    <p class="updated">@L["Updated"]: @DateFormatter.FormatDateTime(LastRefreshed)</p>
    <KPICardGrid IsOwner="@IsOwner" Kpis="@Rooms" State="@RoomState" Retry="LoadRoomsAsync"
                 RoomsHref="@RoomsHref" FilterDescription="@FilterDescription"
                 Revenue="@Revenue" RevenueState="@RevenueState" RevenueHref="@RevenueHref" RevenueRetry="LoadRevenueAsync"
                 TotalRevenue="@TotalRevenue" TotalRevenueState="@TotalRevenueState" TotalRevenueRetry="LoadTotalRevenueAsync"
                 Incidents="@Incidents" IncidentState="@IncidentState" IncidentsHref="@IncidentsHref" IncidentRetry="LoadIncidentsAsync" />
    <a class="reports-link" href="@ReportsHref">@L["ViewReports"]</a>
    @* Cặp panel luôn nằm chung 1 hàng; panel đơn được đưa ra khỏi grid để chiếm toàn bộ chiều rộng
       (gộp 2 ô thay vì để 1 ô trống như cơ chế grid 2 cột cũ). *@
    <div class="panel-grid">
        <DashboardPanel Title="@L["RoomStructure"]" State="@RoomState" DeniedText="@L["RoomsDenied"]" Retry="LoadRoomsAsync">
            @if (Rooms is not null) { <RoomStructureChart Kpis="@Rooms" /> }
        </DashboardPanel>
        <DashboardPanel Title="@L["Tenants"]" Icon="users" State="@TenantState" DeniedText="@L["TenantsDenied"]" Retry="LoadTenantsAsync">
            <TenantOverviewCard Kpis="@Tenants" />
        </DashboardPanel>
    </div>
    @if (IsOwner)
    {
        <DashboardPanel Title="@L["RevenueChart"]" State="@TotalRevenueState" DeniedText="@L["RevenueDenied"]" Retry="LoadTotalRevenueAsync">
            <p class="scope-note">@L["AllTimeData"]</p>
            <RevenueChart Periods="@(TotalRevenue?.Periods)" />
        </DashboardPanel>
    }
    else
    {
        <DashboardPanel Title="@L["Incidents"]" Icon="wrench" State="@IncidentState" DeniedText="@L["IncidentsDenied"]" Retry="LoadIncidentsAsync">
            <IncidentOverviewCard Kpis="@Incidents" ReportsHref="@IncidentsHref" />
        </DashboardPanel>
    }
    <div class="panel-grid panel-grid--charts">
        <DashboardPanel Title="@L["OccupancyTrend"]" State="@OccupancyState" DeniedText="@L["RoomsDenied"]" Retry="LoadOccupancyAsync">
            <OccupancyTrendChart Months="@(Occupancy?.Months)" />
        </DashboardPanel>
        @if (IsOwner)
        {
            <DashboardPanel Title="@L["DebtAging"]" State="@DebtAgingState" DeniedText="@L["RevenueDenied"]" Retry="LoadDebtAgingAsync">
                <DebtAgingChart Data="@DebtAging" />
            </DashboardPanel>
        }
        else
        {
            <DashboardPanel Title="@L["IncidentStatusTitle"]" State="@IncidentState" DeniedText="@L["IncidentsDenied"]" Retry="LoadIncidentsAsync">
                <IncidentStatusChart Kpis="@Incidents" />
            </DashboardPanel>
        }
    </div>
    <DashboardPanel Title="@L["ContractExpiry"]" State="@ContractExpiryState" DeniedText="@L["RoomsDenied"]" Retry="LoadContractExpiryAsync">
        <ContractExpiryChart Months="@ContractExpiry" />
    </DashboardPanel>
</div>

@code {
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment? HeaderActions { get; set; }
    [Parameter] public EventCallback RefreshAdditionalContent { get; set; }
    [Parameter] public bool AdditionalContentBusy { get; set; }

    private readonly DashboardFilterState Filter = new();
    private IReadOnlyList<DashboardPropertyOption> Properties = [];
    private RoomReportKpis? Rooms;
    private TenantReportKpis? Tenants;
    private RevenueReportDto? Revenue;
    private RevenueReportDto? TotalRevenue;
    private IncidentReportKpis? Incidents;
    private OccupancyReportResult? Occupancy;
    private DebtAgingDto? DebtAging;
    private IReadOnlyList<ContractExpiryMonthDto>? ContractExpiry;
    private DashboardLoadState PropertyState = DashboardLoadState.Loading;
    private DashboardLoadState RoomState = DashboardLoadState.Loading;
    private DashboardLoadState TenantState = DashboardLoadState.Loading;
    private DashboardLoadState RevenueState = DashboardLoadState.Loading;
    private DashboardLoadState TotalRevenueState = DashboardLoadState.Loading;
    private DashboardLoadState IncidentState = DashboardLoadState.Loading;
    private DashboardLoadState OccupancyState = DashboardLoadState.Loading;
    private DashboardLoadState DebtAgingState = DashboardLoadState.Loading;
    private DashboardLoadState ContractExpiryState = DashboardLoadState.Loading;
    private bool IsOwner;
    private bool Refreshing;
    private DateTime? LastRefreshed;
    private bool Busy => AdditionalContentBusy || Refreshing || PropertyState == DashboardLoadState.Loading
        || RoomState == DashboardLoadState.Loading || TenantState == DashboardLoadState.Loading
        || RevenueState == DashboardLoadState.Loading || TotalRevenueState == DashboardLoadState.Loading
        || IncidentState == DashboardLoadState.Loading || OccupancyState == DashboardLoadState.Loading
        || DebtAgingState == DashboardLoadState.Loading || ContractExpiryState == DashboardLoadState.Loading;
    private string RoomsHref => Filter.PropertyId is { } id ? $"/rooms?propertyId={id}" : "/rooms";
    private string ReportsHref => Filter.PropertyId is { } id ? $"/reports?propertyId={id}" : "/reports";
    private string RevenueHref => ReportsHref;
    private string IncidentsHref => Filter.PropertyId is { } id ? $"/reports?propertyId={id}" : "/reports";
    private DashboardPeriodRange Range => DashboardPeriodRange.Resolve(Filter.Period, Time);
    private string FilterDescription
    {
        get
        {
            var property = Properties.FirstOrDefault(p => p.Id == Filter.PropertyId)?.Name ?? L["AllProperties"].Value;
            return $"{property} · {L[Filter.Period.ToString()]} · {DateFormatter.Format(Range.Start)} – {DateFormatter.Format(Range.End)}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        IsOwner = await PageService.GetRoleAsync() == Roles.ChuTro;
        await ReloadAsync(false);
    }

    private Task RefreshAsync() => ReloadAsync(true);

    private async Task ReloadAsync(bool notify)
    {
        if (Refreshing) return;
        Refreshing = true;
        try
        {
            // Nạp công việc trước thống kê để tránh chồng truy vấn dùng chung DbContext.
            if (notify)
            {
                PageService.InvalidateCache();
                await RefreshAdditionalContent.InvokeAsync();
            }
            await Task.WhenAll(LoadPropertiesAsync(), LoadRoomsAsync(), LoadTenantsAsync(),
                LoadIncidentsAsync(), LoadRevenueAsync(), LoadTotalRevenueAsync(),
                LoadOccupancyAsync(), LoadDebtAgingAsync(), LoadContractExpiryAsync());
            LastRefreshed = PageService.GetLastRefreshedAtUtc();
            if (States.Contains(DashboardLoadState.Error)) Toasts.Error(L["Error"]);
            else if (notify && States.All(s => s == DashboardLoadState.Loaded)) Toasts.Success(L["RefreshSuccess"]);
        }
        finally { Refreshing = false; }
    }

    private IEnumerable<DashboardLoadState> States =>
        [PropertyState, RoomState, TenantState, IncidentState, RevenueState, TotalRevenueState,
         OccupancyState, DebtAgingState, ContractExpiryState];

    private async Task ChangePropertyAsync(ChangeEventArgs args)
    {
        if (Busy) return;
        Filter.PropertyId = int.TryParse(args.Value?.ToString(), out var id) ? id : null;
        await Task.WhenAll(LoadRoomsAsync(), LoadTenantsAsync(), LoadIncidentsAsync(), LoadRevenueAsync(),
            LoadTotalRevenueAsync(), LoadOccupancyAsync(), LoadDebtAgingAsync(), LoadContractExpiryAsync());
    }

    private async Task ChangePeriodAsync(ChangeEventArgs args)
    {
        if (Busy || !Enum.TryParse<DashboardPeriod>(args.Value?.ToString(), out var period)) return;
        Filter.Period = period;
        await Task.WhenAll(LoadIncidentsAsync(), LoadRevenueAsync());
    }

    private async Task ClearFiltersAsync()
    {
        if (Busy) return;
        Filter.PropertyId = null;
        Filter.Period = DashboardPeriod.Month;
        await Task.WhenAll(LoadRoomsAsync(), LoadTenantsAsync(), LoadIncidentsAsync(), LoadRevenueAsync(),
            LoadTotalRevenueAsync(), LoadOccupancyAsync(), LoadDebtAgingAsync(), LoadContractExpiryAsync());
    }

    private async Task LoadPropertiesAsync()
    {
        PropertyState = DashboardLoadState.Loading;
        try { Properties = await PageService.ListPropertiesAsync(); PropertyState = DashboardLoadState.Loaded; }
        catch (UnauthorizedAccessException) { Properties = []; PropertyState = DashboardLoadState.Denied; }
        catch (Exception ex) { Properties = []; PropertyState = DashboardLoadState.Error; Logger.LogError(ex, "Dashboard properties failed"); if (!Refreshing) Toasts.Error(L["Error"]); }
        finally { await InvokeAsync(StateHasChanged); }
    }

    private async Task LoadRoomsAsync()
    {
        RoomState = DashboardLoadState.Loading;
        Rooms = null;
        try { Rooms = await PageService.GetRoomKpisAsync(Filter.PropertyId); RoomState = DashboardLoadState.Loaded; }
        catch (UnauthorizedAccessException) { RoomState = DashboardLoadState.Denied; }
        catch (Exception ex) { RoomState = DashboardLoadState.Error; Logger.LogError(ex, "Dashboard rooms failed"); if (!Refreshing) Toasts.Error(L["Error"]); }
        finally { await InvokeAsync(StateHasChanged); }
    }

    private async Task LoadTenantsAsync()
    {
        TenantState = DashboardLoadState.Loading;
        Tenants = null;
        try { Tenants = await PageService.GetTenantKpisAsync(Filter.PropertyId); TenantState = DashboardLoadState.Loaded; }
        catch (UnauthorizedAccessException) { TenantState = DashboardLoadState.Denied; }
        catch (Exception ex) { TenantState = DashboardLoadState.Error; Logger.LogError(ex, "Dashboard tenants failed"); if (!Refreshing) Toasts.Error(L["Error"]); }
        finally { await InvokeAsync(StateHasChanged); }
    }

    private async Task LoadIncidentsAsync()
    {
        IncidentState = DashboardLoadState.Loading;
        Incidents = null;
        try
        {
            Incidents = await PageService.GetIncidentKpisAsync(Range.Start, Range.End, Filter.PropertyId);
            IncidentState = DashboardLoadState.Loaded;
        }
        catch (UnauthorizedAccessException) { IncidentState = DashboardLoadState.Denied; }
        catch (Exception ex) { IncidentState = DashboardLoadState.Error; Logger.LogError(ex, "Dashboard incidents failed"); if (!Refreshing) Toasts.Error(L["Error"]); }
        finally { await InvokeAsync(StateHasChanged); }
    }

    private async Task LoadRevenueAsync()
    {
        if (!IsOwner)
        {
            Revenue = null;
            RevenueState = DashboardLoadState.Loaded;
            return;
        }

        RevenueState = DashboardLoadState.Loading;
        Revenue = null;
        try
        {
            Revenue = await PageService.GetRevenueReportAsync(new RevenueReportFilter(
                Range.Start, Range.End, Filter.PropertyId, RevenueDateBasis.InvoicePeriod));
            RevenueState = DashboardLoadState.Loaded;
        }
        catch (UnauthorizedAccessException) { RevenueState = DashboardLoadState.Denied; }
        catch (Exception ex) { RevenueState = DashboardLoadState.Error; Logger.LogError(ex, "Dashboard revenue failed"); if (!Refreshing) Toasts.Error(L["Error"]); }
        finally { await InvokeAsync(StateHasChanged); }
    }

    private async Task LoadTotalRevenueAsync()
    {
        if (!IsOwner)
        {
            TotalRevenue = null;
            TotalRevenueState = DashboardLoadState.Loaded;
            return;
        }

        TotalRevenueState = DashboardLoadState.Loading;
        TotalRevenue = null;
        try
        {
            // Tổng doanh thu luỹ kế: không giới hạn kỳ, chỉ lọc theo nhà trọ đang chọn.
            TotalRevenue = await PageService.GetRevenueReportAsync(new RevenueReportFilter(
                null, null, Filter.PropertyId, RevenueDateBasis.InvoicePeriod));
            TotalRevenueState = DashboardLoadState.Loaded;
        }
        catch (UnauthorizedAccessException) { TotalRevenueState = DashboardLoadState.Denied; }
        catch (Exception ex) { TotalRevenueState = DashboardLoadState.Error; Logger.LogError(ex, "Dashboard total revenue failed"); if (!Refreshing) Toasts.Error(L["Error"]); }
        finally { await InvokeAsync(StateHasChanged); }
    }

    private async Task LoadOccupancyAsync()
    {
        OccupancyState = DashboardLoadState.Loading;
        Occupancy = null;
        try { Occupancy = await PageService.GetOccupancyAsync(Filter.PropertyId); OccupancyState = DashboardLoadState.Loaded; }
        catch (UnauthorizedAccessException) { OccupancyState = DashboardLoadState.Denied; }
        catch (Exception ex) { OccupancyState = DashboardLoadState.Error; Logger.LogError(ex, "Dashboard occupancy failed"); if (!Refreshing) Toasts.Error(L["Error"]); }
        finally { await InvokeAsync(StateHasChanged); }
    }

    private async Task LoadDebtAgingAsync()
    {
        if (!IsOwner)
        {
            DebtAging = null;
            DebtAgingState = DashboardLoadState.Loaded;
            return;
        }

        DebtAgingState = DashboardLoadState.Loading;
        DebtAging = null;
        try { DebtAging = await PageService.GetDebtAgingAsync(Filter.PropertyId); DebtAgingState = DashboardLoadState.Loaded; }
        catch (UnauthorizedAccessException) { DebtAgingState = DashboardLoadState.Denied; }
        catch (Exception ex) { DebtAgingState = DashboardLoadState.Error; Logger.LogError(ex, "Dashboard debt aging failed"); if (!Refreshing) Toasts.Error(L["Error"]); }
        finally { await InvokeAsync(StateHasChanged); }
    }

    private async Task LoadContractExpiryAsync()
    {
        ContractExpiryState = DashboardLoadState.Loading;
        ContractExpiry = null;
        try { ContractExpiry = await PageService.GetContractExpiryAsync(Filter.PropertyId); ContractExpiryState = DashboardLoadState.Loaded; }
        catch (UnauthorizedAccessException) { ContractExpiryState = DashboardLoadState.Denied; }
        catch (Exception ex) { ContractExpiryState = DashboardLoadState.Error; Logger.LogError(ex, "Dashboard contract expiry failed"); if (!Refreshing) Toasts.Error(L["Error"]); }
        finally { await InvokeAsync(StateHasChanged); }
    }
}
