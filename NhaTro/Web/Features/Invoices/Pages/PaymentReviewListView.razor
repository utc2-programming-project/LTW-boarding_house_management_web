@page "/payment-requests"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "PaymentReview")]
@inject PaymentReviewPageService ReviewPage
@inject NavigationManager Navigation
@inject IStringLocalizer<InvoiceResources> L
@inject IStringLocalizer<Web.Shared> SL

<PageTitle>@L["ReviewPageTitle"]</PageTitle>

<div class="payment-review-page page-stack">
    <PageHeading Title="@L["ReviewHeading"]" HelpText="@L["ReviewSubtitle"]">
        <Actions>
            <button type="button" class="btn btn-secondary" disabled="@_loading" @onclick="() => ReloadAsync()">
                <LucideIcon Name="refresh" />
                <span>@L["ReviewRefresh"]</span>
            </button>
        </Actions>
    </PageHeading>

    @if (_loading)
    {
        <LoadingOverlay Visible="true" Text="@L["Loading"]" />
    }
    else if (_error is not null)
    {
        <div class="page-error" role="alert">
            <p>@_error</p>
            <button type="button" class="btn btn-secondary" @onclick="() => ReloadAsync()">@L["ReviewRetry"]</button>
        </div>
    }
    else
    {
        <div class="stat-grid">
            <article class='stat-card stat-card--link stat-card--warning @ReviewCardClass(PaymentStatus.Pending)' role="button" tabindex="0"
                     @onclick='() => ApplyReviewFilterAsync(PaymentStatus.Pending)'>
                <div class="stat-card__top">
                    <span class="stat-label">@L["ReviewStatPending"]</span>
                    <span class="stat-icon stat-icon--warning"><LucideIcon Name="history" /></span>
                </div>
                <div class="stat-value">@_result.Summary.PendingCount</div>
            </article>
            <article class='stat-card stat-card--link @ReviewCardClass(PaymentStatus.Confirmed)' role="button" tabindex="0"
                     @onclick='() => ApplyReviewFilterAsync(PaymentStatus.Confirmed)'>
                <div class="stat-card__top">
                    <span class="stat-label">@L["ReviewStatConfirmed"]</span>
                    <span class="stat-icon stat-icon--success"><LucideIcon Name="circle-check" /></span>
                </div>
                <div class="stat-value">@_result.Summary.ConfirmedCount</div>
            </article>
            <article class='stat-card stat-card--link @ReviewCardClass(PaymentStatus.Rejected)' role="button" tabindex="0"
                     @onclick='() => ApplyReviewFilterAsync(PaymentStatus.Rejected)'>
                <div class="stat-card__top">
                    <span class="stat-label">@L["ReviewStatRejected"]</span>
                    <span class="stat-icon stat-icon--danger"><LucideIcon Name="circle-x" /></span>
                </div>
                <div class="stat-value">@_result.Summary.RejectedCount</div>
            </article>
            <article class='stat-card stat-card--link @ReviewCardClass(PaymentStatus.Pending)' role="button" tabindex="0"
                     @onclick='() => ApplyReviewFilterAsync(PaymentStatus.Pending)'>
                <div class="stat-card__top">
                    <span class="stat-label">@L["ReviewStatPendingAmount"]</span>
                    <span class="stat-icon stat-icon--accent"><LucideIcon Name="wallet" /></span>
                </div>
                <div class="stat-value">@MoneyFormatter.Format(_result.Summary.PendingAmount)</div>
            </article>
        </div>

        <div class="filter-bar filter-bar--panel">
            <div class="filter-bar__row">
                <div class="filter-bar__search">
                    <label class="sr-only" for="review-keyword">@L["ReviewFilterKeyword"]</label>
                    <span class="filter-bar__icon" aria-hidden="true"><LucideIcon Name="search" /></span>
                    <input id="review-keyword" class="input" type="search" autocomplete="off"
                           placeholder="@L["ReviewFilterKeywordPlaceholder"]"
                           @bind="_keyword" @bind:event="oninput" @bind:after="OnFilterChangedAsync" />
                </div>
                <div class="filter-bar__field filter-bar__select">
                    <label class="sr-only" for="review-status">@L["ReviewFilterStatus"]</label>
                    <select id="review-status" class="input" @bind="_status" @bind:after="OnFilterChangedAsync">
                        <option value="">@L["ReviewAllStatuses"]</option>
                        <option value="@PaymentStatus.Pending">@L["PaymentStatusPending"]</option>
                        <option value="@PaymentStatus.Confirmed">@L["PaymentStatusConfirmed"]</option>
                        <option value="@PaymentStatus.Rejected">@L["PaymentStatusRejected"]</option>
                    </select>
                </div>
                <div class="filter-bar__field filter-bar__select">
                    <label class="sr-only" for="review-year">@L["FilterYear"]</label>
                    <select id="review-year" class="input" @bind="_year" @bind:after="OnFilterChangedAsync">
                        <option value="">@L["AllYears"]</option>
                        @foreach (var year in AvailableYears)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </div>
                <div class="filter-bar__field filter-bar__select">
                    <label class="sr-only" for="review-month">@L["FilterMonth"]</label>
                    <select id="review-month" class="input" disabled="@(_year is null)" @bind="_month" @bind:after="OnFilterChangedAsync">
                        <option value="">@L["AllMonths"]</option>
                        @for (var month = 1; month <= 12; month++)
                        {
                            <option value="@month">@string.Format(L["MonthValue"], month)</option>
                        }
                    </select>
                </div>
                <div class="filter-bar__actions">
                    <FilterAdvancedToggle @bind-Expanded="_showAdvanced" ActiveCount="AdvancedFilterCount" PanelId="review-advanced-panel" />
                    <FilterResetButton OnClick="ResetFiltersAsync" />
                </div>
            </div>
            <div class="filter-bar__advanced" id="review-advanced-panel" hidden="@(!_showAdvanced)">
                <div class="filter-bar__stack">
                    <label for="review-min-amount">@L["ReviewFilterMinAmount"]</label>
                    <input id="review-min-amount" class="input" type="number" min="0" step="1000" inputmode="numeric"
                           placeholder="@L["ReviewAmountPlaceholder"]"
                           @bind="_minAmount" @bind:after="OnFilterChangedAsync" />
                </div>
                <div class="filter-bar__stack">
                    <label for="review-max-amount">@L["ReviewFilterMaxAmount"]</label>
                    <input id="review-max-amount" class="input" type="number" min="0" step="1000" inputmode="numeric"
                           placeholder="@L["ReviewAmountPlaceholder"]"
                           @bind="_maxAmount" @bind:after="OnFilterChangedAsync" />
                </div>
            </div>
        </div>

        <div class="table-card">
            @if (_result.Items.Count > 0)
            {
                <div class="table-responsive">
                    <table class="review-table">
                        <thead>
                            <tr>
                                <th>@L["ReviewThRequest"]</th>
                                <th>@L["ReviewThInvoice"]</th>
                                <th>@L["ReviewThRoomProperty"]</th>
                                <th>@L["ReviewThTenants"]</th>
                                <th>@L["ReviewThPeriod"]</th>
                                <th>@L["ReviewThRequestedAt"]</th>
                                <th class="text-right">@L["ReviewThAmount"]</th>
                                <th>@L["ReviewThStatus"]</th>
                                <th class="text-center">@L["ReviewThActions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _result.Items)
                            {
                                <tr>
                                    <td class="font-semibold tabular-nums">
                                        <a class="cell-link" href="@AppLinks.PaymentRequest(item.Payment.Id)" title="@SL["CellLinkOpenPayment"]">YC-@item.Payment.Id</a>
                                    </td>
                                    <td class="font-semibold tabular-nums">
                                        <a class="cell-link" href="@AppLinks.Invoice(item.InvoiceId)" title="@SL["CellLinkOpenInvoice"]">HD-@item.InvoiceId</a>
                                    </td>
                                    <td>
                                        <a class="cell-link room-code" href="@AppLinks.RoomsByCode(item.RoomCode)" title="@SL["CellLinkOpenRoom"]">@item.RoomCode</a>
                                        <a class="cell-link is-quiet property-name" href="@AppLinks.PropertiesByKeyword(item.PropertyName)" title="@SL["CellLinkOpenProperty"]">@item.PropertyName</a>
                                    </td>
                                    <td>
                                        @if (item.TenantNames.Count == 0)
                                        {
                                            <span class="muted">@L["NoTenants"]</span>
                                        }
                                        else
                                        {
                                            @for (var i = 0; i < item.TenantNames.Count; i++)
                                            {
                                                var tenantName = item.TenantNames[i];
                                                if (i > 0)
                                                {
                                                    <span>, </span>
                                                }
                                                <a class="cell-link is-quiet" href="@AppLinks.TenantsByKeyword(tenantName)" title="@SL["CellLinkOpenTenant"]">@tenantName</a>
                                            }
                                        }
                                    </td>
                                    <td class="tabular-nums">@DateFormatter.Format(item.PeriodStart) – @DateFormatter.Format(item.PeriodEnd)</td>
                                    <td class="tabular-nums">@DateFormatter.FormatDateTime(item.Payment.RequestedAt.UtcDateTime)</td>
                                    <td class="text-right tabular-nums">@MoneyFormatter.Format(item.Payment.Amount)</td>
                                    <td>
                                        <StatusBadge Text="@PaymentStatusText(item.Payment.Status)" Tone="@PaymentStatusTone(item.Payment.Status)" />
                                    </td>
                                    <td class="text-center">
                                        <div class="p2-row-actions">
                                            <button type="button"
                                                    class="icon-button p2-menu-trigger @(IsMenuOpen(item.Payment.Id) ? "is-open" : null)"
                                                    title="@L["ReviewThActions"]"
                                                    aria-label="@($"{L["ReviewThActions"]}: YC-{item.Payment.Id}")"
                                                    aria-haspopup="menu"
                                                    aria-expanded="@(IsMenuOpen(item.Payment.Id) ? "true" : "false")"
                                                    aria-controls="@($"review-row-menu-{item.Payment.Id}")"
                                                    @onclick="() => ToggleRowMenu(item.Payment.Id)">
                                                <LucideIcon Name="ellipsis" />
                                            </button>
                                            @if (IsMenuOpen(item.Payment.Id))
                                            {
                                                <div id="@($"review-row-menu-{item.Payment.Id}")" class="p2-row-menu" role="menu" aria-label="@L["ReviewThActions"]" data-row-menu>
                                                    <button type="button" class="p2-row-menu-item" role="menuitem" @onclick="() => MenuDetail(item.Payment.Id)">
                                                        <LucideIcon Name="eye" /><span>@L["ReviewViewDetail"]</span>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <TablePager Page="_result.Page" TotalPages="TotalPages" From="FirstItem" To="LastItem" Total="_result.TotalCount"
                            PageChanged="GoToPageAsync" />
            }
            else
            {
                <EmptyStateCard Title="@L["ReviewEmptyTitle"]" Description="@L["ReviewEmptyDesc"]" />
            }
        </div>
    }
</div>

@code {
    private const int PageSize = 20;

    private PaymentReviewListResult _result = new()
    {
        Items = [],
        TotalCount = 0,
        Page = 1,
        PageSize = PageSize,
        Summary = new PaymentReviewSummaryDto
        {
            PendingCount = 0,
            ConfirmedCount = 0,
            RejectedCount = 0,
            PendingAmount = 0m,
        },
    };

    private PaymentStatus? _status = PaymentStatus.Pending;
    private string _keyword = string.Empty;
    private int? _year;
    private int? _month;
    private string _minAmount = string.Empty;
    private string _maxAmount = string.Empty;
    private bool _loading = true;
    private string? _error;
    private int _page = 1;
    private bool _showAdvanced;
    // Các lượt đọc dùng chung DbContext scoped của circuit: xếp hàng để bấm thẻ KPI/gõ tìm
    // liên tiếp không chạy hai truy vấn song song trên cùng context.
    private readonly SemaphoreSlim _reloadGate = new(1, 1);

    private int AdvancedFilterCount =>
        (string.IsNullOrWhiteSpace(_minAmount) ? 0 : 1)
        + (string.IsNullOrWhiteSpace(_maxAmount) ? 0 : 1);

    private int? _openMenuId;

    private static IReadOnlyList<int> AvailableYears
    {
        get
        {
            var current = DateTime.UtcNow.Year;
            return Enumerable.Range(current - 5, 7).Reverse().ToArray();
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_result.TotalCount / (double)PageSize));

    private int FirstItem => _result.TotalCount == 0 ? 0 : (_result.Page - 1) * PageSize + 1;

    private int LastItem => Math.Min(_result.Page * PageSize, _result.TotalCount);

    protected override Task OnInitializedAsync()
    {
        _lastAppliedKeywordQuery = KeywordQuery;
        if (KeywordQuery is { Length: > 0 })
        {
            _keyword = KeywordQuery.Trim();
        }

        return ReloadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Link từ bảng khác (?q=A107): Blazor dùng lại trang nên phải lọc lại theo query mới.
        if (string.Equals(KeywordQuery, _lastAppliedKeywordQuery, StringComparison.Ordinal))
        {
            return;
        }

        _lastAppliedKeywordQuery = KeywordQuery;
        _keyword = KeywordQuery?.Trim() ?? string.Empty;
        _page = 1;
        await ReloadAsync();
    }

    /// <summary>Từ khóa từ link chéo (?q=A107 hoặc ?q=HD-001): điền sẵn ô tìm kiếm.</summary>
    [SupplyParameterFromQuery(Name = "q")]
    public string? KeywordQuery { get; set; }

    private string? _lastAppliedKeywordQuery;

    private string ReviewCardClass(PaymentStatus status) =>
        _status == status ? "is-active" : string.Empty;

    private async Task ApplyReviewFilterAsync(PaymentStatus status)
    {
        _status = status;
        _page = 1;
        await ReloadAsync(showLoading: false);
    }

    private async Task ReloadAsync(bool showLoading = true)
    {
        await _reloadGate.WaitAsync();
        try
        {
            if (showLoading) _loading = true;
            _error = null;
            _openMenuId = null;

            try
            {
                _result = await ReviewPage.ListAsync(new PaymentReviewFilter
                {
                    Status = _status,
                    Keyword = _keyword,
                    Year = _year,
                    Month = _month,
                    MinAmount = decimal.TryParse(_minAmount, out var min) && min >= 0 ? min : null,
                    MaxAmount = decimal.TryParse(_maxAmount, out var max) && max >= 0 ? max : null,
                    Page = _page,
                    PageSize = PageSize,
                });
            }
            catch (UnauthorizedAccessException)
            {
                _error = L["ReviewErrorForbidden"];
            }
            catch (Exception)
            {
                _error = L["ReviewLoadError"];
            }
            finally
            {
                _loading = false;
            }
        }
        finally { _reloadGate.Release(); }
    }

    private async Task OnFilterChangedAsync()
    {
        if (_year is null)
        {
            _month = null;
        }

        _page = 1;
        await ReloadAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _status = null;
        _keyword = string.Empty;
        _year = null;
        _month = null;
        _minAmount = string.Empty;
        _maxAmount = string.Empty;
        _page = 1;
        _showAdvanced = false;
        await ReloadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        var target = PaginationHelper.ClampPage(page, TotalPages);
        if (target == _page)
        {
            return;
        }

        _page = target;
        await ReloadAsync();
    }

    private void OpenDetail(int paymentId) => Navigation.NavigateTo($"/payment-requests/{paymentId}");

    private bool IsMenuOpen(int paymentId) => _openMenuId == paymentId;

    private void ToggleRowMenu(int paymentId) => _openMenuId = _openMenuId == paymentId ? null : paymentId;

    private void MenuDetail(int paymentId)
    {
        _openMenuId = null;
        OpenDetail(paymentId);
    }

    private string PaymentStatusText(PaymentStatus status) => status switch
    {
        PaymentStatus.Pending => L["PaymentStatusPending"],
        PaymentStatus.Confirmed => L["PaymentStatusConfirmed"],
        PaymentStatus.Rejected => L["PaymentStatusRejected"],
        _ => L["StatusUnknown"],
    };

    private static BadgeTone PaymentStatusTone(PaymentStatus status) => status switch
    {
        PaymentStatus.Pending => BadgeTone.Warning,
        PaymentStatus.Confirmed => BadgeTone.Success,
        PaymentStatus.Rejected => BadgeTone.Error,
        _ => BadgeTone.Neutral,
    };
}
