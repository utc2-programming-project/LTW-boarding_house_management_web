    private async Task ReviseAsync(ReviseInvoiceRequest request)
    {
        if (_invoice is null || _caller is null || _revising) return;
        _revising = true;
        try
        {
            // Chỉ lưu. Khách CHƯA nhận bản mới cho tới khi chủ trọ bấm "Gửi bill đến khách hàng".
            var revised = await InvoiceService.ReviseAsync(_invoice.Id, request, _caller);
            _invoice = revised;
            _reviseOpen = false;
            Toasts.Success(L["ReviseSuccess"]);
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is IInvoiceServiceError)
        {
            Toasts.Error(InvoiceServiceErrorText(exception));
        }
        finally
        {
            _revising = false;
        }
    }

    private string InvoiceServiceErrorText(Exception exception)
    {
        var code = (exception as IInvoiceServiceError)?.ErrorCode;
        if (code is not null && InvoiceErrorKeys.TryGetValue(code, out var key))
        {
            return L[key];
        }

        return string.IsNullOrWhiteSpace(exception.Message) ? L["ReviseErrorUnknown"] : exception.Message;
    }

    private string PaymentStateText => (_invoice?.Status, _latestPayment?.Status) switch
    {
        (InvoiceStatus.Paid, _) => L["PaymentStatePaid"],
        (_, PaymentStatus.Confirmed) => L["PaymentStatePaid"],
        (_, PaymentStatus.Pending) => L["PaymentStatePendingConfirmation"],
        (_, PaymentStatus.Rejected) => L["PaymentStateRejected"],
        (InvoiceStatus.Issued, null) when _invoice?.DueDate is { } due && due < DateOnly.FromDateTime(DateTime.Today) => L["PaymentStateExpired"],
        (InvoiceStatus.Issued, _) => L["PaymentStateUnpaid"],
        _ => L["PaymentStateUnpaid"],
    };

    private BadgeTone PaymentStateTone => (_invoice?.Status, _latestPayment?.Status) switch
    {
        (InvoiceStatus.Paid, _) => BadgeTone.Success,
        (_, PaymentStatus.Confirmed) => BadgeTone.Success,
        (_, PaymentStatus.Pending) => BadgeTone.Warning,
        (_, PaymentStatus.Rejected) => BadgeTone.Error,
        _ => BadgeTone.Info,
    };
    private bool _requiresResultCheck;

