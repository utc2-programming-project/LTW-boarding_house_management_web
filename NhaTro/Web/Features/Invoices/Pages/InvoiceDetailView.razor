    protected override Task OnParametersSetAsync() => ReloadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _recoveryRef = DotNetObjectReference.Create(this);
        try
        {
            await PaymentRecovery.ConnectAsync(_recoveryRef);
            _recoveryConnected = true;
        }
        catch (Exception)
        {
            // Không có JS/storage không chặn trang; người dùng vẫn tra thủ công được.
        }

        // Chỉ mở nút gửi sau khi đã kiểm marker một lần, tránh khe hở trước tra cứu.
        _recoveryReady = true;
        StateHasChanged();
        await TryRecoverPendingAsync();
    }

    private string RecoveryTarget => $"invoice:{Id}";

    /// <summary>
    /// Sau khôi phục circuit hoặc tải lại: chỉ tra đọc nếu còn marker chưa rõ kết quả.
    /// Không tự gọi lại lệnh ghi.
    /// </summary>
    [JSInvokable]
    public async Task OnReconnectedAsync()
    {
        await InvokeAsync(async () =>
        {
            if (_submitting || _invoice is null || _caller is null)
            {
                return;
            }

            if (!_requiresResultCheck && !await HasPendingRecoveryAsync())
            {
                return;
            }

            _requiresResultCheck = true;
            await CheckResultAsync();
            StateHasChanged();
        });
    }

    private async Task TryRecoverPendingAsync()
    {
        if (!_recoveryConnected || _checkingResult || _invoice is null || _caller is null)
        {
            return;
        }

        if (!await HasPendingRecoveryAsync())
        {
            return;
        }

        _requiresResultCheck = true;
        StateHasChanged();
        await CheckResultAsync();
    }

    private async Task<bool> HasPendingRecoveryAsync()
    {
        if (_caller is null)
        {
            return false;
        }

        try
        {
            return await PaymentRecovery.HasAsync(RecoveryTarget, _caller.UserId);
        }
        catch (Exception)
        {
            return false;
        }
    }

    private async Task ClearRecoveryAsync()
    {
        try
        {
            await PaymentRecovery.ClearAsync(RecoveryTarget);
        }
        catch (Exception)
        {
        }
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _notFound = false;
        _loadError = null;
        _paymentsError = null;
        _invoice = null;
        _latestPayment = null;
        _payments = [];
        _proofFiles = new Dictionary<Guid, FileMetadataDto>();
        _formError = null;
        _resultCheckMessage = null;
        _requiresResultCheck = false;
        _bankAccount = null;

        try
        {
            var caller = await CallerProvider.GetCallerAsync();
            _caller = caller;
            _invoice = await InvoiceQuery.GetInvoiceAsync(Id, caller);
            _latestPayment = _invoice.LatestPayment;
            // PLAN-028: QR chỉ hiển thị cho khách thuê; lấy TK của chủ trọ sở hữu phòng.
            _bankAccount = caller.IsKhachThue
                ? await OwnerBank.GetForInvoiceAsync(_invoice.Id)
                : null;
            ResetForm();
            await LoadPaymentHistoryAsync();
        }
        catch (KeyNotFoundException)
        {
            // Không phân biệt "không tồn tại" với "ngoài phạm vi" để không lộ ID hóa đơn.
            _notFound = true;
        }
        catch (UnauthorizedAccessException)
        {
            _notFound = true;
        }
        catch (Exception)
        {
            _loadError = L["ErrorLoadDetail"];
        }
        finally
        {
            _loading = false;
        }

        await TryRecoverPendingAsync();
    }

    private async Task IssueAsync()
    {
        if (_issuing || _caller is null || _invoice is null || _caller.IsKhachThue) return;
        if (_invoice.Status != InvoiceStatus.Draft) return;

        _issuing = true;
        try
        {
            var issued = await InvoiceService.IssueAsync(_invoice.Id, _caller);
            _invoice = issued;
            Toasts.Success(L["IssueSuccess"]);
            await ReloadAsync();
        }
        catch (Web.Features.Invoices.InvoiceOperationException)
        {
            Toasts.Error(L["IssueFailed"]);
        }
        catch (Exception)
        {
            Toasts.Error(L["IssueFailed"]);
        }
        finally
        {
            _issuing = false;
        }
    }

    private async Task LoadPaymentHistoryAsync()
    {
        if (_invoice is null)
        {
            return;
        }

        try
        {
            _payments = await PaymentPage.HistoryAsync(Id);
            _proofFiles = (await PaymentPage.ProofFilesAsync(Id)).ToDictionary(file => file.Id);
            _latestPayment = _payments.FirstOrDefault() ?? _invoice.LatestPayment;
        }
        catch (Exception)
        {
            _paymentsError = L["ErrorLoadPayments"];
        }
    }

    private void ResetForm()
    {
        _selectedFiles = [];
        _preparedProofIds = [];
        _fileInputVersion++;
        _fileError = null;
        _formError = null;
        _resultCheckMessage = null;
    }

    private async Task SubmitAsync()
    {
        if (_submitting || _checkingResult || _requiresResultCheck || !_recoveryReady
            || _invoice is null || _caller is null || !_caller.IsKhachThue)
        {
            return;
        }

        _submitting = true;
        _formError = null;
        _fileError = null;
        _resultCheckMessage = null;

        try
        {
            if (!ValidateForm(out var amount, out var transferredAt))
            {
                return;
            }

            var proofIds = _preparedProofIds.ToList();
            var pendingFiles = _selectedFiles.ToList();
            foreach (var file in pendingFiles)
            {
                var result = await PaymentPage.UploadProofAsync(Invoice.Id, file);
                if (!result.Succeeded || result.File is null)
                {
                    _formError = UploadErrorText(result);
                    _preparedProofIds = proofIds;
                    return;
                }

                proofIds.Add(result.File.Id);
                _preparedProofIds = proofIds.ToList();
                // Giữ lại tệp chưa tải được để lần gửi sau không upload trùng tệp đã lên.
                _selectedFiles = _selectedFiles.Where(item => !ReferenceEquals(item, file)).ToList();
            }

            if (proofIds.Count == 0)
            {
                _fileError = L["PaymentProofRequired"];
                return;
            }

            _selectedFiles = [];
            _fileInputVersion++;

            bool marked;
            try
            {
                marked = await PaymentRecovery.MarkAsync(RecoveryTarget, "submit", _caller.UserId);
            }
            catch (Exception)
            {
                marked = false;
            }

            if (!marked)
            {
                _formError = L["PaymentRecoveryStoreFailed"];
                return;
            }

            var payment = await PaymentPage.SubmitAsync(
                Invoice.Id,
                amount,
                transferredAt,
                null,
                proofIds);

            _latestPayment = payment;
            _preparedProofIds = [];
            await ClearRecoveryAsync();
            Toasts.Success(L["PaymentSubmittedSuccess"]);
            await RefreshAfterSubmitAsync();
        }
        catch (PaymentNotFoundException exception)
        {
            await ClearRecoveryAsync();
            _formError = ServiceErrorText(exception);
        }
        catch (PaymentAuthorizationException exception)
        {
            await ClearRecoveryAsync();
            _formError = ServiceErrorText(exception);
        }
        catch (PaymentValidationException exception)
        {
            await ClearRecoveryAsync();
            _formError = ServiceErrorText(exception);
            if (exception.ErrorCode is PaymentErrorCodes.ProofRequired or PaymentErrorCodes.InvalidProof)
            {
                _fileError = _formError;
                // Minh chứng bị service từ chối: bỏ qua bộ đệm để lần sau phải chọn/tải lại.
                ClearProofSelection();
            }
        }
        catch (PaymentOperationException exception)
            when (exception.ErrorCode is PaymentErrorCodes.PendingPaymentExists
                or PaymentErrorCodes.InvoiceAlreadyPaid
                or PaymentErrorCodes.ConcurrencyConflict)
        {
            _formError = ServiceErrorText(exception);
            _requiresResultCheck = false;
            ClearProofSelection();
            await LoadPaymentHistoryAsync();
            _paymentsError = null;
            await ClearRecoveryAsync();
        }
        catch (PaymentOperationException exception)
        {
            await ClearRecoveryAsync();
            _formError = ServiceErrorText(exception);
        }
        catch (Exception)
        {
            // Không biết server đã ghi yêu cầu hay chưa: bắt buộc tra kết quả trước khi thử lại.
            _requiresResultCheck = true;
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task CheckResultAsync()
    {
        if (_checkingResult || _invoice is null)
        {
            return;
        }

        _checkingResult = true;
        _formError = null;
        _resultCheckMessage = null;

        try
        {
            var latest = await PaymentPage.LatestAsync(Id);
            await LoadPaymentHistoryAsync();
            _latestPayment = latest ?? _payments.FirstOrDefault() ?? _invoice.LatestPayment;
            _requiresResultCheck = false;
            await ClearRecoveryAsync();

            if (latest is null)
            {
                // Chưa có bản ghi: giữ minh chứng đã tải để lần gửi lại không upload trùng.
                _resultCheckMessage = L["PaymentNoResultYet"];
            }
            else
            {
                _preparedProofIds = [];
                _selectedFiles = [];
                _fileInputVersion++;
            }
        }
        catch (Exception exception)
        {
            _formError = ServiceErrorText(exception);
            _requiresResultCheck = true;
        }
        finally
        {
            _checkingResult = false;
        }
    }

    private async Task RefreshAfterSubmitAsync()
    {
        if (_invoice is null)
        {
            return;
        }

        try
        {
            var invoice = await InvoiceQuery.GetInvoiceAsync(Id, _caller!);
            _invoice = invoice;
            _latestPayment = invoice.LatestPayment ?? _latestPayment;
            await LoadPaymentHistoryAsync();
            ResetForm();
        }
        catch (Exception)
        {
            // Yêu cầu đã gửi thành công; lỗi đọc lại chỉ làm mất phần làm mới, không báo gửi thất bại.
            _resultCheckMessage = L["PaymentRefreshPending"];
        }
    }

    private bool ValidateForm(out decimal amount, out DateTimeOffset transferredAt)
    {
        // Form gửi bill chỉ còn 1 nút: số tiền = tổng hóa đơn, thời điểm = lúc gửi.
        // Trên bill chuyển khoản ngân hàng đã có đủ thông tin chi tiết.
        amount = Invoice?.TotalAmount ?? 0m;
        transferredAt = DateTimeOffset.Now;
        var valid = true;

        if (amount <= 0m)
        {
            _formError = L["PaymentAmountInvalid"];
            valid = false;
        }

        if (_selectedFiles.Count == 0 && _preparedProofIds.Count == 0)
        {
            _fileError = L["PaymentProofRequired"];
            valid = false;
        }

        return valid;
    }

    private void OnFilesSelected(InputFileChangeEventArgs args)
    {
        _fileError = null;
        // Không được thay key/render lại ô chọn file ở đây: Blazor JS giữ stream theo element,
        // render lại sẽ làm Stream đọc ở bước gửi bị lỗi "_blazorFilesById".

        IReadOnlyList<IBrowserFile> incoming;
        try
        {
            incoming = args.GetMultipleFiles(20);
        }
        catch (InvalidOperationException)
        {
            _fileError = L["PaymentProofTooMany"];
            return;
        }

        var accepted = new List<IBrowserFile>(_selectedFiles);
        foreach (var file in incoming)
        {
            if (file.Size > PaymentPolicy.MaxBytes)
            {
                _fileError = string.Format(
                    L["PaymentProofTooLarge"],
                    file.Name,
                    FileTypeRules.DescribeMegabytes(PaymentPolicy.MaxBytes));
                continue;
            }

            var extension = FileTypeRules.GetExtension(file.Name);
            if (!PaymentPolicy.AllowedExtensions.Contains(extension, StringComparer.Ordinal))
            {
                _fileError = L["PaymentProofInvalidType"];
                continue;
            }

            if (accepted.Any(existing => existing.Name == file.Name && existing.Size == file.Size))
            {
                continue;
            }

            accepted.Add(file);
        }

        _selectedFiles = accepted;
    }

    private void RemoveFile(IBrowserFile file)
    {
        _selectedFiles = _selectedFiles.Where(item => !ReferenceEquals(item, file)).ToList();
        // Không bump _fileInputVersion: giữ nguyên element để các tệp còn lại đọc được stream.
        _fileError = null;
    }

    private void ClearProofSelection()
    {
        _selectedFiles = [];
        _preparedProofIds = [];
        _fileInputVersion++;
    }

    private string ServiceErrorText(Exception exception)
    {
        var code = (exception as IPaymentServiceError)?.ErrorCode;
        if (code is not null && PaymentErrorKeys.TryGetValue(code, out var key))
        {
            return L[key];
        }

        return string.IsNullOrWhiteSpace(exception.Message) ? L["PayErrorUnknown"] : exception.Message;
    }

    private string UploadErrorText(UploadResult result)
    {
        if (result.ErrorCode is not null && UploadErrorKeys.TryGetValue(result.ErrorCode, out var key))
        {
            return L[key];
        }

        return string.IsNullOrWhiteSpace(result.ErrorMessage) ? L["PayErrorUploadUnknown"] : result.ErrorMessage;
    }

    private string ProofName(Guid proofId) =>
        _proofFiles.TryGetValue(proofId, out var file) && !string.IsNullOrWhiteSpace(file.FileName)
            ? file.FileName
            : L["PaymentProofOpen"];

