@page "/invoices/{Id:int}"
@page "/my/invoices/{Id:int}"
@page "/my-invoices/{Id:int}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@attribute [Authorize(Policy = "InvoiceView")]
@using Web.Common.Utils
@inject IInvoiceQueryService InvoiceQuery
@inject Web.Features.Invoices.Services.IInvoiceService InvoiceService
@inject Web.Features.Notifications.INotificationService Notifications
@inject Web.Features.Invoices.Services.IOwnerBankAccountService OwnerBank
@inject PaymentPageService PaymentPage
@inject PaymentRecoveryService PaymentRecovery
@inject P2CallerProvider CallerProvider
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject IStringLocalizer<InvoiceResources> L

<PageTitle>@L["DetailPageTitle"]</PageTitle>

<div class="invoice-detail-page">
    @if (_loading)
    {
        <LoadingOverlay Visible="true" Text="@L["Loading"]" />
    }
    else if (_loadError is not null)
    {
        <div class="page-error" role="alert">
            <p>@_loadError</p>
            <button type="button" class="btn btn-secondary" @onclick="ReloadAsync">@L["Retry"]</button>
        </div>
    }
    else if (_notFound || _invoice is null)
    {
        <EmptyStateCard Title="@L["DetailNotFoundTitle"]" Description="@L["DetailNotFoundDesc"]">
            <button type="button" class="btn btn-secondary" @onclick="BackToList">@L["BackToInvoices"]</button>
        </EmptyStateCard>
    }
    else
    {
        <PageHeading Title="@($"{L["DetailHeading"]} · HD-{Invoice.Id}")" CurrentLabel="@L["DetailBreadcrumb"]" HelpText="@L["DetailSubtitle"]">
            <Actions>
                <div class="header-actions">
                    @if (_caller is not null && !_caller.IsKhachThue && Invoice.Status == InvoiceStatus.Draft)
                    {
                        <button type="button" class="btn btn-primary" disabled="@_issuing" @onclick="IssueAsync">
                            @if (_issuing)
                            {
                                <span class="spinner"></span>
                                <span>@L["IssuingButton"]</span>
                            }
                            else
                            {
                                <LucideIcon Name="send" />
                                <span>@L["SendBillButton"]</span>
                            }
                        </button>
                    }
                    else if (_caller is not null && !_caller.IsKhachThue && Invoice.Status == InvoiceStatus.Issued)
                    {
                        @* Có bản chỉnh sửa chưa gửi thì nút gửi bill nổi bật để chủ trọ gửi bản mới. *@
                        <button type="button" class="@(Invoice.HasUnsentChanges ? "btn btn-primary" : "btn btn-secondary")"
                                disabled="@_sending" @onclick="SendBillAsync">
                            @if (_sending)
                            {
                                <span class="spinner"></span>
                                <span>@L["SendingBill"]</span>
                            }
                            else
                            {
                                <LucideIcon Name="send" />
                                <span>@L["SendBillButton"]</span>
                            }
                        </button>

                        @if (CanRevise || CanDelete)
                        {
                            <details class="invoice-action-menu">
                                <summary class="btn btn-secondary"><LucideIcon Name="more-horizontal" /><span>@L["InvoiceMoreActions"]</span></summary>
                                <div class="invoice-action-menu-panel">
                                    @if (CanRevise)
                                    {
                                        <button type="button" class="p2-row-menu-item" disabled="@_revising" @onclick="OpenRevise">
                                            <LucideIcon Name="edit" /><span>@L["ReviseButton"]</span>
                                        </button>
                                    }
                                    @if (CanDelete)
                                    {
                                        <button type="button" class="p2-row-menu-item danger" disabled="@_deleting" @onclick="OpenDelete">
                                            <LucideIcon Name="trash" /><span>@L["DeleteIssuedButton"]</span>
                                        </button>
                                    }
                                </div>
                            </details>
                        }
                    }
                    <button type="button" class="btn btn-secondary" @onclick="BackToList">
                        <LucideIcon Name="arrow-left" />
                        <span>@L["BackToList"]</span>
                    </button>
                </div>
            </Actions>
        </PageHeading>

        <section class="detail-card">
            <div class="detail-grid">
                <div class="detail-field">
                    <span class="detail-label">@L["DetailStatus"] <HelpTip Text="@L["DetailStatusHint"]" /></span>
                    <StatusBadge Text="@StatusText(Invoice.Status)" Tone="@StatusTone(Invoice.Status)" />
                </div>
                <div class="detail-field">
                    <span class="detail-label">@L["DetailPeriod"] <HelpTip Text="@L["InvoicePeriodHint"]" /></span>
                    <span class="detail-value tabular-nums">@DateFormatter.Format(Invoice.PeriodStart) – @DateFormatter.Format(Invoice.PeriodEnd)</span>
                </div>
                <div class="detail-field">
                    <span class="detail-label">@L["DetailContract"] <HelpTip Text="@L["DetailContractHint"]" /></span>
                    <span class="detail-value">
                        <a class="cell-link" href="@ContractLink">@Invoice.ContractNumber</a>
                    </span>
                </div>
                <div class="detail-field">
                    <span class="detail-label">@L["DetailProperty"] <HelpTip Text="@L["DetailPropertyHint"]" /></span>
                    <span class="detail-value">
                        @if (IsMyInvoices)
                        {
                            @Invoice.PropertyName
                        }
                        else
                        {
                            <a class="cell-link" href="@AppLinks.PropertiesByKeyword(Invoice.PropertyName)">@Invoice.PropertyName</a>
                        }
                    </span>
                </div>
                <div class="detail-field">
                    <span class="detail-label">@L["DetailRoom"] <HelpTip Text="@L["DetailRoomHint"]" /></span>
                    <span class="detail-value">
                        @if (IsMyInvoices)
                        {
                            @Invoice.RoomCode
                        }
                        else
                        {
                            <a class="cell-link" href="@AppLinks.RoomsByCode(Invoice.RoomCode)">@Invoice.RoomCode</a>
                        }
                    </span>
                </div>
                <div class="detail-field">
                    <span class="detail-label">@L["DetailTenants"] <HelpTip Text="@L["DetailTenantsHint"]" /></span>
                    <span class="detail-value">
                        @if (Invoice.TenantNames.Count == 0)
                        {
                            <span class="muted">@L["NoTenants"]</span>
                        }
                        else if (IsMyInvoices)
                        {
                            @string.Join(", ", Invoice.TenantNames)
                        }
                        else
                        {
                            @for (var i = 0; i < Invoice.TenantNames.Count; i++)
                            {
                                if (i > 0) { <span>, </span> }
                                <a class="cell-link" href="@AppLinks.TenantsByKeyword(Invoice.TenantNames[i])">@Invoice.TenantNames[i]</a>
                            }
                        }
                    </span>
                </div>
                <div class="detail-field">
                    <span class="detail-label">@L["DetailCreatedAt"]</span>
                    <span class="detail-value tabular-nums">@DateFormatter.FormatDateTime(Invoice.CreatedAt)</span>
                </div>
                <div class="detail-field">
                    <span class="detail-label">@L["DetailIssuedAt"]</span>
                    <span class="detail-value tabular-nums">
                        @(Invoice.IssuedAt is null ? L["DetailNotAvailable"] : DateFormatter.FormatDateTime(Invoice.IssuedAt))
                    </span>
                </div>
                <div class="detail-field">
                    <span class="detail-label">@L["DetailDueDate"]</span>
                    <span class="detail-value tabular-nums">
                        @(Invoice.DueDate is null ? "—" : DateFormatter.Format(Invoice.DueDate.Value))
                    </span>
                </div>
                <div class="detail-field">
                    <span class="detail-label">@L["DetailPaymentStatus"]</span>
                    <span class="badge-inline">
                        <StatusBadge Text="@PaymentStateText" Tone="@PaymentStateTone" />
                    </span>
                </div>
            </div>
        </section>

        <section class="items-card">
            <h2 class="section-title">@L["ItemsHeading"]</h2>

            @if (Invoice.Items.Count == 0)
            {
                <p class="muted">@L["NoItems"]</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="items-table">
                        <thead>
                            <tr>
                                <th>@L["ThItemType"]</th>
                                <th>@L["ThDescription"]</th>
                                <th>@L["ThUnit"]</th>
                                <th class="text-right">@L["ThQuantity"]</th>
                                <th class="text-right">@L["ThUnitPrice"]</th>
                                <th class="text-right">@L["ThAmount"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Invoice.Items)
                            {
                                <tr>
                                    <td>@ItemTypeText(item.ItemType)</td>
                                    <td>@item.Description</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Unit) ? "-" : item.Unit)</td>
                                    <td class="text-right tabular-nums">@item.Quantity.ToString("0.##")</td>
                                    <td class="text-right tabular-nums">@MoneyFormatter.Format(item.UnitPrice)</td>
                                    <td class="text-right tabular-nums @(item.Amount < 0 ? "discount" : "")">
                                        @MoneyFormatter.Format(item.Amount)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="summary-panel">
                <div class="summary-row">
                    <span>@L["SummaryTotal"] <HelpTip Text="@L["SummaryTotalHint"]" /></span>
                    <strong class="tabular-nums">@MoneyFormatter.Format(Invoice.TotalAmount)</strong>
                </div>
                <div class="summary-row">
                    <span>@L["SummaryPaid"] <HelpTip Text="@L["SummaryPaidHint"]" /></span>
                    <strong class="tabular-nums">@MoneyFormatter.Format(Invoice.PaidAmount)</strong>
                </div>
                <div class="summary-row outstanding">
                    <span>@L["SummaryOutstanding"] <HelpTip Text="@L["SummaryOutstandingHint"]" /></span>
                    <strong class="tabular-nums">@MoneyFormatter.Format(Invoice.OutstandingAmount)</strong>
                </div>
            </div>

            @if (Invoice.Revisions.Count > 0)
            {
                <section class="revision-panel">
                    <div class="section-title-row">
                        <h3 class="section-title">@L["RevisionHistoryTitle"]</h3>
                        <span class="revision-count">@Invoice.Revisions.Count</span>
                    </div>
                    <p class="muted">@L["RevisionHistoryHint"]</p>
                    <ul class="revision-list">
                        @foreach (var revision in Invoice.Revisions)
                        {
                            <li>
                                <div class="revision-reason">@revision.Reason</div>
                                <div class="revision-meta">
                                    <span>@DateFormatter.FormatDateTime(revision.ChangedAt)</span>
                                    @if (revision.PreviousTotalAmount != revision.NewTotalAmount)
                                    {
                                        <span class="revision-amount">
                                            @MoneyFormatter.Format(revision.PreviousTotalAmount)
                                            <LucideIcon Name="arrow-right" />
                                            @MoneyFormatter.Format(revision.NewTotalAmount)
                                        </span>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                </section>
            }
        </section>

        @if (Invoice.Status != InvoiceStatus.Draft && _caller is { IsKhachThue: true })
        {
            <section class="qr-card">
                <h2 class="section-title">@L["QrTitle"]</h2>
                <div class="qr-payment-layout">
                    <div class="qr-zone">
                        @if (_bankAccount is not { IsConfigured: true })
                        {
                            @if (IsInvoicePaid)
                            {
                                <LucideIcon Name="circle-check" Class="qr-paid-icon" />
                            }
                            else
                            {
                                @* PLAN-028: Chủ trọ chưa nhập tài khoản nhận tiền nên không sinh được VietQR. *@
                                <div class="qr-missing-bank" role="alert">
                                    <LucideIcon Name="alert-triangle" />
                                    <p>@L["QrMissingBankNotice"]</p>
                                </div>
                            }
                        }
                        else if (_qrExpired)
                        {
                            <p class="qr-expired" role="status">@L["QrExpired"]</p>
                            <button type="button" class="btn btn-primary" @onclick="GenerateQr">
                                <LucideIcon Name="qr-code" />
                                <span>@L["RegenerateQrButton"]</span>
                            </button>
                        }
                        else if (_qrImageUri is null)
                        {
                            <div class="qr-placeholder">
                                <button type="button" class="btn btn-primary" @onclick="GenerateQr">
                                    <LucideIcon Name="qr-code" />
                                    <span>@L["CreateQrButton"]</span>
                                </button>
                                <p class="muted">@L["QrNote"]</p>
                            </div>
                        }
                        else
                        {
                            <img class="qr-image" src="@_qrImageUri" alt="VietQR" width="240" height="240" />
                            <p class="qr-validity">@L["QrExpiresAt"]: @_qrExpiresAt?.ToLocalTime().ToString("HH:mm")@(string.IsNullOrWhiteSpace(_qrRemaining) ? "" : $" ({L["QrRemainingInstruction"]} {_qrRemaining})")</p>
                        }
                    </div>
                    <div class="qr-side">
                        <dl class="qr-info">
                            <div><dt>@L["QrBank"]</dt><dd>@(_bankAccount?.DisplayAccount ?? L["QrBankNotConfigured"])</dd></div>
                            <div><dt>@L["SummaryTotal"]</dt><dd class="tabular-nums">@MoneyFormatter.Format(Invoice.TotalAmount)</dd></div>
                            <div><dt>@L["QrContent"]</dt><dd>HD-@Invoice.Id</dd></div>
                        </dl>

                        @if (Invoice.Status == InvoiceStatus.Draft)
                        {
                            <div class="payment-notice info" role="status">
                                <LucideIcon Name="info" />
                                <span>@L["PaymentDraftNotice"]</span>
                            </div>
                        }
                        else if (Invoice.Status == InvoiceStatus.Paid || _latestPayment?.Status == PaymentStatus.Confirmed)
                        {
                            <div class="payment-notice success" role="status">
                                <LucideIcon Name="circle-check" />
                                <span>@L["PaymentPaidNotice"]</span>
                            </div>
                            @if (_latestPayment is not null)
                            {
                                <PaymentSummaryCard Payment="_latestPayment" ProofFiles="_proofFiles" />
                            }
                        }
                        else if (_latestPayment is { Status: PaymentStatus.Pending })
                        {
                            <div class="payment-notice warning" role="status">
                                <LucideIcon Name="info" />
                                <span>@L["PaymentPendingNotice"]</span>
                            </div>
                            <PaymentSummaryCard Payment="_latestPayment" ProofFiles="_proofFiles" />
                        }
                        else
                        {
                            @if (_latestPayment is { Status: PaymentStatus.Rejected })
                            {
                                <div class="payment-notice danger" role="alert">
                                    <LucideIcon Name="alert" />
                                    <span>@L["PaymentRejectedNotice"]</span>
                                </div>
                                <PaymentSummaryCard Payment="_latestPayment" ProofFiles="_proofFiles" />
                            }

                            @if (_requiresResultCheck)
                            {
                                <div class="payment-notice warning">
                                    <LucideIcon Name="wifi" />
                                    <div class="payment-result-check">
                                        <p>@L["PaymentResultUnknown"]</p>
                                        <button type="button" class="btn btn-secondary" disabled="@_checkingResult" @onclick="CheckResultAsync">
                                            @if (_checkingResult)
                                            {
                                                <span class="spinner"></span>
                                            }
                                            else
                                            {
                                                <LucideIcon Name="refresh" />
                                            }
                                            <span>@L[_checkingResult ? "PaymentChecking" : "PaymentCheckResult"]</span>
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @if (_resultCheckMessage is not null)
                                {
                                    <div class="payment-notice info" role="status">
                                        <LucideIcon Name="info" />
                                        <span>@_resultCheckMessage</span>
                                    </div>
                                }

                                <form class="payment-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
                                    @if (_formError is not null)
                                    {
                                        <div class="form-alert" role="alert">
                                            <LucideIcon Name="alert" />
                                            <span>@_formError</span>
                                        </div>
                                    }
                                    <div class="payment-fixed-amount">
                                        <span class="payment-fixed-amount__label">@L["PaymentAmount"]</span>
                                        <strong class="tabular-nums">@MoneyFormatter.Format(Invoice.TotalAmount)</strong>
                                    </div>
                                    <div class="payment-field full">
                                        <span class="detail-label">@L["PaymentProof"]</span>
                                        <InputFile @key="_fileInputVersion"
                                                   id="payment-proof-input"
                                                   multiple
                                                   accept="@ProofAccept"
                                                   OnChange="OnFilesSelected"
                                                   disabled="@_submitting" />
                                        <span class="note">@string.Format(L["PaymentProofHint"], FileTypeRules.DescribeMegabytes(PaymentPolicy.MaxBytes))</span>
                                        @if (_fileError is not null)
                                        {
                                            <span class="field-error" role="alert">@_fileError</span>
                                        }

                                        @if (_selectedFiles.Count > 0)
                                        {
                                            <ul class="selected-proofs">
                                                @foreach (var file in _selectedFiles)
                                                {
                                                    <li>
                                                        <LucideIcon Name="file" />
                                                        <span class="selected-proof-name">@file.Name</span>
                                                        <span class="muted tabular-nums">@NumberFormatter.FileSize(file.Size)</span>
                                                        <button type="button"
                                                                class="icon-action-btn"
                                                                title="@L["PaymentProofRemove"]"
                                                                aria-label="@L["PaymentProofRemove"]"
                                                                disabled="@_submitting"
                                                                @onclick="() => RemoveFile(file)">
                                                            <LucideIcon Name="x" />
                                                        </button>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </div>

                                    <div class="form-actions">
                                        <button type="submit" class="btn btn-primary" data-payment-write disabled="@(_submitting || !_recoveryReady)">
                                            @if (_submitting)
                                            {
                                                <span class="spinner"></span>
                                            }
                                            else
                                            {
                                                <LucideIcon Name="send" />
                                            }
                                            <span>@L[_submitting ? "PaymentSubmitting" : "PaymentSubmit"]</span>
                                        </button>
                                    </div>
                                </form>
                            }
                        }
                    </div>
                </div>
            </section>
        }

        @if (_caller is not null && !_caller.IsKhachThue && (_latestPayment is not null || _paymentsError is not null))
        {
            <section class="payment-card">
                <div class="payment-card-header">
                    <h2 class="section-title">@L["PaymentHeading"]</h2>
                    @if (_latestPayment is not null)
                    {
                        <StatusBadge Text="@PaymentStatusText(_latestPayment.Status)" Tone="@PaymentStatusTone(_latestPayment.Status)" />
                    }
                </div>

                @if (_paymentsError is not null)
                {
                    <div class="form-alert" role="alert">
                        <LucideIcon Name="alert" />
                        <span>@_paymentsError</span>
                    </div>
                }

                @if (_formError is not null)
                {
                    <div class="form-alert" role="alert">
                        <LucideIcon Name="alert" />
                        <span>@_formError</span>
                    </div>
                }

                @if (_latestPayment is not null)
                {
                    <PaymentSummaryCard Payment="_latestPayment" ProofFiles="_proofFiles" />
                }
            </section>
        }

                @if (_payments.Count > 0)
                {
                    <section class="payment-card">
                    <div class="payment-history">
                        <h3 class="section-title">@L["PaymentHistoryHeading"]</h3>
                        <div class="table-responsive">
                            <table class="items-table payment-history-table">
                                <thead>
                                    <tr>
                                        <th>@L["PaymentRequestedAt"]</th>
                                        <th class="text-right">@L["ThAmount"]</th>
                                        <th>@L["PaymentTransactionCode"]</th>
                                        <th>@L["ThStatus"]</th>
                                        <th>@L["PaymentProof"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payment in _payments)
                                    {
                                        <tr>
                                            <td class="tabular-nums">@DateFormatter.FormatDateTime(payment.RequestedAt.UtcDateTime)</td>
                                            <td class="text-right tabular-nums">@MoneyFormatter.Format(payment.Amount)</td>
                                            <td class="break-anywhere">@(string.IsNullOrWhiteSpace(payment.TransactionCode) ? "-" : payment.TransactionCode)</td>
                                            <td>
                                                <StatusBadge Text="@PaymentStatusText(payment.Status)" Tone="@PaymentStatusTone(payment.Status)" />
                                            </td>
                                            <td>
                                                @if (payment.ProofFileIds.Count == 0)
                                                {
                                                    <span class="muted">-</span>
                                                }
                                                else
                                                {
                                                    foreach (var proofId in payment.ProofFileIds)
                                                    {
                                                        <a class="proof-link" href="@($"/api/files/{proofId:D}")" target="_blank" rel="noopener">
                                                            @ProofName(proofId)
                                                        </a>
                                                    }
                                                }
                                            </td>
                                        </tr>
                                        @if (payment.Status == PaymentStatus.Rejected && !string.IsNullOrWhiteSpace(payment.RejectionReason))
                                        {
                                            <tr class="history-reason">
                                                <td colspan="5"><strong>@L["PaymentRejectionReason"]:</strong> @payment.RejectionReason</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </section>
        }
    }
</div>

@if (_reviseOpen && Invoice is not null && _caller is not null)
{
    <InvoiceRevisionDialog Invoice="Invoice" Caller="_caller" Busy="_revising"
                           OnSubmit="ReviseAsync" OnCancel="CloseRevise" />
}

@if (_deleteVisible && Invoice is not null)
{
    <ConfirmDialog Visible="true"
                   Title="@L["DeleteIssuedTitle"]"
                   Message="@string.Format(L["DeleteIssuedMessage"], Invoice.Id, MoneyFormatter.Format(Invoice.TotalAmount))"
                   ConfirmText="@L["DeleteIssuedConfirm"]"
                   CancelText="@L["ReviseCancel"]"
                   BusyText="@L["Deleting"]"
                   Danger="true"
                   OnConfirm="DeleteIssuedAsync"
                   OnCancel="CancelDelete" />
}

@code {
    [Parameter]
    public int Id { get; set; }

    private InvoiceDto? _invoice;
    private PaymentDto? _latestPayment;
    private IReadOnlyList<PaymentDto> _payments = [];
    private IReadOnlyDictionary<Guid, FileMetadataDto> _proofFiles = new Dictionary<Guid, FileMetadataDto>();
    private PropertyCaller? _caller;

    private bool _loading = true;
    private bool _notFound;
    private string? _loadError;
    private string? _paymentsError;

    private List<IBrowserFile> _selectedFiles = [];
    private List<Guid> _preparedProofIds = [];
    private int _fileInputVersion;
    private string? _fileError;
    private string? _formError;
    private string? _resultCheckMessage;
    private bool _submitting;
    private bool _issuing;
    private bool _reviseOpen;
    private bool _revising;
    private bool _sending;
    private bool _deleteVisible;
    private bool _deleting;
    private bool _checkingResult;
    private DotNetObjectReference<InvoiceDetailView>? _recoveryRef;
    private bool _recoveryConnected;
    private bool _recoveryReady;
    private string? _qrImageUri;
    private Web.Features.Invoices.Services.OwnerBankAccount? _bankAccount;
    private DateTimeOffset? _qrExpiresAt;
    private bool _qrExpired => _qrExpiresAt is { } expires && DateTimeOffset.UtcNow > expires;
    private string? _qrRemaining => _qrExpiresAt is { } expires && expires > DateTimeOffset.UtcNow
        ? (expires - DateTimeOffset.UtcNow).ToString(@"mm\:ss")
        : null;
    private PeriodicTimer? _qrTimer;
    private CancellationTokenSource? _qrTimerCts;

    private void GenerateQr()
    {
        if (_invoice is null || _bankAccount is not { IsConfigured: true }) return;
        _qrImageUri = VietQr.ImageDataUri(VietQr.GeneratePayload(
            _bankAccount.BankCode,
            _bankAccount.AccountNumber,
            _invoice.TotalAmount,
            $"HD-{_invoice.Id}"));
        _qrExpiresAt = DateTimeOffset.UtcNow.AddMinutes(30);
        StartQrTimer();
    }

    private void StartQrTimer()
    {
        StopQrTimer();
        _qrTimerCts = new CancellationTokenSource();
        _qrTimer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        var token = _qrTimerCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                while (await _qrTimer.WaitForNextTickAsync(token))
                {
                    if (_qrExpiresAt is { } expires && DateTimeOffset.UtcNow > expires)
                    {
                        _qrImageUri = null;
                        _qrExpiresAt = null;
                        _ = InvokeAsync(StateHasChanged);
                        StopQrTimer();
                        return;
                    }

                    _ = InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException)
            {
            }
        }, token);
    }

    private void StopQrTimer()
    {
        _qrTimer?.Dispose();
        _qrTimer = null;
        _qrTimerCts?.Cancel();
        _qrTimerCts?.Dispose();
        _qrTimerCts = null;
    }

    public async ValueTask DisposeAsync()
    {
        StopQrTimer();

        if (_recoveryRef is null)
        {
            return;
        }

        try
        {
            await PaymentRecovery.DisconnectAsync(_recoveryRef);
        }
        catch (Exception)
        {
        }

        _recoveryRef.Dispose();
        _recoveryRef = null;
    }

    private async Task SendBillAsync()
    {
        if (_invoice is null || _caller is null || _caller.IsKhachThue || _sending) return;
        _sending = true;
        try
        {
            // Draft: phát hành rồi gửi; Đã phát hành: gửi lại thông báo cho khách.
            if (_invoice.Status == InvoiceStatus.Draft)
            {
                var issued = await InvoiceService.IssueAsync(_invoice.Id, _caller);
                _invoice = issued;
            }

            // Bản chỉnh sửa mới nhất (nếu có) đi kèm thông báo để khách biết chính xác.
            var latestRevision = _invoice.Revisions.FirstOrDefault();
            var message = latestRevision is null
                ? $"Hóa đơn HD-{_invoice.Id} ({MoneyFormatter.Format(_invoice.TotalAmount)}). Vui lòng vào xem và thanh toán."
                : string.Format(
                    L["ReviseNotifyMessage"].Value,
                    _invoice.Id,
                    MoneyFormatter.Format(_invoice.TotalAmount),
                    latestRevision.Reason);

            var tenantUserIds = await InvoiceQuery.GetContractTenantUserIdsAsync(_invoice.ContractId);
            foreach (var tenantUserId in tenantUserIds)
            {
                if (!string.IsNullOrWhiteSpace(tenantUserId))
                {
                    await Notifications.NotifyAsync(
                        tenantUserId,
                        latestRevision is null ? "Có hóa đơn cần thanh toán" : L["ReviseNotifyTitle"].Value,
                        message,
                        $"/my/invoices/{_invoice.Id}");
                }
            }

            // Đánh dấu bản hiện tại đã gửi cho khách.
            await InvoiceService.MarkBillSentAsync(_invoice.Id, _caller);

            Toasts.Success(L["SendBillSuccess"]);
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is IInvoiceServiceError)
        {
            Toasts.Error(InvoiceServiceErrorText(exception));
        }
        finally
        {
            _sending = false;
        }
    }

    private bool IsInvoicePaid =>
        Invoice.Status == InvoiceStatus.Paid || _latestPayment?.Status == PaymentStatus.Confirmed;

    /// <summary>
    /// Chủ trọ chỉnh sửa được hoá đơn đã phát hành khi khách CHƯA gửi yêu cầu thanh toán.
    /// Khách đã gửi yêu cầu (đang chờ xác nhận) hoặc đã thanh toán thì không được sửa.
    /// </summary>
    private bool CanRevise =>
        _caller is { IsChuTro: true }
        && Invoice.Status == InvoiceStatus.Issued
        && !Invoice.HasPaymentRequest;

    /// <summary>
    /// Chủ trọ xóa được hoá đơn đã gửi khi khách CHƯA gửi yêu cầu thanh toán.
    /// </summary>
    private bool CanDelete =>
        _caller is { IsChuTro: true }
        && Invoice.Status == InvoiceStatus.Issued
        && !Invoice.HasPaymentRequest;

