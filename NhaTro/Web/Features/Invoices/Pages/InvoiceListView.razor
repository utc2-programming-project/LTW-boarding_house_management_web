@page "/invoices"
@page "/my/invoices"
@page "/my-invoices"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "InvoiceView")]
@using Web.Features.Utilities
@using Web.Features.Utilities.Services
@using Web.Features.Accounts
@inject IInvoiceQueryService InvoiceQuery
@inject IInvoiceService InvoiceService
@inject P2CallerProvider CallerProvider
@inject NavigationManager Navigation
@inject Web.Features.Utilities.Services.ServiceRegistrationService RegistrationService
@inject Web.Features.Utilities.Services.ServiceCatalogPageService ServiceCatalogPageService
@inject ToastService Toast
@inject IStringLocalizer<InvoiceResources> L
@inject IStringLocalizer<UtilityResources> UL
@inject IStringLocalizer<Web.Shared> SL

<PageTitle>@L[IsMyInvoices ? "MyPageTitle" : "PageTitle"]</PageTitle>

<div class="invoice-page page-stack">
    <PageHeading Title="@L[IsMyInvoices ? "MyHeading" : "Heading"]" HelpText="@L[IsMyInvoices ? "MySubtitle" : "Subtitle"]">
        <Actions>
            @if (IsMyInvoices)
            {
                <button type="button" class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/my/service-registrations")'>
                    <LucideIcon Name="history" />
                    <span>@L["RegistrationHistoryButton"]</span>
                </button>
                <button type="button" class="btn btn-primary" @onclick="OpenRegistrationModal">
                    <LucideIcon Name="plus" />
                    <span>@L["RegisterServiceButton"]</span>
                </button>
            }
            else
            {
                <AuthorizeView Roles="ChuTro">
                    <Authorized>
                        <button type="button" class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/invoices/trash")'>
                            <LucideIcon Name="trash" />
                            <span>@L["InvoiceTrashOpen"]</span>
                        </button>
                    </Authorized>
                </AuthorizeView>
                <button type="button" class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/service-registrations")'>
                    <LucideIcon Name="file-text" />
                    <span>@L["ManageRegistrationsButton"]</span>
                </button>
            }
        </Actions>
    </PageHeading>

    @if (_loading)
    {
        <LoadingOverlay Visible="true" Text="@L["Loading"]" />
    }
    else if (_error is not null)
    {
        <div class="page-error" role="alert">
            <p>@_error</p>
            <button type="button" class="btn btn-secondary" @onclick="ReloadAsync">@L["Retry"]</button>
        </div>
    }
    else
    {
        <div class="stat-grid">
            <div class="stat-card">
                <div class="stat-card__top">
                    <span class="stat-label">@L["StatDraft"]</span>
                    <span class="stat-icon stat-icon--neutral"><LucideIcon Name="file-text" /></span>
                </div>
                <div class="stat-value">@_result.Summary.DraftCount</div>
            </div>
            <div class="stat-card">
                <div class="stat-card__top">
                    <span class="stat-label">@L["StatIssued"]</span>
                    <span class="stat-icon stat-icon--info"><LucideIcon Name="send" /></span>
                </div>
                <div class="stat-value">@_result.Summary.IssuedCount</div>
            </div>
            <div class="stat-card">
                <div class="stat-card__top">
                    <span class="stat-label">@L["StatPaid"]</span>
                    <span class="stat-icon stat-icon--success"><LucideIcon Name="circle-check" /></span>
                </div>
                <div class="stat-value">@_result.Summary.PaidCount</div>
            </div>
            @* Số tiền còn phải thu: nổi bật + bấm để lọc ra đúng các hoá đơn chưa thu. *@
            <a class="stat-card stat-card--warning stat-card--link"
               href="@($"{DetailBase}?paymentState=unpaid")"
               title="@L["StatOutstandingTitle"]">
                <div class="stat-card__top">
                    <span class="stat-label">@L["StatOutstanding"]</span>
                    <span class="stat-icon stat-icon--warning"><LucideIcon Name="wallet" /></span>
                </div>
                <div class="stat-value">
                    @MoneyFormatter.Format(_result.Summary.OutstandingAmount)
                    <LucideIcon Name="arrow-right" Class="stat-value__arrow" />
                </div>
            </a>
        </div>

        <div class="filter-bar filter-bar--panel">
            <div class="filter-bar__row">
                <div class="filter-bar__search">
                    <label class="sr-only" for="invoice-keyword">@L["FilterKeyword"]</label>
                    <span class="filter-bar__icon" aria-hidden="true"><LucideIcon Name="search" /></span>
                    <input id="invoice-keyword" class="input" type="search" autocomplete="off"
                           placeholder="@L["FilterKeywordPlaceholder"]"
                           @bind="_keyword" @bind:event="oninput" @bind:after="OnFilterChanged" />
                </div>
                <div class="filter-bar__field filter-bar__select">
                    <label class="sr-only" for="invoice-year">@L["FilterYear"]</label>
                    <select id="invoice-year" class="input" @bind="_year" @bind:after="OnFilterChanged">
                        <option value="">@L["AllYears"]</option>
                        @foreach (var year in AvailableYears)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </div>
                <div class="filter-bar__field filter-bar__select">
                    <label class="sr-only" for="invoice-month">@L["FilterMonth"]</label>
                    <select id="invoice-month" class="input" disabled="@(_year is null)" @bind="_month" @bind:after="OnFilterChanged">
                        <option value="">@L["AllMonths"]</option>
                        @for (var month = 1; month <= 12; month++)
                        {
                            <option value="@month">@string.Format(L["MonthValue"], month)</option>
                        }
                    </select>
                </div>
                <div class="filter-bar__field filter-bar__select">
                    <label class="sr-only" for="invoice-status">@L["FilterStatus"]</label>
                    <select id="invoice-status" class="input" @bind="_status" @bind:after="OnFilterChanged">
                        <option value="">@L["AllStatuses"]</option>
                        <option value="@InvoiceStatus.Draft">@L["StatusDraft"]</option>
                        <option value="@InvoiceStatus.Issued">@L["StatusIssued"]</option>
                        <option value="@InvoiceStatus.Paid">@L["StatusPaid"]</option>
                    </select>
                </div>
                <div class="filter-bar__actions">
                    <FilterAdvancedToggle @bind-Expanded="_showAdvanced" ActiveCount="AdvancedFilterCount" PanelId="invoice-advanced-panel" />
                    <FilterResetButton OnClick="ResetFiltersAsync" />
                </div>
            </div>
            <div class="filter-bar__advanced" id="invoice-advanced-panel" hidden="@(!_showAdvanced)">
                <div class="filter-bar__stack filter-bar__wide">
                    <label for="invoice-contract">@L["FilterContract"]</label>
                    <select id="invoice-contract" class="input" @bind="_contractId" @bind:after="OnFilterChanged">
                        <option value="">@L["AllContracts"]</option>
                        @foreach (var option in _contractOptions)
                        {
                            <option value="@option.ContractId">@option.ContractNumber · @option.RoomCode</option>
                        }
                    </select>
                </div>
                <div class="filter-bar__stack">
                    <label for="invoice-payment-state">@L["FilterPaymentState"]</label>
                    <select id="invoice-payment-state" class="input" @bind="_paymentState" @bind:after="OnFilterChanged">
                        <option value="">@L["PaymentStateAll"]</option>
                        <option value="unpaid">@L["PaymentStateUnpaid"]</option>
                        <option value="partial">@L["PaymentStatePartial"]</option>
                        <option value="pending_confirmation">@L["PaymentStatePendingConfirmation"]</option>
                        <option value="paid">@L["PaymentStatePaid"]</option>
                        <option value="payment_rejected">@L["PaymentStateRejected"]</option>
                        <option value="expired">@L["PaymentStateExpired"]</option>
                    </select>
                </div>
                <div class="filter-bar__stack">
                    <label for="invoice-min-amount">@L["FilterMinAmount"]</label>
                    <input id="invoice-min-amount" class="input" type="number" min="0" step="1000" inputmode="numeric"
                           placeholder="@L["AmountPlaceholder"]"
                           @bind="_minAmount" @bind:after="OnFilterChanged" />
                </div>
                <div class="filter-bar__stack">
                    <label for="invoice-max-amount">@L["FilterMaxAmount"]</label>
                    <input id="invoice-max-amount" class="input" type="number" min="0" step="1000" inputmode="numeric"
                           placeholder="@L["AmountPlaceholder"]"
                           @bind="_maxAmount" @bind:after="OnFilterChanged" />
                </div>
            </div>
        </div>

        <div class="table-card">
            @if (_result.Items.Count > 0)
            {
                <div class="table-responsive">
                    <table class="invoice-table">
                        <thead>
                            <tr>
                                <th>@L["ThInvoice"]</th>
                                <th>@L["ThPeriod"]</th>
                                <th>@L["DetailDueDate"]</th>
                                <th>@L["ThContract"]</th>
                                <th>@L["ThRoomProperty"]</th>
                                <th>@L["ThTenants"]</th>
                                <th class="text-right">@L["ThTotal"]</th>
                                <th class="text-right">@L["ThOutstanding"]</th>
                                <th class="text-center">@L["ThActions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var invoice in _result.Items)
                            {
                                <tr>
                                    <td class="font-semibold">
                                        @* Hóa đơn của chính mình: khách thuê vẫn mở được /my/invoices/{id}. *@
                                        <a class="cell-link" href="@AppLinks.Invoice(invoice.Id, DetailBase)" title="@SL["CellLinkOpenInvoice"]">HD-@invoice.Id</a>
                                    </td>
                                    <td class="tabular-nums">@DateFormatter.Format(invoice.PeriodStart) – @DateFormatter.Format(invoice.PeriodEnd)</td>
                                    <td class="tabular-nums">@(invoice.DueDate is null ? "—" : DateFormatter.Format(invoice.DueDate.Value))</td>
                                    <td>
                                        @if (CanFollowLinks)
                                        {
                                            <a class="cell-link is-quiet" href="@AppLinks.Contract(invoice.ContractId)" title="@SL["CellLinkOpenContract"]">@invoice.ContractNumber</a>
                                        }
                                        else
                                        {
                                            <span>@invoice.ContractNumber</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="invoice-room-cell">
                                            <div class="invoice-room-line">
                                                @if (CanFollowLinks)
                                                {
                                                    <a class="cell-link room-code" href="@AppLinks.RoomsByCode(invoice.RoomCode)" title="@SL["CellLinkOpenRoom"]">@invoice.RoomCode</a>
                                                }
                                                else
                                                {
                                                    <span class="room-code">@invoice.RoomCode</span>
                                                }
                                                <StatusBadge Text="@StatusText(invoice.Status)" Tone="@StatusTone(invoice.Status)" />
                                            </div>
                                            @if (CanFollowLinks)
                                            {
                                                <a class="cell-link is-quiet property-name" href="@AppLinks.PropertiesByKeyword(invoice.PropertyName)" title="@SL["CellLinkOpenProperty"]">@invoice.PropertyName</a>
                                            }
                                            else
                                            {
                                                <span class="property-name">@invoice.PropertyName</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (invoice.TenantNames.Count == 0)
                                        {
                                            <span class="muted">@L["NoTenants"]</span>
                                        }
                                        else if (CanFollowLinks)
                                        {
                                            @for (var i = 0; i < invoice.TenantNames.Count; i++)
                                            {
                                                var tenantName = invoice.TenantNames[i];
                                                if (i > 0)
                                                {
                                                    <span>, </span>
                                                }
                                                <a class="cell-link is-quiet" href="@AppLinks.TenantsByKeyword(tenantName)" title="@SL["CellLinkOpenTenant"]">@tenantName</a>
                                            }
                                        }
                                        else
                                        {
                                            <span>@string.Join(", ", invoice.TenantNames)</span>
                                        }
                                    </td>
                                    <td class="text-right tabular-nums">@MoneyFormatter.Format(invoice.TotalAmount)</td>
                                    <td class="text-right tabular-nums">
                                        @* Hoá đơn còn nợ: làm nổi bật + bấm để mở hoá đơn thanh toán. *@
                                        @if (invoice.OutstandingAmount > 0)
                                        {
                                            <a class="outstanding-link"
                                               href="@AppLinks.Invoice(invoice.Id, DetailBase)"
                                               title="@SL["CellLinkOpenInvoice"]">
                                                <LucideIcon Name="wallet" />
                                                <span>@MoneyFormatter.Format(invoice.OutstandingAmount)</span>
                                                <LucideIcon Name="arrow-right" />
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="outstanding-settled">@MoneyFormatter.Format(invoice.OutstandingAmount)</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="p2-row-actions">
                                            <button type="button"
                                                    class="icon-button p2-menu-trigger @(IsMenuOpen(invoice.Id) ? "is-open" : null)"
                                                    title="@L["ThActions"]"
                                                    aria-label="@($"{L["ThActions"]}: HD-{invoice.Id}")"
                                                    aria-haspopup="menu"
                                                    aria-expanded="@(IsMenuOpen(invoice.Id) ? "true" : "false")"
                                                    aria-controls="@($"invoice-row-menu-{invoice.Id}")"
                                                    @onclick="() => ToggleRowMenu(invoice.Id)">
                                                <LucideIcon Name="ellipsis" />
                                            </button>
                                            @if (IsMenuOpen(invoice.Id))
                                            {
                                                <div id="@($"invoice-row-menu-{invoice.Id}")" class="p2-row-menu" role="menu" aria-label="@L["ThActions"]" data-row-menu>
                                                    <button type="button" class="p2-row-menu-item" role="menuitem" @onclick="() => MenuDetail(invoice.Id)">
                                                        <LucideIcon Name="eye" /><span>@L["ViewDetail"]</span>
                                                    </button>
                                                    @if (!IsMyInvoices && invoice.Status == InvoiceStatus.Draft)
                                                    {
                                                        <div class="p2-row-menu-sep" role="separator"></div>
                                                        <button type="button" class="p2-row-menu-item danger" role="menuitem" @onclick="() => MenuDelete(invoice.Id)">
                                                            <LucideIcon Name="trash" /><span>@L["InvoiceDeleteAction"]</span>
                                                        </button>
                                                    }
                                                    else if (!IsMyInvoices && invoice.Status == InvoiceStatus.Issued && invoice.OutstandingAmount > 0m)
                                                    {
                                                        @* Hoá đơn đã gửi khách mà khách chưa thanh toán: cho xóa (vào thùng rác). *@
                                                        <div class="p2-row-menu-sep" role="separator"></div>
                                                        <button type="button" class="p2-row-menu-item danger" role="menuitem" @onclick="() => MenuDelete(invoice.Id)">
                                                            <LucideIcon Name="trash" /><span>@L["InvoiceDeleteIssuedAction"]</span>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <TablePager Page="_result.Page" TotalPages="TotalPages" From="FirstItem" To="LastItem" Total="_result.TotalCount"
                            PageChanged="GoToPageAsync" />
            }
            else
            {
                <EmptyStateCard Title="@L["EmptyTitle"]" Description="@L["EmptyDesc"]" />
            }
        </div>
    }
</div>

@if (_registrationOpen)
{
    <div class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="invoice-registration-title" @onclick="CloseRegistrationModal">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <header class="modal-header">
                <div class="modal-header-text">
                    <h2 id="invoice-registration-title">@L["RegisterServiceButton"]</h2>
                    <p>@L["RegisterServiceMonthlyNote"]</p>
                </div>
                <button type="button" class="icon-action-btn" aria-label="@L["CancelBtn"]" @onclick="CloseRegistrationModal">✕</button>
            </header>
            <div class="modal-body">
                <div class="form-field">
                    <label for="registration-contract">@UL["ServiceRequestContractLabel"]</label>
                    <select id="registration-contract" class="input" @bind="_registrationContractId" disabled="@(_registrationContractOptions.Count <= 1)">
                        @foreach (var contract in _registrationContractOptions)
                        {
                            <option value="@contract.ContractId">@contract.RoomCode · @contract.PropertyName · @contract.ContractNumber</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label for="registration-service">@L["RegisterServiceSelect"]</label>
                    <select id="registration-service" class="input" @bind="_registrationServiceId">
                        @foreach (var service in _services)
                        {
                            <option value="@service.Id">@service.Name — @MoneyFormatter.Format(service.CurrentRate)</option>
                        }
                    </select>
                </div>
                @if (_selectedService is not null)
                {
                    <dl class="summary-lines">
                        <div><dt>@L["ServiceRequestName"]</dt><dd>@_selectedService.Name</dd></div>
                        <div><dt>@L["ServiceRequestPrice"]</dt><dd class="tabular-nums">@MoneyFormatter.Format(_selectedService.CurrentRate)</dd></div>
                        <div><dt>@L["ServiceRequestMonth"]</dt><dd class="tabular-nums">@DateOnly.FromDateTime(DateTime.Today).ToString("MM/yyyy")</dd></div>
                    </dl>
                }
                <div class="form-field">
                    <label for="registration-note">@L["RegisterServiceNote"]</label>
                    <input id="registration-note" type="text" class="input" @bind="_registrationNote" />
                </div>
                @if (_registrationError is not null)
                {
                    <div class="form-alert" role="alert"><span>@_registrationError</span></div>
                }
            </div>
            <footer class="modal-footer">
                <button type="button" class="btn btn-secondary" disabled="@_submittingRegistration" @onclick="CloseRegistrationModal">@L["CancelBtn"]</button>
                <button type="button" class="btn btn-primary" disabled="@(_submittingRegistration || _registrationContractId is null)" @onclick="SubmitRegistrationAsync">
                    @(_submittingRegistration ? L["Loading"] : L["RegisterServiceSubmit"])
                </button>
            </footer>
        </div>
    </div>
}

<ConfirmDialog Visible="_deleteVisible"
               Title="@(_deleteIssued ? L["DeleteIssuedTitle"] : L["InvoiceDeleteTitle"])"
               Message="@(_deleteIssued
                   ? string.Format(L["DeleteIssuedMessage"], _deleteInvoiceId ?? 0, MoneyFormatter.Format(_result.Items.FirstOrDefault(invoice => invoice.Id == _deleteInvoiceId)?.TotalAmount ?? 0m))
                   : string.Format(L["InvoiceDeleteMessage"], _deleteInvoiceId ?? 0))"
               ConfirmText="@L["InvoiceDeleteConfirm"]" CancelText="@L["CancelBtn"]" Danger="true"
               OnConfirm="DeleteInvoiceAsync" OnCancel="CancelDeleteInvoice" />

@code {
    private const int PageSize = 20;

    /// <summary>Các giá trị hợp lệ cho ?paymentState= (khớp option của bộ lọc).</summary>
    private static readonly string[] PaymentStateOptions =
    [
        "unpaid",
        "partial",
        "pending_confirmation",
        "paid",
        "payment_rejected",
        "expired",
    ];
    private bool _deleteVisible;
    private int? _deleteInvoiceId;
    private bool _deleteIssued;

    private InvoiceListResult _result = new()
    {
        Items = [],
        TotalCount = 0,
        Page = 1,
        PageSize = PageSize,
        Summary = new InvoiceSummaryDto
        {
            DraftCount = 0,
            IssuedCount = 0,
            PaidCount = 0,
            OutstandingAmount = 0m,
        },
    };

    private IReadOnlyList<InvoiceContractOptionDto> _contractOptions = [];
    private bool _loading = true;
    private string? _error;

    private int? _year;
    private int? _month;
    private Guid? _contractId;
    private InvoiceStatus? _status;
    private string _keyword = string.Empty;
    private string _paymentState = string.Empty;
    private string _minAmount = string.Empty;
    private string _maxAmount = string.Empty;
    private int _page = 1;
    private bool _showAdvanced;

    private int AdvancedFilterCount =>
        (_contractId is null ? 0 : 1)
        + (string.IsNullOrWhiteSpace(_paymentState) ? 0 : 1)
        + (string.IsNullOrWhiteSpace(_minAmount) ? 0 : 1)
        + (string.IsNullOrWhiteSpace(_maxAmount) ? 0 : 1);

    private int? _openMenuId;

    // Đăng ký dịch vụ (khách thuê) ngay trên trang Hóa đơn.
    private bool _registrationOpen;
    private bool _submittingRegistration;
    private IReadOnlyList<Web.Features.Utilities.DTOs.ServiceItemDto> _services = [];
    private string _registrationServiceId = string.Empty;
    private string _registrationNote = string.Empty;
    private string? _registrationError;
    private IReadOnlyList<ServiceRegistrationContractOptionDto> _registrationContractOptions = [];
    private Guid? _registrationContractId;

    private Web.Features.Utilities.DTOs.ServiceItemDto? _selectedService =>
        _services.FirstOrDefault(service => service.Id == _registrationServiceId);

    private bool IsMyInvoices =>
        Navigation.Uri.Contains("/my/invoices", StringComparison.OrdinalIgnoreCase) ||
        Navigation.Uri.Contains("/my-invoices", StringComparison.OrdinalIgnoreCase);

    private string DetailBase => IsMyInvoices ? "/my/invoices" : "/invoices";

    // Khách thuê xem /my/invoices: không link sang trang nghiệp vụ (sẽ bị chặn quyền).
    private bool _isTenant;

    private bool CanFollowLinks => !IsMyInvoices && !_isTenant;

    private IReadOnlyList<int> AvailableYears
    {
        get
        {
            var current = DateTime.UtcNow.Year;
            return Enumerable.Range(current - 5, 7).Reverse().ToArray();
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_result.TotalCount / (double)PageSize));

    private int FirstItem => _result.TotalCount == 0 ? 0 : (_result.Page - 1) * PageSize + 1;

    private int LastItem => Math.Min(_result.Page * PageSize, _result.TotalCount);

    protected override Task OnInitializedAsync()
    {
        // Tới từ P5 ("Tới lập hóa đơn") với ?contractId=&periodStart= → lọc sẵn.
        if (QueryPeriodStart is { } periodStart)
        {
            _year = periodStart.Year;
            _month = periodStart.Month;
        }

        if (!string.IsNullOrWhiteSpace(QueryContractId)
            && Guid.TryParse(QueryContractId, out var queryContractId)
            && queryContractId != Guid.Empty)
        {
            _contractId = queryContractId;
        }

        _lastAppliedKeywordQuery = KeywordQuery;
        if (KeywordQuery is { Length: > 0 })
        {
            _keyword = KeywordQuery.Trim();
        }

        // Link từ KPI/panel trang chủ: ?paymentState=unpaid → lọc sẵn hoá đơn chưa thu.
        if (!string.IsNullOrWhiteSpace(QueryPaymentState)
            && PaymentStateOptions.Contains(QueryPaymentState))
        {
            _paymentState = QueryPaymentState;
        }

        return ReloadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Link từ bảng khác (?q=A107): Blazor dùng lại trang nên phải lọc lại theo query mới.
        if (string.Equals(KeywordQuery, _lastAppliedKeywordQuery, StringComparison.Ordinal))
        {
            return;
        }

        _lastAppliedKeywordQuery = KeywordQuery;
        _keyword = KeywordQuery?.Trim() ?? string.Empty;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OpenRegistrationModal()
    {
        _registrationOpen = true;
        _registrationError = null;
        _registrationNote = string.Empty;
        try
        {
            _registrationContractOptions = await RegistrationService.GetMyContractOptionsAsync();
            _registrationContractId = _registrationContractOptions.FirstOrDefault()?.ContractId;

            var services = await ServiceCatalogPageService.GetServicesForCallerAsync();
            _services = services
                .Where(service => !service.IsReadOnly && service.Type != Web.Features.Utilities.DTOs.ServiceTypeCategory.Meter)
                .ToList();
            _registrationServiceId = _services.FirstOrDefault()?.Id ?? string.Empty;

            if (_registrationContractOptions.Count == 0)
            {
                _registrationError = UL["RegErrorNoActiveContract"];
            }
        }
        catch (Exception)
        {
            _registrationError = L["ErrorLoad"];
        }
    }

    private void CloseRegistrationModal()
    {
        if (_submittingRegistration) return;
        _registrationOpen = false;
    }

    private async Task SubmitRegistrationAsync()
    {
        if (_submittingRegistration) return;
        _submittingRegistration = true;
        _registrationError = null;
        try
        {
            if (!int.TryParse(_registrationServiceId, out var serviceId) || serviceId <= 0)
            {
                _registrationError = L["RegisterServiceRequired"];
                return;
            }

            if (_registrationContractId is not { } contractId)
            {
                _registrationError = UL["RegErrorNoActiveContract"];
                return;
            }

            await RegistrationService.RequestAsync(serviceId, contractId, _registrationNote);
            Toast.Success(L["RegisterServiceSuccess"]);
            _registrationOpen = false;
        }
        catch (ServiceRegistrationException ex)
        {
            var localized = UL[$"RegError{ex.ErrorCode}"];
            _registrationError = localized.ResourceNotFound ? UL["RegErrorGeneric"].Value : localized.Value;
        }
        catch (Exception)
        {
            _registrationError = UL["RegErrorGeneric"];
        }
        finally
        {
            _submittingRegistration = false;
        }
    }

    [SupplyParameterFromQuery(Name = "contractId")]
    public string? QueryContractId { get; set; }

    [SupplyParameterFromQuery(Name = "periodStart")]
    public DateOnly? QueryPeriodStart { get; set; }

    /// <summary>Từ khóa từ link chéo (?q=A107 hoặc ?q=HD-001): điền sẵn ô tìm kiếm.</summary>
    [SupplyParameterFromQuery(Name = "q")]
    public string? KeywordQuery { get; set; }

    /// <summary>Lọc sẵn trạng thái thanh toán từ link (?paymentState=unpaid): dùng cho KPI/panel trang chủ.</summary>
    [SupplyParameterFromQuery(Name = "paymentState")]
    public string? QueryPaymentState { get; set; }

    private string? _lastAppliedKeywordQuery;

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        _openMenuId = null;

        try
        {
            var caller = await CallerProvider.GetCallerAsync();
            _contractOptions = await InvoiceQuery.GetContractOptionsAsync(caller);
            _result = await InvoiceQuery.GetInvoicesAsync(BuildFilter(), caller);
        }
        catch (UnauthorizedAccessException)
        {
            _error = L["ErrorLoad"];
        }
        catch (Exception)
        {
            _error = L["ErrorLoad"];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnFilterChanged()
    {
        // Tháng chỉ có nghĩa khi đã chọn năm; bỏ tháng nếu người dùng xóa năm.
        if (_year is null)
        {
            _month = null;
        }

        _page = 1;
        await LoadResultAsync();
    }

    private async Task LoadResultAsync()
    {
        _loading = true;
        _error = null;
        _openMenuId = null;

        try
        {
            var caller = await CallerProvider.GetCallerAsync();
            // Khách thuê không vào được /rooms, /tenants: chỉ hiện link cho vai trò nghiệp vụ.
            _isTenant = caller.Role == Roles.KhachThue;
            _result = await InvoiceQuery.GetInvoicesAsync(BuildFilter(), caller);
        }
        catch (Exception)
        {
            _error = L["ErrorLoad"];
        }
        finally
        {
            _loading = false;
        }
    }

    private InvoiceFilter BuildFilter() => new()
    {
        Keyword = _keyword,
        Year = _year,
        Month = _month,
        ContractId = _contractId,
        Status = _status,
        PaymentState = _paymentState switch
        {
            "unpaid" => InvoicePaymentState.Unpaid,
            "partial" => InvoicePaymentState.Partial,
            "pending_confirmation" => InvoicePaymentState.PendingConfirmation,
            "paid" => InvoicePaymentState.Paid,
            "payment_rejected" => InvoicePaymentState.PaymentRejected,
            "expired" => InvoicePaymentState.Expired,
            _ => (InvoicePaymentState?)null,
        },
        MinAmount = decimal.TryParse(_minAmount, out var min) && min >= 0 ? min : null,
        MaxAmount = decimal.TryParse(_maxAmount, out var max) && max >= 0 ? max : null,
        Page = _page,
        PageSize = PageSize,
    };

    private async Task ResetFiltersAsync()
    {
        _year = null;
        _month = null;
        _contractId = null;
        _status = null;
        _keyword = string.Empty;
        _paymentState = string.Empty;
        _minAmount = string.Empty;
        _maxAmount = string.Empty;
        _page = 1;
        _showAdvanced = false;
        await LoadResultAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        var target = PaginationHelper.ClampPage(page, TotalPages);
        if (target == _page)
        {
            return;
        }

        _page = target;
        await LoadResultAsync();
    }

    private void OpenDetail(int invoiceId) => Navigation.NavigateTo($"{DetailBase}/{invoiceId}");

    private bool IsMenuOpen(int invoiceId) => _openMenuId == invoiceId;

    private void ToggleRowMenu(int invoiceId) => _openMenuId = _openMenuId == invoiceId ? null : invoiceId;

    private void MenuDelete(int invoiceId)
    {
        _openMenuId = null;
        _deleteInvoiceId = invoiceId;
        _deleteIssued = _result.Items.Any(invoice => invoice.Id == invoiceId && invoice.Status == InvoiceStatus.Issued);
        _deleteVisible = true;
    }

    private void CancelDeleteInvoice()
    {
        _deleteVisible = false;
        _deleteInvoiceId = null;
    }

    private async Task DeleteInvoiceAsync()
    {
        if (_deleteInvoiceId is not int invoiceId)
        {
            CancelDeleteInvoice();
            return;
        }

        _deleteVisible = false;
        try
        {
            var caller = await CallerProvider.GetCallerAsync();
            var item = _result.Items.FirstOrDefault(invoice => invoice.Id == invoiceId);
            if (item is { Status: InvoiceStatus.Issued })
            {
                // Hoá đơn đã gửi khách: xoá mềm để vào thùng rác (chỉ khi khách chưa yêu cầu thanh toán).
                await InvoiceService.DeleteIssuedAsync(invoiceId, caller);
                Toast.Success(L["InvoiceDeleted"]);
            }
            else
            {
                await InvoiceService.DeleteDraftAsync(invoiceId, caller);
                Toast.Success(L["InvoiceDeleted"]);
            }

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Toast.Error(ErrorText(ex));
        }
        finally
        {
            _deleteInvoiceId = null;
        }
    }

    private string ErrorText(Exception ex) =>
        ex is IInvoiceServiceError error ? L[$"InvoiceError{error.ErrorCode}"] : L["InvoiceGenericError"];

    private void MenuDetail(int invoiceId)
    {
        _openMenuId = null;
        OpenDetail(invoiceId);
    }

    private string StatusText(InvoiceStatus status) => status switch
    {
        InvoiceStatus.Draft => L["StatusDraft"],
        InvoiceStatus.Issued => L["StatusIssued"],
        InvoiceStatus.Paid => L["StatusPaid"],
        _ => L["StatusUnknown"],
    };

    private static BadgeTone StatusTone(InvoiceStatus status) => status switch
    {
        InvoiceStatus.Draft => BadgeTone.Neutral,
        InvoiceStatus.Issued => BadgeTone.Info,
        InvoiceStatus.Paid => BadgeTone.Success,
        _ => BadgeTone.Neutral,
    };
}
