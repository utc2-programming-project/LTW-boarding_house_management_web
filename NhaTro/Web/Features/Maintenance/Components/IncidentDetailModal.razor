@inject IStringLocalizer<IncidentResource> L
@inject ToastService Toasts

<FeatureDialog @ref="_dialog" Visible="true" Title="@L["DetailTitle"]" CloseLabel="@L["Close"]" Busy="@Busy" OnClose="OnClose">
    <div class="detail-body">
        @if (_loading) { <LoadingOverlay Visible="true" Text="@L["Loading"]" /> }
        else if (_item is not null)
        {
            <div class="detail-heading"><h3>@_item.Title</h3><StatusBadge Text="@L[$"Status{_item.Status}"]" Tone="@(_item.Status == IncidentStatus.Completed ? BadgeTone.Success : BadgeTone.Info)" /></div>
            <dl class="detail-grid">
                <div><dt>@L["PropertyRoom"]</dt><dd>@RoomText</dd></div>
                <div><dt>@L["CreatedAt"]</dt><dd class="tabular-nums">@DateFormatter.FormatDateTime(_item.CreatedAtUtc)</dd></div>
                <div><dt>@L["Category"]</dt><dd>@L[$"Category{_item.Category}"]</dd></div>
                <div><dt>@L["Urgency"]</dt><dd>@L[$"Urgency{_item.Urgency}"]</dd></div>
            </dl>
            <section><h3>@L["Description"]</h3><p class="preserve-text">@_item.Description</p></section>
            @foreach (var kind in new[] { false, true })
            {
                <section><h3>@L[kind ? "ResultPhoto" : "ReportPhoto"]</h3>
                    @if (!_item.Photos.Any(p => p.IsResult == kind)) { <p>@L["NoData"]</p> }
                    <div class="photo-grid">
                        @foreach (var photo in _item.Photos.Where(p => p.IsResult == kind))
                        {
                            <figure><a href="@photo.Url" target="_blank" rel="noopener"><img src="@photo.Url" alt="@photo.Name" /></a><figcaption>@photo.Name</figcaption></figure>
                        }
                    </div>
                </section>
            }
            @if (!TenantView)
            {
                <section><h3>@L["TechnicalNotes"]</h3><p class="preserve-text">@(string.IsNullOrWhiteSpace(_item.TechnicalNotes) ? L["NoData"].Value : _item.TechnicalNotes)</p>
                    <dl class="detail-grid"><div><dt>@L["Assignee"]</dt><dd>@_item.Assignee</dd></div><div><dt>@L["RepairCost"]</dt><dd class="tabular-nums">@MoneyFormatter.Format(_item.RepairCost)</dd></div></dl>
                </section>
                @if (_item.Pending.Count > 0)
                {
                    <section class="pending-panel"><h3>@L["PendingApproval"]</h3><p>@L["ApprovalNotice"]</p></section>
                }
                @if (_item.Status != IncidentStatus.Completed)
                {
                    <section class="processing-panel">
                        <h3>@L["Processing"]</h3><p>@L["ActionUpdate"] · @L[$"Mode{_updateMode}"]</p>
                        <dl><dt>@L["NextStatus"]</dt><dd>@L[$"Status{NextStatus}"]</dd></dl>
                        <label for="incident-technical-notes">@L["TechnicalNotes"]</label><textarea id="incident-technical-notes" rows="3" maxlength="2000" @bind="_notes" disabled="@UpdateDisabled"></textarea>
                        <label for="incident-assignee">@L["Assignee"]</label><input id="incident-assignee" maxlength="100" @bind="_assignee" disabled="@UpdateDisabled" />
                        <label for="incident-repair-cost">@L["RepairCost"]</label><input id="incident-repair-cost" inputmode="numeric" @bind="_cost" @bind:after="() => _costInvalid = false" disabled="@UpdateDisabled" aria-invalid="@(_costInvalid ? "true" : "false")" aria-describedby="incident-cost-hint incident-cost-error" />
                        <p id="incident-cost-hint">@L["RepairCostHint"]</p><p id="incident-cost-error" role="status">@(_costInvalid ? L["RepairCostInvalid"].Value : "")</p>
                        <button type="button" class="btn btn-primary" disabled="@UpdateDisabled" @onclick="UpdateAsync">@L[_saving ? "Saving" : _updateMode == IncidentMode.Approval ? "RequestAction" : "UpdateAction"]</button>
                    </section>
                }
                <section class="processing-panel">
                    <h3>@L["ResultPhoto"]</h3><p>@L["ActionResultPhoto"] · @L[$"Mode{_photoMode}"]</p>
                    <IncidentPhotoPicker @key="_photoVersion" @bind-Photos="_photos" Capacity="AvailablePhotoSlots" Disabled="@(_saving || _photoMode == IncidentMode.Deny)" BusyChanged="value => _uploading = value" />
                    <button type="button" class="btn btn-secondary" disabled="@(Busy || _photoMode == IncidentMode.Deny || _photos.Count == 0)" @onclick="SavePhotosAsync">@L[_saving ? "Saving" : "SaveResultPhotos"]</button>
                </section>
            }
            <section><h3>@L["History"]</h3><ol class="history">
                @foreach (var entry in _item.History.OrderByDescending(h => h.AtUtc))
                {
                    <li><span>@L[entry.EventKey]</span><span class="tabular-nums">@DateFormatter.FormatDateTime(entry.AtUtc)</span></li>
                }
            </ol></section>
        }
        @if (_error is not null) { <div class="detail-error" role="alert"><p>@_error</p><button class="btn btn-secondary" disabled="@Busy" @onclick="RefreshAsync">@L["Retry"]</button></div> }
        @foreach (var error in _photoErrors) { <p class="detail-error" role="alert">@error</p> }
        <div class="detail-actions"><button class="btn btn-secondary" disabled="@Busy" @onclick="CloseAsync">@L["Close"]</button></div>
    </div>
</FeatureDialog>
@code {
    [Parameter, EditorRequired] public IncidentPageService Session { get; set; } = default!;
    [Parameter] public int IncidentId { get; set; }
    [Parameter] public IReadOnlyList<IncidentRoomDto> Rooms { get; set; } = [];
    [Parameter] public bool TenantView { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private FeatureDialog? _dialog;
    private IncidentItem? _item;
    private IncidentMode _updateMode;
    private IncidentMode _photoMode;
    private IReadOnlyList<IncidentSelectedPhoto> _photos = [];
    private Guid? _photoRequestId;
    private string _notes = "";
    private string _assignee = "";
    private string _cost = "";
    private string? _error;
    private List<string> _photoErrors = [];
    private bool _loading = true;
    private bool _saving;
    private bool _uploading;
    private bool _costInvalid;
    private int _photoVersion;
    private bool Busy => _loading || _saving || _uploading;
    private bool UpdateDisabled => Busy || _updateMode == IncidentMode.Deny || _item?.Pending.Any(p => p.Action == IncidentAction.Update) == true;
    private IncidentStatus NextStatus => _item?.Status == IncidentStatus.New ? IncidentStatus.InProgress : IncidentStatus.Completed;
    private IncidentPending? PendingPhotos => _item?.Pending.FirstOrDefault(p => p.Action == IncidentAction.ResultPhoto);
    private int AvailablePhotoSlots => PendingPhotos is { } pending ? Math.Max(0, pending.ExpectedPhotoCount - pending.Photos.Count)
        : Math.Max(0, 3 - (_item?.Photos.Count(p => p.IsResult) ?? 0));
    private string RoomText => _item?.RoomLabel ?? L["NoData"];
    protected override Task OnInitializedAsync() => RefreshAsync();
    private async Task RefreshAsync()
    {
        _loading = true;
        _error = null;
        _photoErrors.Clear();
        try
        {
            _item = await Session.DetailAsync(IncidentId);
            _updateMode = await Session.ModeAsync(IncidentAction.Update);
            _photoMode = await Session.ModeAsync(IncidentAction.ResultPhoto);
            _photoRequestId = PendingPhotos?.Id;
            _notes = _item.TechnicalNotes;
            _assignee = _item.Assignee;
            _cost = _item.RepairCost is null ? "" : MoneyFormatter.Format(_item.RepairCost);
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { _item = null; _error = L[ex is IncidentPageException ? ex.Message : "LoadFailed"]; }
        finally { _loading = false; }
    }
    private async Task UpdateAsync()
    {
        if (Busy || _item is null) return;
        decimal? cost = null;
        _costInvalid = false;
        if (!string.IsNullOrWhiteSpace(_cost))
        {
            if (!MoneyFormatter.TryParse(_cost, out var amount) || amount < 0 || decimal.Truncate(amount) != amount) { _costInvalid = true; return; }
            cost = amount;
        }
        _saving = true;
        _error = null;
        try
        {
            var pending = await Session.UpdateAsync(IncidentId, NextStatus, _notes, _assignee, cost);
            Toasts.Success(L[pending ? "RequestCreated" : "IncidentUpdated"]);
            await RefreshAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { _error = L[ex is IncidentPageException ? ex.Message : "SaveFailed"]; Toasts.Error(_error); }
        finally { _saving = false; }
    }
    private async Task SavePhotosAsync()
    {
        if (Busy || _photos.Count == 0) return;
        _saving = true;
        _error = null;
        _photoErrors.Clear();
        try
        {
            var remaining = _photos.ToList();
            foreach (var photo in _photos.ToArray())
            {
                var result = await Session.UploadAsync(IncidentId, _photoRequestId, IncidentPhotoKind.Result, photo, _photos.Count);
                _photoRequestId = result.ApprovalRequestId ?? _photoRequestId;
                if (result.Succeeded) remaining.Remove(photo);
                else _photoErrors.Add($"{photo.Name}: {L[result.ErrorCode ?? "UploadFailed"]}");
                _photos = remaining.ToArray();
            }
            _photos = remaining;
            _photoVersion++;
            var errors = _photoErrors.ToList();
            await RefreshAsync();
            _photoErrors = errors;
            if (remaining.Count > 0) { _error = L["PhotosPartiallyFailed"]; Toasts.Error(_error); }
            else { Toasts.Success(L[_photoRequestId is null ? "PhotosSaved" : "RequestCreated"]); _photoRequestId = null; }
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { _error = L[ex is IncidentPageException ? ex.Message : "SaveFailed"]; Toasts.Error(_error); }
        finally { _saving = false; }
    }
    private Task CloseAsync() => _dialog?.RequestCloseAsync() ?? Task.CompletedTask;
}
