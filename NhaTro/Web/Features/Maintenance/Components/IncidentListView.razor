@inject IStringLocalizer<IncidentResource> L
@inject IStringLocalizer<Web.Shared> SL
@inject NavigationManager Nav
@inject Web.Common.Utils.FilterUrlState Url
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop

<div class="incident-list page-stack" @ref="_listRegion" tabindex="-1" aria-label="@L["ListCaption"]">
<section class="stat-grid" aria-label="@L["StatSummary"]">
    <article class='stat-card stat-card--link @IncidentCardClass("")' role="button" tabindex="0"
             @onclick='() => ApplyIncidentFilterAsync("")'>
        <div class="stat-card__top">
            <span class="stat-label">
                @L["StatTotal"]
                <HelpTip Text="@L["StatTotalHint"]" />
            </span>
            <span class="stat-icon stat-icon--accent"><LucideIcon Name="wrench" /></span>
        </div>
        <div class="stat-value">@_totalCount <small>@L["StatUnit"]</small></div>
    </article>
    <article class='stat-card stat-card--link @IncidentCardClass(nameof(IncidentStatus.New))' role="button" tabindex="0"
             @onclick='() => ApplyIncidentFilterAsync(nameof(IncidentStatus.New))'>
        <div class="stat-card__top">
            <span class="stat-label">
                @L["StatusNew"]
                <HelpTip Text="@L["StatNewHint"]" />
            </span>
            <span class="stat-icon stat-icon--info"><LucideIcon Name="inbox" /></span>
        </div>
        <div class="stat-value">@_newCount <small>@L["StatUnit"]</small></div>
    </article>
    <article class='stat-card stat-card--link @IncidentCardClass(nameof(IncidentStatus.InProgress))' role="button" tabindex="0"
             @onclick='() => ApplyIncidentFilterAsync(nameof(IncidentStatus.InProgress))'>
        <div class="stat-card__top">
            <span class="stat-label">
                @L["StatusInProgress"]
                <HelpTip Text="@L["StatInProgressHint"]" />
            </span>
            <span class="stat-icon stat-icon--warning"><LucideIcon Name="refresh-cw" /></span>
        </div>
        <div class="stat-value">@_inProgressCount <small>@L["StatUnit"]</small></div>
    </article>
    <article class='stat-card stat-card--link @IncidentCardClass(nameof(IncidentStatus.Completed))' role="button" tabindex="0"
             @onclick='() => ApplyIncidentFilterAsync(nameof(IncidentStatus.Completed))'>
        <div class="stat-card__top">
            <span class="stat-label">
                @L["StatusCompleted"]
                <HelpTip Text="@L["StatCompletedHint"]" />
            </span>
            <span class="stat-icon stat-icon--success"><LucideIcon Name="circle-check" /></span>
        </div>
        <div class="stat-value">@_completedCount <small>@L["StatUnit"]</small></div>
    </article>
</section>
<form class="filter-bar filter-bar--panel" novalidate @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault>
    <div class="filter-bar__row">
        <div class="filter-bar__search">
            <label class="sr-only" for="incident-title-filter">@L["Title"]</label>
            <span class="filter-bar__icon" aria-hidden="true"><LucideIcon Name="search" /></span>
            <input id="incident-title-filter" class="input" type="search" autocomplete="off"
                   placeholder="@L["SearchTitle"]" @bind="_fTitle" @bind:event="oninput" @bind:after="ApplyFiltersDebouncedAsync" />
        </div>
        <div class="filter-bar__field filter-bar__text">
            <label class="sr-only" for="incident-room-filter">@L["PropertyRoom"]</label>
            <input id="incident-room-filter" class="input" type="search" autocomplete="off"
                   placeholder="@L["SearchRoom"]" @bind="_fRoom" @bind:event="oninput" @bind:after="ApplyFiltersDebouncedAsync" />
        </div>
        <div class="filter-bar__field filter-bar__select">
            <label class="sr-only" for="incident-category-filter">@L["Category"]</label>
            <select id="incident-category-filter" class="input" @bind="_fCategory" @bind:after="ApplyFiltersAsync">
                <option value="">@L["AllFilterValues"]</option>
                @foreach (var value in Enum.GetValues<IncidentCategory>())
                {
                    <option value="@value">@L[$"Category{value}"]</option>
                }
            </select>
        </div>
        <div class="filter-bar__field filter-bar__select">
            <label class="sr-only" for="incident-urgency-filter">@L["Urgency"]</label>
            <select id="incident-urgency-filter" class="input" @bind="_fUrgency" @bind:after="ApplyFiltersAsync">
                <option value="">@L["AllFilterValues"]</option>
                @foreach (var value in Enum.GetValues<IncidentUrgency>())
                {
                    <option value="@value">@L[$"Urgency{value}"]</option>
                }
            </select>
        </div>
        <div class="filter-bar__field filter-bar__select">
            <label class="sr-only" for="incident-status-filter">@L["Status"]</label>
            <select id="incident-status-filter" class="input" @bind="_fStatus" @bind:after="ApplyFiltersAsync">
                <option value="">@L["AllFilterValues"]</option>
                @foreach (var value in Enum.GetValues<IncidentStatus>())
                {
                    <option value="@value">@L[$"Status{value}"]</option>
                }
            </select>
        </div>
        <div class="filter-bar__field filter-bar__text">
            <label class="sr-only" for="incident-created-filter">@L["CreatedAt"]</label>
            <input id="incident-created-filter" class="input" type="date"
                   @bind="_fCreated" @bind:after="ApplyFiltersAsync" />
        </div>
        <div class="filter-bar__actions">
            <FilterResetButton OnClick="ClearFiltersAsync" />
        </div>
    </div>
</form>
<DataTable @key="_tableKey" @ref="_table" TItem="IncidentItem" Columns="_columns" ItemsProvider="LoadAsync"
           Labels="Labels" Caption="@L["ListCaption"]" PageSize="5"
           HasActiveFilters="HasFilters" OnClearFilters="ClearFilterStateAsync">
    <EmptyActions>
        @if (CanCreate)
        {
            <button type="button" class="btn btn-primary" @onclick="OnCreate">
                <LucideIcon Name="plus" /> @L["CreateIncident"]
            </button>
        }
    </EmptyActions>
</DataTable>
</div>

@code {
    [Parameter, EditorRequired] public IncidentPageService Session { get; set; } = default!;
    [Parameter] public IReadOnlyList<IncidentRoomDto> Rooms { get; set; } = [];
    [Parameter] public EventCallback<int> OnDetail { get; set; }
    [Parameter] public EventCallback OnCreate { get; set; }
    [Parameter] public bool CanCreate { get; set; }

    /// <summary>Khách thuê không được vào /rooms nên cột phòng giữ dạng text.</summary>
    [Parameter] public bool CanFollowLinks { get; set; } = true;
    private DataTable<IncidentItem>? _table;
    private ElementReference _listRegion;
    private readonly Dictionary<int, ElementReference> _detailButtons = [];
    private int? _focusAfterRender;
    private IReadOnlyList<DataTableColumn<IncidentItem>> _columns = [];
    private int _totalCount;
    private int _newCount;
    private int _inProgressCount;
    private int _completedCount;
    private string _fTitle = string.Empty;
    private string _fRoom = string.Empty;
    private string _fCategory = string.Empty;
    private string _fUrgency = string.Empty;
    private string _fStatus = string.Empty;
    private DateTime? _fCreated;
    private int _tableKey;
    private CancellationTokenSource? _filterDebounce;

    private bool HasFilters =>
        !string.IsNullOrWhiteSpace(_fTitle)
        || !string.IsNullOrWhiteSpace(_fRoom)
        || !string.IsNullOrWhiteSpace(_fCategory)
        || !string.IsNullOrWhiteSpace(_fUrgency)
        || !string.IsNullOrWhiteSpace(_fStatus)
        || _fCreated is not null;

    private DataTableLabels Labels => new()
    {
        Loading = L["Loading"], EmptyTitle = L["NoData"], EmptyDescription = L["EmptyDescription"],
        NoResultsTitle = L["NoResults"], ClearFilters = L["ClearFilters"],
        LoadFailed = L["LoadFailed"],
        Retry = L["Retry"]
    };

    protected override void OnInitialized()
    {
        _columns =
        [
            new()
            {
                Key = "Title",
                Title = L["Title"],
                Template = i => @<span class="cell-truncate" data-hover-tip>
                    @Text(i, i.Title)
                    <span class="hover-tip" role="tooltip" aria-hidden="true">
                        <span class="hover-tip__line">@Text(i, i.Title)</span>
                    </span>
                </span>,
                Sortable = true,
                Width = "260px",
            },
            new() { Key = "Room", Title = L["PropertyRoom"], Template = RoomCell, Sortable = true, Width = "200px" },
            new() { Key = "Category", Title = L["Category"], Value = i => L[$"Category{i.Category}"], Width = "130px" },
            new() { Key = "Urgency", Title = L["Urgency"], Value = i => L[$"Urgency{i.Urgency}"], Width = "110px" },
            new() { Key = "Status", Title = L["Status"], Template = i => @<div>
                    <StatusBadge Text="@L[$"Status{i.Status}"]" Tone="@(i.Status == IncidentStatus.Completed ? BadgeTone.Success : BadgeTone.Info)" />
                @if (i.Pending.Count > 0)
                {
                    <StatusBadge Text="@L["PendingApproval"]" Tone="BadgeTone.Warning" />
                }
            </div>, Width = "170px" },
            new() { Key = "Created", Title = L["CreatedAt"], Value = i => DateFormatter.FormatDateTime(i.CreatedAtUtc), Sortable = true, Width = "150px" },
            new() { Key = "Actions", Title = L["Actions"], Template = i => @<button type="button" class="btn btn-secondary incident-detail-action"
                @ref="_detailButtons[i.Id]"
                aria-label="@L["ViewDetailNamed", Text(i, i.Title)]" @onclick="() => OnDetail.InvokeAsync(i.Id)">@L["ViewDetail"]</button>, CellClass = "cell-actions", Width = "140px" }
        ];

        ApplyUrlState();
    }

    // Component con không nhận SupplyParameterFromQuery: đọc thẳng query string khi mở trang.
    private void ApplyUrlState()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        _fTitle = query.TryGetValue("q", out var title) ? title.ToString() : string.Empty;
        _fRoom = query.TryGetValue("room", out var room) ? room.ToString() : string.Empty;

        if (query.TryGetValue("category", out var category)
            && Enum.TryParse<IncidentCategory>(category.ToString(), out var parsedCategory))
        {
            _fCategory = parsedCategory.ToString();
        }

        if (query.TryGetValue("urgency", out var urgency)
            && Enum.TryParse<IncidentUrgency>(urgency.ToString(), out var parsedUrgency))
        {
            _fUrgency = parsedUrgency.ToString();
        }

        if (query.TryGetValue("status", out var status)
            && Enum.TryParse<IncidentStatus>(status.ToString(), out var parsedStatus))
        {
            _fStatus = parsedStatus.ToString();
        }

        if (query.TryGetValue("created", out var created)
            && DateTime.TryParse(created.ToString(), System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var parsedCreated))
        {
            _fCreated = parsedCreated.Date;
        }
    }

    private Task WriteUrlStateAsync() => Url.ReplaceAsync(new Dictionary<string, string?>
    {
        ["q"] = string.IsNullOrWhiteSpace(_fTitle) ? null : _fTitle.Trim(),
        ["room"] = string.IsNullOrWhiteSpace(_fRoom) ? null : _fRoom.Trim(),
        ["category"] = string.IsNullOrEmpty(_fCategory) ? null : _fCategory,
        ["urgency"] = string.IsNullOrEmpty(_fUrgency) ? null : _fUrgency,
        ["status"] = string.IsNullOrEmpty(_fStatus) ? null : _fStatus,
        ["created"] = _fCreated is { } created
            ? created.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)
            : null,
    });

    private static string Text(IncidentItem item, string text) => text;

    // Bảng có thể thay DOM nút khi reload; focus nút hiện hành sau render, không dùng reference cũ của dialog.
    public Task RestoreDetailFocusAsync(int id)
    {
        _focusAfterRender = id;
        return InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusAfterRender is not int id) return;
        _focusAfterRender = null;
        var target = _detailButtons.TryGetValue(id, out var button) ? button : _listRegion;
        try { await target.FocusAsync(); }
        catch (JSDisconnectedException) { }
    }

    private string RoomText(IncidentItem item)
    {
        var room = Rooms.FirstOrDefault(r => r.Id == item.RoomId);
        return room is null ? item.RoomLabel : $"{room.PropertyName} / {room.Name}";
    }

    // Cột phòng: bấm sang danh sách phòng đã lọc theo mã phòng (chỉ vai trò nghiệp vụ).
    private RenderFragment<IncidentItem> RoomCell => item => @<text>
        @if (CanFollowLinks)
        {
            <a class="cell-link is-quiet cell-truncate" href="@AppLinks.RoomsByCode(RoomName(item))" data-hover-tip>
                @RoomText(item)
                <span class="hover-tip" role="tooltip" aria-hidden="true">
                    <span class="hover-tip__line">@RoomText(item)</span>
                </span>
            </a>
        }
        else
        {
            <span class="cell-truncate" data-hover-tip>
                @RoomText(item)
                <span class="hover-tip" role="tooltip" aria-hidden="true">
                    <span class="hover-tip__line">@RoomText(item)</span>
                </span>
            </span>
        }
    </text>;

    private string RoomName(IncidentItem item) =>
        Rooms.FirstOrDefault(r => r.Id == item.RoomId)?.Name ?? item.RoomLabel;

    private string IncidentCardClass(string status) =>
        string.Equals(_fStatus, status, StringComparison.Ordinal) ? "is-active" : string.Empty;

    private async Task ApplyIncidentFilterAsync(string status)
    {
        _fStatus = status;
        if (_table is not null) await _table.ReloadAsync();
    }

    private Task ApplyFiltersAsync()
    {
        _tableKey++;
        return Task.CompletedTask;
    }

    private async Task ApplyFiltersDebouncedAsync()
    {
        _filterDebounce?.Cancel();
        _filterDebounce?.Dispose();
        var cts = _filterDebounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(UiTiming.SearchDebounceMs, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!cts.IsCancellationRequested)
        {
            await InvokeAsync(ApplyFiltersAsync);
        }
    }

    private Task ClearFilterStateAsync()
    {
        _fTitle = string.Empty;
        _fRoom = string.Empty;
        _fCategory = string.Empty;
        _fUrgency = string.Empty;
        _fStatus = string.Empty;
        _fCreated = null;
        return Task.CompletedTask;
    }

    private async Task ClearFiltersAsync()
    {
        await ClearFilterStateAsync();
        _tableKey++;
    }

    private async Task<PagedResult<IncidentItem>> LoadAsync(DataTableRequest request)
    {
        _detailButtons.Clear();
        var query = new IncidentListQuery(
            Title: string.IsNullOrWhiteSpace(_fTitle) ? null : _fTitle,
            Room: string.IsNullOrWhiteSpace(_fRoom) ? null : _fRoom,
            Category: Enum.TryParse<IncidentCategory>(_fCategory, out var category) ? category : null,
            Urgency: Enum.TryParse<IncidentUrgency>(_fUrgency, out var urgency) ? urgency : null,
            Status: Enum.TryParse<IncidentStatus>(_fStatus, out var status) ? status : null,
            CreatedOn: _fCreated is { } created ? DateOnly.FromDateTime(created) : null,
            Page: request.Page,
            PageSize: request.PageSize,
            SortKey: request.SortKey,
            SortDescending: request.SortDescending);

        var page = await Session.ListPageAsync(query);
        await UpdateStatsAsync(page.Total, page.NewCount, page.InProgressCount, page.CompletedCount);
        await WriteUrlStateAsync();
        // Trang do SQL trả DTO nhẹ; bảng vẫn dùng model hiển thị cũ nên chiếu tại đây.
        var items = page.Items.Select(i => new IncidentItem(i.Id, i.RoomId, i.Title, "", i.Category, i.Urgency,
            i.Status, i.CreatedAt, "", [], [], [], RoomLabel: $"{i.PropertyName} / {i.RoomCode}")).ToArray();
        return new()
        {
            Items = items,
            TotalCount = page.TotalCount,
            Page = page.Page,
            PageSize = page.PageSize,
        };
    }

    // Dải KPI tính trên toàn bộ phiếu trong phạm vi người xem, không phụ thuộc bộ lọc của bảng.
    private async Task UpdateStatsAsync(int total, int newCount, int inProgress, int completed)
    {
        if (total == _totalCount && newCount == _newCount
            && inProgress == _inProgressCount && completed == _completedCount)
        {
            return;
        }

        _totalCount = total;
        _newCount = newCount;
        _inProgressCount = inProgress;
        _completedCount = completed;
        await InvokeAsync(StateHasChanged);
    }

    public Task ReloadAsync() => _table?.ReloadAsync() ?? Task.CompletedTask;
}
