@inject IStringLocalizer<IncidentResource> L
@using Microsoft.JSInterop

<div class="incident-list" @ref="_listRegion" tabindex="-1" aria-label="@L["ListCaption"]">
<section class="stat-grid" aria-label="@L["StatSummary"]">
    <article class="stat-card">
        <div class="stat-card__top">
            <span class="stat-label">
                @L["StatTotal"]
                <button type="button" class="stat-help" data-tip="@L["StatTotalHint"]" aria-label="@L["StatTotalHint"]">?</button>
            </span>
            <span class="stat-icon stat-icon--accent"><LucideIcon Name="wrench" /></span>
        </div>
        <div class="stat-value">@_totalCount <small>@L["StatUnit"]</small></div>
    </article>
    <article class="stat-card">
        <div class="stat-card__top">
            <span class="stat-label">
                @L["StatusNew"]
                <button type="button" class="stat-help" data-tip="@L["StatNewHint"]" aria-label="@L["StatNewHint"]">?</button>
            </span>
            <span class="stat-icon stat-icon--info"><LucideIcon Name="inbox" /></span>
        </div>
        <div class="stat-value">@_newCount <small>@L["StatUnit"]</small></div>
    </article>
    <article class="stat-card">
        <div class="stat-card__top">
            <span class="stat-label">
                @L["StatusInProgress"]
                <button type="button" class="stat-help" data-tip="@L["StatInProgressHint"]" aria-label="@L["StatInProgressHint"]">?</button>
            </span>
            <span class="stat-icon stat-icon--warning"><LucideIcon Name="refresh-cw" /></span>
        </div>
        <div class="stat-value">@_inProgressCount <small>@L["StatUnit"]</small></div>
    </article>
    <article class="stat-card">
        <div class="stat-card__top">
            <span class="stat-label">
                @L["StatusCompleted"]
                <button type="button" class="stat-help" data-tip="@L["StatCompletedHint"]" aria-label="@L["StatCompletedHint"]">?</button>
            </span>
            <span class="stat-icon stat-icon--success"><LucideIcon Name="circle-check" /></span>
        </div>
        <div class="stat-value">@_completedCount <small>@L["StatUnit"]</small></div>
    </article>
</section>
<DataTable @ref="_table" TItem="IncidentItem" Columns="_columns" ItemsProvider="LoadAsync"
           Labels="Labels" Caption="@L["ListCaption"]" PageSize="5" UseFilterToolbar="true">
    <EmptyActions>
        @if (CanCreate)
        {
            <button type="button" class="btn btn-primary" @onclick="OnCreate">
                <LucideIcon Name="plus" /> @L["CreateIncident"]
            </button>
        }
    </EmptyActions>
</DataTable>
</div>

@code {
    [Parameter, EditorRequired] public IncidentPageService Session { get; set; } = default!;
    [Parameter] public IReadOnlyList<IncidentRoomDto> Rooms { get; set; } = [];
    [Parameter] public EventCallback<int> OnDetail { get; set; }
    [Parameter] public EventCallback OnCreate { get; set; }
    [Parameter] public bool CanCreate { get; set; }
    private DataTable<IncidentItem>? _table;
    private ElementReference _listRegion;
    private readonly Dictionary<int, ElementReference> _detailButtons = [];
    private int? _focusAfterRender;
    private IReadOnlyList<DataTableColumn<IncidentItem>> _columns = [];
    private int _totalCount;
    private int _newCount;
    private int _inProgressCount;
    private int _completedCount;

    private DataTableLabels Labels => new()
    {
        Loading = L["Loading"], EmptyTitle = L["NoData"], EmptyDescription = L["EmptyDescription"],
        NoResultsTitle = L["NoResults"], ClearFilters = L["ClearFilters"],
        LoadFailed = L["LoadFailed"],
        Retry = L["Retry"], FilterBy = L["FilterBy"], Pagination = L["Pagination"],
        FirstPage = L["FirstPage"], PreviousPage = L["PreviousPage"], NextPage = L["NextPage"],
        LastPage = L["LastPage"], Page = L["Page"], Summary = L["PageSummary"]
    };

    protected override void OnInitialized()
    {
        _columns =
        [
            new() { Key = "Title", Title = L["Title"], Value = i => Text(i, i.Title), Sortable = true, Filterable = true, FilterPlaceholder = L["SearchTitle"] },
            new() { Key = "Room", Title = L["PropertyRoom"], Value = RoomText, Sortable = true, Filterable = true, FilterPlaceholder = L["SearchRoom"] },
            new() { Key = "Category", Title = L["Category"], Value = i => L[$"Category{i.Category}"], Filterable = true, FilterOptions = FilterOptions<IncidentCategory>("Category") },
            new() { Key = "Urgency", Title = L["Urgency"], Value = i => L[$"Urgency{i.Urgency}"], Filterable = true, FilterOptions = FilterOptions<IncidentUrgency>("Urgency") },
            new() { Key = "Status", Title = L["Status"], Filterable = true, FilterOptions = FilterOptions<IncidentStatus>("Status"), Template = i => @<div>
                    <StatusBadge Text="@L[$"Status{i.Status}"]" Tone="@(i.Status == IncidentStatus.Completed ? BadgeTone.Success : BadgeTone.Info)" />
                @if (i.Pending.Count > 0)
                {
                    <StatusBadge Text="@L["PendingApproval"]" Tone="BadgeTone.Warning" />
                }
            </div> },
            new() { Key = "Created", Title = L["CreatedAt"], Value = i => DateFormatter.FormatDateTime(i.CreatedAtUtc), Sortable = true, Filterable = true, FilterPlaceholder = L["SearchCreatedDate"] },
            new() { Key = "Actions", Title = L["Actions"], Template = i => @<button type="button" class="btn btn-secondary incident-detail-action"
                @ref="_detailButtons[i.Id]"
                aria-label="@L["ViewDetailNamed", Text(i, i.Title)]" @onclick="() => OnDetail.InvokeAsync(i.Id)">@L["ViewDetail"]</button> }
        ];
    }

    // Giá trị enum dùng để lọc chính xác, nhãn được dịch theo ngôn ngữ hiện tại.
    private IReadOnlyList<DataTableFilterOption> FilterOptions<TEnum>(string prefix) where TEnum : struct, Enum =>
        [new("", L["AllFilterValues"]), .. Enum.GetValues<TEnum>().Select(value =>
            new DataTableFilterOption(value.ToString(), L[$"{prefix}{value}"]))];

    private static string Text(IncidentItem item, string text) => text;

    // Bảng có thể thay DOM nút khi reload; focus nút hiện hành sau render, không dùng reference cũ của dialog.
    public Task RestoreDetailFocusAsync(int id)
    {
        _focusAfterRender = id;
        return InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusAfterRender is not int id) return;
        _focusAfterRender = null;
        var target = _detailButtons.TryGetValue(id, out var button) ? button : _listRegion;
        try { await target.FocusAsync(); }
        catch (JSDisconnectedException) { }
    }

    private string RoomText(IncidentItem item)
    {
        var room = Rooms.FirstOrDefault(r => r.Id == item.RoomId);
        return room is null ? item.RoomLabel : $"{room.PropertyName} / {room.Name}";
    }

    private async Task<PagedResult<IncidentItem>> LoadAsync(DataTableRequest request)
    {
        _detailButtons.Clear();
        var scoped = await Session.ListAsync();
        await UpdateStatsAsync(scoped);
        IEnumerable<IncidentItem> items = scoped;
        foreach (var filter in request.Filters)
        {
            items = filter.Key switch
            {
                "Title" => items.Where(i => i.Title.Contains(filter.Value, StringComparison.CurrentCultureIgnoreCase)),
                "Room" => items.Where(i => RoomText(i).Contains(filter.Value, StringComparison.CurrentCultureIgnoreCase)),
                "Category" => items.Where(i => i.Category.ToString() == filter.Value),
                "Urgency" => items.Where(i => i.Urgency.ToString() == filter.Value),
                "Status" => items.Where(i => i.Status.ToString() == filter.Value),
                "Created" => items.Where(i => DateFormatter.FormatDateTime(i.CreatedAtUtc)
                    .Contains(filter.Value, StringComparison.CurrentCultureIgnoreCase)),
                _ => items
            };
        }
        var ordered = request.SortKey switch
        {
            "Title" => items.OrderBy(i => Text(i, i.Title), StringComparer.CurrentCultureIgnoreCase),
            "Room" => items.OrderBy(RoomText, StringComparer.CurrentCultureIgnoreCase),
            "Created" => items.OrderBy(i => i.CreatedAtUtc),
            _ => items.OrderByDescending(i => i.CreatedAtUtc)
        };
        var sorted = request.SortDescending ? ordered.Reverse() : ordered;
        var all = sorted.ToArray();
        return new() { Items = all.Skip((request.Page - 1) * request.PageSize).Take(request.PageSize).ToArray(),
            TotalCount = all.Length, Page = request.Page, PageSize = request.PageSize };
    }

    // Dải KPI tính trên toàn bộ phiếu trong phạm vi người xem, không phụ thuộc bộ lọc của bảng.
    private async Task UpdateStatsAsync(IReadOnlyList<IncidentItem> scoped)
    {
        var total = scoped.Count;
        var newCount = scoped.Count(item => item.Status == IncidentStatus.New);
        var inProgress = scoped.Count(item => item.Status == IncidentStatus.InProgress);
        var completed = scoped.Count(item => item.Status == IncidentStatus.Completed);
        if (total == _totalCount && newCount == _newCount
            && inProgress == _inProgressCount && completed == _completedCount)
        {
            return;
        }

        _totalCount = total;
        _newCount = newCount;
        _inProgressCount = inProgress;
        _completedCount = completed;
        await InvokeAsync(StateHasChanged);
    }

    public Task ReloadAsync() => _table?.ReloadAsync() ?? Task.CompletedTask;
}
