@inject IStringLocalizer<IncidentResource> L

<section aria-label="@L["ImageViewer"]">
    <h3>@Photo.Name</h3>
    <div class="image-controls">
        <button type="button" class="btn btn-secondary" @onclick="OnClose">@L["BackToIncident"]</button>
        <button type="button" class="btn btn-secondary" disabled="@(_zoom <= 1)" @onclick="() => _zoom--">@L["ZoomOut"]</button>
        <button type="button" class="btn btn-secondary" disabled="@(_zoom >= 3)" @onclick="() => _zoom++">@L["ZoomIn"]</button>
        <button type="button" class="btn btn-secondary" @onclick="() => _rotation = (_rotation + 90) % 360">@L["RotateImage"]</button>
        @if (Photo.IsResult)
        {
            <a class="btn btn-primary" href="@Photo.Url" data-enhance-nav="false" download>@L["DownloadResultPhoto"]</a>
        }
    </div>
    <div class="image-stage" tabindex="0" aria-label="@L["ImageViewer"]">
        @if (_failed)
        {
            <p role="alert">@L["LoadFailed"]</p>
        }
        else
        {
            <img src="@Photo.PreviewUrl" alt="@Photo.Name" style="@ImageTransform" @onerror="() => _failed = true" />
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public IncidentStoredPhoto Photo { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    private int _zoom = 1;
    private int _rotation;
    private bool _failed;
    private string ImageTransform => $"transform: scale({_zoom}) rotate({_rotation}deg)";
}
