@implements IDisposable
@using Microsoft.JSInterop
@inject IStringLocalizer<IncidentResource> L
@inject IJSRuntime JS

<div class="photo-picker">
    <label class="photo-label" for="@_inputId">@L["Attachments"]</label>

    @* InputFile ẩn; vùng kéo-thả bên dưới mở hộp chọn tệp và nhận tệp kéo vào
       qua appDocumentUpload (dùng chung với form hồ sơ giấy tờ). *@
    <InputFile @key="_inputVersion" id="@_inputId" class="hidden-native-input" OnChange="ReadAsync" multiple
               accept=".jpg,.jpeg,.png" disabled="@IsDisabled"
               aria-describedby="@(_inputId + "-hint " + _inputId + "-error")" />

    <button type="button" id="@_zoneId"
            class="drop-zone-card @(_error is not null ? "drop-zone-error" : null) @(IsDisabled ? "is-disabled" : null)"
            disabled="@IsDisabled" aria-controls="@_inputId" @onclick="OpenFilePickerAsync">
        <span class="drop-cloud-icon" aria-hidden="true"><LucideIcon Name="upload" /></span>
        <span class="drop-primary-text">@L["DragDropPhotos"] <span class="browse-link">@L["ChoosePhotos"]</span></span>
        <span id="@(_inputId + "-hint")" class="drop-secondary-text">@L["PhotoHint", Capacity]</span>
    </button>

    @if (_reading)
    {
        <p class="photo-status" role="status">@L["ReadingPhotos"]</p>
    }
    else if (Photos.Count > 0)
    {
        <p class="photo-status" role="status">@L["PhotosSelected", Photos.Count]</p>
    }

    <div id="@(_inputId + "-error")" class="photo-error" role="alert">@_error</div>

    <div class="photo-grid">
        @foreach (var photo in Photos)
        {
            <figure>
                <img src="@photo.DataUrl" alt="@photo.Name" />
                <figcaption>@photo.Name</figcaption>
                <button type="button" class="btn btn-secondary" disabled="@(Disabled || _reading)"
                        aria-label="@L["RemovePhotoNamed", photo.Name]" @onclick="() => RemoveAsync(photo)">@L["RemovePhoto"]</button>
            </figure>
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<IncidentSelectedPhoto> Photos { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyList<IncidentSelectedPhoto>> PhotosChanged { get; set; }
    [Parameter] public EventCallback<bool> BusyChanged { get; set; }
    [Parameter] public int Capacity { get; set; } = IncidentSelectedPhoto.MaxCount;
    [Parameter] public bool Disabled { get; set; }
    private readonly string _inputId = $"incident-photo-{Guid.NewGuid():N}";
    private readonly string _zoneId = $"incident-photo-zone-{Guid.NewGuid():N}";
    private readonly CancellationTokenSource _lifetime = new();
    private string? _error;
    private bool _reading;
    private bool _disposed;
    private int _inputVersion;
    private bool _dropZoneWatched;

    private bool IsDisabled => Disabled || _reading || Photos.Count >= Capacity;

    private async Task OpenFilePickerAsync()
    {
        if (IsDisabled) return;

        await JS.InvokeVoidAsync("appDocumentUpload.openFilePicker", _inputId);
    }

    private async Task ReadAsync(InputFileChangeEventArgs args)
    {
        if (_reading || Disabled) return;
        _error = null;
        if (args.FileCount + Photos.Count > Capacity)
        {
            _error = L["PhotoLimit"];
            _inputVersion++;
            return;
        }
        _reading = true;
        await BusyChanged.InvokeAsync(true);
        try
        {
            // Chỉ thay danh sách khi cả lượt đọc hợp lệ; lỗi không xóa ảnh/nội dung đang nhập.
            var selected = new List<IncidentSelectedPhoto>(Photos);
            foreach (var file in args.GetMultipleFiles(IncidentSelectedPhoto.MaxCount))
                selected.Add(await IncidentSelectedPhoto.ReadAsync(file, _lifetime.Token));
            if (!_disposed) await PhotosChanged.InvokeAsync(selected.ToArray());
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex) when (ex is IOException || ex is InvalidDataException || ex is InvalidOperationException)
        {
            _error = L["PhotoInvalid"];
        }
        finally
        {
            _reading = false;
            _inputVersion++;
            if (!_disposed) await BusyChanged.InvokeAsync(false);
        }
    }

    private async Task RemoveAsync(IncidentSelectedPhoto photo)
    {
        if (Disabled || _reading) return;
        _error = null;
        await PhotosChanged.InvokeAsync(Photos.Where(p => !ReferenceEquals(p, photo)).ToArray());
        _inputVersion++;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _dropZoneWatched || IsDisabled) return;

        _dropZoneWatched = true;
        try
        {
            await JS.InvokeVoidAsync("appDocumentUpload.watchDropZone", _zoneId, _inputId);
        }
        catch (JSDisconnectedException) { }
    }

    public void Dispose()
    {
        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
