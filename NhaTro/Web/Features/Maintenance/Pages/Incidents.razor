@page "/incidents"
@rendermode InteractiveServer
@attribute [Authorize(Policy = IncidentAccess.Policy)]
@inject IncidentPageService Session
@inject IStringLocalizer<IncidentResource> L

<PageTitle>@L["PageTitle"]</PageTitle>
<div class="incidents-page page-stack">
    <PageHeading Title="@L[_tenant ? "TenantHeading" : "PageTitle"]" HelpText="@L[_tenant ? "TenantSubtitle" : "LiveStaffSubtitle"]">
        <Actions>
            @if (!_loading && _error is null)
            {
                <AuthorizeView Roles="ChuTro">
                    <Authorized>
                        <a class="btn btn-secondary" href="/incidents/trash">
                            <LucideIcon Name="trash" /> @L["TrashTitle"]
                        </a>
                    </Authorized>
                </AuthorizeView>
                <button type="button" class="btn btn-primary" disabled="@(_createMode == IncidentMode.Deny || _rooms.Count == 0)" @onclick="() => _creating = true">
                    <LucideIcon Name="plus" /> @L["CreateIncident"]
                </button>
            }
        </Actions>
    </PageHeading>
    @if (_loading) { <LoadingOverlay Visible="true" Text="@L["Loading"]" /> }
    else if (_error is not null)
    {
        <div role="alert"><p>@_error</p><button class="btn btn-secondary" @onclick="InitializeAsync">@L["Retry"]</button></div>
    }
    else
    {
        @if (_createMode == IncidentMode.Deny) { <p>@L["ActionDenied"]</p> }
        <IncidentListView @ref="_list" Session="Session" Rooms="_rooms" CanCreate="@(_createMode != IncidentMode.Deny && _rooms.Count > 0)"
                          CanFollowLinks="!_tenant"
                          OnCreate="() => _creating = true" OnDetail="id => _detailId = id" />
        @if (!_tenant) { <IncidentApprovalPanel Session="Session" OnChanged="ReloadAsync" /> }
        @if (_creating) { <IncidentReportForm Session="Session" Rooms="_rooms" Mode="_createMode" OnClose="CloseCreateAsync" OnSaved="CloseCreateAsync" /> }
        @if (_detailId is int id)
        {
            <IncidentDetailModal @key="id" Session="Session" IncidentId="id" Rooms="_rooms" TenantView="_tenant" OnClose="CloseDetailAsync" OnChanged="ReloadAsync" />
        }
    }
</div>
@code {
    private IncidentListView? _list;
    private IReadOnlyList<IncidentRoomDto> _rooms = [];
    private IncidentMode _createMode;
    private bool _loading = true;
    private bool _tenant;
    private bool _creating;
    private int? _detailId;
    private string? _error;

    /// <summary>Id sự cố từ link chéo (?incidentId=5): mở ngay modal chi tiết.</summary>
    [SupplyParameterFromQuery(Name = "incidentId")]
    public int? IncidentIdQuery { get; set; }

    protected override Task OnInitializedAsync()
    {
        if (IncidentIdQuery is { } incidentId && incidentId > 0)
        {
            _detailId = incidentId;
        }

        return InitializeAsync();
    }
    private async Task InitializeAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var caller = await Session.CallerAsync();
            _tenant = caller.IsKhachThue;
            _rooms = await Session.RoomsAsync();
            _createMode = await Session.ModeAsync(IncidentAction.Create);
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { _error = L[ex is IncidentPageException ? ex.Message : "LoadFailed"]; }
        finally { _loading = false; }
    }
    private Task ReloadAsync() => _list?.ReloadAsync() ?? Task.CompletedTask;
    private async Task CloseCreateAsync() { _creating = false; await ReloadAsync(); }
    private async Task CloseDetailAsync()
    {
        var id = _detailId;
        _detailId = null;
        if (id is not null && _list is not null) await _list.RestoreDetailFocusAsync(id.Value);
    }
}
