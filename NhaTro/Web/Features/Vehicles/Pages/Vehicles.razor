    private async Task ChangePropertyByIdAsync(int id)
    {
        if (id == _propertyId) return;
        _propertyId = id;
        _roomFilter = null;
        await LoadPropertyContextAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        _tableKey++;
        if (_table is not null)
        {
            await _table.ReloadAsync();
        }
    }

    private async Task ChangePageSizeAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            _pageSize = size;
            _tableKey++;
            if (_table is not null)
            {
                await _table.ReloadAsync();
            }
        }
    }

    private async Task ResetFiltersAsync()
    {
        _keyword = string.Empty;
        _roomFilter = null;
        _typeFilter = null;
        _statusFilter = null;
        await ApplyFiltersAsync();
    }

    private string KpiCardClass(string key) => key switch
    {
        "active" when _statusFilter == VehicleStatus.Active && !_typeFilter.HasValue => "is-active",
        "electric" when _typeFilter == VehicleType.ElectricMotorbike => "is-active",
        "inactive" when _statusFilter == VehicleStatus.Inactive => "is-active",
        _ => string.Empty,
    };

    private async Task ApplyKpiFilterAsync(string key)
    {
        switch (key)
        {
            case "active":
                _statusFilter = _statusFilter == VehicleStatus.Active && !_typeFilter.HasValue ? null : VehicleStatus.Active;
                _typeFilter = null;
                break;
            case "electric":
                _typeFilter = _typeFilter == VehicleType.ElectricMotorbike ? null : VehicleType.ElectricMotorbike;
                _statusFilter = VehicleStatus.Active;
                break;
            case "inactive":
                _statusFilter = _statusFilter == VehicleStatus.Inactive ? null : VehicleStatus.Inactive;
                _typeFilter = null;
                break;
        }

        await ApplyFiltersAsync();
    }

