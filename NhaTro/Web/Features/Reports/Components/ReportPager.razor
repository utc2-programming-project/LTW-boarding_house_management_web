@inject IStringLocalizer<ReportResource> L

<div class="report-pager">
    <span>@L["PageSummary", DashboardFormat.FormatNumber(Page), DashboardFormat.FormatNumber(TotalPages), DashboardFormat.FormatNumber(TotalCount)]</span>
    <nav aria-label="@Label">
        <button type="button" class="btn btn-secondary" disabled="@(Disabled || Page <= 1)" @onclick="() => PageChanged.InvokeAsync(Page - 1)">
            <LucideIcon Name="chevron-left" />@L["Previous"]
        </button>
        <button type="button" class="btn btn-secondary" disabled="@(Disabled || Page >= TotalPages)" @onclick="() => PageChanged.InvokeAsync(Page + 1)">
            @L["Next"]<LucideIcon Name="chevron-right" />
        </button>
    </nav>
</div>

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 20;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    private int TotalPages => PaginationHelper.TotalPages(TotalCount, PageSize);
}
