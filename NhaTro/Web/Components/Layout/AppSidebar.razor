@* Sidebar chính của hệ thống: render các nhóm mục từ AppNavigation, lọc theo vai trò
   (AuthorizeView, Policy riêng cho sự cố). Menu cuộn riêng, khu tài khoản cố định ở đáy. *@

@using System.Security.Claims
@using Web.Components.Account
@using Web.Features.Accounts
@inject IStringLocalizer<Shared> L
@inject NavigationManager Navigation
@implements IDisposable

<aside id="app-sidebar" class="app-sidebar" aria-label="@L["Navigation"]" tabindex="-1" data-permanent>
    <span class="sidebar-resizer" data-sidebar-resizer aria-hidden="true"></span>
    <button class="icon-button drawer-close" type="button" data-drawer-close aria-label="@L["CloseNavigation"]"><LucideIcon Name="close" /></button>
    <a class="app-brand" href="/home" aria-label="@L["AppName"]" title="@L["AppName"]"
       data-label="@L["AppName"]" data-toggle-label="@L["ToggleNavigation"]"><span class="app-logo"><LucideIcon Name="building" /></span><span class="app-logo-panel" aria-hidden="true"><LucideIcon Name="panel-left" /></span><span class="sidebar-label">@L["AppName"]</span></a>
    <div class="sidebar-main">
        <nav class="sidebar-menu" aria-label="@L["Navigation"]">
            @foreach (var section in AppNavigation.Sections)
            {
                <AuthorizeView Roles="@section.Roles" Context="groupAuth">
                    <Authorized>
                        @if (AnyVisibleItem(groupAuth.User, section))
                        {
                            <div class="sidebar-group">
                                @if (section.TitleKey is not null)
                                {
                                    <p class="sidebar-group-title sidebar-label">@L[section.TitleKey]</p>
                                }
                                <div class="sidebar-group-items">
                                    @foreach (var item in section.Items.Where(entry => entry.ShowInSidebar))
                                    {
                                        <AuthorizeView Roles="@item.Roles" Context="menuAuth"
                                                       Policy="@(item.Href == "/incidents" ? Web.Features.Maintenance.IncidentAccess.Policy : null)">
                                            @{
                                                var active = string.Equals(item.Href, _activeHref, StringComparison.OrdinalIgnoreCase);
                                            }
                                            <a href="@item.Href" class="@NavClass(active)" aria-current="@NavAriaCurrent(active)" aria-label="@L[item.Key]" title="@L[item.Key]"><LucideIcon Name="@item.Icon" /><span class="sidebar-label">@L[item.Key]</span></a>
                                        </AuthorizeView>
                                    }
                                </div>
                            </div>
                        }
                    </Authorized>
                </AuthorizeView>
            }
        </nav>
    </div>
    <div class="sidebar-footer">
        <AuthorizeView Context="account">
            <Authorized>
                <div class="sidebar-account-wrap">
                    <button class="sidebar-account" type="button" data-account-menu-toggle aria-haspopup="menu" aria-expanded="false"
                            aria-controls="account-menu" aria-label="@L["AccountTitle"]">
                        <span class="avatar" data-avatar-user="@UserId(account.User)" data-initials="@Initials(DisplayName(account.User))" aria-hidden="true">@Initials(DisplayName(account.User))</span>
                        <span class="sidebar-account-text">
                            <span class="sidebar-account-name">@DisplayName(account.User)</span>
                            <span class="sidebar-account-role">@RoleLabel(account.User)</span>
                        </span>
                        <span class="rail-tip" aria-hidden="true">@AccountTip(account.User)</span>
                        <span class="sidebar-account-caret" aria-hidden="true"><LucideIcon Name="chevrons-up-down" /></span>
                    </button>
                    <div class="account-menu" id="account-menu" role="menu" aria-label="@L["AccountTitle"]" hidden>
                        <div class="account-menu-identity">
                            <span class="avatar account-menu-avatar" data-avatar-user="@UserId(account.User)" data-initials="@Initials(DisplayName(account.User))" aria-hidden="true">@Initials(DisplayName(account.User))</span>
                            <span class="account-menu-identity-text">
                                <span class="account-menu-identity-name">@DisplayName(account.User)</span>
                                <span class="account-menu-identity-meta">@RoleLabel(account.User)</span>
                            </span>
                        </div>
                        <div class="account-menu-sep" role="separator"></div>
                        <a class="account-menu-item" role="menuitem" href="account">
                            <LucideIcon Name="user" />
                            <span class="account-menu-item-text">
                                <span>@L["AccountTitle"]</span>
                                <span class="account-menu-item-sub">@L["AccountMenuSub"]</span>
                            </span>
                        </a>
                        @if (AvailableRoles(account.User).Count > 1)
                        {
                            <a class="account-menu-item" role="menuitem" href="select-role"><LucideIcon Name="repeat" /><span class="account-menu-item-text"><span>@L["SwitchRole"]</span></span></a>
                        }
                        <div class="account-menu-sep" role="separator"></div>
                        <div class="account-menu-row" role="group" aria-labelledby="account-menu-appearance-label">
                            <span class="account-menu-row-label" id="account-menu-appearance-label">@L["AppearanceLabel"]</span>
                            <button class="account-menu-theme" type="button" data-theme-toggle aria-label="@L["ToggleTheme"]" aria-pressed="false">
                                <span class="light-icon"><LucideIcon Name="moon" /></span>
                                <span class="dark-icon"><LucideIcon Name="sun" /></span>
                            </button>
                        </div>
                        <div class="account-menu-row">
                            <span class="account-menu-row-label" id="account-menu-language-label">@L["Language"]</span>
                            <div class="culture-control account-menu-culture">
                                <AntiforgeryToken />
                                <div class="tabbar tabbar--sm" role="group" aria-labelledby="account-menu-language-label">
                                    <button type="button" class="tabbar-item" data-culture="vi-VN" aria-pressed="@(CultureInfo.CurrentUICulture.Name == "vi-VN" ? "true" : "false")" lang="vi">VI</button>
                                    <button type="button" class="tabbar-item" data-culture="en-US" aria-pressed="@(CultureInfo.CurrentUICulture.Name == "en-US" ? "true" : "false")" lang="en">EN</button>
                                </div>
                                <span class="culture-error" role="alert" hidden data-culture-error>@L["CultureError"]</span>
                                <span class="sr-only" role="status" data-culture-status data-loading-label="@L["Loading"]"></span>
                            </div>
                        </div>
                        <div class="account-menu-sep" role="separator"></div>
                        <form action="Account/Logout" method="post" data-enhance="false">
                            <AntiforgeryToken />
                            <input type="hidden" name="returnUrl" value="" />
                            <button type="submit" class="account-menu-item account-menu-item-danger" role="menuitem"><LucideIcon Name="logout" /><span class="account-menu-item-text"><span>@L["SignOut"]</span></span></button>
                        </form>
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <a class="nav-item" href="login" data-tip="@L["SignIn"]"><LucideIcon Name="user" /><span class="sidebar-label">@L["SignIn"]</span></a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</aside>

@code {
    private string? _activeHref;

    protected override void OnInitialized()
    {
        UpdateActive();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateActive();
        _ = InvokeAsync(StateHasChanged);
    }

    private void UpdateActive()
    {
        var path = SidebarActive.Normalize(Navigation.ToBaseRelativePath(Navigation.Uri));
        _activeHref = NavigationResolver.Resolve(path)?.SidebarItem?.Href;
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private static string NavClass(bool active) => active ? "nav-item active" : "nav-item";

    private static string? NavAriaCurrent(bool active) => active ? "page" : null;

    // Họ tên thật (claim GivenName) thay cho email đăng nhập; cookie cũ chưa có claim thì rơi về Name.
    private static string DisplayName(ClaimsPrincipal user) =>
        user.FindFirst(ClaimTypes.GivenName)?.Value is { Length: > 0 } fullName
            ? fullName
            : user.Identity?.Name ?? string.Empty;

    private static string UserId(ClaimsPrincipal user) =>
        user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

    private static string Initials(string? name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();

    private static IReadOnlyList<string> AvailableRoles(ClaimsPrincipal user)
    {
        var value = user.FindFirst(NhaTroClaimsPrincipalFactory.AvailableRolesClaim)?.Value;
        return string.IsNullOrWhiteSpace(value)
            ? []
            : value.Split(',', StringSplitOptions.RemoveEmptyEntries);
    }

    // Nhóm không còn mục nào người dùng mở được thì ẩn cả tiêu đề nhóm.
    private static bool AnyVisibleItem(ClaimsPrincipal user, NavigationSection section) =>
        section.Items.Any(entry => entry.ShowInSidebar && HasAnyRole(user, entry.Roles));

    private static bool HasAnyRole(ClaimsPrincipal user, string roles) =>
        roles.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Any(user.IsInRole);

    private string AccountTip(ClaimsPrincipal user)
    {
        var name = user.Identity?.Name ?? string.Empty;
        var role = RoleLabel(user);
        return string.IsNullOrEmpty(role) ? name : $"{name} · {role}";
    }

    private string RoleLabel(ClaimsPrincipal user) => Roles.ResolvePrimaryRole(user) switch
    {
        Roles.Admin => L["RoleAdmin"].Value,
        Roles.ChuTro => L["RoleChuTro"].Value,
        Roles.QuanLy => L["RoleQuanLy"].Value,
        Roles.KhachThue => L["RoleKhachThue"].Value,
        _ => string.Empty,
    };
}
