@inject IStringLocalizer<Shared> L

<nav class="breadcrumb" aria-label="@L["Breadcrumb"]">
    <ol>
        @for (var i = 0; i < Items.Count; i++)
        {
            var item = Items[i];
            var isLast = i == Items.Count - 1;
            <li>
                @if (item.Href is not null && !isLast)
                {
                    <a href="@item.Href">@item.Label</a>
                }
                else if (isLast)
                {
                    <span aria-current="page">@item.Label</span>
                }
                else
                {
                    <span>@item.Label</span>
                }
                @if (!isLast)
                {
                    <LucideIcon Name="chevron" />
                }
            </li>
        }
    </ol>
</nav>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<BreadcrumbItem> Items { get; set; } = [];
    public sealed record BreadcrumbItem(string Label, string? Href = null);
}
