@inject IStringLocalizer<Shared> L

<header class="app-topbar">
    <button class="icon-button" type="button" data-drawer-toggle aria-controls="app-sidebar" aria-expanded="false" aria-label="@L["ToggleNavigation"]"><LucideIcon Name="menu" /></button>
    <span class="topbar-title">@L["AppName"]</span>
    <div class="topbar-actions">
        <button class="icon-button" type="button" data-theme-toggle aria-label="@L["ToggleTheme"]" aria-pressed="false"><span class="light-icon"><LucideIcon Name="moon" /></span><span class="dark-icon"><LucideIcon Name="sun" /></span></button>
        <div class="culture-control">
            <span class="sr-only" id="culture-label">@L["Language"]</span>
            <div role="group" aria-labelledby="culture-label">
                <button type="button" class="culture-button" data-culture="vi-VN" aria-pressed="@(CultureInfo.CurrentUICulture.Name == "vi-VN" ? "true" : "false")" lang="vi">VI</button>
                <button type="button" class="culture-button" data-culture="en-US" aria-pressed="@(CultureInfo.CurrentUICulture.Name == "en-US" ? "true" : "false")" lang="en">EN</button>
            </div>
            <span class="culture-error" role="alert" hidden data-culture-error>@L["CultureError"]</span>
            <span class="sr-only" role="status" data-culture-status data-loading-label="@L["Loading"]"></span>
        </div>
        <AuthorizeView>
            <Authorized Context="auth">
                <a class="avatar" href="Account/Manage" aria-label="@L["MyAccount"]" title="@L["MyAccount"]">@Initials(auth.User.Identity?.Name)</a>
                <form action="Account/Logout" method="post" data-enhance="false">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="" />
                    <button type="submit" class="icon-button" aria-label="@L["SignOut"]" title="@L["SignOut"]"><LucideIcon Name="logout" /></button>
                </form>
            </Authorized>
            <NotAuthorized><a class="btn btn-secondary sign-in" href="Account/Login">@L["SignIn"]</a></NotAuthorized>
        </AuthorizeView>
    </div>
</header>

@code {
    private static string Initials(string? name) => string.IsNullOrWhiteSpace(name) ? "?" : name[..1].ToUpperInvariant();
}
