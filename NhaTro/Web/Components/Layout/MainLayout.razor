@using Web.Components.Shared.Feedback
@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IStringLocalizer<Shared> L

<MudThemeProvider Theme="AppTheme.Value" IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<ToastHost @rendermode="InteractiveServer" />

<a class="skip-link" href="#main-content">@L["SkipContent"]</a>
<div class="app-shell">
    <div class="app-chrome-shadow" aria-hidden="true"><span></span></div>
    <AppSidebar />
    <div class="drawer-overlay" data-drawer-overlay hidden></div>
    <div class="app-workspace">
        <AppTopbar />
        <ManagerOwnerBanner @rendermode="InteractiveServer" />
        <OwnerBankAccountBanner @rendermode="InteractiveServer" />
        <TenantContactBanner @rendermode="InteractiveServer" />
        <main id="main-content" class="app-content" tabindex="-1"><div class="app-surface">@Body</div></main>
    </div>
</div>
<div id="blazor-error-ui" data-nosnippet role="alert">
    <span>@L["ConnectionError"]</span>
    <a href="" class="reload">@L["Reload"]</a>
    <button type="button" class="dismiss icon-button" aria-label="@L["Close"]"><LucideIcon Name="close" /></button>
</div>

@code {
    private bool _dark;
    private string? _lastUri;
    private DotNetObjectReference<MainLayout>? _reference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _reference = DotNetObjectReference.Create(this);
            _dark = await JS.InvokeAsync<bool>("appLayout.connect", _reference);
            _lastUri = Navigation.Uri;
            StateHasChanged();
            return;
        }

        // Interactive routing đổi trang ngay trong circuit: đồng bộ mục active + animation chuyển cảnh.
        if (Navigation.Uri == _lastUri) return;
        _lastUri = Navigation.Uri;
        try { await JS.InvokeVoidAsync("appLayout.onNavigated"); }
        catch (JSDisconnectedException) { }
    }

    [JSInvokable]
    public Task SetTheme(bool dark)
    {
        _dark = dark;
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        // Prerender/static SSR không tạo JS reference và không được gọi interop.
        if (_reference is null) return;
        try { await JS.InvokeVoidAsync("appLayout.disconnect"); }
        catch (JSDisconnectedException) { }
        _reference?.Dispose();
    }
}
