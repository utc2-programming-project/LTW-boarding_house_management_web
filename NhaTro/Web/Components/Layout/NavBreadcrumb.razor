@inject NavigationManager Navigation
@inject IStringLocalizer<Shared> L

@if (_items.Count > 0)
{
    <BreadcrumbNav Items="_items" TitleAsHeading="TitleAsHeading" HeadingId="@HeadingId" HeadingText="@HeadingText"
                   CurrentContent="CurrentContent" HeadingSuffix="HeadingSuffix" />
}

@code {
    /// <summary>Nhãn trang hiện tại cho route động (vd số hợp đồng); nối thêm sau mục cuối.</summary>
    [Parameter] public string? CurrentLabel { get; set; }

    /// <summary>Nhãn thay cho mục cuối (giữ nguyên chuỗi tổ tiên), dùng cho tiêu đề riêng của trang.</summary>
    [Parameter] public string? HeadingLabel { get; set; }

    [Parameter] public bool TitleAsHeading { get; set; }
    [Parameter] public string? HeadingId { get; set; }
    [Parameter] public string? HeadingText { get; set; }
    [Parameter] public RenderFragment? CurrentContent { get; set; }
    [Parameter] public RenderFragment? HeadingSuffix { get; set; }

    private IReadOnlyList<BreadcrumbNav.BreadcrumbItem> _items = [];

    protected override void OnParametersSet() => _items = Build();

    private IReadOnlyList<BreadcrumbNav.BreadcrumbItem> Build()
    {
        var path = SidebarActive.Normalize(Navigation.ToBaseRelativePath(Navigation.Uri));
        var match = NavigationResolver.Resolve(path);
        if (match is null)
        {
            var label = !string.IsNullOrWhiteSpace(CurrentLabel) ? CurrentLabel : HeadingLabel;
            return string.IsNullOrWhiteSpace(label)
                ? Array.Empty<BreadcrumbNav.BreadcrumbItem>()
                : new[] { new BreadcrumbNav.BreadcrumbItem(label) };
        }

        var appendCurrent = !string.IsNullOrWhiteSpace(CurrentLabel)
            && !string.Equals(CurrentLabel, L[match.Leaf.Key].Value, StringComparison.Ordinal);
        var items = new List<BreadcrumbNav.BreadcrumbItem>(match.Chain.Count + 2);

        if (match.Section.TitleKey is { } sectionKey)
        {
            items.Add(new BreadcrumbNav.BreadcrumbItem(L[sectionKey]));
        }

        for (var i = 0; i < match.Chain.Count; i++)
        {
            var node = match.Chain[i];
            var isCurrent = i == match.Chain.Count - 1 && !appendCurrent;
            items.Add(new BreadcrumbNav.BreadcrumbItem(L[node.Key], isCurrent ? null : node.Href));
        }

        if (appendCurrent)
        {
            items.Add(new BreadcrumbNav.BreadcrumbItem(CurrentLabel!));
        }
        else if (!string.IsNullOrWhiteSpace(HeadingLabel) && items.Count > 0)
        {
            items[^1] = items[^1] with { Label = HeadingLabel };
        }

        return items;
    }
}
