@inherits LayoutComponentBase
@using Web.Features.Landing
@inject IStringLocalizer<Shared> L
@inject IStringLocalizer<LandingResource> LandingL

@* Khung công khai cho landing: không sidebar/topbar nghiệp vụ, chỉ brand,
   điều hướng neo, đổi sáng/tối, VI/EN và hai lối vào đăng nhập/đăng ký. *@
<a class="skip-link" href="#main-content">@L["SkipContent"]</a>
<div class="public-shell">
    <header class="public-header" data-permanent>
        <div class="public-container public-header-inner">
            <a class="public-brand" href="/" aria-label="@L["AppName"]">
                <span class="app-logo"><LucideIcon Name="building" /></span>
                <span class="public-brand-name">@L["AppName"]</span>
            </a>
            <nav class="public-nav" aria-label="@L["Navigation"]">
                <a href="#features" onclick="event.preventDefault();vhtScrollTo('features');">@LandingL["NavFeatures"]</a>
                <a href="#roles" onclick="event.preventDefault();vhtScrollTo('roles');">@LandingL["NavRoles"]</a>
            </nav>
            <div class="public-actions">
                <button class="icon-button" type="button" data-theme-toggle aria-label="@L["ToggleTheme"]" aria-pressed="false"><span class="light-icon"><LucideIcon Name="moon" /></span><span class="dark-icon"><LucideIcon Name="sun" /></span></button>
                <div class="culture-control">
                    <AntiforgeryToken />
                    <span class="sr-only" id="public-culture-label">@L["Language"]</span>
                    <div class="tabbar tabbar--sm" role="group" aria-labelledby="public-culture-label">
                        <button type="button" class="tabbar-item" data-culture="vi-VN" aria-pressed="@(CultureInfo.CurrentUICulture.Name == "vi-VN" ? "true" : "false")" lang="vi">VI</button>
                        <button type="button" class="tabbar-item" data-culture="en-US" aria-pressed="@(CultureInfo.CurrentUICulture.Name == "en-US" ? "true" : "false")" lang="en">EN</button>
                    </div>
                    <span class="culture-error" role="alert" hidden data-culture-error>@L["CultureError"]</span>
                    <span class="sr-only" role="status" data-culture-status data-loading-label="@L["Loading"]"></span>
                </div>
                <a class="btn btn-secondary public-login" href="/login">@LandingL["Login"]</a>
                <a class="btn btn-primary public-register" href="/Account/RegisterOwner">@LandingL["Register"]</a>
            </div>
        </div>
    </header>
    <main id="main-content" class="public-main" tabindex="-1">
        @Body
    </main>
    <footer class="public-footer">
        <div class="public-container public-footer-inner">
            <div class="public-footer-grid">
                <div class="public-footer-brand">
                    <a class="public-brand" href="/" aria-label="@L["AppName"]">
                        <span class="app-logo"><LucideIcon Name="building" /></span>
                        <span class="public-brand-name">@L["AppName"]</span>
                    </a>
                    <p class="public-footer-desc">@LandingL["FooterDescription"]</p>
                </div>
                <div>
                    <h3 class="public-footer-heading">@LandingL["FooterProduct"]</h3>
                    <ul class="public-footer-list">
                        <li><a href="#features" onclick="event.preventDefault();vhtScrollTo('features');">@LandingL["NavFeatures"]</a></li>
                        <li><a href="#roles" onclick="event.preventDefault();vhtScrollTo('roles');">@LandingL["NavRoles"]</a></li>
                        <li><a href="/login">@LandingL["Login"]</a></li>
                        <li><a href="/Account/RegisterOwner">@LandingL["Register"]</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="public-footer-heading">@LandingL["FooterSupport"]</h3>
                    <ul class="public-footer-list">
                        <li><a href="#roles" onclick="event.preventDefault();vhtScrollTo('roles');">@LandingL["FooterGuide"]</a></li>
                        <li><a href="#faq" onclick="event.preventDefault();vhtScrollTo('faq');">@LandingL["FooterFaq"]</a></li>
                        <li><a href="#footer-contact" onclick="event.preventDefault();vhtScrollTo('footer-contact');">@LandingL["FooterContact"]</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="public-footer-heading">@LandingL["FooterLegal"]</h3>
                    <ul class="public-footer-list">
                        <li><span class="public-footer-placeholder">@LandingL["FooterTerms"]</span></li>
                        <li><span class="public-footer-placeholder">@LandingL["FooterPrivacy"]</span></li>
                    </ul>
                </div>
                <div id="footer-contact">
                    <h3 class="public-footer-heading">@LandingL["FooterContact"]</h3>
                    <ul class="public-footer-list">
                        <li><span class="public-footer-placeholder">@LandingL["FooterEmail"]</span></li>
                        <li><span class="public-footer-placeholder">@LandingL["FooterPhone"]</span></li>
                    </ul>
                </div>
            </div>
            <div class="public-footer-bottom">
                <p>© @DateTime.Today.Year @L["AppName"]. @LandingL["FooterRights"]</p>
            </div>
        </div>
    </footer>
</div>
<div id="blazor-error-ui" data-nosnippet role="alert">
    <span>@L["ConnectionError"]</span>
    <a href="" class="reload">@L["Reload"]</a>
    <button type="button" class="dismiss icon-button" aria-label="@L["Close"]"><LucideIcon Name="close" /></button>
</div>
