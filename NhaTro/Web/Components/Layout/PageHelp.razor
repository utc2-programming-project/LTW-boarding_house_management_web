@using Web.Components.Shared.Feedback
@inject IStringLocalizer<Shared> L

<HelpTip Text="@Text" Label="@AccessibleLabel" AlignEnd="true" />

@code {
    /// <summary>Nội dung giải thích của nút dấu hỏi; rỗng thì không hiện nút.</summary>
    [Parameter, EditorRequired] public string? Text { get; set; }

    /// <summary>Nhãn truy cập cho nút; mặc định dùng key chung PageHelpLabel.</summary>
    [Parameter] public string? Label { get; set; }

    private string AccessibleLabel => string.IsNullOrWhiteSpace(Label) ? L["PageHelpLabel"] : Label;
}
