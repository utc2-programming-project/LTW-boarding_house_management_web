@using Microsoft.AspNetCore.Identity
@using Web.Data
@using Web.Data.Seeding
@using Web.Features.Accounts

@inject IConfiguration Config
@inject IWebHostEnvironment Env
@inject IStringLocalizer<Shared> L
@inject UserManager<ApplicationUser> Users

@* VHT-8: bang "dang nhap nhanh" giup tester vao tung vai tro trong 1 bam.
   Chi hien o Development, voi tai khoan mau ton tai va mat khau khop,
   nen khong bao gio lo ra o moi truong that. *@
@if (Entries.Count > 0)
{
    <div class="auth-divider" aria-hidden="true"><span>@L["OrDivider"]</span></div>
    <aside class="dev-login" aria-label="@L["DevQuickLoginTitle"]">
        <p class="dev-login-title">
            <span class="dev-badge">DEV</span>
            <span>@L["DevQuickLoginTitle"]</span>
        </p>
        <p class="dev-login-hint">@L["DevQuickLoginHint"]</p>
        <ul class="dev-login-list">
            @foreach (var entry in Entries)
            {
                <li class="dev-login-row">
                    <span class="dev-login-role">@L[AccountPermissionRules.RoleResourceKey(entry.Role)]</span>
                    <code class="dev-login-email" title="@entry.Email">@entry.Email</code>
                    <form method="post" action="/login">
                        <AntiforgeryToken />
                        <input type="hidden" name="_handler" value="login" />
                        <input type="hidden" name="Input.Email" value="@entry.Email" />
                        <input type="hidden" name="Input.Password" value="@entry.Password" />
                        <input type="hidden" name="Input.RememberMe" value="false" />
                        <button type="submit" class="btn btn-secondary btn-xs">@L["DevUseButton"]</button>
                    </form>
                </li>
            }
        </ul>
    </aside>
}

@code {
    private sealed record DevLoginEntry(string Role, string Email, string Password);

    private List<DevLoginEntry> Entries { get; } = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Env.IsDevelopment()
            || string.Equals(Config["DevAccounts:Skip"], "true", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        // Admin that duoc gieo tu AdminSeed (khong phai tu DevAccounts).
        var adminEmail = Config["AdminSeed:Email"];
        var adminPassword = Config["AdminSeed:Password"];
        if (string.IsNullOrWhiteSpace(adminEmail) || string.IsNullOrWhiteSpace(adminPassword))
        {
            adminEmail = AdminSeeder.DevelopmentEmail;
            adminPassword = AdminSeeder.DevelopmentPassword;
        }

        await AddIfValidAsync(Roles.Admin, adminEmail, adminPassword);

        // Cac vai tro con lai lay tu danh sach user mau (bo qua admin mau vi da co Admin that).
        var devPassword = Config["DevAccounts:Password"];
        if (string.IsNullOrWhiteSpace(devPassword))
        {
            devPassword = DevAccountSeeder.DefaultPassword;
        }

        foreach (var (email, role) in DevAccountSeeder.Accounts)
        {
            if (role != Roles.Admin)
            {
                await AddIfValidAsync(role, email, devPassword);
            }
        }
    }

    private async Task AddIfValidAsync(string role, string email, string password)
    {
        var user = await Users.FindByEmailAsync(email);
        if (user is null || !await Users.CheckPasswordAsync(user, password))
        {
            return;
        }

        Entries.Add(new DevLoginEntry(role, email, password));
    }
}
