@inherits LayoutComponentBase
@layout Web.Components.Layout.MainLayout
@inject IStringLocalizer<Shared> L

<section class="account-shell">
    <BreadcrumbNav Items="@(new BreadcrumbNav.BreadcrumbItem[] { new(L["ManageAccountTitle"]) })" />

    <header class="page-heading">
        <div>
            <h1 id="account-title">@L["ManageAccountTitle"]</h1>
            <p>@L["ManageAccountSubtitle"]</p>
        </div>
    </header>

    <div class="account-body">
        <ManageNavMenu />
        <div class="account-panel">@Body</div>
    </div>
</section>
