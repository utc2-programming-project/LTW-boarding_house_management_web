@using Microsoft.AspNetCore.Identity
@using Web.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject IStringLocalizer<Shared> L

<nav class="account-nav" aria-label="@L["ManageAccountTitle"]">
    <NavLink href="Account/Manage" Match="NavLinkMatch.All">@L["ProfileTitle"]</NavLink>
    <NavLink href="Account/Manage/Email">@L["EmailLabel"]</NavLink>
    <NavLink href="Account/Manage/ChangePassword">@L["PasswordLabel"]</NavLink>
    @if (hasExternalLogins)
    {
        <NavLink href="Account/Manage/ExternalLogins">@L["ManageNavExternalLogins"]</NavLink>
    }
    <NavLink href="Account/Manage/TwoFactorAuthentication">@L["TwoFactorLoginTitle"]</NavLink>
    <NavLink href="Account/Manage/Passkeys">@L["ManageNavPasskeys"]</NavLink>
    <NavLink href="Account/Manage/PersonalData">@L["ManageNavPersonalData"]</NavLink>
</nav>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
