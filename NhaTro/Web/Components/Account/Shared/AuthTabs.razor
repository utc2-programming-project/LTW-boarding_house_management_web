@inject IStringLocalizer<Shared> L

@* Preset 3 tab của luồng tài khoản trên TabBar chung; trang auth là static SSR nên phải là link. *@
<TabBar Items="Items" ActiveKey="@ActiveKey" Disabled="@Dimmed" Fill="true" AriaLabel="@L["AuthTabsLabel"]" />

@code {
    [Parameter] public AuthTab Active { get; set; } = AuthTab.None;

    [Parameter] public bool Dimmed { get; set; }

    private string ActiveKey => Active switch
    {
        AuthTab.Login => "login",
        AuthTab.Register => "register",
        AuthTab.Forgot => "forgot",
        _ => string.Empty,
    };

    private IReadOnlyList<TabItem> Items =>
    [
        new("login", L["LoginTitle"].Value, "/login"),
        new("register", L["AuthTabRegister"].Value, "/Account/RegisterOwner"),
        new("forgot", L["AuthTabForgot"].Value, "/Account/ForgotPassword"),
    ];
}
