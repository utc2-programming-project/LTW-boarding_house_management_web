<StatusMessage Message="@StatusMessage" />
@inject IStringLocalizer<Shared> L

<h2 class="account-section">@L["RecoveryCodesTitle"]</h2>
<div class="form-alert warning" role="alert">
    <LucideIcon Name="alert" />
    <div>
        <p><strong>@L["RecoveryCodesSafePlace"]</strong></p>
        <p>@L["RecoveryCodesLostDevice"]</p>
    </div>
</div>
<div class="account-codes">
    @foreach (var recoveryCode in RecoveryCodes)
    {
        <code class="account-code">@recoveryCode</code>
    }
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
