@page "/Account/InvalidPasswordReset"
@layout Layout.AuthLayout

@* Trang báo liên kết đặt lại mật khẩu không hợp lệ hoặc đã hết hạn,
   kèm lối gửi lại yêu cầu và quay về đăng nhập. Dùng khung AuthLayout. *@

@inject IStringLocalizer<Shared> L

<PageTitle>@L["InvalidPasswordResetTitle"] · @L["AppName"]</PageTitle>

<section class="auth-page" aria-labelledby="invalid-reset-title">
    <div class="auth-card">
        <header class="page-heading auth-heading">
            <div>
                <h1 id="invalid-reset-title">@L["InvalidPasswordResetTitle"]</h1>
                <p>@L["InvalidPasswordResetText"]</p>
            </div>
        </header>

        <div class="form-alert" role="alert">
            <LucideIcon Name="alert" />
            <span>@L["ResetPasswordInvalidToken"]</span>
        </div>

        <p class="hint">
            <a href="Account/ForgotPassword">@L["ForgotPasswordTitle"]</a>
        </p>
        <p class="hint">
            <a href="Account/Login">@L["BackToLogin"]</a>
        </p>
    </div>
</section>
