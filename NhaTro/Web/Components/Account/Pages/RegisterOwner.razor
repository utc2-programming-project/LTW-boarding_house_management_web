@page "/Account/RegisterOwner"
@layout Layout.AuthLayout

@using System.ComponentModel.DataAnnotations
@using Web.Components.Shared.Forms
@using Web.Features.Accounts
@using Web.Features.Accounts.DTOs

@inject IAccountService Accounts
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<Shared> L

<PageTitle>@L["RegisterOwnerTitle"] · @L["AppName"]</PageTitle>

<section class="auth-page" aria-labelledby="register-owner-title">
    <div class="auth-card">
        <AuthTabs Active="AuthTab.Register" />
        <PageHeading Title="@L["RegisterOwnerTitle"]" TitleId="register-owner-title" Class="auth-heading" />
        <p class="auth-subtitle">@L["RegisterOwnerSubtitle"]</p>

        @if (_done)
        {
            <div class="form-alert" role="status">
                <LucideIcon Name="check" />
                <span>@L["RegisterOwnerSuccessText"]</span>
            </div>
            <p class="auth-alt-action"><a href="Account/Login">@L["BackToLogin"]</a></p>
        }
        else
        {
            if (_error is not null)
            {
                <div class="form-alert" role="alert">
                    <LucideIcon Name="alert" />
                    <span>@_error</span>
                </div>
            }

            <EditForm Model="Input" FormName="register-owner" OnValidSubmit="SubmitAsync" method="post">
                <DataAnnotationsValidator />

                <FormField TValue="string" Id="register-name" Label="@L["FullNameLabel"]" Required="true"
                           For="() => Input.FullName">
                    <InputText @bind-Value="Input.FullName" id="register-name" class="input"
                               autocomplete="name" maxlength="200" aria-required="true"
                               placeholder="@L["FullNamePlaceholder"]"
                               aria-describedby="register-name-error" />
                </FormField>

                <FormField TValue="string" Id="register-email" Label="@L["EmailLabel"]" Required="true"
                           For="() => Input.Email">
                    <InputText @bind-Value="Input.Email" id="register-email" class="input" type="email"
                               autocomplete="username" maxlength="256" aria-required="true"
                               placeholder="@L["EmailPlaceholder"]"
                               aria-describedby="register-email-error" />
                </FormField>

                <FormField TValue="string" Id="register-phone" Label="@L["PhoneLabel"]"
                           For="() => Input.PhoneNumber">
                    <LabelSuffix><span class="label-optional">@L["OptionalLabel"]</span></LabelSuffix>
                    <ChildContent>
                        <InputText @bind-Value="Input.PhoneNumber" id="register-phone" class="input"
                                   inputmode="numeric" maxlength="10" autocomplete="tel"
                                   placeholder="@L["PhonePlaceholder"]"
                                   aria-describedby="register-phone-error" />
                    </ChildContent>
                </FormField>

                <FormField TValue="string" Id="register-password" Label="@L["PasswordLabel"]" Required="true"
                           Hint="@L["PasswordMinHint"]" For="() => Input.Password">
                    <div class="password-wrap">
                        <InputText @bind-Value="Input.Password" id="register-password" class="input" type="password"
                                   autocomplete="new-password" aria-required="true"
                                   placeholder="@L["PasswordPlaceholder"]"
                                   aria-describedby="register-password-hint register-password-error" />
                        <button type="button" class="password-toggle" data-password-toggle="register-password"
                                data-show-label="@L["ShowPassword"]" data-hide-label="@L["HidePassword"]"
                                aria-label="@L["ShowPassword"]" aria-pressed="false">
                            <span class="pw-icon-show"><LucideIcon Name="eye" /></span>
                            <span class="pw-icon-hide"><LucideIcon Name="eye-off" /></span>
                        </button>
                    </div>
                </FormField>

                <FormField TValue="string" Id="register-confirm" Label="@L["ConfirmPasswordLabel"]" Required="true"
                           For="() => Input.ConfirmPassword">
                    <div class="password-wrap">
                        <InputText @bind-Value="Input.ConfirmPassword" id="register-confirm" class="input"
                                   type="password" autocomplete="new-password" aria-required="true"
                                   placeholder="@L["ConfirmPasswordPlaceholder"]"
                                   aria-describedby="register-confirm-error" />
                        <button type="button" class="password-toggle" data-password-toggle="register-confirm"
                                data-show-label="@L["ShowPassword"]" data-hide-label="@L["HidePassword"]"
                                aria-label="@L["ShowPassword"]" aria-pressed="false">
                            <span class="pw-icon-show"><LucideIcon Name="eye" /></span>
                            <span class="pw-icon-hide"><LucideIcon Name="eye-off" /></span>
                        </button>
                    </div>
                </FormField>

                <p class="auth-callout">
                    <LucideIcon Name="info" />
                    <span>@L["RegisterOwnerNote"]</span>
                </p>

                <button type="submit" class="btn btn-primary btn-block" disabled="@_saving">
                    @if (_saving) { <span class="spinner" aria-hidden="true"></span> }
                    @L["RegisterOwnerButton"]
                </button>
            </EditForm>

            <p class="auth-alt-action">
                <a href="Account/Login">@L["RegisterOwnerLogin"]</a>
            </p>
        }
    </div>
</section>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    private string? _error;
    private bool _saving;
    private bool _done;

    protected override void OnInitialized() => Input ??= new();

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            var result = await Accounts.RegisterOwnerAsync(new RegisterOwnerRequest
            {
                Email = Input.Email,
                FullName = Input.FullName,
                PhoneNumber = Input.PhoneNumber,
                Password = Input.Password,
            });

            if (!result.Succeeded)
            {
                _error = result.ErrorCode == AccountErrorCodes.DuplicateEmail
                    ? L["RegisterOwnerEmailTaken"]
                    : L["RegisterOwnerFailed"];
                return;
            }

            _done = true;

            // PLAN-022: chuyển sang nhập OTP thay vì gửi liên kết xác nhận.
            RedirectManager.RedirectTo(
                $"/Account/VerifyOtp?purpose=OwnerRegistration&email={Uri.EscapeDataString(Input.Email.Trim())}");
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class InputModel
    {
        [Required]
        [StringLength(200, MinimumLength = 2)]
        public string FullName { get; set; } = string.Empty;

        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [RegularExpression(@"^0\d{9}$", ErrorMessage = "Số điện thoại phải có 10 số, bắt đầu bằng 0.")]
        public string? PhoneNumber { get; set; }

        [Required]
        [StringLength(100, MinimumLength = 8)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "Mật khẩu xác nhận không khớp.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
