@page "/login"
@page "/Account/Login"
@layout Layout.AuthLayout

@* Trang đăng nhập theo chuẩn phong_cach_giao_dien.md.
   Giữ static SSR + form POST vì Identity ghi cookie qua HTTP, không làm được trong circuit Blazor. *@

@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using Web.Components.Shared.Forms
@using Web.Data
@using Web.Features.Accounts.Contexts
@using Web.Infrastructure.Security

@inject SignInManager<ApplicationUser> SignInManager
@inject PostLoginRouter PostLogin
@inject UserManager<ApplicationUser> Users
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<Shared> L
@inject ICaptchaVerifier CaptchaVerifier
@inject ILoginAttemptGuard AttemptGuard

<PageTitle>@L["LoginTitle"] · @L["AppName"]</PageTitle>

<section class="auth-page auth-page--quick" aria-labelledby="login-title">
    <div class="auth-card">
        <AuthTabs Active="AuthTab.Login" />
        <PageHeading Title="@L["LoginTitle"]" TitleId="login-title" Class="auth-heading" />
        <p class="auth-subtitle">@L["LoginSubtitle"]</p>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="form-alert" role="alert">
                <LucideIcon Name="alert" />
                <span>@errorMessage</span>
            </div>
        }

        <EditForm EditContext="editContext" method="post" OnSubmit="LoginUser" FormName="login">
            <FormField TValue="string" Id="login-email" Label="@L["EmailLabel"]" Required="true"
                       For="() => Input.Email">
                <InputText @bind-Value="Input.Email" id="login-email" class="input"
                           autocomplete="username webauthn" aria-required="true"
                           placeholder="@L["EmailPlaceholder"]"
                           aria-describedby="login-email-error" />
            </FormField>

            <FormField TValue="string" Id="login-password" Label="@L["PasswordLabel"]" Required="true"
                       For="() => Input.Password">
                <LabelAction>
                    <a class="auth-inline-link" href="Account/ForgotPassword">@L["ForgotPassword"]</a>
                </LabelAction>
                <ChildContent>
                    <div class="password-wrap">
                        <InputText @bind-Value="Input.Password" id="login-password"
                                   type="password" class="input"
                                   autocomplete="current-password" aria-required="true"
                                   placeholder="@L["PasswordPlaceholder"]"
                                   aria-describedby="login-password-error" />
                        <button type="button" class="password-toggle" data-password-toggle="login-password"
                                data-show-label="@L["ShowPassword"]" data-hide-label="@L["HidePassword"]"
                                aria-label="@L["ShowPassword"]" aria-pressed="false">
                            <span class="pw-icon-show"><LucideIcon Name="eye" /></span>
                            <span class="pw-icon-hide"><LucideIcon Name="eye-off" /></span>
                        </button>
                    </div>
                </ChildContent>
            </FormField>

            @* chi hien khi da sai qua nguong; dap an duoc ma hoa trong token an. *@
            @if (_captchaChallenge is not null)
            {
                <FormField TValue="string" Id="login-captcha" Label="@CaptchaLabel"
                           Hint="@L["CaptchaRequired"]" Required="true"
                           For="() => Input.CaptchaAnswer">
                    <input type="hidden" name="Input.CaptchaToken" value="@_captchaChallenge.Token" />
                    <InputText @bind-Value="Input.CaptchaAnswer" id="login-captcha" class="input"
                               autocomplete="off" inputmode="numeric" aria-required="true"
                               aria-describedby="login-captcha-error" />
                </FormField>
            }

            @* "Quên mật khẩu?" nằm cùng hàng với label Mật khẩu ở trên. *@
            <div class="remember-row">
                <label class="checkbox-label" for="login-remember">
                    <InputCheckbox @bind-Value="Input.RememberMe" id="login-remember" class="checkbox" />
                    <span>@L["RememberMe"]</span>
                </label>
            </div>

            <button type="submit" class="btn btn-primary btn-block" disabled="@_submitting">
                @if (_submitting)
                {
                    <span class="spinner" aria-hidden="true"></span>
                }
                @L["LoginButton"]
            </button>
        </EditForm>

        <p class="auth-alt-action">
            <a href="Account/RegisterOwner">@L["RegisterOwnerLink"]</a>
        </p>
    </div>

    @* Panel nổi cạnh thẻ đăng nhập; chỉ hiện ở Development (xem DevQuickLogin.razor). *@
    <DevQuickLogin />
</section>

@code {
    private string? errorMessage;
    private bool _submitting;
    private EditContext editContext = default!;
    private ValidationMessageStore? messageStore;
    private CaptchaChallenge? _captchaChallenge;

    private string CaptchaLabel => _captchaChallenge is null
        ? string.Empty
        : $"{L["CaptchaQuestion"]}: {_captchaChallenge.Question} = ?";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "stale")]
    private string? StaleForm { get; set; }

    // Rate limiter chuyển POST bị chặn về đây thay vì trả text thô.
    [SupplyParameterFromQuery(Name = "tooManyRequests")]
    private string? TooManyRequestsFlag { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        editContext = new EditContext(Input);
        messageStore ??= new ValidationMessageStore(editContext);
        editContext.OnFieldChanged += (_, _) =>
        {
            messageStore.Clear();
            errorMessage = null;
        };

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            // Program.cs doi POST co token cu (tab khac da dang nhap / phien het han)
            // thanh redirect ve day de tai lai form voi token moi.
            // IP đang bị chặn vì sai quá nhiều lần: ưu tiên thông báo chặn kèm số phút,
            // kể cả khi rate limiter cũng vừa chặn request (đã gắn tooManyRequests=1).
            if (AttemptGuard.GetIpBlockRemaining(RateLimitPolicies.ClientKey(HttpContext)) is { } blocked)
            {
                errorMessage = BlockedMessage(blocked);
            }
            else if (StaleForm == "1")
            {
                errorMessage = L["LoginFormStale"];
            }
            else if (TooManyRequestsFlag == "1")
            {
                // Vua bi gioi han tan suat: hien thong bao ngay tren form thay vi trang text.
                errorMessage = L["TooManyRequests"];
            }

            // Xoa cookie dang nhap ngoai (neu co) de bat dau luong dang nhap sach.
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    public async Task LoginUser(EditContext? _ = null)
    {
        if (_submitting)
        {
            return;
        }

        // Thong bao loi hien bang <ValidationMessage> da dich trong FormField.
        messageStore!.Clear();
        errorMessage = null;
        var valid = true;

        if (string.IsNullOrWhiteSpace(Input.Email))
        {
            messageStore.Add(() => Input.Email, L["EmailRequired"]);
            valid = false;
        }
        else if (!IsValidEmail(Input.Email))
        {
            messageStore.Add(() => Input.Email, L["EmailInvalid"]);
            valid = false;
        }

        if (string.IsNullOrEmpty(Input.Password))
        {
            messageStore.Add(() => Input.Password, L["PasswordRequired"]);
            valid = false;
        }

        if (!valid)
        {
            editContext.NotifyValidationStateChanged();
            return;
        }

        _submitting = true;

        // Chan theo IP: sai qua nhieu lan thi tam khoa IP, KHONG khoa tai khoan.
        var clientIp = RateLimitPolicies.ClientKey(HttpContext);
        if (AttemptGuard.GetIpBlockRemaining(clientIp) is { } blockedNow)
        {
            _submitting = false;
            errorMessage = BlockedMessage(blockedNow);
            return;
        }

        // sau nhieu lan sai, bat buoc giai CAPTCHA truoc khi kiem mat khau.
        if (IsCaptchaRequired())
        {
            if (!CaptchaVerifier.Verify(Input.CaptchaToken, Input.CaptchaAnswer))
            {
                _submitting = false;

                // Giai CAPTCHA sai cung la mot lan thu that bai: dem theo IP de chan som.
                AttemptGuard.RegisterFailure(clientIp, Input.Email.Trim());
                if (AttemptGuard.GetIpBlockRemaining(clientIp) is { } blockedCaptcha)
                {
                    errorMessage = BlockedMessage(blockedCaptcha);
                    return;
                }

                errorMessage = L["CaptchaInvalid"];
                _captchaChallenge = CaptchaVerifier.CreateChallenge();
                Input.CaptchaAnswer = string.Empty;
                return;
            }
        }

        var result = await SignInManager.PasswordSignInAsync(
            Input.Email.Trim(), Input.Password, Input.RememberMe, lockoutOnFailure: false);

        if (result.Succeeded)
        {
            AttemptGuard.RegisterSuccess(clientIp, Input.Email.Trim());
            Logger.LogInformation("Nguoi dung dang nhap thanh cong.");

            // PLAN-022: tài khoản chưa xác thực Gmail chỉ được vào trang OTP.
            var signedInUser = await Users.FindByEmailAsync(Input.Email.Trim());
            if (signedInUser is null)
            {
                RedirectManager.RedirectTo("/home");
                return;
            }

            if (signedInUser is { EmailConfirmed: false })
            {
                var target = string.IsNullOrEmpty(ReturnUrl) ? "/home" : ReturnUrl;
                RedirectManager.RedirectTo(
                    $"Account/VerifyOtp?purpose=FirstLogin&email={Uri.EscapeDataString(Input.Email.Trim())}"
                    + $"&returnUrl={Uri.EscapeDataString(target)}");
                return;
            }

            // PLAN-023: một ngữ cảnh vào thẳng; nhiều ngữ cảnh dừng ở /select-role.
            var redirect = await PostLogin.GetRedirectAsync(
                signedInUser,
                string.IsNullOrEmpty(ReturnUrl) ? "/home" : ReturnUrl);
            RedirectManager.RedirectTo(redirect);
            return;
        }

        _submitting = false;

        if (result.RequiresTwoFactor)
        {
            RedirectManager.RedirectTo(
                "Account/LoginWith2fa",
                new() { ["returnUrl"] = ReturnUrl, ["rememberMe"] = Input.RememberMe });
            return;
        }

        if (result.IsLockedOut)
        {
            Logger.LogWarning("Tai khoan dang nhap bi khoa.");
            RedirectManager.RedirectTo("Account/Lockout");
            return;
        }

        // VHT-95: CanSignInAsync tra false khi tai khoan chua duoc duyet.
        if (result == SignInResult.NotAllowed)
        {
            Logger.LogInformation("Tai khoan dang nhap dang cho duyet.");
            errorMessage = L["LoginPendingApproval"];
            return;
        }

        // Khong noi ro email sai hay mat khau sai (tranh do tai khoan).
        errorMessage = L["LoginInvalid"];

        // Ghi nhan lan sai theo IP + tai khoan (khong dung lockout cua Identity).
        AttemptGuard.RegisterFailure(clientIp, Input.Email.Trim());

        if (AttemptGuard.GetIpBlockRemaining(clientIp) is { } blockedAfter)
        {
            errorMessage = BlockedMessage(blockedAfter);
            return;
        }

        // vuot nguong sai thi hien CAPTCHA cho lan dang nhap tiep theo.
        if (IsCaptchaRequired())
        {
            _captchaChallenge = CaptchaVerifier.CreateChallenge();
            Input.CaptchaAnswer = string.Empty;
        }
    }

    /// <summary>Co bat buoc CAPTCHA khong, dua tren so lan dang nhap sai cua tai khoan.</summary>
    private bool IsCaptchaRequired() =>
        CaptchaVerifier.IsChallengeRequired(AttemptGuard.GetAccountFailures(Input.Email.Trim()));

    /// <summary>Thong bao IP dang bi chan, kem so phut con lai.</summary>
    private string BlockedMessage(TimeSpan remaining) =>
        string.Format(
            System.Globalization.CultureInfo.CurrentCulture,
            L["LoginIpBlocked"],
            Math.Max(1, (int)Math.Ceiling(remaining.TotalMinutes)));

    private static bool IsValidEmail(string value)
    {
        var trimmed = value.Trim();
        var at = trimmed.IndexOf('@');
        if (at <= 0 || at != trimmed.LastIndexOf('@') || at == trimmed.Length - 1)
        {
            return false;
        }

        var domain = trimmed[(at + 1)..];
        return domain.Contains('.')
            && !domain.StartsWith('.')
            && !domain.EndsWith('.')
            && !trimmed.Contains(' ');
    }

    private sealed class InputModel
    {
        public string Email { get; set; } = "";

        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }

        // cau tra loi CAPTCHA + token da phat hanh (khong lo dap an).
        public string CaptchaAnswer { get; set; } = "";

        public string CaptchaToken { get; set; } = "";
    }
}
