@page "/Account/ResetPasswordConfirmation"
@layout Layout.AuthLayout

@* Trang xác nhận đã đổi mật khẩu thành công, kèm nút quay lại đăng nhập.
   Dùng khung AuthLayout. *@

@inject IStringLocalizer<Shared> L

<PageTitle>@L["ResetPasswordConfirmationTitle"] · @L["AppName"]</PageTitle>

<section class="auth-page" aria-labelledby="reset-confirm-title">
    <div class="auth-card">
        <header class="page-heading auth-heading">
            <div>
                <h1 id="reset-confirm-title">@L["ResetPasswordConfirmationTitle"]</h1>
                <p>@L["ResetPasswordConfirmationText"]</p>
            </div>
        </header>

        <div class="form-alert" role="status">
            <LucideIcon Name="check" />
            <span>@L["ResetPasswordConfirmationHint"]</span>
        </div>

        <p class="hint">
            <a href="Account/Login">@L["ClickToLoginAction"]</a>
        </p>
    </div>
</section>
