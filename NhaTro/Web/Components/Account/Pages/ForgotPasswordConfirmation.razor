@page "/Account/ForgotPasswordConfirmation"
@layout Layout.AuthLayout

@* Trang xác nhận đã gửi yêu cầu quên mật khẩu: hướng dẫn kiểm tra hộp thư
   và đường quay lại đăng nhập. Dùng khung AuthLayout. *@

@inject IStringLocalizer<Shared> L

<PageTitle>@L["ForgotPasswordConfirmationTitle"] · @L["AppName"]</PageTitle>

<section class="auth-page" aria-labelledby="forgot-confirm-title">
    <div class="auth-card">
        <header class="page-heading auth-heading">
            <div>
                <h1 id="forgot-confirm-title">@L["ForgotPasswordConfirmationTitle"]</h1>
                <p>@L["ForgotPasswordConfirmationText"]</p>
            </div>
        </header>

        <div class="form-alert" role="status">
            <LucideIcon Name="check" />
            <span>@L["ForgotPasswordConfirmationHint"]</span>
        </div>

        <p class="hint">
            <a href="Account/Login">@L["BackToLogin"]</a>
        </p>
    </div>
</section>
