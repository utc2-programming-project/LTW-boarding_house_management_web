@page "/Account/ExternalLogin"
@layout Layout.AuthLayout

@* PLAN-012: callback đăng nhập ngoài (Google). Dùng ExternalLoginPolicy: chỉ liên kết tài khoản
   đã có, không tạo tài khoản mới. Mọi nhánh kết quả hiển thị trong auth-card + lối về /login. *@

@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using Web.Data
@using Web.Features.Accounts.Contexts
@using Web.Features.Accounts.External
@using Web.Features.Tenants.Invitations

@inject SignInManager<ApplicationUser> SignInManager
@inject PostLoginRouter PostLogin
@inject ExternalLoginPolicy Policy
@inject TenantQrInvitationService Invites
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ExternalLogin> Logger
@inject IStringLocalizer<Shared> L

<PageTitle>@L["GoogleLoginTitle"] · @L["AppName"]</PageTitle>

<section class="auth-page" aria-labelledby="external-login-title">
    <div class="auth-card">
        <PageHeading Title="@L["GoogleLoginTitle"]" TitleId="external-login-title" Class="auth-heading" />

        <div class="form-alert" role="alert">
            <LucideIcon Name="alert" />
            <span>@_message</span>
        </div>

        <a class="btn btn-primary btn-block" href="Account/Login">@L["BackToLogin"]</a>
    </div>
</section>

@code {
    public const string LoginCallbackAction = "LoginCallback";

    private string? _message;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? RemoteError { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Action { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (RemoteError is not null)
        {
            RedirectManager.RedirectToWithStatus(
                "Account/Login",
                $"Error: {L["ExternalProviderError", RemoteError ?? ""]}",
                HttpContext);
            return;
        }

        var info = await SignInManager.GetExternalLoginInfoAsync();
        if (info is null)
        {
            RedirectManager.RedirectToWithStatus("Account/Login", $"Error: {L["ExternalLoginInfoLoadFailed"]}", HttpContext);
            return;
        }

        if (!HttpMethods.IsGet(HttpContext.Request.Method) || Action != LoginCallbackAction)
        {
            RedirectManager.RedirectTo("Account/Login");
            return;
        }

        var result = await Policy.ResolveAsync(info);

        if (result.Outcome == ExternalLoginOutcome.NoAccount
            && TryGetInviteToken(ReturnUrl, out var inviteToken))
        {
            var email = info.Principal.FindFirstValue(ClaimTypes.Email) ?? string.Empty;
            var fullName = info.Principal.FindFirstValue(ClaimTypes.Name) ?? email;
            var created = await Invites.BeginExternalAccountAsync(
                inviteToken,
                new NewTenantAccountRequest { Email = email, FullName = fullName });

            if (!created.Succeeded)
            {
                Logger.LogInformation("External invite signup rejected: {Code}.", created.ErrorCode);
                await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
                _message = L["ExternalLoginInviteFailed"];
                return;
            }

            // Tài khoản vừa tạo → resolve lần hai chỉ còn việc liên kết Google.
            result = await Policy.ResolveAsync(info);
        }

        await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);

        switch (result.Outcome)
        {
            case ExternalLoginOutcome.Linked:
                var signIn = await SignInManager.ExternalLoginSignInAsync(
                    info.LoginProvider,
                    info.ProviderKey,
                    isPersistent: false,
                    bypassTwoFactor: true);

                if (signIn.Succeeded)
                {
                    Logger.LogInformation("External login via {Provider} succeeded.", info.LoginProvider);
                    var redirect = await PostLogin.GetRedirectAsync(result.User!, ReturnUrl);
                    RedirectManager.RedirectTo(redirect);
                    return;
                }

                if (signIn.IsLockedOut)
                {
                    RedirectManager.RedirectTo("Account/Lockout");
                    return;
                }

                _message = signIn.IsNotAllowed ? L["ExternalLoginPendingApproval"] : L["ExternalLoginFailed"];
                return;

            case ExternalLoginOutcome.NoAccount:
                _message = L["ExternalLoginNoAccount"];
                return;

            case ExternalLoginOutcome.EmailNotVerified:
                _message = L["ExternalLoginEmailNotVerified"];
                return;

            default:
                _message = L["ExternalLoginFailed"];
                return;
        }
    }

    // Lời mời dùng link /invite/{token}: chỉ đường dẫn đó mới được tạo tài khoản mới từ Google.
    private static bool TryGetInviteToken(string? returnUrl, out string token)
    {
        token = string.Empty;
        if (string.IsNullOrWhiteSpace(returnUrl))
        {
            return false;
        }

        const string prefix = "/invite/";
        var path = returnUrl.Split('?', '#')[0];
        if (!path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var value = Uri.UnescapeDataString(path[prefix.Length..]).Trim('/');
        if (value.Length == 0 || value.Contains('/'))
        {
            return false;
        }

        token = value;
        return true;
    }
}
