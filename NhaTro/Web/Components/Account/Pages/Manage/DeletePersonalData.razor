@page "/Account/Manage/DeletePersonalData"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Web.Components.Shared.Forms
@using Web.Data
@using Web.Features.Accounts

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<DeletePersonalData> Logger

<PageTitle>@L["DeletePersonalDataTitle"]</PageTitle>

<h2 class="account-section">@L["DeletePersonalDataTitle"]</h2>

<StatusMessage Message="@message" />

<div class="form-alert warning" role="alert">
    <LucideIcon Name="alert" />
    <div>
        <strong>@L["PersonalDataDeleteWarning"]</strong>
    </div>
</div>

<EditForm Model="Input" FormName="delete-user" OnValidSubmit="OnValidSubmitAsync" method="post">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="account-form">
        @if (requirePassword)
        {
            <FormField TValue="string" Id="Input.Password" Label="@L["PasswordLabel"]" Required="true"
                       For="() => Input.Password">
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password"
                           autocomplete="current-password" aria-required="true"
                           aria-describedby="Input.Password-error" />
            </FormField>
        }

        <div class="account-actions">
            <button class="btn btn-danger" type="submit">@L["DeleteAccountAction"]</button>
        </div>
    </div>
</EditForm>

@code {
    private string? message;
    private ApplicationUser? user;
    private bool requirePassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }
        requirePassword = await UserManager.HasPasswordAsync(user);
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (requirePassword && !await UserManager.CheckPasswordAsync(user, Input.Password))
        {
            message = $"Error: {L["IncorrectPassword"]}";
            return;
        }

        var userId = await UserManager.GetUserIdAsync(user);

        // VHT-27: không cho xoá Admin cuối cùng, nếu không hệ thống không còn ai quản trị.
        var isAdmin = await UserManager.IsInRoleAsync(user, Roles.Admin);
        var isLastAdmin = isAdmin
            && (await UserManager.GetUsersInRoleAsync(Roles.Admin)).Count == 1;
        if (AccountPermissionRules.CheckSelfDelete(isAdmin, isLastAdmin) is not null)
        {
            Logger.LogWarning("Chan xoa Admin cuoi cung {UserId}.", userId);
            message = $"Error: {L["LastAdminDeleteBlocked"]}";
            return;
        }

        var result = await UserManager.DeleteAsync(user);
        if (!result.Succeeded)
        {
            // Tài khoản còn dữ liệu nghiệp vụ (nhà, khách, phân công...) sẽ bị FK chặn.
            // Trả thông báo sạch thay vì ném exception => 500.
            Logger.LogWarning(
                "Xoa tai khoan {UserId} that bai: {Errors}",
                userId,
                string.Join(", ", result.Errors.Select(e => e.Description)));
            message = $"Error: {L["AccountDeleteRelatedDataBlocked"]}";
            return;
        }

        await SignInManager.SignOutAsync();

        Logger.LogInformation("User with ID '{UserId}' deleted themselves.", userId);

        RedirectManager.RedirectToCurrentPage();
    }

    private sealed class InputModel
    {
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }
}
