@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>@L["PersonalDataTitle"]</PageTitle>

<h2 class="account-section">@L["PersonalDataTitle"]</h2>
<StatusMessage />

<p>@L["PersonalDataDescription"]</p>
<p><strong>@L["PersonalDataDeleteWarning"]</strong></p>

<div class="account-actions">
    <form action="Account/Manage/DownloadPersonalData" method="post">
        <AntiforgeryToken />
        <button class="btn btn-primary" type="submit">@L["DownloadAction"]</button>
    </form>
    <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">@L["DeleteAction"]</a>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
