@page "/Account/ResetPassword"
@layout Layout.AuthLayout

@* Trang đặt mật khẩu mới từ liên kết trong thư quên mật khẩu: kiểm tra token,
   đổi mật khẩu qua Identity rồi chuyển sang trang xác nhận. Dùng khung AuthLayout. *@

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Web.Components.Shared.Forms
@using Web.Data

@inject IdentityRedirectManager RedirectManager
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<ResetPassword> Logger
@inject IStringLocalizer<Shared> L

<PageTitle>@L["ResetPasswordTitle"] · @L["AppName"]</PageTitle>

<section class="auth-page" aria-labelledby="reset-password-title">
    <div class="auth-card">
        <PageHeading Title="@L["ResetPasswordTitle"]" TitleId="reset-password-title" HelpText="@L["ResetPasswordPrompt"]"
                     InteractiveHelp="true" Class="auth-heading"
                     BreadcrumbItems="@(new BreadcrumbNav.BreadcrumbItem[] { new(L["LoginTitle"], "Account/Login"), new(L["ResetPasswordTitle"]) })" />

        @if (identityErrors is not null)
        {
            <div class="form-alert" role="alert">
                <LucideIcon Name="alert" />
                <span>@ErrorMessage</span>
            </div>
        }

        <EditForm Model="Input" FormName="reset-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <input type="hidden" name="Input.Code" value="@Input.Code" />

            <FormField TValue="string" Id="reset-email" Label="@L["EmailLabel"]" Required="true"
                       Hint="@L["ResetPasswordEmailHint"]" For="() => Input.Email">
                <InputText @bind-Value="Input.Email" id="reset-email" class="input"
                           autocomplete="username" aria-required="true"
                           aria-describedby="reset-email-hint reset-email-error" />
            </FormField>

            <FormField TValue="string" Id="reset-password" Label="@L["PasswordLabel"]" Required="true"
                       For="() => Input.Password">
                <div class="password-wrap">
                    <InputText @bind-Value="Input.Password" id="reset-password" type="password" class="input"
                               autocomplete="new-password" aria-required="true"
                               aria-describedby="reset-password-error" />
                    <button type="button" class="password-toggle" data-password-toggle="reset-password"
                            data-show-label="@L["ShowPassword"]" data-hide-label="@L["HidePassword"]"
                            aria-label="@L["ShowPassword"]" aria-pressed="false">
                        <span class="pw-icon-show"><LucideIcon Name="eye" /></span>
                        <span class="pw-icon-hide"><LucideIcon Name="eye-off" /></span>
                    </button>
                </div>
            </FormField>

            <FormField TValue="string" Id="reset-confirm" Label="@L["ConfirmPasswordLabel"]" Required="true"
                       For="() => Input.ConfirmPassword">
                <InputText @bind-Value="Input.ConfirmPassword" id="reset-confirm" type="password" class="input"
                           autocomplete="new-password" aria-required="true" placeholder="@L["ConfirmPasswordPlaceholder"]"
                           aria-describedby="reset-confirm-error" />
            </FormField>

            <button type="submit" class="btn btn-primary btn-block">@L["ResetPasswordButton"]</button>
        </EditForm>

        <p class="hint">
            <a href="Account/Login">@L["BackToLogin"]</a>
        </p>
    </div>
</section>

@code {
    private IEnumerable<IdentityError>? identityErrors;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    private string? ErrorMessage => identityErrors is null
        ? null
        : string.Format(
            System.Globalization.CultureInfo.CurrentCulture,
            L["ResetPasswordError"],
            string.Join(" ", identityErrors.Select(DescribeError)));

    protected override void OnInitialized()
    {
        Input ??= new();

        if (Code is null)
        {
            RedirectManager.RedirectTo("Account/InvalidPasswordReset");
            return;
        }

        Input.Code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
    }

    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email.Trim());
        if (user is null)
        {
            // Không tiết lộ email có tồn tại hay không.
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, Input.Code, Input.Password);
        if (result.Succeeded)
        {
            Logger.LogInformation("[MAIL] Đặt lại mật khẩu thành công cho {Email}.", Input.Email.Trim());
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
            return;
        }

        Logger.LogWarning(
            "[MAIL] Đặt lại mật khẩu thất bại cho {Email}: {Errors}",
            Input.Email.Trim(),
            string.Join(", ", result.Errors.Select(e => e.Code)));

        identityErrors = result.Errors;
    }

    /// <summary>Lỗi token hay gặp nhất; dịch sang câu dễ hiểu thay vì chuỗi tiếng Anh của Identity.</summary>
    private string DescribeError(IdentityError error) =>
        error.Code.Contains("InvalidToken", StringComparison.OrdinalIgnoreCase)
            ? L["ResetPasswordInvalidToken"]
            : error.Description;

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        [StringLength(100, MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("Password", ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";

        public string Code { get; set; } = "";
    }
}
