@page "/Account/ForgotPassword"
@layout Layout.AuthLayout

@* Quên mật khẩu: gửi OTP 6 số, xác thực rồi mới chuyển sang đặt mật khẩu mới.
   Luôn chuyển sang trang OTP để không tiết lộ email có tài khoản hay không. *@

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Web.Components.Shared.Forms
@using Web.Data
@using Web.Features.Accounts.Otp

@inject UserManager<ApplicationUser> UserManager
@inject IOtpService Otp
@inject ILogger<ForgotPassword> Logger
@inject IStringLocalizer<Shared> L
@inject IdentityRedirectManager RedirectManager

<PageTitle>@L["ForgotPasswordTitle"] · @L["AppName"]</PageTitle>

@* Cùng khung .auth-card với trang đăng nhập (phong_cach_giao_dien.md). *@
<section class="auth-page" aria-labelledby="forgot-password-title">
    <div class="auth-card">
        <AuthTabs Active="AuthTab.Forgot" />
        <PageHeading Title="@L["ForgotPasswordTitle"]" TitleId="forgot-password-title" Class="auth-heading" />
        <p class="auth-subtitle">@L["ForgotPasswordHint"]</p>

        <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />

            <FormField TValue="string" Id="forgot-email" Label="@L["EmailLabel"]" Required="true"
                       For="() => Input.Email">
                <InputText @bind-Value="Input.Email" id="forgot-email" class="input"
                           autocomplete="username" aria-required="true"
                           placeholder="@L["EmailPlaceholder"]"
                           aria-describedby="forgot-email-error" />
            </FormField>

            <button type="submit" class="btn btn-primary btn-block">@L["SendOtpButton"]</button>
        </EditForm>

        <p class="auth-alt-action">
            <a href="Account/Login"><LucideIcon Name="arrow-left" /> @L["BackToLogin"]</a>
        </p>
    </div>
</section>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task OnValidSubmitAsync()
    {
        var email = Input.Email.Trim();
        var user = await UserManager.FindByEmailAsync(email);

        // Chỉ phát OTP khi tài khoản thật sự dùng được; phản hồi/điều hướng vẫn generic.
        if (user is not null && await UserManager.IsEmailConfirmedAsync(user))
        {
            await Otp.IssueAsync(user.Id, email, OtpPurpose.PasswordReset);
        }

        Logger.LogInformation("[OTP] Yêu cầu đặt lại mật khẩu cho {Email}.", email);
        RedirectManager.RedirectTo(
            $"/Account/VerifyOtp?purpose=PasswordReset&email={Uri.EscapeDataString(email)}");
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
    }
}
