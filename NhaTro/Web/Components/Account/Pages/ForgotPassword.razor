@page "/Account/ForgotPassword"
@layout Layout.AuthLayout

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Web.Components.Shared.Forms
@using Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject ILogger<ForgotPassword> Logger
@inject IStringLocalizer<Shared> L
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>@L["ForgotPasswordTitle"] · @L["AppName"]</PageTitle>

@* Cùng khung .auth-card với trang đăng nhập (phong_cach_giao_dien.md). *@
<section class="auth-page" aria-labelledby="forgot-password-title">
    <div class="auth-card">
        <BreadcrumbNav Items="@(new BreadcrumbNav.BreadcrumbItem[]
            {
                new(L["LoginTitle"], "Account/Login"),
                new(L["ForgotPasswordTitle"]),
            })" />

        <header class="page-heading auth-heading">
            <div>
                <h1 id="forgot-password-title">@L["ForgotPasswordTitle"]</h1>
                <p>@L["ForgotPasswordHint"]</p>
            </div>
        </header>

        <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />

            <FormField TValue="string" Id="forgot-email" Label="@L["EmailLabel"]" Required="true"
                       For="() => Input.Email">
                <InputText @bind-Value="Input.Email" id="forgot-email" class="input"
                           autocomplete="username" aria-required="true"
                           aria-describedby="forgot-email-error" />
            </FormField>

            <button type="submit" class="btn btn-primary btn-block">@L["ResetPasswordButton"]</button>
        </EditForm>

        <p class="hint">
            <a href="Account/Login">@L["BackToLogin"]</a>
        </p>
    </div>
</section>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task OnValidSubmitAsync()
    {
        var email = Input.Email.Trim();
        var user = await UserManager.FindByEmailAsync(email);
        if (user is null || !(await UserManager.IsEmailConfirmedAsync(user)))
        {
            // Không tiết lộ email có tồn tại hay chưa.
            Logger.LogInformation("[MAIL] Yêu cầu đặt lại mật khẩu cho email không dùng được: {Email}", email);
            RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
            return;
        }

        // Token đặt lại mật khẩu của Identity: dùng một lần, hết hạn sau 24 giờ.
        var code = await UserManager.GeneratePasswordResetTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
            new Dictionary<string, object?> { ["code"] = code });

        await EmailSender.SendPasswordResetLinkAsync(user, email, HtmlEncoder.Default.Encode(callbackUrl));
        Logger.LogInformation("[MAIL] Đã tạo liên kết đặt lại mật khẩu cho {Email}.", email);

        RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
    }
}
