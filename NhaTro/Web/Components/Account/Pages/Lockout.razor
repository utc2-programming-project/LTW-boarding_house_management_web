@page "/Account/Lockout"
@layout Layout.AuthLayout

@* Trang báo tài khoản đang bị khóa (quản trị khóa, không phải do gõ sai mật khẩu),
   hướng dẫn liên hệ người quản lý tài khoản. Dùng khung AuthLayout. *@

@inject IStringLocalizer<Shared> L

<PageTitle>@L["LockoutTitle"] · @L["AppName"]</PageTitle>

<section aria-labelledby="lockout-title">
    <BreadcrumbNav Items="@(new BreadcrumbNav.BreadcrumbItem[] { new(L["LockoutTitle"]) })" />

    <div class="preview-card empty-state">
        <LucideIcon Name="lock" />
        <h2 id="lockout-title">@L["LockoutTitle"]</h2>
        <p role="alert">@L["LockoutMessage"]</p>
        <a class="btn btn-secondary" href="/login">@L["LoginButton"]</a>
    </div>
</section>
