@using System.Security.Claims
@using System.Text.Json
@using Web.Components.Shared.Feedback
@using Web.Features.Approvals
@using Web.Features.Approvals.DTOs
@using Web.Features.Approvals.Enums
@using Web.Features.Approvals.Services
@using Web.Features.Contracts.Services
@using Web.Common.Utils
@inject AuthenticationStateProvider Auth
@inject IManagerApprovalService Approvals
@inject ContractApprovalSummaryService ContractSummaries
@inject IStringLocalizer<Shared> L

<PageTitle>@Title</PageTitle>

<section class="approval-page" aria-labelledby="approval-title">
    <PageHeading Title="@Title" TitleId="approval-title" HelpText="@(Mine ? L["MyRequestsHelp"] : L["ApprovalsHelp"])">
        <Actions>
            <button type="button" class="btn btn-secondary" disabled="@_busy" @onclick="ReloadAsync">
                <LucideIcon Name="refresh-cw" />@L["ApprovalUiRefresh"]
            </button>
        </Actions>
    </PageHeading>

    @if (_error || _errorMessage is not null)
    {
        <div class="approval-feedback" role="alert">
            <LucideIcon Name="alert" />
            <p>@(_errorMessage ?? L["ApprovalUiError"])</p>
            <button type="button" class="btn btn-secondary" disabled="@_busy" @onclick="ReloadAsync">@L["ApprovalUiRefresh"]</button>
        </div>
    }
    else if (_items is null)
    {
        <p class="approval-loading" role="status"><LucideIcon Name="refresh-cw" />@L["ApprovalUiLoading"]</p>
    }
    else if (_items.Count == 0)
    {
        <EmptyStateCard Title="@L["ApprovalUiEmpty"]" Description="@L["ApprovalUiEmptyHint"]" />
    }
    else
    {
        <div class="approval-list">
            @foreach (var item in _items)
            {
                <article @key="item.Id" class="approval-card">
                    <div class="approval-card-head">
                        <div>
                            <h2>@item.OperationCode · @L[item.OperationCode]</h2>
                            @if (_contractSummaries.TryGetValue(item.Id, out var contractSummary))
                            {
                                <p class="approval-target">@ActionLabel(contractSummary.Action) <span class="approval-target-key">@contractSummary.ContractNumber · @contractSummary.RoomCode · @contractSummary.PropertyName</span></p>
                                @if (contractSummary.NewEndDate is not null)
                                {
                                    <p class="approval-target"><strong>@L["ApprovalUiNewEndDate"]:</strong> @DateFormatter.Format(DateOnly.FromDateTime(contractSummary.NewEndDate.Value))</p>
                                }
                                @if (contractSummary.ProposedDeposit is not null)
                                {
                                    <p class="approval-target"><strong>@L["ApprovalUiDepositChange"]:</strong> @(contractSummary.CurrentDeposit is null ? "—" : MoneyFormatter.Format(contractSummary.CurrentDeposit.Value)) → @MoneyFormatter.Format(contractSummary.ProposedDeposit.Value)</p>
                                }
                            }
                            else
                            {
                                <p class="approval-target">@L[$"ApprovalUiTarget{item.TargetType}"] <span class="approval-target-key">@item.TargetKey</span></p>
                                @if (PayloadSummary(item) is { Length: > 0 } summary)
                                {
                                    <p class="approval-target">@summary</p>
                                }
                            }
                        </div>
                        <StatusBadge Text="@L[$"ApprovalUiStatus{item.Status}"]"
                                     Tone="@(item.Status == ApprovalRequestStatus.Pending ? BadgeTone.Warning : BadgeTone.Neutral)" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(item.DecisionReason))
                    {
                        <p class="approval-reason"><strong>@L["ApprovalUiReason"]:</strong> @item.DecisionReason</p>
                    }
                    @if (!Mine && item.Status == ApprovalRequestStatus.Pending)
                    {
                        <div class="approval-actions">
                            @if (_confirming == item.Id)
                            {
                                <p class="approval-target">@L["ApprovalUiConfirmApprove"]</p>
                                <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="() => DecideAsync(item.Id, null)">@L["ApprovalUiApprove"]</button>
                                <button type="button" class="btn btn-secondary" disabled="@_busy" @onclick="CancelConfirm">@L["Cancel"]</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="() => StartConfirm(item.Id)">@L["ApprovalUiApprove"]</button>
                            }
                            @if (_rejecting == item.Id)
                            {
                                <div class="approval-reject">
                                    <label for="approval-reason">@L["ApprovalUiReason"]</label>
                                    <textarea id="approval-reason" maxlength="@RejectApprovalRequest.MaxReasonLength"
                                              @bind="_reason" @bind:event="oninput" disabled="@_busy"></textarea>
                                </div>
                                <button type="button" class="btn btn-secondary" disabled="@(_busy || string.IsNullOrWhiteSpace(_reason))"
                                        @onclick="() => DecideAsync(item.Id, _reason.Trim())">@L["ApprovalUiReject"]</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary" disabled="@_busy" @onclick="() => StartReject(item.Id)">@L["ApprovalUiReject"]</button>
                            }
                        </div>
                    }
                </article>
            }
        </div>
    }
</section>

@code {
    [Parameter] public bool Mine { get; set; }

    private string Title => L[Mine ? "MyRequests" : "Approvals"];
    private ApprovalCaller _caller = default!;
    private IReadOnlyList<ApprovalRequestDto>? _items;
    private Guid? _rejecting;
    private Guid? _confirming;
    private string _reason = "";
    private bool _error;
    private string? _errorMessage;
    private bool _busy;
    private IReadOnlyDictionary<Guid, ContractApprovalSummary> _contractSummaries = new Dictionary<Guid, ContractApprovalSummary>();

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        var role = Mine ? "QuanLy" : "ChuTro";
        _caller = new(user.FindFirstValue(ClaimTypes.NameIdentifier) ?? "", user.IsInRole(role) ? role : "");
        await LoadAsync();
    }

    private async Task ReloadAsync()
    {
        if (_busy)
            return;

        _busy = true;
        _error = false;
        _errorMessage = null;
        _items = null;
        try
        {
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var result = Mine ? await Approvals.ListMineAsync(_caller) : await Approvals.ListInboxAsync(_caller);
            _error = !result.Succeeded;
            _errorMessage = result.Succeeded ? null : result.ErrorMessage;
            _items = result.Succeeded ? result.Items : null;
            _contractSummaries = _items is not null
                ? await ContractSummaries.GetAsync(_items, _caller.UserId, _caller.Role)
                : new Dictionary<Guid, ContractApprovalSummary>();
        }
        catch
        {
            _error = true;
            _items = null;
        }
    }
    private string ActionLabel(string action) => L[action switch { "Renew" => "ApprovalUiActionRenew", "Liquidate" => "ApprovalUiActionLiquidate", "UpdateDeposit" => "ApprovalUiActionDeposit", _ => "ApprovalUiActionUnknown" }];

    private string PayloadSummary(ApprovalRequestDto item)
    {
        try
        {
            using var document = JsonDocument.Parse(item.PayloadJson);
            var root = document.RootElement;
            var code = item.OperationCode;
            if (code is "SW-01" or "SW-02" or "SW-03")
            {
                var roomCode = ReadString(root, "values", "code");
                return string.Format(L["ApprovalUiRoomChange"], roomCode ?? item.TargetKey);
            }
            if (code == "SW-04")
                return string.Format(L["ApprovalUiTenantCreate"], ReadString(root, "fullName") ?? item.TargetKey);
            if (code == "SW-05")
                return string.Format(L["ApprovalUiTenantUpdate"], ReadString(root, "fullName") ?? item.TargetKey);
            if (code == "SW-06")
            {
                return ReadString(root, "action") == "SetActive"
                    ? string.Format(L["ApprovalUiTenantStatus"], ReadString(root, "fullName") ?? item.TargetKey)
                    : string.Format(L["ApprovalUiTenantDelete"], ReadString(root, "fullName") ?? item.TargetKey);
            }
            return string.Empty;
        }
        catch (JsonException)
        {
            return string.Empty;
        }
    }

    private static string? ReadString(JsonElement root, params string[] path)
    {
        var current = root;
        foreach (var segment in path)
        {
            if (current.ValueKind != JsonValueKind.Object || !current.TryGetProperty(segment, out current))
                return null;
        }
        return current.ValueKind == JsonValueKind.String ? current.GetString() : null;
    }

    private void StartConfirm(Guid id)
    {
        _confirming = id;
        _rejecting = null;
    }

    private void CancelConfirm()
    {
        _confirming = null;
    }

    private void StartReject(Guid id)
    {
        _rejecting = id;
        _confirming = null;
        _reason = "";
    }

    private async Task DecideAsync(Guid id, string? reason)
    {
        if (_busy)
            return;

        _busy = true;
        try
        {
            var result = reason is null
                ? await Approvals.ApproveAsync(id, _caller)
                : await Approvals.RejectAsync(id, new() { Reason = reason }, _caller);

            if (result.Succeeded)
            {
                _rejecting = null;
                _confirming = null;
            }

            await LoadAsync();
            if (!result.Succeeded)
            {
                _errorMessage = result.ErrorMessage ?? L["ApprovalUiError"];
            }
        }
        catch
        {
            _error = true;
        }
        finally
        {
            _busy = false;
        }
    }
}
