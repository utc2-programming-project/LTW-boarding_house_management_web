@page "/admin/owners"
@attribute [Authorize(Roles = Roles.Admin)]
@rendermode InteractiveServer
@implements IDisposable

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Web.Common.Models
@using Web.Common.Utils
@using Web.Components.Shared.Dialogs
@using Web.Components.Shared.Feedback
@using Web.Components.Shared.Tables
@using Web.Features.Accounts
@using Web.Features.Accounts.Owners

@inject OwnerAdminService Owners
@inject AuthenticationStateProvider Auth
@inject ToastService Toasts
@inject IStringLocalizer<Shared> L

<PageTitle>@L["OwnerAdminTitle"] · @L["AppName"]</PageTitle>

<section class="page-stack" aria-labelledby="owner-admin-title">
    <PageHeading Title="@L["OwnerAdminTitle"]" TitleId="owner-admin-title" HelpText="@L["OwnerAdminHelp"]" />

    <form class="filter-bar filter-bar--panel" role="search" @onsubmit="SubmitSearchAsync" @onsubmit:preventDefault>
        <div class="filter-bar__row">
            <div class="filter-bar__search">
                <label class="sr-only" for="owner-search">@L["OwnerAdminSearch"]</label>
                <span class="filter-bar__icon" aria-hidden="true"><LucideIcon Name="search" /></span>
                <input id="owner-search" class="input" type="search"
                       placeholder="@L["OwnerAdminSearch"]" @bind="_keyword" @bind:event="oninput"
                       @bind:after="OnKeywordChangedAsync" />
            </div>
            <div class="filter-bar__actions">
                <FilterResetButton OnClick="ResetAsync" />
            </div>
        </div>
    </form>

    <DataTable @key="_tableKey" @ref="_table" TItem="OwnerListItemDto" Columns="_columns"
               ItemsProvider="LoadAsync" PageSize="PageSize"
               Caption="@L["OwnerAdminTitle"]" Labels="DataTableLabelLocalizer.Create(L)" />
</section>

<ConfirmDialog Visible="_showConfirm"
               Title="@(_target?.IsLocked == true ? L["OwnerUnlockTitle"] : L["OwnerLockTitle"])"
               Message="@(_target?.IsLocked == true ? L["OwnerUnlockMessage"] : L["OwnerLockMessage"])"
               ConfirmText="@(_target?.IsLocked == true ? L["OwnerAdminUnlock"] : L["OwnerAdminLock"])"
               CancelText="@L["Cancel"]"
               Danger="@(_target?.IsLocked != true)"
               OnConfirm="ConfirmChangeAsync"
               OnCancel="CancelChange" />

@code {
    private const int PageSize = 20;

    private DataTable<OwnerListItemDto>? _table;
    private IReadOnlyList<DataTableColumn<OwnerListItemDto>> _columns = [];
    private int _tableKey;
    private CancellationTokenSource? _keywordDebounce;
    private string? _keyword;
    private string? _actorId;
    private bool _showConfirm;
    private OwnerListItemDto? _target;

    protected override void OnInitialized()
    {
        _columns =
        [
            new()
            {
                Key = "name",
                Title = L["OwnerAdminName"],
                Value = owner => string.IsNullOrWhiteSpace(owner.FullName) ? L["NoData"] : owner.FullName,
            },
            new()
            {
                Key = "email",
                Title = L["OwnerAdminEmail"],
                Value = owner => string.IsNullOrWhiteSpace(owner.Email) ? L["NoData"] : owner.Email,
            },
            new()
            {
                Key = "properties",
                Title = L["OwnerAdminProperties"],
                Value = owner => owner.PropertyCount.ToString(System.Globalization.CultureInfo.CurrentCulture),
                IsNumeric = true,
            },
            new()
            {
                Key = "managers",
                Title = L["OwnerAdminManagers"],
                Value = owner => owner.ManagerCount.ToString(System.Globalization.CultureInfo.CurrentCulture),
                IsNumeric = true,
            },
            new()
            {
                Key = "tenants",
                Title = L["OwnerAdminTenants"],
                Value = owner => owner.TenantCount.ToString(System.Globalization.CultureInfo.CurrentCulture),
                IsNumeric = true,
            },
            new()
            {
                Key = "status",
                Title = L["OwnerAdminStatus"],
                Template = owner => @<StatusBadge Tone="@(owner.IsLocked ? BadgeTone.Error : BadgeTone.Success)"
                                                  Text="@(owner.IsLocked ? L["OwnerAdminLocked"] : L["OwnerAdminActive"])" />,
            },
            new()
            {
                Key = "actions",
                Title = L["Actions"],
                Template = owner => @<div class="p2-row-actions">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => AskChangeAsync(owner)">
                        <LucideIcon Name="@(owner.IsLocked ? "unlock" : "lock")" />
                        <span>@(owner.IsLocked ? L["OwnerAdminUnlock"] : L["OwnerAdminLock"])</span>
                    </button>
                </div>,
            },
        ];
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        _actorId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
    }

    private Task SubmitSearchAsync()
    {
        // Tạo lại bảng để tìm kiếm luôn bắt đầu từ trang 1 (DataTable giữ trang nội bộ).
        _tableKey++;
        return Task.CompletedTask;
    }

    private async Task OnKeywordChangedAsync()
    {
        _keywordDebounce?.Cancel();
        _keywordDebounce?.Dispose();
        _keywordDebounce = new CancellationTokenSource();
        var token = _keywordDebounce.Token;
        try
        {
            await Task.Delay(300, token);
            await SubmitSearchAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    public void Dispose()
    {
        _keywordDebounce?.Cancel();
        _keywordDebounce?.Dispose();
    }

    private Task ResetAsync()
    {
        _keyword = null;
        return SubmitSearchAsync();
    }

    private async Task<PagedResult<OwnerListItemDto>> LoadAsync(DataTableRequest request)
    {
        var result = await Owners.ListAsync(_keyword, request.Page, request.PageSize);

        return new PagedResult<OwnerListItemDto>
        {
            Items = result.Items,
            TotalCount = result.TotalCount,
            Page = request.Page,
            PageSize = request.PageSize,
        };
    }

    private Task AskChangeAsync(OwnerListItemDto owner)
    {
        _target = owner;
        _showConfirm = true;
        return Task.CompletedTask;
    }

    private Task CancelChange()
    {
        _showConfirm = false;
        _target = null;
        return Task.CompletedTask;
    }

    private async Task ConfirmChangeAsync()
    {
        if (_target is null || string.IsNullOrWhiteSpace(_actorId))
        {
            return;
        }

        var target = _target;
        var lockOwner = !target.IsLocked;
        var result = lockOwner
            ? await Owners.LockAsync(target.Id, _actorId)
            : await Owners.UnlockAsync(target.Id, _actorId);

        if (result.Succeeded)
        {
            Toasts.Success(lockOwner ? L["OwnerLocked"] : L["OwnerUnlocked"]);
        }
        else
        {
            Toasts.Error(result.ErrorMessage ?? L["OwnerAdminLoadFailed"]);
        }

        _showConfirm = false;
        _target = null;

        if (_table is not null)
        {
            await _table.ReloadAsync();
        }
    }
}
