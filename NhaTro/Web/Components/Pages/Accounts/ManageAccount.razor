@page "/Account/Manage"
@layout Web.Components.Account.Shared.ManageLayout
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Web.Components.Shared.Forms
@using Web.Data
@using Web.Features.Accounts

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<Shared> L

@* VHT-8: giữ nguyên route /Account/Manage nhưng đặt ngoài Components/Account/Pages
   để không dính [ExcludeFromInteractiveRouting] — bấm từ sidebar là chuyển tab SPA,
   không tải lại toàn trang. *@

<PageTitle>@L["ProfileTitle"]</PageTitle>

<h2 class="account-section">@L["ProfileTitle"]</h2>

@if (_loaded && _user is null)
{
    <div class="form-alert" role="alert">
        <LucideIcon Name="alert" />
        <span>@L["InvalidUserTitle"]</span>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(_status))
    {
        <div class="form-alert@(_statusIsError ? "" : " success")" role="alert">
            <LucideIcon Name="@(_statusIsError ? "alert" : "check")" />
            <span>@_status</span>
        </div>
    }

    <EditForm EditContext="_editContext" OnValidSubmit="OnValidSubmitAsync">
        <div class="account-form">
            <div class="account-field">
                <span class="account-field-label">@L["UsernameLabel"]</span>
                <p class="account-readonly">@_username</p>
            </div>

            <FormField TValue="string" Id="Input.PhoneNumber" Label="@L["PhoneLabel"]" For="() => Input.PhoneNumber">
                <InputText @bind-Value="Input.PhoneNumber" id="Input.PhoneNumber" autocomplete="tel"
                           inputmode="numeric" maxlength="10"
                           aria-describedby="Input.PhoneNumber-error" />
            </FormField>

            <div class="account-actions">
                <button type="submit" class="btn btn-primary" disabled="@_saving">@L["SaveChanges"]</button>
            </div>
        </div>
    </EditForm>
}

@code {
    private ApplicationUser? _user;
    private string? _username;
    private string? _phoneNumber;
    private bool _loaded;
    private bool _saving;
    private string? _status;
    private bool _statusIsError;

    private InputModel Input { get; } = new();

    private EditContext _editContext = default!;
    private ValidationMessageStore _messages = default!;

    protected override async Task OnInitializedAsync()
    {
        _editContext = CreateEditContext();

        var state = await AuthState.GetAuthenticationStateAsync();
        _user = await UserManager.GetUserAsync(state.User);
        if (_user is not null)
        {
            _username = await UserManager.GetUserNameAsync(_user);
            _phoneNumber = await UserManager.GetPhoneNumberAsync(_user);
            Input.PhoneNumber = _phoneNumber;
        }

        _loaded = true;
    }

    // Cùng quy tắc với AccountService.UpdateMyProfileAsync: SĐT 10 chữ số bắt đầu bằng 0.
    private EditContext CreateEditContext()
    {
        var context = new EditContext(Input);
        var messages = _messages = new ValidationMessageStore(context);

        context.OnValidationRequested += (_, _) =>
        {
            messages.Clear();
            var phone = NormalizePhone(Input.PhoneNumber);
            if (phone is not null && !AccountService.IsValidVietnamPhone(phone))
            {
                messages.Add(new FieldIdentifier(Input, nameof(InputModel.PhoneNumber)), L["ErrorInvalidPhone"]);
            }
        };

        context.OnFieldChanged += (_, args) => messages.Clear(args.FieldIdentifier);

        return context;
    }

    private async Task OnValidSubmitAsync()
    {
        if (_user is null || _saving) return;

        _saving = true;
        _status = null;
        try
        {
            var phone = NormalizePhone(Input.PhoneNumber);
            if (!string.Equals(phone, _phoneNumber, StringComparison.Ordinal))
            {
                var result = await UserManager.SetPhoneNumberAsync(_user, phone);
                if (!result.Succeeded)
                {
                    _status = L["ProfilePhoneUpdateFailed"];
                    _statusIsError = true;
                    return;
                }

                _phoneNumber = phone;
                Input.PhoneNumber = phone;
            }

            _status = L["ProfileSaved"];
            _statusIsError = false;
        }
        catch
        {
            _status = L["ProfilePhoneUpdateFailed"];
            _statusIsError = true;
        }
        finally
        {
            _saving = false;
        }
    }

    private static string? NormalizePhone(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed class InputModel
    {
        public string? PhoneNumber { get; set; }
    }
}
