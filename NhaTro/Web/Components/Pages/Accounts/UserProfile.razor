@page "/profile"
@attribute [Authorize(Roles = Roles.Admin + "," + Roles.ChuTro + "," + Roles.QuanLy)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Web.Features.Accounts
@using Web.Features.Accounts.DTOs
@using Web.Features.Invoices
@using Web.Components.Shared.Feedback
@using Web.Components.Shared.Forms

@inject IAccountService Accounts
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<Shared> L
@inject ToastService Toasts
@inject Web.Features.Invoices.Services.OwnerBankAccountNotifier BankAccountNotifier

@* VHT-8: ho so ca nhan (/profile). Ca 4 vai tro deu vao duoc, chi sua duoc cua chinh minh. *@

<PageTitle>@L["ProfileTitle"] · @L["AppName"]</PageTitle>

<section class="profile-page" aria-labelledby="profile-title">
    <PageHeading Title="@L["ProfileTitle"]" TitleId="profile-title" HelpText="@L["ProfileSubtitle"]" CurrentLabel="@L["ProfileTitle"]" />

    @if (_loading)
    {
        <LoadingOverlay Visible="true" Text="@L["TableLoading"]" />
    }
    else if (_profile is null)
    {
        <EmptyStateCard Title="@L["NoData"]" Description="@L["ProfileLoadFailed"]">
            <button type="button" class="btn btn-secondary" @onclick="LoadAsync">@L["Retry"]</button>
        </EmptyStateCard>
    }
    else
    {
        <div class="profile-overview">
            <div class="profile-avatar" aria-hidden="true">@ProfileInitials</div>
            <div class="profile-identity">
                <p class="profile-overview-label">@L["ProfileInfoSection"]</p>
                <h2>@ProfileDisplayName</h2>
                <p class="profile-email">@_emailReadonly</p>
                <p class="profile-email-hint">@L["EmailReadonlyHint"]</p>
            </div>
            <div class="profile-role">
                <StatusBadge Tone="@RoleTone(_profile.Role)" Text="@RoleText(_profile.Role)" />
            </div>
        </div>

        <div class="profile-content-grid">
            <section class="profile-card profile-form-card" aria-labelledby="profile-info-title">
                <div class="profile-card-heading">
                    <span class="profile-heading-icon" aria-hidden="true"><LucideIcon Name="user" /></span>
                    <div>
                        <h2 id="profile-info-title">@L["ProfileInfoSection"]</h2>
                    </div>
                </div>

                <EditForm EditContext="_editContext" OnValidSubmit="SaveProfileAsync">
                    <div class="profile-fields @(_profile.Role == Roles.ChuTro ? "profile-fields-owner" : "")">
                        <div class="profile-field-name">
                            <FormField TValue="string" Id="profile-fullname" Label="@L["FullNameLabel"]" Required="true"
                                       For="() => _form.FullName">
                                <InputText @bind-Value="_form.FullName" id="profile-fullname" maxlength="200"
                                           aria-describedby="profile-fullname-error" aria-invalid="@(_editContext.HasError(() => _form.FullName) ? "true" : "false")" />
                            </FormField>
                        </div>

                        <div class="profile-field-phone">
                            <FormField TValue="string" Id="profile-phone" Label="@L["PhoneLabel"]"
                                       Hint="@L["PhoneHint"]" For="() => _form.PhoneNumber">
                                <InputText @bind-Value="_form.PhoneNumber" id="profile-phone" inputmode="numeric" maxlength="10"
                                           aria-describedby="profile-phone-hint profile-phone-error" aria-invalid="@(_editContext.HasError(() => _form.PhoneNumber) ? "true" : "false")" />
                            </FormField>
                        </div>

                        @if (_profile.Role == Roles.ChuTro)
                        {
                            <div class="profile-field-bank-heading">
                                <span class="profile-bank-icon" aria-hidden="true"><LucideIcon Name="wallet" /></span>
                                <div>
                                    <h3>@L["ProfileBankSection"]</h3>
                                    <p>@L["ProfileBankHint"]</p>
                                </div>
                            </div>

                            <div class="profile-field-bank">
                                <FormField TValue="string" Id="profile-bank-code" Label="@L["BankLabel"]" Required="true"
                                           For="() => _form.BankCode">
                                    <InputSelect TValue="string" @bind-Value="_form.BankCode" id="profile-bank-code"
                                                 aria-describedby="profile-bank-code-error" aria-invalid="@(_editContext.HasError(() => _form.BankCode) ? "true" : "false")">
                                        <option value="">@L["BankSelectPlaceholder"]</option>
                                        @foreach (var bank in VietQrBankCatalog.All)
                                        {
                                            <option value="@bank.Code">@bank.Name</option>
                                        }
                                    </InputSelect>
                                </FormField>
                            </div>

                            <div class="profile-field-bank-number">
                                <FormField TValue="string" Id="profile-bank-number" Label="@L["BankAccountNumberLabel"]" Required="true"
                                           Hint="@L["BankAccountNumberHint"]" For="() => _form.BankAccountNumber">
                                    <InputText @bind-Value="_form.BankAccountNumber" id="profile-bank-number" inputmode="numeric" maxlength="20"
                                               aria-describedby="profile-bank-number-hint profile-bank-number-error" aria-invalid="@(_editContext.HasError(() => _form.BankAccountNumber) ? "true" : "false")" />
                                </FormField>
                            </div>

                            <div class="profile-field-bank-name">
                                <FormField TValue="string" Id="profile-bank-name" Label="@L["BankAccountNameLabel"]" Required="true"
                                           Hint="@L["BankAccountNameHint"]" For="() => _form.BankAccountName">
                                    <InputText @bind-Value="_form.BankAccountName" id="profile-bank-name" maxlength="50"
                                               aria-describedby="profile-bank-name-hint profile-bank-name-error" aria-invalid="@(_editContext.HasError(() => _form.BankAccountName) ? "true" : "false")" />
                                </FormField>
                            </div>
                        }

                    </div>

                    <div class="profile-actions">
                        <button type="button" class="btn btn-secondary" disabled="@_saving" @onclick="ResetForm">
                            @L["Cancel"]
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@_saving">
                            @if (_saving)
                            {
                                <span class="spinner" aria-hidden="true"></span>
                            }
                            @L["SaveChanges"]
                        </button>
                    </div>
                </EditForm>
            </section>

            <aside class="profile-side-column">
                <section class="profile-card profile-security-card" aria-labelledby="profile-security-title">
                    <span class="profile-security-icon" aria-hidden="true"><LucideIcon Name="shield-check" /></span>
                    <div class="profile-security-copy">
                        <h2 id="profile-security-title">@L["SecuritySection"]</h2>
                        <p>@L["ChangePasswordHint"]</p>
                    </div>
                    <a class="btn btn-secondary profile-security-action" href="Account/Manage/ChangePassword">
                        <LucideIcon Name="key" />
                        @L["ChangePassword"]
                    </a>
                </section>
            </aside>
        </div>
    }
</section>

@code {
    private MyProfileDto? _profile;
    private bool _loading = true;
    private bool _saving;

    private EditContext _editContext = default!;
    private ValidationMessageStore _messages = default!;
    private ProfileForm _form = new();
    private string _emailReadonly = string.Empty;

    private string ProfileDisplayName => string.IsNullOrWhiteSpace(_profile?.FullName)
        ? _profile?.UserName ?? string.Empty
        : _profile?.FullName ?? string.Empty;

    private string ProfileInitials
    {
        get
        {
            var parts = ProfileDisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (parts.Length == 0) return "?";
            if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
            return string.Concat(char.ToUpperInvariant(parts[0][0]), char.ToUpperInvariant(parts[^1][0]));
        }
    }

    private sealed class ProfileForm
    {
        public string? FullName { get; set; }
        public string? PhoneNumber { get; set; }
        public string? BankCode { get; set; }
        public string? BankAccountNumber { get; set; }
        public string? BankAccountName { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _editContext = CreateEditContext();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (string.IsNullOrEmpty(userId))
            {
                _profile = null;
                return;
            }

            var result = await Accounts.GetMyProfileAsync(userId);
            _profile = result.Succeeded ? result.Value : null;
            if (_profile is not null)
            {
                _form = ToForm(_profile);
                _emailReadonly = _profile.Email ?? _profile.UserName;
                _editContext = CreateEditContext();
            }
        }
        catch
        {
            _profile = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetForm()
    {
        if (_profile is null) return;
        _form = ToForm(_profile);
        _editContext = CreateEditContext();
    }

    private static ProfileForm ToForm(MyProfileDto profile) => new()
    {
        FullName = profile.FullName,
        PhoneNumber = profile.PhoneNumber,
        BankCode = profile.BankCode,
        BankAccountNumber = profile.BankAccountNumber,
        BankAccountName = profile.BankAccountName,
    };

    // EditForm chạy OnValidSubmit nên cần một bộ kiểm tra gắn vào EditContext; nếu không, form luôn "hợp lệ"
    // và lỗi chỉ hiện sau khi service trả về. Dùng ValidationMessageStore để message theo ngôn ngữ đang chọn.
    private EditContext CreateEditContext()
    {
        var context = new EditContext(_form);
        var messages = _messages = new ValidationMessageStore(context);
        context.OnValidationRequested += (_, _) =>
        {
            messages.Clear();
            ValidateProfile((ProfileForm)context.Model, messages);
            context.NotifyValidationStateChanged();
        };
        context.OnFieldChanged += (_, args) =>
        {
            messages.Clear(args.FieldIdentifier);
            context.NotifyValidationStateChanged();
        };
        return context;
    }

    // Cùng quy tắc với AccountService.UpdateMyProfileAsync: họ tên tối đa 200 ký tự, SĐT 10 chữ số bắt đầu bằng 0.
    private void ValidateProfile(ProfileForm form, ValidationMessageStore messages)
    {
        if ((form.FullName?.Trim().Length ?? 0) > 200)
        {
            messages.Add(new FieldIdentifier(form, nameof(ProfileForm.FullName)),
                string.Format(L["TenantValidationLength"], L["FullNameLabel"], 200));
        }

        var phone = form.PhoneNumber?.Trim();
        if (!string.IsNullOrEmpty(phone) && !AccountService.IsValidVietnamPhone(phone))
        {
            messages.Add(new FieldIdentifier(form, nameof(ProfileForm.PhoneNumber)), L["ErrorInvalidPhone"]);
        }

        if (_profile?.Role == Roles.ChuTro)
        {
            ValidateBankAccount(form, messages);
        }
    }

    // PLAN-028: hoặc để trống cả 3 (không dùng QR), hoặc nhập đủ 3 và đúng định dạng.
    private void ValidateBankAccount(ProfileForm form, ValidationMessageStore messages)
    {
        var code = form.BankCode?.Trim();
        var number = form.BankAccountNumber?.Trim();
        var name = form.BankAccountName?.Trim();
        if (string.IsNullOrEmpty(code) && string.IsNullOrEmpty(number) && string.IsNullOrEmpty(name))
        {
            return;
        }

        if (string.IsNullOrEmpty(code))
        {
            messages.Add(new FieldIdentifier(form, nameof(ProfileForm.BankCode)),
                string.Format(L["TenantValidationRequired"], L["BankLabel"]));
        }

        if (string.IsNullOrEmpty(number))
        {
            messages.Add(new FieldIdentifier(form, nameof(ProfileForm.BankAccountNumber)),
                string.Format(L["TenantValidationRequired"], L["BankAccountNumberLabel"]));
        }
        else if (!number.All(char.IsAsciiDigit) || number.Length is < 6 or > 20)
        {
            messages.Add(new FieldIdentifier(form, nameof(ProfileForm.BankAccountNumber)), L["ErrorInvalidBankAccount"]);
        }

        if (string.IsNullOrEmpty(name))
        {
            messages.Add(new FieldIdentifier(form, nameof(ProfileForm.BankAccountName)),
                string.Format(L["TenantValidationRequired"], L["BankAccountNameLabel"]));
        }
        else if (name.Length is < 5 or > 50)
        {
            messages.Add(new FieldIdentifier(form, nameof(ProfileForm.BankAccountName)), L["ErrorInvalidBankAccount"]);
        }
    }

    private async Task SaveProfileAsync()
    {
        if (_saving) return;
        _saving = true;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (string.IsNullOrEmpty(userId)) return;

            var result = await Accounts.UpdateMyProfileAsync(
                new UpdateMyProfileRequest
                {
                    FullName = _form.FullName,
                    PhoneNumber = _form.PhoneNumber,
                    BankCode = _form.BankCode,
                    BankAccountNumber = _form.BankAccountNumber,
                    BankAccountName = _form.BankAccountName,
                },
                userId);
            if (!result.Succeeded)
            {
                if (result.ErrorCode == AccountErrorCodes.InvalidPhone)
                {
                    _messages.Add(new FieldIdentifier(_form, nameof(ProfileForm.PhoneNumber)), L["ErrorInvalidPhone"]);
                    _editContext.NotifyValidationStateChanged();
                }
                else if (result.ErrorCode == AccountErrorCodes.InvalidBankAccount)
                {
                    _messages.Add(new FieldIdentifier(_form, nameof(ProfileForm.BankCode)), L["ErrorInvalidBankAccount"]);
                    _editContext.NotifyValidationStateChanged();
                }
                Toasts.Error(MessageFor(result.ErrorCode));
                return;
            }

            _profile = result.Value;
            _emailReadonly = _profile?.Email ?? _emailReadonly;
            // PLAN-028: báo banner "chưa nhập tài khoản nhận tiền" cập nhật ngay sau khi lưu.
            BankAccountNotifier.NotifyChanged();
            Toasts.Success(L["ProfileSaved"]);
        }
        catch
        {
            Toasts.Error(L["ErrorGeneric"]);
        }
        finally
        {
            _saving = false;
        }
    }

    private string MessageFor(string? code) => code switch
    {
        AccountErrorCodes.InvalidPhone => L["ErrorInvalidPhone"],
        AccountErrorCodes.InvalidBankAccount => L["ErrorInvalidBankAccount"],
        AccountErrorCodes.UserNotFound => L["ErrorUserNotFound"],
        _ => L["ErrorGeneric"],
    };

    private string RoleText(string role) => L[AccountPermissionRules.RoleResourceKey(role)];

    private static BadgeTone RoleTone(string role) => role switch
    {
        Roles.Admin => BadgeTone.Error,
        Roles.ChuTro => BadgeTone.Info,
        Roles.QuanLy => BadgeTone.Success,
        Roles.KhachThue => BadgeTone.Neutral,
        _ => BadgeTone.Neutral,
    };
}
