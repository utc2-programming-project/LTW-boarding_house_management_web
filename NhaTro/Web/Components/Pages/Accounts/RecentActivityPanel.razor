@using Microsoft.AspNetCore.Identity
@using Web.Components.Shared.Feedback
@using Web.Data
@using Web.Features.Notifications

@inject UserManager<ApplicationUser> UserManager
@inject INotificationService Notifications
@inject IStringLocalizer<Shared> L

@* Tab Hoạt động: lịch sử sự kiện của riêng tài khoản đang đăng nhập, lấy từ hộp thư thông báo. *@

<div class="acct-stack">
    <section class="acct-card" aria-labelledby="account-activity-title">
        <div class="acct-card-head">
            <span class="acct-card-icon" aria-hidden="true"><LucideIcon Name="history" /></span>
            <div>
                <h2 id="account-activity-title">@L["RecentActivityTitle"]</h2>
                <p class="acct-card-desc">@L["RecentActivityDesc"]</p>
            </div>
        </div>

        @if (_rows.Count == 0)
        {
            <p class="account-hint">@L["RecentActivityEmpty"]</p>
        }
        else
        {
            <ul class="acct-rows">
                @foreach (var row in _rows)
                {
                    <li class="acct-row">
                        <span class="acct-row-icon" aria-hidden="true"><LucideIcon Name="bell" /></span>
                        <div class="acct-row-copy">
                            @if (string.IsNullOrWhiteSpace(row.Link))
                            {
                                <span class="acct-row-title">@row.Title</span>
                            }
                            else
                            {
                                <a class="acct-row-title" href="@row.Link">@row.Title</a>
                            }
                            <span class="acct-row-desc">
                                @row.Body
                                <span class="acct-activity-time">@row.CreatedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</span>
                            </span>
                        </div>
                        <span class="acct-row-side">
                            @if (!row.IsRead)
                            {
                                <StatusBadge Tone="@BadgeTone.Info" Text="@L["StatusUnread"]" />
                            }
                        </span>
                    </li>
                }
            </ul>

            @if (_hasUnread)
            {
                <div class="acct-form-actions">
                    <EditForm Model="MarkAll" FormName="activity-mark-all" OnValidSubmit="MarkAllReadAsync" method="post">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-secondary">@L["NotificationMarkAllRead"]</button>
                    </EditForm>
                </div>
            }

            <p class="account-hint">@L["RecentActivityDevicesHint"]</p>
        }
    </section>
</div>

@code {
    private const int Take = 10;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "activity-mark-all")]
    private MarkAllModel MarkAll { get; set; } = default!;

    private IReadOnlyList<AppNotification> _rows = [];
    private string? _userId;
    private bool _hasUnread;

    protected override async Task OnInitializedAsync()
    {
        MarkAll ??= new();

        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            return;
        }

        _userId = user.Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_userId is not null)
        {
            _rows = await Notifications.ListAsync(_userId, Take);
            _hasUnread = _rows.Any(row => !row.IsRead);
        }
    }

    private async Task MarkAllReadAsync()
    {
        if (_userId is null)
        {
            return;
        }

        await Notifications.MarkAllReadAsync(_userId);
        await LoadAsync();
    }

    private sealed class MarkAllModel
    {
    }
}
