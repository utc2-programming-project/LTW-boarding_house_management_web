@page "/admin/users"
@attribute [Authorize]
@rendermode InteractiveServer

@* Trang quản lý tài khoản (/admin/users): xem/lọc danh sách, tạo tài khoản theo phạm vi
   tòa nhà, duyệt - đổi vai trò - khóa/mở khóa. *@

@using Microsoft.AspNetCore.Authorization
@using Web.Common.Models
@using Web.Common.Utils
@using Web.Components.Shared.Dialogs
@using Web.Components.Shared.Feedback
@using Web.Components.Shared.Forms
@using Web.Components.Shared.Tables
@using Web.Features.Accounts
@using Web.Features.Accounts.DTOs
@using Web.Features.Properties.Components

@inject IAccountService Accounts
@inject AuthenticationStateProvider AuthState
@inject IStringLocalizer<Shared> L
@inject ToastService Toasts

@* VHT-95: quyền và phạm vi thao tác do AccountService kiểm ở server; UI chỉ hiện nút theo quyền. *@

<PageTitle>@L["AccountsTitle"] · @L["AppName"]</PageTitle>

<section class="accounts-page" aria-labelledby="accounts-title">
    <PageHeading Title="@L["AccountsTitle"]" TitleId="accounts-title" HelpText="@L["AccountsSubtitle"]">
        <Actions>
            @if (_assignableRoles.Count > 0)
            {
                <button type="button" class="btn btn-primary" @onclick="OpenCreate">
                    <LucideIcon Name="plus" /> @L["CreateAccount"]
                </button>
            }
            @if (_callerRole == Roles.Admin)
            {
                <button type="button" class="btn btn-secondary" @onclick="OpenTrash">
                    <LucideIcon Name="trash" /> @L["AccountTrash"]
                </button>
            }
        </Actions>
    </PageHeading>

    <div class="filter-bar filter-bar--panel" role="search">
        <div class="filter-bar__row">
            <div class="filter-bar__search">
                <label class="sr-only" for="account-search">@L["SearchAccounts"]</label>
                <span class="filter-bar__icon" aria-hidden="true"><LucideIcon Name="search" /></span>
                <InputText id="account-search" class="input" @bind-Value="_keyword"
                           @bind-Value:after="ReloadAsync" placeholder="@L["SearchAccountsHint"]" />
            </div>

            <div class="filter-bar__field filter-bar__select">
                <label class="sr-only" for="account-role">@L["FilterRole"]</label>
                <select id="account-role" class="input" @bind="_roleFilter" @bind:after="ReloadAsync">
                    <option value="">@L["FilterAllRoles"]</option>
                    @foreach (var role in _filterRoles)
                    {
                        <option value="@role">@RoleText(role)</option>
                    }
                </select>
            </div>

            @if (HasActiveAccountFilters)
            {
                <div class="filter-bar__actions">
                    <button type="button" class="btn btn-secondary filter-bar__reset" @onclick="ClearAccountFiltersAsync"
                            aria-label="@L["ClearFilters"]" title="@L["ClearFilters"]">
                        <LucideIcon Name="refresh-cw" />
                    </button>
                </div>
            }
        </div>
    </div>

    <DataTable @ref="_table" TItem="AccountListItemDto" Columns="_columns"
               ItemsProvider="LoadAccountsAsync" PageSize="10" Caption="@L["AccountsTitle"]"
               Labels="DataTableLabelLocalizer.Create(L)"
               CompactFooter="true" ItemUnitLabel="@L["AccountsCountUnit"]">

        <EmptyActions>
            <p class="note">@L["AccountsEmptyHint"]</p>
        </EmptyActions>
    </DataTable>
</section>

<AccountTrashDialog Visible="_showTrash" CallerUserId="@_callerUserId" CallerRole="@_callerRole"
                      OnClose="CloseTrash" />

<CreateAccountDialog Visible="_createVisible" CallerUserId="@_callerUserId" CallerRole="@_callerRole"
                     AssignableRoles="_assignableRoles"
                     OnClose="CloseCreate" OnCreated="OnAccountCreated" />

<ConfirmDialog Visible="_confirmApprove.Visible" Title="@L["ApproveTitle"]"
               Message="@ApproveMessage()" ConfirmText="@L["Approve"]" CancelText="@L["Cancel"]"
               OnConfirm="ConfirmApproveAsync" OnCancel="CancelApprove" />

<ConfirmDialog Visible="_confirmRole.Visible" Title="@L["ChangeRoleTitle"]"
               ConfirmText="@L["Confirm"]" CancelText="@L["Cancel"]"
               OnConfirm="ConfirmRoleAsync" OnCancel="CancelRoleChange">
    <p>@L["ChangeRoleMessageBefore"] <strong>@_confirmRole.UserName</strong></p>
    <div class="field">
        <label class="label" for="role-select">@L["NewRoleLabel"]</label>
        <select id="role-select" class="input" @bind="_confirmRole.NewRole">
            @foreach (var role in _roleChangeOptions)
            {
                <option value="@role">@RoleText(role)</option>
            }
        </select>
    </div>
    <p class="note">@L["ChangeRoleWarning"]</p>
</ConfirmDialog>

<ConfirmDialog Visible="_confirmDelete.Visible" Title="@L["DeleteAccountTitle"]"
               Message="@string.Format(L["DeleteAccountMessage"], _confirmDelete.UserName)"
               ConfirmText="@L["DeleteAccountConfirm"]" CancelText="@L["Cancel"]" Danger="true"
               OnConfirm="ConfirmDeleteAsync" OnCancel="CancelDelete" />

<ConfirmDialog Visible="_confirmLock.Visible" Title="@(_confirmLock.Lock ? L["LockTitle"] : L["UnlockTitle"])"               Message="@LockMessage()"
               ConfirmText="@(_confirmLock.Lock ? L["LockConfirm"] : L["UnlockConfirm"])"
               CancelText="@L["Cancel"]" Danger="_confirmLock.Lock"
               OnConfirm="ConfirmLockAsync" OnCancel="CancelLock" />

@if (_assignManager.Visible)
{
    <ManagerAssignmentDialog ManagerUserId="@_assignManager.UserId"
                             ManagerName="@_assignManager.Name"
                             OnClose="CloseManagerAssign"
                             OnChanged="OnManagerAssignmentChanged" />
}

@code {
    private const int PageSize = 10;

    private DataTable<AccountListItemDto>? _table;
    private IReadOnlyList<DataTableColumn<AccountListItemDto>> _columns = [];
    private IReadOnlyList<string> _assignableRoles = [];
    private IReadOnlyList<string> _filterRoles = [];
    private IReadOnlyList<string> _roleChangeOptions = [];
    private IReadOnlyList<string> _lockableRoles = [];
    private bool _canChangeRole;
    private bool _createVisible;

    private string? _keyword;
    private string? _roleFilter;

    private bool HasActiveAccountFilters =>
        !string.IsNullOrWhiteSpace(_keyword) || !string.IsNullOrWhiteSpace(_roleFilter);

    private Task ClearAccountFiltersAsync()
    {
        _keyword = null;
        _roleFilter = null;
        return ReloadAsync();
    }

    private string? _openMenuId;
    private string _callerUserId = string.Empty;
    private string _callerRole = string.Empty;

    private ApproveState _confirmApprove = new();
    private RoleChangeState _confirmRole = new();
    private LockState _confirmLock = new();
    private DeleteState _confirmDelete = new();
    private bool _showTrash;
    private ManagerAssignState _assignManager = new();

    private sealed class ApproveState
    {
        public bool Visible { get; set; }
        public string UserId { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
    }

    private sealed class RoleChangeState
    {
        public bool Visible { get; set; }
        public string UserId { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public string NewRole { get; set; } = string.Empty;
    }

    private sealed class LockState
    {
        public bool Visible { get; set; }
        public bool Lock { get; set; }
        public string UserId { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
    }

    private sealed class DeleteState
    {
        public bool Visible { get; set; }
        public string UserId { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
    }

    private sealed class ManagerAssignState
    {
        public bool Visible { get; set; }
        public string UserId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _callerUserId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        _callerRole = Roles.ResolvePrimaryRole(state.User);

        _assignableRoles = AccountPermissionRules.AssignableRoles(_callerRole);
        _filterRoles = AccountPermissionRules.VisibleRoles(_callerRole);
        _lockableRoles = AccountPermissionRules.LockableRoles(_callerRole);
        _canChangeRole = AccountPermissionRules.CanChangeRole(_callerRole);
        _roleChangeOptions = _canChangeRole ? Roles.All : [];

        _columns =
        [
            new DataTableColumn<AccountListItemDto>
            {
                Key = "name",
                Title = L["ColumnAccount"],
                Sortable = true,
                Template = user => @<span class="account-cell">
                    <span class="account-name">@(string.IsNullOrWhiteSpace(user.FullName) ? user.UserName : user.FullName)</span>
                    @if (!string.IsNullOrWhiteSpace(user.FullName))
                    {
                        <small class="account-sub">@user.UserName</small>
                    }
                </span>,
            },
            new DataTableColumn<AccountListItemDto>
            {
                Key = "email",
                Title = L["EmailLabel"],
                Value = user => user.Email,
            },
            new DataTableColumn<AccountListItemDto>
            {
                Key = "phone",
                Title = L["PhoneLabel"],
                Value = user => string.IsNullOrWhiteSpace(user.PhoneNumber) ? L["NoData"] : user.PhoneNumber,
            },
            new DataTableColumn<AccountListItemDto>
            {
                Key = "role",
                Title = L["ColumnRole"],
                Sortable = true,
                Template = user => @<StatusBadge Tone="@RoleTone(user.Role)" Text="@RoleText(user.Role)" />,
            },
            new DataTableColumn<AccountListItemDto>
            {
                Key = "owner",
                Title = L["ColumnOwnerOrProperty"],
                Template = user => @<span class="account-owner">
                    @if (user.Role == Roles.QuanLy
                         && string.IsNullOrWhiteSpace(user.OwnerName)
                         && string.IsNullOrWhiteSpace(user.OwnerEmail))
                    {
                        <span class="owner-badge unassigned">@L["OwnerUnassigned"]</span>
                    }
                    else if (user.Role == Roles.QuanLy)
                    {
                        <span class="account-name">@(string.IsNullOrWhiteSpace(user.OwnerName) ? user.OwnerEmail : user.OwnerName)</span>
                        @if (user.AssignedProperties.Count > 0)
                        {
                            <small class="account-sub">@string.Join(", ", user.AssignedProperties.Select(property => property.Name))</small>
                        }
                    }
                    else if (user.Role == Roles.ChuTro)
                    {
                        <span class="account-name">@L["OwnerSelf"]</span>
                        <small class="account-sub">@(user.OwnedProperties.Count > 0
                            ? string.Join(", ", user.OwnedProperties.Select(property => property.Name))
                            : L["OwnerNoProperty"].Value)</small>
                    }
                    else
                    {
                        <span class="note">@L["NotApplicable"]</span>
                    }
                </span>,
            },
            new DataTableColumn<AccountListItemDto>
            {
                Key = "status",
                Title = L["ColumnStatus"],
                Template = user => @<StatusBadge Tone="@StatusTone(user.Status)"
                                                   Text="@L[AccountStatusRules.ResourceKey(user.Status)]" />,
            },
            new DataTableColumn<AccountListItemDto>
            {
                Key = "actions",
                Title = L["ColumnActions"],
                Template = user => @<span class="row-actions">
                    @if (user.Id == _callerUserId)
                    {
                        <span class="account-self">
                            <LucideIcon Name="user" />
                            @L["ThisIsYou"]
                        </span>
                    }
                    else if (HasRowActions(user))
                    {
                        <div class="p2-row-actions">
                            <button type="button"
                                    class="icon-button p2-menu-trigger @(IsMenuOpen(user.Id) ? "is-open" : null)"
                                    title="@L["ColumnActions"]"
                                    aria-label="@($"{L["ColumnActions"]}: {DisplayName(user)}")"
                                    aria-haspopup="menu"
                                    aria-expanded="@(IsMenuOpen(user.Id) ? "true" : "false")"
                                    aria-controls="@($"account-row-menu-{user.Id}")"
                                    @onclick="() => ToggleRowMenu(user.Id)">
                                <LucideIcon Name="ellipsis" />
                            </button>
                            @if (IsMenuOpen(user.Id))
                            {
                                <div id="@($"account-row-menu-{user.Id}")" class="p2-row-menu" role="menu" aria-label="@L["ColumnActions"]" data-row-menu>
                                    @if (user.Status == AccountStatus.Pending
                                         && AccountPermissionRules.CanApprove(_callerRole, user.Role))
                                    {
                                        <button type="button" class="p2-row-menu-item" role="menuitem" @onclick="() => MenuApprove(user)">
                                            <LucideIcon Name="check" /><span>@L["Approve"]</span>
                                        </button>
                                    }
                                    @if (_canChangeRole)
                                    {
                                        <button type="button" class="p2-row-menu-item" role="menuitem" @onclick="() => MenuRoleChange(user)">
                                            <LucideIcon Name="shield" /><span>@L["ChangeRole"]</span>
                                        </button>
                                    }
                                    @if (_lockableRoles.Contains(user.Role))
                                    {
                                        <button type="button" class="p2-row-menu-item" role="menuitem" @onclick="() => MenuLock(user)">
                                            <LucideIcon Name="@(user.IsLocked ? "unlock" : "lock")" />
                                            <span>@(user.IsLocked ? L["Unlock"] : L["Lock"])</span>
                                        </button>
                                    }
                                    @if (_callerRole == Roles.ChuTro && user.Role == Roles.QuanLy)
                                    {
                                        <button type="button" class="p2-row-menu-item" role="menuitem" @onclick="() => MenuAssign(user)">
                                            <LucideIcon Name="building" /><span>@L["AssignProperties"]</span>
                                        </button>
                                    }
                                    @if (_lockableRoles.Contains(user.Role))
                                    {
                                        <div class="p2-row-menu-sep" role="separator"></div>
                                        <button type="button" class="p2-row-menu-item danger" role="menuitem" @onclick="() => MenuDelete(user)">
                                            <LucideIcon Name="trash" /><span>@L["DeleteAccount"]</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </span>,
            },
        ];
    }

    private async Task<PagedResult<AccountListItemDto>> LoadAccountsAsync(DataTableRequest request)
    {
        var keyword = string.IsNullOrWhiteSpace(_keyword)
            ? request.Filters.GetValueOrDefault("name")
            : _keyword;
        var role = string.IsNullOrWhiteSpace(_roleFilter)
            ? request.Filters.GetValueOrDefault("role")
            : _roleFilter;

        return await Accounts.ListAsync(
            keyword, role, request.Page, request.PageSize, _callerUserId, _callerRole);
    }

    private Task ReloadAsync()
    {
        _openMenuId = null;
        return _table?.ReloadAsync() ?? Task.CompletedTask;
    }

    private bool HasRowActions(AccountListItemDto user) =>
        (user.Status == AccountStatus.Pending && AccountPermissionRules.CanApprove(_callerRole, user.Role))
        || _canChangeRole
        || _lockableRoles.Contains(user.Role)
        || (_callerRole == Roles.ChuTro && user.Role == Roles.QuanLy);

    private bool IsMenuOpen(string userId) => _openMenuId == userId;

    private void ToggleRowMenu(string userId) => _openMenuId = _openMenuId == userId ? null : userId;

    private void MenuApprove(AccountListItemDto user)
    {
        _openMenuId = null;
        OpenApprove(user);
    }

    private void MenuRoleChange(AccountListItemDto user)
    {
        _openMenuId = null;
        OpenRoleChange(user);
    }

    private void MenuLock(AccountListItemDto user)
    {
        _openMenuId = null;
        OpenLock(user);
    }

    private void MenuAssign(AccountListItemDto user)
    {
        _openMenuId = null;
        OpenManagerAssign(user);
    }

    private void MenuDelete(AccountListItemDto user)
    {
        _openMenuId = null;
        OpenDelete(user);
    }

    private void OpenCreate() => _createVisible = true;

    private void CloseCreate() => _createVisible = false;

    private async Task OnAccountCreated(string role)
    {
        _createVisible = false;

        Toasts.Success(role == Roles.KhachThue && _callerRole == Roles.QuanLy
            ? L["AccountCreatedPending"]
            : L["AccountCreated"]);

        await ReloadAsync();
    }

    private void OpenApprove(AccountListItemDto user)
    {
        _confirmApprove = new ApproveState
        {
            Visible = true,
            UserId = user.Id,
            UserName = DisplayName(user),
        };
    }

    private void CancelApprove() => _confirmApprove.Visible = false;

    private string ApproveMessage() => string.Format(L["ApproveMessage"], _confirmApprove.UserName);

    private async Task ConfirmApproveAsync()
    {
        var result = await Accounts.ApproveAsync(_confirmApprove.UserId, _callerUserId, _callerRole);

        _confirmApprove.Visible = false;

        if (!result.Succeeded)
        {
            Toasts.Error(MessageFor(result.ErrorCode));
            return;
        }

        Toasts.Success(L["AccountApproved"]);
        await ReloadAsync();
    }

    private void OpenRoleChange(AccountListItemDto user)
    {
        _confirmRole = new RoleChangeState
        {
            Visible = true,
            UserId = user.Id,
            UserName = DisplayName(user),
            NewRole = _roleChangeOptions.Contains(user.Role) ? user.Role : _roleChangeOptions.FirstOrDefault() ?? string.Empty,
        };
    }

    private void CancelRoleChange() => _confirmRole.Visible = false;

    private async Task ConfirmRoleAsync()
    {
        var result = await Accounts.ChangeRoleAsync(
            _confirmRole.UserId, _confirmRole.NewRole, _callerUserId, _callerRole);

        _confirmRole.Visible = false;

        if (!result.Succeeded)
        {
            Toasts.Error(MessageFor(result.ErrorCode));
            return;
        }

        Toasts.Success(L["RoleChanged"]);
        await ReloadAsync();
    }

    private void OpenTrash() => _showTrash = true;

    private Task CloseTrash()
    {
        _showTrash = false;
        return ReloadAsync();
    }

    private void OpenDelete(AccountListItemDto user)
    {
        _confirmDelete = new DeleteState
        {
            Visible = true,
            UserId = user.Id,
            UserName = DisplayName(user),
        };
    }

    private void CancelDelete() => _confirmDelete.Visible = false;

    private async Task ConfirmDeleteAsync()
    {
        var result = await Accounts.DeleteAsync(
            _confirmDelete.UserId, _callerUserId, _callerRole);

        _confirmDelete.Visible = false;

        if (!result.Succeeded)
        {
            Toasts.Error(MessageFor(result.ErrorCode));
            return;
        }

        Toasts.Success(L["AccountDeleted"]);
        await ReloadAsync();
    }

    private void OpenLock(AccountListItemDto user)
    {
        _confirmLock = new LockState
        {
            Visible = true,
            Lock = !user.IsLocked,
            UserId = user.Id,
            UserName = DisplayName(user),
        };
    }

    private void CancelLock() => _confirmLock.Visible = false;

    private string LockMessage() => string.Format(
        _confirmLock.Lock ? L["LockMessage"] : L["UnlockMessage"], _confirmLock.UserName);

    private void OpenManagerAssign(AccountListItemDto user)
    {
        _assignManager = new ManagerAssignState
        {
            Visible = true,
            UserId = user.Id,
            Name = DisplayName(user),
        };
    }

    private void CloseManagerAssign() => _assignManager.Visible = false;

    private Task OnManagerAssignmentChanged() => ReloadAsync();

    private async Task ConfirmLockAsync()
    {
        var result = _confirmLock.Lock
            ? await Accounts.LockAsync(_confirmLock.UserId, _callerUserId, _callerRole)
            : await Accounts.UnlockAsync(_confirmLock.UserId, _callerUserId, _callerRole);

        _confirmLock.Visible = false;

        if (!result.Succeeded)
        {
            Toasts.Error(MessageFor(result.ErrorCode));
            return;
        }

        Toasts.Success(_confirmLock.Lock ? L["AccountLocked"] : L["AccountUnlocked"]);
        await ReloadAsync();
    }

    private string MessageFor(string? code) => L[AccountErrorCodes.ResourceKey(code)];

    private static string DisplayName(AccountListItemDto user) =>
        string.IsNullOrWhiteSpace(user.FullName) ? user.UserName : user.FullName;

    private string RoleText(string role) => L[AccountPermissionRules.RoleResourceKey(role)];

    private static BadgeTone StatusTone(AccountStatus status) => status switch
    {
        AccountStatus.Unverified => BadgeTone.Warning,
        AccountStatus.Pending => BadgeTone.Info,
        AccountStatus.Locked => BadgeTone.Neutral,
        _ => BadgeTone.Success,
    };

    private static BadgeTone RoleTone(string role) => role switch
    {
        Roles.Admin => BadgeTone.Error,
        Roles.ChuTro => BadgeTone.Info,
        Roles.QuanLy => BadgeTone.Success,
        Roles.KhachThue => BadgeTone.Neutral,
        _ => BadgeTone.Neutral,
    };
}
