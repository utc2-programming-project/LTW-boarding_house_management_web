@using Web.Components.Shared.Dialogs
@using Web.Components.Shared.Feedback
@using Web.Features.Accounts
@using Web.Features.Accounts.DTOs

@inject IAccountService Accounts
@inject ToastService Toasts
@inject IStringLocalizer<Shared> L

<FeatureDialog Visible="Visible" Title="@L["AccountTrashTitle"]" CloseLabel="@L["Close"]" OnClose="OnClose">
    @if (_loading)
    {
        <p class="note">@L["TableLoading"]</p>
    }
    else if (_items.Count == 0)
    {
        <p class="note">@L["AccountTrashEmpty"]</p>
    }
    else
    {
        <div class="trash-actions">
            <button type="button" class="btn btn-danger btn-sm" @onclick="() => _showEmpty = true">
                @L["EmptyTrash"]
            </button>
        </div>
        <div class="table-scroll">
            <table class="account-table">
                <thead>
                    <tr>
                        <th scope="col">@L["EmailLabel"]</th>
                        <th scope="col">@L["FullNameLabel"]</th>
                        <th scope="col">@L["AccountDeletedAt"]</th>
                        <th scope="col">@L["ColumnActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr>
                            <td>@item.OriginalEmail</td>
                            <td>@(string.IsNullOrWhiteSpace(item.FullName) ? L["NoData"].Value : item.FullName)</td>
                            <td>@(item.DeletedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td>
                                <div class="p2-row-actions">
                                    <button type="button" class="btn btn-secondary btn-sm"
                                            @onclick="() => RestoreAsync(item)">
                                        @L["AccountRestore"]
                                    </button>
                                    <button type="button" class="btn btn-danger btn-sm"
                                            @onclick="() => RequestPurge(item)">
                                        @L["Purge"]
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</FeatureDialog>

<PurgeConfirmDialog Visible="_showPurge" Title="@L["PurgeTitle"]"
                Message="@string.Format(L["PurgeMessage"], _purgeTarget?.OriginalEmail ?? string.Empty)"
                ExpectedText="@(_purgeTarget?.OriginalEmail ?? string.Empty)"
                PromptText="@string.Format(L["PurgeTypePrompt"], _purgeTarget?.OriginalEmail ?? string.Empty)"
                MismatchText="@L["PurgeMismatch"]"
                ConfirmText="@L["Purge"]" CancelText="@L["Cancel"]"
                OnConfirm="ConfirmPurgeAsync" OnCancel="CancelPurge" />

<PurgeConfirmDialog Visible="_showEmpty" Title="@L["EmptyTrashTitle"]"
                Message="@L["EmptyTrashMessage"]"
                ExpectedText="@L["TrashEmptyPhrase"]"
                PromptText="@string.Format(L["PurgeTypePrompt"], L["TrashEmptyPhrase"].Value)"
                MismatchText="@L["PurgeMismatch"]"
                ConfirmText="@L["EmptyTrash"]" CancelText="@L["Cancel"]"
                OnConfirm="EmptyTrashAsync" OnCancel="() => _showEmpty = false" />

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string CallerUserId { get; set; } = string.Empty;
    [Parameter] public string CallerRole { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }

    private IReadOnlyList<DeletedAccountDto> _items = [];
    private DeletedAccountDto? _purgeTarget;
    private bool _loading;
    private bool _wasVisible;
    private bool _showPurge;
    private bool _showEmpty;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && !_wasVisible)
        {
            await LoadAsync();
        }

        _wasVisible = Visible;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = await Accounts.ListDeletedAsync(CallerRole);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RestoreAsync(DeletedAccountDto item)
    {
        var result = await Accounts.RestoreAsync(item.Id, CallerUserId, CallerRole);
        if (!result.Succeeded)
        {
            Toasts.Error(L[AccountErrorCodes.ResourceKey(result.ErrorCode)]);
            return;
        }

        Toasts.Success(L["AccountRestored"]);
        await LoadAsync();
    }

    private void RequestPurge(DeletedAccountDto item)
    {
        _purgeTarget = item;
        _showPurge = true;
    }

    private void CancelPurge()
    {
        _showPurge = false;
        _purgeTarget = null;
    }

    private async Task ConfirmPurgeAsync()
    {
        if (_purgeTarget is null)
        {
            _showPurge = false;
            return;
        }

        var result = await Accounts.PurgeAsync(_purgeTarget.Id, CallerUserId, CallerRole);
        _showPurge = false;
        if (!result.Succeeded)
        {
            Toasts.Error(L[AccountErrorCodes.ResourceKey(result.ErrorCode)]);
            return;
        }

        Toasts.Success(L["PurgeSuccess"]);
        _purgeTarget = null;
        await LoadAsync();
    }

    private async Task EmptyTrashAsync()
    {
        _showEmpty = false;
        var summary = await Accounts.PurgeAllAsync(CallerUserId, CallerRole);
        if (summary.Purged == 0 && summary.Skipped == 0)
        {
            Toasts.Success(L["EmptyTrashNothing"]);
        }
        else
        {
            Toasts.Success(string.Format(L["EmptyTrashSuccess"], summary.Purged, summary.Skipped));
        }

        await LoadAsync();
    }
}
