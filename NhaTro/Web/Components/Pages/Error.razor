@page "/Error"
@using System.Diagnostics
@inject IStringLocalizer<Shared> L

<PageTitle>@L["ErrorTitle"] · @L["AppName"]</PageTitle>

@* Trang lỗi an toàn, song ngữ; không lộ chi tiết exception ở môi trường thật. *@
<section class="empty-state" aria-labelledby="error-title">
    <LucideIcon Name="alert" />
    <h1 id="error-title">@L["ErrorTitle"]</h1>
    <p>@L["ErrorPageMessage"]</p>
    @if (ShowRequestId)
    {
        <p><small>@L["ErrorRequestId"]: <code>@RequestId</code></small></p>
    }
    <a class="btn btn-primary" href="/">@L["BackToHome"]</a>
</section>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
