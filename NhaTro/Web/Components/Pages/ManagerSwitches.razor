@page "/manager-switches"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "ChuTro")]
@using System.Security.Claims
@using Web.Components.Shared.Feedback
@using Web.Features.Settings
@using Web.Features.Settings.DTOs
@using Web.Features.Settings.Enums
@using Web.Features.Settings.Services
@inject AuthenticationStateProvider Auth
@inject IManagerToggleService Toggles
@inject IStringLocalizer<Shared> L

<PageTitle>@L["ManagerSwitches"] · @L["AppName"]</PageTitle>

<section class="switches-page" aria-labelledby="switches-title">
    <BreadcrumbNav Items="@(new BreadcrumbNav.BreadcrumbItem[] { new(L["ManagerSwitches"]) })" />

    <header class="page-heading">
        <div>
            <h1 id="switches-title">@L["ManagerSwitches"]</h1>
            <p>@L["ManagerSwitchesSubtitle"]</p>
        </div>
    </header>

    @if (_error)
    {
        <div class="form-alert" role="alert">
            <LucideIcon Name="alert" />
            <span>@L["ApprovalUiError"]</span>
        </div>
    }
    @if (_items is null && !_error)
    {
        <p class="account-hint" role="status">@L["ApprovalUiLoading"]</p>
    }
    else if (_items is { Count: 0 })
    {
        <EmptyStateCard Title="@L["ApprovalUiEmpty"]" />
    }
    else if (_items is not null)
    {
        <div class="account-panel">
            <p class="account-hint">@L["ManagerSwitchesSaveHint"]</p>
            <div class="table-scroll">
                <table class="account-table">
                    <thead><tr><th scope="col">@L["ApprovalUiAction"]</th><th scope="col">@L["ApprovalUiMode"]</th></tr></thead>
                    <tbody>
                        @foreach (var item in _items.OrderBy(item => item.Code, StringComparer.OrdinalIgnoreCase))
                        {
                            <tr @key="item.Code">
                                <th scope="row"><label for="@item.Code">@item.Code · @L[item.Code]</label></th>
                                <td>
                                    <select @key="_renderVersion" id="@item.Code" class="input" value="@item.Mode" disabled="@_saving"
                                            @onchange="args => SaveAsync(item, args)">
                                        @foreach (var mode in item.AllowedModes)
                                        {
                                            <option value="@mode">@L[$"ApprovalUiMode{mode}"]</option>
                                        }
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>

@code {
    private IReadOnlyList<ManagerToggleItem>? _items;
    private ManagerToggleCaller _caller = default!;
    private bool _saving;
    private bool _error;
    private int _renderVersion;

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        _caller = new(user.FindFirstValue(ClaimTypes.NameIdentifier) ?? "", user.IsInRole("ChuTro") ? "ChuTro" : "");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Toggles.GetAllAsync(_caller);
        _error = !result.Succeeded;
        _items = result.Succeeded ? result.Items : null;
    }

    private async Task SaveAsync(ManagerToggleItem item, ChangeEventArgs args)
    {
        if (_saving || !Enum.TryParse<ManagerToggleMode>(args.Value?.ToString(), out var mode))
            return;

        _saving = true;
        try
        {
            var result = await Toggles.SetAsync(item.Code, mode, _caller);
            await LoadAsync();
            _error |= !result.Succeeded;
        }
        finally
        {
            _renderVersion++;
            _saving = false;
        }
    }
}
