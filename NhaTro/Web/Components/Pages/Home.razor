@page "/"
@inject IStringLocalizer<Shared> L
@using Web.Common.Utils

<PageTitle>@L["LayoutPreview"] — @L["AppName"]</PageTitle>
<section class="preview-page" aria-labelledby="preview-title">
    <BreadcrumbNav Items="@(new BreadcrumbNav.BreadcrumbItem[] { new(L["LayoutPreview"]) })" />
    <header class="page-heading">
        <div><h1 id="preview-title">@L["LayoutPreview"]</h1><p>@L["PreviewDescription"]</p></div>
        <span class="preview-badge">@L["SampleData"]</span>
    </header>
    <section class="preview-card" aria-labelledby="sample-title">
        <h2 id="sample-title">@L["DisplayExamples"]</h2>
        <p>@L["SampleDisclaimer"]</p>
        <dl class="sample-values">
            <div><dt>@L["SampleDate"]</dt><dd>@DateFormatter.Format(new DateOnly(2026, 10, 15))</dd></div>
            <div><dt>@L["SampleAmount"]</dt><dd>@MoneyFormatter.Format(1500000m)</dd></div>
        </dl>
    </section>
    <section class="preview-card empty-state" aria-labelledby="empty-title">
        <LucideIcon Name="empty" />
        <h2 id="empty-title">@L["NoData"]</h2>
        <p>@L["ModulesPending"]</p>
        <a class="app-button secondary" href="/">@L["BackToPreview"]</a>
    </section>
</section>
