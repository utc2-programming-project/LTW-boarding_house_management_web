@page "/not-found"
@layout MainLayout
@inject IStringLocalizer<Shared> L

<PageTitle>@L["NotFoundTitle"] · @L["AppName"]</PageTitle>

<PageHeading Title="@L["NotFoundTitle"]" TitleId="not-found-title" HelpText="@L["NotFoundHelp"]" InteractiveHelp="true" />

@* Trang không tìm thấy, song ngữ; không lộ thông tin nội bộ. *@
<section class="empty-state">
    <LucideIcon Name="search" />
    <p>@L["NotFoundMessage"]</p>
    <a class="btn btn-primary" href="/home">@L["BackToHome"]</a>
</section>
