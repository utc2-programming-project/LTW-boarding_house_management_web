@page "/not-found"
@layout MainLayout
@inject IStringLocalizer<Shared> L

<PageTitle>@L["NotFoundTitle"] · @L["AppName"]</PageTitle>

@* Trang không tìm thấy, song ngữ; không lộ thông tin nội bộ. *@
<section class="empty-state" aria-labelledby="not-found-title">
    <LucideIcon Name="search" />
    <h1 id="not-found-title">@L["NotFoundTitle"]</h1>
    <p>@L["NotFoundMessage"]</p>
    <a class="btn btn-primary" href="/">@L["BackToHome"]</a>
</section>
