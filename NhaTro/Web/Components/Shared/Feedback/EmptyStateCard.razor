<div class="empty-state">
    <span class="icon" aria-hidden="true">
        @if (Icon is not null)
        {
            @Icon
        }
        else
        {
            <LucideIcon Name="inbox" />
        }
    </span>
    <p class="title">@Title</p>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="description">@Description</p>
    }
    @if (ChildContent is not null)
    {
        <div class="actions">@ChildContent</div>
    }
</div>

@code {
    /// <summary>Tiêu đề đã dịch, ví dụ "Chưa có dữ liệu" / "No data".</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    /// <summary>Icon thay thế (SVG 24×24, hiển thị 48px).</summary>
    [Parameter]
    public RenderFragment? Icon { get; set; }

    /// <summary>Nút kêu gọi hành động: tạo mới hoặc xóa bộ lọc.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
