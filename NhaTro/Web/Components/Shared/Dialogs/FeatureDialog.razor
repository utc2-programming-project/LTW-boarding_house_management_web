@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog @ref="_dialog" class="feature-dialog @CssClass" aria-labelledby="@_titleId">
    <header class="feature-dialog-header">
        <h2 id="@_titleId">@Title</h2>
        <button type="button" class="icon-button" aria-label="@CloseLabel" title="@CloseLabel"
                disabled="@Busy" @onclick="CloseAsync">
            <LucideIcon Name="close" />
        </button>
    </header>
    <div class="feature-dialog-content">
        @ChildContent
    </div>
</dialog>

@code {
    private const string ModulePath = "./Components/Shared/Dialogs/ConfirmDialog.razor.js";

    private readonly string _titleId = $"feature-dialog-{Guid.NewGuid():N}-title";
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private IJSObjectReference? _registration;
    private DotNetObjectReference<FeatureDialog>? _self;
    private bool _openInDom;

    [Parameter] public bool Visible { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string CloseLabel { get; set; } = "Close";
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible == _openInDom) return;

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
        if (_registration is null)
        {
            _self = DotNetObjectReference.Create(this);
            _registration = await _module.InvokeAsync<IJSObjectReference>("register", _dialog, _self);
        }

        await _module.InvokeVoidAsync(Visible ? "open" : "close", _dialog);
        _openInDom = Visible;
    }

    private Task CloseAsync() => RequestCloseAsync(OnClose);

    public Task RequestCloseAsync() => RequestCloseAsync(OnClose);

    public async Task RequestCloseAsync(EventCallback callback)
    {
        if (Busy) return;
        await CloseNativeAsync();
        await callback.InvokeAsync();
    }

    public async Task CloseNativeAsync()
    {
        if (_module is null || !_openInDom) return;

        try
        {
            await _module.InvokeVoidAsync("close", _dialog);
        }
        catch (JSDisconnectedException)
        {
            // The parent can still finish closing after the circuit is disconnected.
        }
        finally
        {
            _openInDom = false;
        }
    }

    [JSInvokable]
    public Task OnDismissRequested() =>
        Visible && !Busy ? InvokeAsync(CloseAsync) : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_registration is not null)
            {
                await _registration.InvokeVoidAsync("dispose");
                await _registration.DisposeAsync();
            }

            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit has already ended.
        }

        _self?.Dispose();
    }
}
