@inject IStringLocalizer<Shared> L

<button type="button" class="btn btn-secondary filter-bar__reset" disabled="@Disabled" @onclick="OnClick">
    <LucideIcon Name="refresh-cw" />
    <span>@L["ClearFilters"]</span>
</button>

@code {
    /// <summary>Nút xoá toàn bộ bộ lọc. Nhãn lấy từ resource chung để mọi trang cùng một chữ.</summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public bool Disabled { get; set; }
}
