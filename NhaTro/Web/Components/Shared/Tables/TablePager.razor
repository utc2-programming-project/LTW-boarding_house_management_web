@inject IStringLocalizer<Shared> L

@if (Total > 0)
{
    <footer class="table-pager">
        <span class="table-pager__summary">@string.Format(L["TableSummary"], From, To, Total)</span>
        <div class="table-pager__controls">
            @if (TotalPages > 1)
            {
                <nav class="table-pager__pages" aria-label="@L["TablePagination"]">
                    <button type="button" class="table-pager__button" aria-label="@L["TableFirstPage"]"
                            disabled="@(Disabled || Page <= 1)" @onclick="() => GoToAsync(1)">
                        <LucideIcon Name="chevrons-left" />
                    </button>
                    <button type="button" class="table-pager__button" aria-label="@L["TablePreviousPage"]"
                            disabled="@(Disabled || Page <= 1)" @onclick="() => GoToAsync(Page - 1)">
                        <LucideIcon Name="chevron-left" />
                    </button>
                    @foreach (var p in PaginationHelper.PageWindow(Page, TotalPages))
                    {
                        <button type="button" class="table-pager__button @(p == Page ? "current" : null)"
                                aria-label="@($"{L["TablePage"]} {p}")" aria-current="@(p == Page ? "page" : null)"
                                disabled="@Disabled" @onclick="() => GoToAsync(p)">@p</button>
                    }
                    <button type="button" class="table-pager__button" aria-label="@L["TableNextPage"]"
                            disabled="@(Disabled || Page >= TotalPages)" @onclick="() => GoToAsync(Page + 1)">
                        <LucideIcon Name="chevron-right" />
                    </button>
                    <button type="button" class="table-pager__button" aria-label="@L["TableLastPage"]"
                            disabled="@(Disabled || Page >= TotalPages)" @onclick="() => GoToAsync(TotalPages)">
                        <LucideIcon Name="chevrons-right" />
                    </button>
                </nav>
            }
        </div>
    </footer>
}

@code {
    /// <summary>Trang hiện tại (bắt đầu từ 1).</summary>
    [Parameter]
    public int Page { get; set; } = 1;

    [Parameter]
    public int TotalPages { get; set; } = 1;

    /// <summary>Bản ghi đầu của trang hiện tại.</summary>
    [Parameter]
    public int From { get; set; }

    /// <summary>Bản ghi cuối của trang hiện tại.</summary>
    [Parameter]
    public int To { get; set; }

    [Parameter]
    public int Total { get; set; }

    /// <summary>Khoá điều hướng khi trang đang tải dữ liệu.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<int> PageChanged { get; set; }

    private Task GoToAsync(int page) =>
        page < 1 || page > TotalPages || page == Page
            ? Task.CompletedTask
            : PageChanged.InvokeAsync(page);
}
